---
import Page from '../../components/Page.astro';
import EngagementBar from '../../components/EngagementBarNew.astro';
import GitHubContributionGrid from '../../components/GitHubContributionGrid.astro';
import IsometricMark from '../../components/IsometricMark.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ProjectCard from '../../components/home/ProjectCard.astro';
import { webProjects } from '../../data/projects';

import engagementSource from '../../components/EngagementBarNew.astro?raw';
import contributionSource from '../../components/GitHubContributionGrid.astro?raw';
import globalSearchSource from '../../components/GlobalSearch.astro?raw';
import isometricSource from '../../components/IsometricMark.astro?raw';
import themeToggleSource from '../../components/ThemeToggle.astro?raw';
import projectCardSource from '../../components/home/ProjectCard.astro?raw';

const project = webProjects[0];
---

<Page
  title="Components — Nabil Rizki Navisa"
  description="A compact gallery of reusable portfolio components with live previews and source code."
  path="/components/"
>
  <div class="components-page">
    <header class="components-hero">
      <div>
        <span class="eyebrow">SYSTEM / COMPONENTS</span>
        <h1>Components</h1>
        <p>Reusable pieces from this portfolio. Preview first, source directly below.</p>
      </div>
      <a class="generator-link" href="/components/isometric-generator/">A–Z isometric generator ↗</a>
    </header>

    <div class="component-list">
      <section class="component-block" id="github-contribution-grid">
        <header class="component-head">
          <div>
            <span class="component-index">01</span>
            <h2>GitHub Contribution Graph</h2>
          </div>
          <span class="component-kind">data display</span>
        </header>

        <div class="preview-stage contribution-preview">
          <GitHubContributionGrid username="nabilrn" />
        </div>

        <p class="component-credit">
          Adapted from
          <a href="https://chanhdai.com/" target="_blank" rel="noopener noreferrer">Chánh Đại</a>.
          Chánh Đại's contribution graph credits
          <a href="https://www.kibo-ui.com/components/contribution-graph" target="_blank" rel="noopener noreferrer">Kibo UI</a>.
        </p>

        <details class="source-panel">
          <summary>source code</summary>
          <pre><code>{contributionSource}</code></pre>
        </details>
      </section>

      <section class="component-block" id="global-search">
        <header class="component-head">
          <div>
            <span class="component-index">02</span>
            <h2>Global Search</h2>
          </div>
          <span class="component-kind">navigation</span>
        </header>

        <div class="preview-stage compact-preview">
          <button type="button" class="search-preview-trigger" data-global-search-open>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            <span>Search portfolio</span>
            <kbd data-global-search-shortcut>Ctrl K</kbd>
          </button>
        </div>

        <details class="source-panel">
          <summary>source code</summary>
          <pre><code>{globalSearchSource}</code></pre>
        </details>
      </section>

      <section class="component-block" id="theme-toggle">
        <header class="component-head">
          <div>
            <span class="component-index">03</span>
            <h2>Theme Toggle</h2>
          </div>
          <span class="component-kind">interaction</span>
        </header>

        <div class="preview-stage compact-preview">
          <div class="theme-preview-shell"><ThemeToggle /></div>
          <span class="preview-note">pixel transition is the real site interaction</span>
        </div>

        <details class="source-panel">
          <summary>source code</summary>
          <pre><code>{themeToggleSource}</code></pre>
        </details>
      </section>

      <section class="component-block" id="project-card">
        <header class="component-head">
          <div>
            <span class="component-index">04</span>
            <h2>Project Card</h2>
          </div>
          <span class="component-kind">content</span>
        </header>

        <div class="preview-stage project-card-preview">
          {project && <ProjectCard project={project} />}
        </div>

        <details class="source-panel">
          <summary>source code</summary>
          <pre><code>{projectCardSource}</code></pre>
        </details>
      </section>

      <section class="component-block" id="engagement-bar">
        <header class="component-head">
          <div>
            <span class="component-index">05</span>
            <h2>Engagement Bar</h2>
          </div>
          <span class="component-kind">interaction</span>
        </header>

        <div class="preview-stage compact-preview">
          <EngagementBar
            postId="component-preview"
            title="Component preview"
            variant="inline"
            trackView={false}
          />
        </div>

        <details class="source-panel">
          <summary>source code</summary>
          <pre><code>{engagementSource}</code></pre>
        </details>
      </section>

      <section class="component-block" id="isometric-mark">
        <header class="component-head">
          <div>
            <span class="component-index">06</span>
            <h2>Isometric Mark</h2>
          </div>
          <a class="component-action" href="/components/isometric-generator/">open generator ↗</a>
        </header>

        <div class="preview-stage isometric-preview">
          <IsometricMark character="N" depth={28} hatch={true} guides={true} />
        </div>

        <details class="source-panel">
          <summary>source code</summary>
          <pre><code>{isometricSource}</code></pre>
        </details>
      </section>
    </div>
  </div>
</Page>

<style>
  .components-page {
    width: min(1100px, 100%);
    margin: 0 auto;
    border-inline: 1px solid var(--sheet-line, var(--border));
    border-bottom: 1px solid var(--sheet-line, var(--border));
  }

  .components-hero {
    min-height: 132px;
    padding: 26px clamp(18px, 3vw, 34px);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--sheet-line, var(--border));
  }

  .eyebrow,
  .component-index,
  .component-kind {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .components-hero h1 {
    margin: 8px 0 7px;
    font-family: var(--font-sans);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -.045em;
  }

  .components-hero p {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.5;
  }

  .generator-link,
  .component-action {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 10px;
    text-decoration: none;
    white-space: nowrap;
  }

  .generator-link:hover,
  .generator-link:focus-visible,
  .component-action:hover,
  .component-action:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
    outline: none;
  }

  .component-list { display: grid; }

  .component-block {
    padding: 0 clamp(16px, 3vw, 32px) 30px;
    scroll-margin-top: 68px;
  }

  .component-block + .component-block {
    border-top: 1px solid var(--sheet-line, var(--border));
  }

  .component-head {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }

  .component-head > div {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .component-head h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 640;
    line-height: 1.2;
    letter-spacing: -.02em;
  }

  .preview-stage {
    min-height: 180px;
    padding: clamp(16px, 2.4vw, 28px);
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--border);
    background:
      linear-gradient(to right, transparent calc(50% - .5px), color-mix(in srgb, var(--border) 50%, transparent) 50%, transparent calc(50% + .5px)),
      linear-gradient(to bottom, transparent calc(50% - .5px), color-mix(in srgb, var(--border) 50%, transparent) 50%, transparent calc(50% + .5px));
  }

  .contribution-preview {
    min-height: 230px;
    display: block;
    padding-top: 44px;
    background: transparent;
  }

  .compact-preview {
    min-height: 150px;
    align-content: center;
    gap: 12px;
  }

  .project-card-preview { min-height: 330px; }
  .project-card-preview :global(.project-card) { width: min(300px, 100%); }

  .isometric-preview { min-height: 330px; }
  .isometric-preview :global(.isometric-mark) { width: min(420px, 88%); }

  .search-preview-trigger {
    min-height: 40px;
    padding: 0 11px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 12px;
    cursor: pointer;
  }

  .search-preview-trigger svg {
    width: 15px;
    height: 15px;
    color: var(--muted);
  }

  .search-preview-trigger kbd {
    margin-left: 8px;
    padding: 3px 5px;
    border: 1px solid var(--border);
    border-bottom-color: var(--border-strong);
    border-radius: 3px;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 8px;
  }

  .theme-preview-shell {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .preview-note,
  .component-credit {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 10px;
    line-height: 1.45;
  }

  .component-credit { margin: 10px 0 0; }
  .component-credit a { color: var(--text); text-underline-offset: 2px; }

  .source-panel {
    margin-top: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .source-panel summary {
    min-height: 38px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .04em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .source-panel summary::-webkit-details-marker { display: none; }
  .source-panel summary::before { content: '+ '; margin-right: 6px; color: var(--text); }
  .source-panel[open] summary::before { content: '− '; }

  .source-panel pre {
    max-height: 520px;
    margin: 0;
    padding: 14px;
    overflow: auto;
    border-top: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 42%, var(--bg));
    color: color-mix(in srgb, var(--text) 92%, var(--muted));
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.55;
    tab-size: 2;
    white-space: pre;
  }

  @media (max-width: 720px) {
    .components-page { border-inline: 0; }
    .components-hero { min-height: 118px; align-items: flex-start; flex-direction: column; }
    .component-head { min-height: 68px; }
    .component-kind { display: none; }
    .component-head > div { gap: 8px; }
    .component-head h2 { font-size: 16px; }
    .preview-stage { padding: 14px; }
    .contribution-preview { overflow-x: auto; }
    .project-card-preview { min-height: 300px; }
    .isometric-preview { min-height: 260px; }
  }
</style>
