---
import Page from '../../components/Page.astro';
import ChanhDaiReferenceMark from '../../components/dev/ChanhDaiReferenceMark.astro';
import NRNModularMark from '../../components/dev/NRNModularMark.astro';
import NRNMark from '../../components/home/NRNMark.astro';

const sourceUrl = 'https://github.com/ncdai/chanhdai.com/blob/main/src/features/portfolio/components/chanhdai-mark-isometric.tsx';
---

<Page
    title="NRN Geometry Development Compare"
    description="Development-only comparison of the ChanhDai reference, the current NRN mark, and a modular NRN geometry experiment."
    path="/dev/nrn-compare/"
    robots="noindex, nofollow"
    layoutVariant="portfolio-full"
>
    <main class="compare-page">
        <header class="compare-header">
            <div>
                <p class="eyebrow">DEVELOPMENT / GEOMETRY LAB</p>
                <h1>NRN × ChanhDai comparison</h1>
            </div>
            <p class="summary">
                Three-way lab: source reference, current Figma-derived NRN, and a modular NRN built from one
                isometric lattice. Production remains untouched while geometry, topology, stroke, hatch, and lighting are compared.
            </p>
        </header>

        <section class="compare-grid" aria-label="Isometric mark comparison">
            <article class="compare-panel">
                <header class="panel-header">
                    <div>
                        <span class="panel-kicker">REFERENCE</span>
                        <h2>ChanhDai</h2>
                    </div>
                    <a href={sourceUrl} target="_blank" rel="noreferrer">source ↗</a>
                </header>

                <div class="stage stage-reference">
                    <ChanhDaiReferenceMark />
                    <span class="figure-label" aria-hidden="true">FIG. A / CHANHDAI SOURCE GEOMETRY</span>
                </div>

                <footer class="panel-meta">
                    <span>556 × 354 viewBox</span>
                    <span>source geometry + color ratios</span>
                </footer>
            </article>

            <article class="compare-panel compare-panel-experiment">
                <header class="panel-header">
                    <div>
                        <span class="panel-kicker">EXPERIMENT</span>
                        <h2>NRN modular</h2>
                    </div>
                    <code>NRNModularMark.astro</code>
                </header>

                <div class="stage stage-modular">
                    <NRNModularMark />
                </div>

                <footer class="panel-meta">
                    <span>30° lattice / depth 16</span>
                    <span>1 stroke · 12% hatch · 16% outline</span>
                </footer>
            </article>

            <article class="compare-panel">
                <header class="panel-header">
                    <div>
                        <span class="panel-kicker">CURRENT BRANCH</span>
                        <h2>NRN current</h2>
                    </div>
                    <code>NRNMark.astro</code>
                </header>

                <div class="stage stage-nrn">
                    <NRNMark />
                </div>

                <footer class="panel-meta">
                    <span>825 × 470 viewBox</span>
                    <span>existing Figma-derived implementation</span>
                </footer>
            </article>
        </section>

        <section class="inspection-strip" aria-label="Comparison checklist">
            <span>01 silhouette</span>
            <span>02 topology</span>
            <span>03 hatch phase</span>
            <span>04 depth seams</span>
            <span>05 base contrast</span>
            <span>06 cursor glow</span>
        </section>

        <p class="license-note">
            ChanhDai reference code is used here only as a development comparison reference under its MIT license;
            the original copyright and license notice are preserved in the reference component source.
        </p>
    </main>
</Page>

<style>
    .compare-page {
        width: min(1780px, calc(100% - 24px));
        margin: 0 auto;
        padding: 28px 0 64px;
    }

    .compare-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 660px);
        gap: 40px;
        align-items: end;
        padding: 0 4px 22px;
        border-bottom: 1px solid var(--border);
    }

    .eyebrow,
    .panel-kicker {
        color: var(--muted);
        font-size: 10px;
        line-height: 1;
        letter-spacing: .12em;
    }

    h1,
    h2,
    p {
        margin: 0;
    }

    h1 {
        margin-top: 8px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(24px, 3vw, 38px);
        font-weight: 560;
        letter-spacing: -.035em;
        line-height: 1;
    }

    .summary {
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 13px;
        line-height: 1.55;
    }

    .compare-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-inline: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .compare-panel {
        min-width: 0;
        background: var(--bg);
    }

    .compare-panel + .compare-panel {
        border-left: 1px solid var(--border);
    }

    .compare-panel-experiment {
        background: color-mix(in srgb, var(--surface) 12%, var(--bg));
    }

    .panel-header,
    .panel-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 13px 16px;
    }

    .panel-header {
        min-height: 62px;
        border-bottom: 1px solid var(--border);
    }

    .panel-header h2 {
        margin-top: 5px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 16px;
        font-weight: 520;
        line-height: 1;
    }

    .panel-header a,
    .panel-header code {
        color: var(--muted);
        font: 9px/1 var(--font-mono);
        text-decoration: none;
    }

    .panel-header a:hover {
        color: var(--text);
    }

    .stage {
        position: relative;
        height: clamp(330px, 31vw, 520px);
        min-height: 0;
        overflow: hidden;
        background: var(--bg);
    }

    .stage-reference {
        padding: clamp(16px, 2vw, 38px);
    }

    .stage-reference > :global(.cd-reference),
    .stage-modular > :global(.modular-stage),
    .stage-nrn > :global(.nrn-stage) {
        width: 100%;
        height: 100%;
    }

    .figure-label {
        position: absolute;
        right: 14px;
        bottom: 12px;
        color: color-mix(in srgb, var(--muted) 55%, var(--bg));
        font: 9px/1 var(--font-mono);
        letter-spacing: .05em;
        pointer-events: none;
        user-select: none;
    }

    .panel-meta {
        min-height: 38px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font: 9px/1.2 var(--font-mono);
        letter-spacing: .035em;
    }

    .inspection-strip {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        border-inline: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .inspection-strip span {
        padding: 11px 12px;
        color: var(--muted);
        font: 9px/1 var(--font-mono);
        letter-spacing: .06em;
        text-align: center;
        text-transform: uppercase;
    }

    .inspection-strip span + span {
        border-left: 1px solid var(--border);
    }

    .license-note {
        max-width: 820px;
        padding: 14px 4px 0;
        color: color-mix(in srgb, var(--muted) 68%, var(--bg));
        font: 9px/1.5 var(--font-mono);
    }

    @media (max-width: 1180px) {
        .compare-grid {
            grid-template-columns: 1fr 1fr;
        }

        .compare-panel:nth-child(3) {
            grid-column: 1 / -1;
            border-left: 0;
            border-top: 1px solid var(--border);
        }

        .stage {
            height: clamp(350px, 45vw, 540px);
        }
    }

    @media (max-width: 760px) {
        .compare-header {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .compare-grid {
            grid-template-columns: 1fr;
        }

        .compare-panel + .compare-panel,
        .compare-panel:nth-child(3) {
            grid-column: auto;
            border-left: 0;
            border-top: 1px solid var(--border);
        }

        .stage {
            height: clamp(340px, 74vw, 540px);
        }

        .inspection-strip {
            grid-template-columns: 1fr 1fr;
        }

        .inspection-strip span:nth-child(odd) {
            border-left: 0;
        }

        .inspection-strip span:nth-child(n+3) {
            border-top: 1px solid var(--border);
        }
    }

    @media (max-width: 540px) {
        .compare-page {
            width: calc(100% - 16px);
            padding-top: 20px;
        }

        .stage-reference {
            padding: 14px;
        }

        .panel-meta {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }
    }
</style>
