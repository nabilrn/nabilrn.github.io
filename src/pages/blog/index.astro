---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../../assets/profile-anime.webp';
import EngagementBar from '../../components/EngagementBarNew.astro';
import Page from '../../components/Page.astro';
import { authorName, getSiteContent, localeMeta, localizePath, normalizeLocale, siteUrl, type SiteLocale } from '../../data/siteContent';
import { getBlogLocaleInfo } from '../../utils/blogLocale';

interface Props {
	locale?: SiteLocale;
	path?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/blog/', locale);
const content = getSiteContent(locale).blog;
const siteCopy = getSiteContent(locale);
const homePath = localizePath('/', locale);
const handle = '@NabilrizkiN';
const avatarAlt = locale === 'id' ? `Foto profil ${authorName}` : `${authorName} profile picture`;
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const localePosts = posts.filter((post) => getBlogLocaleInfo(post).locale === locale);

const getReadingTime = (raw: string) => Math.max(1, Math.ceil(raw.trim().split(/\s+/).length / 200));
const cards = localePosts.map((post) => {
	const info = getBlogLocaleInfo(post);
	const readingTime = getReadingTime(post.body);
	return {
		post,
		link: localizePath(`/blog/${post.slug}/`, locale),
		searchText: [post.data.title, post.data.description, ...post.data.tags].join(' ').toLowerCase(),
		readingLabel: content.minReadByLocale[info.locale](readingTime),
		date: post.data.pubDate.toLocaleDateString(localeMeta[info.locale].dateLocale, {
			month: 'short',
			day: 'numeric',
		}),
		dateFull: post.data.pubDate.toLocaleDateString(localeMeta[info.locale].dateLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	};
});

const breadcrumbJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: siteCopy.nav.home,
			item: new URL(localizePath('/', locale), siteUrl).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: siteCopy.nav.blog,
			item: new URL(localizePath('/blog/', locale), siteUrl).toString(),
		},
	],
});
const blogCollectionJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: content.seoTitle,
	description: content.seoDescription,
	url: new URL(localizePath('/blog/', locale), siteUrl).toString(),
	mainEntity: {
		'@type': 'Blog',
		name: `${authorName} blog`,
		url: new URL(localizePath('/blog/', locale), siteUrl).toString(),
		blogPost: cards.map((item) => ({
			'@type': 'BlogPosting',
			headline: item.post.data.title,
			description: item.post.data.description,
			url: new URL(localizePath(`/blog/${item.post.slug}/`, locale), siteUrl).toString(),
			datePublished: item.post.data.pubDate.toISOString(),
			dateModified: (item.post.data.updatedDate ?? item.post.data.pubDate).toISOString(),
			inLanguage: locale,
			keywords: item.post.data.tags,
		})),
	},
});
---

<Page
	title={content.seoTitle}
	description={content.seoDescription}
	path={pagePath}
	locale={locale}
	ogImageAlt={content.ogImageAlt}
>
	<div class="blog-feed" data-blog-locale-root>
		<header class="feed-header">
			<div>
				<h1>Blog</h1>
				<p>{cards.length} {cards.length === 1 ? 'post' : 'posts'}</p>
			</div>
		</header>

		<div class="search-row">
			<label class="search-field">
				<span class="visually-hidden">{content.searchLabel}</span>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
					<circle cx="11" cy="11" r="6.5" />
					<path d="m16 16 4 4" />
				</svg>
				<input id="blog-search" type="search" placeholder={content.searchPlaceholder} data-blog-search />
			</label>
		</div>

		<section class="feed-list" aria-label={content.postsAria}>
			{cards.map((item) => (
				<article class="feed-post" data-post-search={item.searchText}>
					<div class="avatar-column">
						<a href={homePath} aria-label={`${authorName} — ${siteCopy.nav.home}`}>
							<Image src={avatar} alt={avatarAlt} width={80} height={80} />
						</a>
					</div>

					<div class="feed-post-body">
						<div class="post-author-line">
							<a href={homePath} class="author-name">{authorName}</a>
							<span class="author-handle">{handle}</span>
							<span aria-hidden="true">·</span>
							<time datetime={item.post.data.pubDate.toISOString()} title={item.dateFull}>{item.date}</time>
						</div>

						<a href={item.link} class="post-content-link">
							<h2>{item.post.data.title}</h2>
							<p>{item.post.data.description}</p>
						</a>

						<div class="post-submeta">
							<span>{item.readingLabel}</span>
							{item.post.data.tags.slice(0, 3).map((tag) => <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>)}
						</div>

						<div class="post-actions">
							<EngagementBar
								postId={item.post.slug}
								title={item.post.data.title}
								variant="feed"
								locale={locale}
								trackView={false}
							/>
						</div>
					</div>
				</article>
			))}

			<p class="empty-state" data-locale-empty hidden>{content.noMatches}</p>
		</section>
	</div>

	<script is:inline type="application/ld+json" set:html={breadcrumbJson}></script>
	<script is:inline type="application/ld+json" set:html={blogCollectionJson}></script>
</Page>

<style>
	.blog-feed {
		width: min(720px, 100%);
		margin: 0 auto;
		border-inline: 1px solid var(--sheet-line, var(--border));
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.feed-header {
		min-height: 72px;
		padding: 14px 18px;
		display: flex;
		align-items: center;
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.feed-header h1 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 20px;
		font-weight: 650;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.feed-header p {
		margin: 3px 0 0;
		font-family: var(--font-sans);
		font-size: 12px;
		line-height: 1.2;
		color: var(--muted);
	}

	.search-row {
		padding: 10px 16px;
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.search-field {
		height: 40px;
		padding: 0 13px;
		display: grid;
		grid-template-columns: 18px minmax(0, 1fr);
		align-items: center;
		gap: 9px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface) 72%, transparent);
		color: var(--muted);
		transition: border-color 130ms ease, background 130ms ease, color 130ms ease;
	}

	.search-field:focus-within {
		border-color: var(--border-strong);
		background: var(--bg);
		color: var(--text);
	}

	.search-field svg {
		width: 17px;
		height: 17px;
	}

	.search-field input {
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 13px;
	}

	.search-field input::placeholder { color: var(--muted); }

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.feed-post {
		padding: 14px 16px 10px;
		display: grid;
		grid-template-columns: 42px minmax(0, 1fr);
		gap: 10px;
		border-bottom: 1px solid var(--sheet-line, var(--border));
		transition: background 130ms ease;
	}

	.feed-post:last-of-type { border-bottom: 0; }

	.feed-post:hover {
		background: color-mix(in srgb, var(--surface) 46%, transparent);
	}

	.avatar-column a,
	.avatar-column img {
		display: block;
		width: 40px;
		height: 40px;
	}

	.avatar-column img {
		border: 1px solid var(--border);
		border-radius: 50%;
		object-fit: cover;
	}

	.feed-post-body {
		min-width: 0;
	}

	.post-author-line {
		min-width: 0;
		display: flex;
		align-items: baseline;
		gap: 4px;
		font-family: var(--font-sans);
		font-size: 13px;
		line-height: 1.35;
		color: var(--muted);
	}

	.author-name {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text);
		font-weight: 650;
	}

	.author-name:hover,
	.author-name:focus-visible {
		text-decoration: underline;
		text-underline-offset: 2px;
		outline: none;
	}

	.author-handle {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.post-author-line time { white-space: nowrap; }

	.post-content-link {
		display: block;
		margin-top: 2px;
		color: inherit;
	}

	.post-content-link:focus-visible {
		outline: 1px solid var(--border-strong);
		outline-offset: 3px;
	}

	.post-content-link h2 {
		margin: 0 0 5px;
		font-family: var(--font-sans);
		font-size: 16px;
		font-weight: 650;
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--text);
	}

	.post-content-link p {
		margin: 0;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 1.45;
		color: color-mix(in srgb, var(--text) 84%, var(--muted));
	}

	.post-submeta {
		margin-top: 7px;
		display: flex;
		flex-wrap: wrap;
		gap: 5px 10px;
		font-family: var(--font-sans);
		font-size: 11px;
		line-height: 1.35;
		color: var(--muted);
	}

	.post-actions {
		margin-top: 5px;
		max-width: 390px;
	}

	.empty-state {
		margin: 0;
		padding: 28px 18px;
		font-family: var(--font-sans);
		font-size: 13px;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.blog-feed { border-inline: 0; }
		.feed-post { padding-inline: 14px; }
		.search-row { padding-inline: 12px; }
	}

	@media (max-width: 440px) {
		.feed-post {
			grid-template-columns: 38px minmax(0, 1fr);
			gap: 9px;
		}

		.avatar-column a,
		.avatar-column img {
			width: 36px;
			height: 36px;
		}

		.post-author-line { font-size: 12px; }
		.author-name { max-width: 145px; }
		.author-handle { max-width: 104px; }
		.post-content-link h2 { font-size: 15px; }
		.post-content-link p { font-size: 13.5px; }
	}
</style>

<script is:inline define:vars={{ noMatchesMessage: content.noMatches }}>
	(() => {
		const root = document.querySelector('[data-blog-locale-root]');
		if (!root) return;

		const cards = Array.from(root.querySelectorAll('[data-post-search]'));
		const emptyState = root.querySelector('[data-locale-empty]');
		const search = root.querySelector('[data-blog-search]');
		if (!(search instanceof HTMLInputElement)) return;

		const apply = () => {
			const query = search.value.trim().toLowerCase();
			let visible = 0;
			for (const card of cards) {
				const matches = !query || (card.getAttribute('data-post-search') || '').includes(query);
				card.hidden = !matches;
				if (matches) visible++;
			}
			if (emptyState) {
				emptyState.hidden = visible > 0;
				emptyState.textContent = noMatchesMessage;
			}
		};

		search.addEventListener('input', apply);
	})();
</script>
