---
import { getCollection } from 'astro:content';
import Page from '../../components/Page.astro';
import { authorName, getSiteContent, localeMeta, localizePath, normalizeLocale, siteUrl, type SiteLocale } from '../../data/siteContent';
import { getBlogLocaleInfo } from '../../utils/blogLocale';

interface Props {
	locale?: SiteLocale;
	path?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/blog/', locale);
const content = getSiteContent(locale).blog;
const siteCopy = getSiteContent(locale);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const localePosts = posts.filter((post) => getBlogLocaleInfo(post).locale === locale);

const getReadingTime = (raw: string) => Math.max(1, Math.ceil(raw.trim().split(/\s+/).length / 200));
const cards = localePosts.map((post) => {
	const info = getBlogLocaleInfo(post);
	const readingTime = getReadingTime(post.body);
	return {
		post,
		link: localizePath(`/blog/${post.slug}/`, locale),
		searchText: [post.data.title, post.data.description, ...post.data.tags].join(' ').toLowerCase(),
		readingLabel: content.minReadByLocale[info.locale](readingTime),
		date: post.data.pubDate.toLocaleDateString(localeMeta[info.locale].dateLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	};
});

const breadcrumbJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: siteCopy.nav.home,
			item: new URL(localizePath('/', locale), siteUrl).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: siteCopy.nav.blog,
			item: new URL(localizePath('/blog/', locale), siteUrl).toString(),
		},
	],
});
const blogCollectionJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: content.seoTitle,
	description: content.seoDescription,
	url: new URL(localizePath('/blog/', locale), siteUrl).toString(),
	mainEntity: {
		'@type': 'Blog',
		name: `${authorName} blog`,
		url: new URL(localizePath('/blog/', locale), siteUrl).toString(),
		blogPost: cards.map((item) => ({
			'@type': 'BlogPosting',
			headline: item.post.data.title,
			description: item.post.data.description,
			url: new URL(localizePath(`/blog/${item.post.slug}/`, locale), siteUrl).toString(),
			datePublished: item.post.data.pubDate.toISOString(),
			dateModified: (item.post.data.updatedDate ?? item.post.data.pubDate).toISOString(),
			inLanguage: locale,
			keywords: item.post.data.tags,
		})),
	},
});
---

<Page
	title={content.seoTitle}
	description={content.seoDescription}
	path={pagePath}
	locale={locale}
	ogImageAlt={content.ogImageAlt}
>
	<div class="blog-page" data-blog-locale-root>
		<header class="blog-header">
			<div>
				<p class="hand-label">my blog</p>
				<h1>Blog</h1>
			</div>
			<div class="blog-tools">
				<span class="post-count">{cards.length} posts</span>
				<label class="search-field">
					<span class="visually-hidden">{content.searchLabel}</span>
					<input id="blog-search" type="search" placeholder={content.searchPlaceholder} data-blog-search />
				</label>
			</div>
		</header>

		<section class="blog-list" aria-label={content.postsAria}>
			{cards.map((item, index) => (
				<article class="post-row" data-post-search={item.searchText}>
					<a href={item.link} class="post-link">
						<span class="post-number">{String(index + 1).padStart(2, '0')}</span>
						<div class="post-copy">
							<h2>{item.post.data.title}</h2>
							<p>{item.post.data.description}</p>
						</div>
						<div class="post-meta">
							<time datetime={item.post.data.pubDate.toISOString()}>{item.date}</time>
							<span>{item.readingLabel}</span>
							<span aria-hidden="true">↗</span>
						</div>
					</a>
				</article>
			))}
			<p class="empty-state" data-locale-empty hidden>{content.noMatches}</p>
		</section>
	</div>

	<script is:inline type="application/ld+json" set:html={breadcrumbJson}></script>
	<script is:inline type="application/ld+json" set:html={blogCollectionJson}></script>
</Page>

<style>
	.blog-page {
		width: min(1120px, 100%);
		margin: 0 auto;
		border-inline: 1px solid var(--sheet-line, var(--border));
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.blog-header {
		min-height: 150px;
		padding: 34px clamp(18px, 3vw, 34px) 28px;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.hand-label {
		margin: 0 0 6px;
		font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
		font-size: 14px;
		line-height: 1;
		color: var(--muted);
		transform: rotate(-1.5deg);
		transform-origin: left center;
	}

	h1 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.blog-tools {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.post-count {
		font-family: var(--font-mono);
		font-size: 9px;
		color: var(--muted);
		white-space: nowrap;
	}

	.search-field {
		width: min(260px, 34vw);
		border-bottom: 1px solid var(--border-strong);
	}

	.search-field:focus-within {
		border-bottom-color: var(--text);
	}

	.search-field input {
		width: 100%;
		height: 34px;
		padding: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 10px;
	}

	.search-field input::placeholder { color: var(--muted); }

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.post-row {
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.post-row:last-of-type { border-bottom: 0; }

	.post-link {
		min-height: 118px;
		padding: 24px clamp(18px, 3vw, 34px);
		display: grid;
		grid-template-columns: 42px minmax(0, 1fr) 150px;
		gap: 18px;
		align-items: start;
		transition: background 130ms ease;
	}

	.post-link:hover,
	.post-link:focus-visible {
		background: color-mix(in srgb, var(--surface) 58%, transparent);
		outline: none;
	}

	.post-link:focus-visible {
		box-shadow: inset 0 0 0 1px var(--text);
	}

	.post-number,
	.post-meta {
		font-family: var(--font-mono);
		font-size: 9px;
		color: var(--muted);
	}

	.post-number { padding-top: 5px; }

	.post-copy h2 {
		max-width: 32ch;
		margin: 0 0 7px;
		font-family: var(--font-sans);
		font-size: clamp(19px, 2vw, 24px);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.025em;
	}

	.post-copy p {
		max-width: 70ch;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 13px;
		line-height: 1.55;
		color: var(--muted);
	}

	.post-meta {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 6px 12px;
		align-items: start;
	}

	.post-meta time,
	.post-meta span:nth-child(2) {
		grid-column: 1;
	}

	.post-meta span:last-child {
		grid-column: 2;
		grid-row: 1 / 3;
		font-size: 13px;
		color: var(--text);
	}

	.empty-state {
		padding: 28px clamp(18px, 3vw, 34px);
		font-size: 13px;
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.blog-page { border-inline: 0; }

		.blog-header {
			min-height: 128px;
			align-items: flex-start;
			flex-direction: column;
		}

		.blog-tools,
		.search-field {
			width: 100%;
		}

		.post-link {
			grid-template-columns: 30px minmax(0, 1fr);
			gap: 12px;
		}

		.post-meta {
			grid-column: 2;
			grid-template-columns: auto auto 1fr;
			justify-content: start;
		}

		.post-meta time,
		.post-meta span:nth-child(2),
		.post-meta span:last-child {
			grid-column: auto;
			grid-row: auto;
		}

		.post-meta span:last-child { margin-left: auto; }
	}
</style>

<script is:inline define:vars={{ noMatchesMessage: content.noMatches }}>
	(() => {
		const root = document.querySelector('[data-blog-locale-root]');
		if (!root) return;

		const cards = Array.from(root.querySelectorAll('[data-post-search]'));
		const emptyState = root.querySelector('[data-locale-empty]');
		const search = root.querySelector('[data-blog-search]');
		if (!(search instanceof HTMLInputElement)) return;

		const apply = () => {
			const query = search.value.trim().toLowerCase();
			let visible = 0;
			for (const card of cards) {
				const matches = !query || (card.getAttribute('data-post-search') || '').includes(query);
				card.hidden = !matches;
				if (matches) visible++;
			}
			if (emptyState) {
				emptyState.hidden = visible > 0;
				emptyState.textContent = noMatchesMessage;
			}
		};

		search.addEventListener('input', apply);
	})();
</script>
