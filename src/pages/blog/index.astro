---
import { getCollection } from 'astro:content';
import Page from '../../components/Page.astro';
import { authorName, getSiteContent, localeMeta, localizePath, normalizeLocale, siteUrl, type SiteLocale } from '../../data/siteContent';
import { getBlogLocaleInfo, type BlogLocale } from '../../utils/blogLocale';

interface Props {
	locale?: SiteLocale;
	path?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/blog/', locale);
const content = getSiteContent(locale).blog;
const siteCopy = getSiteContent(locale);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const localePosts = posts.filter((post) => getBlogLocaleInfo(post).locale === locale);

const getReadingTime = (raw: string) => {
	const words = raw.trim().split(/\s+/).length;
	return Math.max(1, Math.ceil(words / 200));
};

const localeLabel = content.localeLabel as Record<BlogLocale, string>;
const cards = localePosts.map((post) => {
	const localeInfo = getBlogLocaleInfo(post);
	const readingTime = getReadingTime(post.body);
	const searchText = [post.data.title, post.data.description, ...post.data.tags].join(' ');
	return {
		post,
		locale: localeInfo.locale,
		link: localizePath(`/blog/${post.slug}/`, locale),
		searchText,
		readingLabel: content.minReadByLocale[localeInfo.locale](readingTime),
		date: post.data.pubDate.toLocaleDateString(localeMeta[localeInfo.locale].dateLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		}),
	};
});

const indexLabel = locale === 'id' ? 'indeks tulisan' : 'writing index';
const noteLabel = locale === 'id' ? 'catatan yang layak disimpan →' : 'notes worth keeping →';
const entryLabel = locale === 'id' ? 'tulisan' : 'entries';
const updatedLabel = locale === 'id' ? 'terbaru' : 'latest';
const latestDate = cards[0]?.date ?? '—';

const breadcrumbJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: siteCopy.nav.home,
			item: new URL(localizePath('/', locale), siteUrl).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: siteCopy.nav.blog,
			item: new URL(localizePath('/blog/', locale), siteUrl).toString(),
		},
	],
});
const blogCollectionJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: content.seoTitle,
	description: content.seoDescription,
	url: new URL(localizePath('/blog/', locale), siteUrl).toString(),
	mainEntity: {
		'@type': 'Blog',
		name: `${authorName} ${content.eyebrow}`,
		url: new URL(localizePath('/blog/', locale), siteUrl).toString(),
		blogPost: cards.map((item) => ({
			'@type': 'BlogPosting',
			headline: item.post.data.title,
			description: item.post.data.description,
			url: new URL(localizePath(`/blog/${item.post.slug}/`, item.locale), siteUrl).toString(),
			datePublished: item.post.data.pubDate.toISOString(),
			dateModified: (item.post.data.updatedDate ?? item.post.data.pubDate).toISOString(),
			inLanguage: item.locale,
			keywords: item.post.data.tags,
		})),
	},
});
---

<Page
	title={content.seoTitle}
	description={content.seoDescription}
	path={pagePath}
	locale={locale}
	ogImageAlt={content.ogImageAlt}
>
	<div class="blog-sheet" data-blog-locale-root>
		<section class="blog-hero" aria-labelledby="blog-title">
			<div class="hero-copy">
				<div class="sheet-kicker">
					<span>02</span>
					<span>BLOG / {indexLabel.toUpperCase()}</span>
				</div>
				<p class="hand-note" aria-hidden="true">{noteLabel}</p>
				<h1 id="blog-title">{content.heading}</h1>
				<p class="intro">{content.intro}</p>
			</div>

			<aside class="hero-spec" aria-label="Blog index summary">
				<div class="spec-row">
					<span>{entryLabel}</span>
					<strong>{String(cards.length).padStart(2, '0')}</strong>
				</div>
				<div class="spec-row">
					<span>lang</span>
					<strong>{locale.toUpperCase()}</strong>
				</div>
				<div class="spec-row">
					<span>{updatedLabel}</span>
					<strong>{latestDate}</strong>
				</div>
				<div class="search-field">
					<label for="blog-search">{content.searchLabel}</label>
					<div class="search-control">
						<span aria-hidden="true">/</span>
						<input id="blog-search" type="search" placeholder={content.searchPlaceholder} data-blog-search />
					</div>
				</div>
			</aside>
		</section>

		<section class="blog-index" aria-label={content.postsAria}>
			<div class="index-header" aria-hidden="true">
				<span>no.</span>
				<span>entry</span>
				<span>metadata</span>
			</div>

			{cards.map((item, index) => (
				<article class="post-row" data-post-locale={item.locale} data-post-search={item.searchText.toLowerCase()}>
					<a href={item.link} class="post-link">
						<div class="post-number">{String(index + 1).padStart(2, '0')}</div>
						<div class="post-copy">
							<h2>{item.post.data.title}</h2>
							<p>{item.post.data.description}</p>
							<div class="post-tags" aria-label="Tags">
								{item.post.data.tags.slice(0, 4).map((tag) => <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>)}
							</div>
						</div>
						<div class="post-meta">
							<span>{localeLabel[item.locale]}</span>
							<time datetime={item.post.data.pubDate.toISOString()}>{item.date}</time>
							<span>{item.readingLabel}</span>
							<span class="post-arrow" aria-hidden="true">↗</span>
						</div>
					</a>
				</article>
			))}

			<p class="empty-locale" data-locale-empty hidden>{content.noMatches}</p>
		</section>
	</div>

	<script is:inline type="application/ld+json" set:html={breadcrumbJson}></script>
	<script is:inline type="application/ld+json" set:html={blogCollectionJson}></script>
</Page>

<style>
	.blog-sheet {
		--sheet-line: color-mix(in srgb, var(--border) 78%, var(--bg));
		margin-inline: calc(var(--content-gutter) * -1);
		border-bottom: 1px solid var(--sheet-line);
	}

	.blog-hero {
		min-height: 330px;
		display: grid;
		grid-template-columns: minmax(0, 1.618fr) minmax(260px, 1fr);
		border-bottom: 2px solid var(--border);
	}

	.hero-copy {
		position: relative;
		padding: clamp(28px, 5vw, 64px) clamp(22px, 5vw, 64px) 42px;
		border-right: 1px solid var(--sheet-line);
	}

	.sheet-kicker {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: clamp(48px, 8vw, 86px);
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.09em;
		color: var(--muted);
	}

	.sheet-kicker span:first-child {
		color: var(--text);
	}

	.hand-note {
		position: absolute;
		top: clamp(72px, 10vw, 105px);
		right: clamp(24px, 5vw, 64px);
		margin: 0;
		color: var(--muted);
		font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
		font-size: 13px;
		line-height: 1.1;
		transform: rotate(-2deg);
	}

	h1 {
		max-width: 17ch;
		margin: 0 0 18px;
		font-family: var(--font-sans);
		font-size: clamp(38px, 5.4vw, 68px);
		font-weight: 600;
		line-height: 0.98;
		letter-spacing: -0.055em;
	}

	.intro {
		max-width: 68ch;
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(14px, 1.5vw, 17px);
		line-height: 1.65;
		color: var(--muted);
	}

	.hero-spec {
		align-self: stretch;
		display: grid;
		grid-template-rows: repeat(3, minmax(48px, auto)) 1fr;
	}

	.spec-row {
		padding: 0 clamp(16px, 2.4vw, 28px);
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 16px;
		border-bottom: 1px solid var(--sheet-line);
		font-family: var(--font-mono);
		font-size: 9px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.spec-row strong {
		color: var(--text);
		font-size: 10px;
		font-weight: 500;
	}

	.search-field {
		align-self: end;
		padding: 22px clamp(16px, 2.4vw, 28px) 26px;
	}

	.search-field label {
		display: block;
		margin-bottom: 8px;
		font-family: var(--font-mono);
		font-size: 8px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.search-control {
		min-height: 38px;
		display: grid;
		grid-template-columns: 20px 1fr;
		align-items: center;
		border-bottom: 1px solid var(--border-strong);
		color: var(--muted);
	}

	.search-control:focus-within {
		border-bottom-color: var(--text);
		color: var(--text);
	}

	.search-control input {
		width: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 11px;
	}

	.search-control input::placeholder { color: var(--muted); }

	.blog-index {
		display: grid;
	}

	.index-header {
		min-height: 34px;
		padding: 0 clamp(16px, 2.2vw, 26px);
		display: grid;
		grid-template-columns: 70px minmax(0, 1fr) 190px;
		align-items: center;
		gap: 18px;
		border-bottom: 1px solid var(--sheet-line);
		font-family: var(--font-mono);
		font-size: 8px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--muted) 78%, transparent);
	}

	.post-row {
		min-width: 0;
		border-bottom: 1px solid var(--sheet-line);
	}

	.post-link {
		min-height: 148px;
		padding: clamp(20px, 3vw, 34px) clamp(16px, 2.2vw, 26px);
		display: grid;
		grid-template-columns: 70px minmax(0, 1fr) 190px;
		gap: 18px;
		align-items: start;
		transition: background 150ms ease;
	}

	.post-link:hover,
	.post-link:focus-visible {
		background: color-mix(in srgb, var(--surface) 68%, transparent);
		outline: none;
	}

	.post-link:focus-visible {
		box-shadow: inset 0 0 0 1px var(--text);
	}

	.post-number {
		padding-top: 4px;
		font-family: var(--font-mono);
		font-size: 10px;
		color: var(--muted);
	}

	.post-copy {
		min-width: 0;
	}

	.post-copy h2 {
		max-width: 30ch;
		margin: 0 0 9px;
		font-family: var(--font-sans);
		font-size: clamp(19px, 2.3vw, 28px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.035em;
	}

	.post-copy p {
		max-width: 70ch;
		margin: 0 0 15px;
		font-family: var(--font-sans);
		font-size: 13px;
		line-height: 1.58;
		color: var(--muted);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 8px;
		color: color-mix(in srgb, var(--muted) 86%, var(--text));
	}

	.post-meta {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 7px 12px;
		align-items: start;
		font-family: var(--font-mono);
		font-size: 9px;
		line-height: 1.35;
		color: var(--muted);
	}

	.post-meta time {
		grid-column: 1 / -1;
		color: var(--text);
	}

	.post-arrow {
		grid-column: 2;
		grid-row: 1;
		font-size: 14px;
		color: var(--text);
		transition: transform 150ms ease;
	}

	.post-link:hover .post-arrow,
	.post-link:focus-visible .post-arrow {
		transform: translate(2px, -2px);
	}

	.empty-locale {
		margin: 0;
		padding: 30px 26px;
		border-bottom: 1px solid var(--sheet-line);
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--muted);
	}

	@media (max-width: 820px) {
		.blog-hero {
			grid-template-columns: 1fr;
		}

		.hero-copy {
			border-right: 0;
			border-bottom: 1px solid var(--sheet-line);
		}

		.sheet-kicker {
			margin-bottom: 56px;
		}

		.hero-spec {
			grid-template-columns: repeat(3, 1fr);
			grid-template-rows: auto auto;
		}

		.spec-row {
			min-height: 52px;
			border-right: 1px solid var(--sheet-line);
		}

		.spec-row:nth-child(3) { border-right: 0; }

		.search-field {
			grid-column: 1 / -1;
			padding-block: 16px 20px;
		}

		.index-header { display: none; }

		.post-link {
			grid-template-columns: 42px minmax(0, 1fr);
			min-height: 0;
		}

		.post-meta {
			grid-column: 2;
			grid-template-columns: repeat(3, auto) 1fr;
			justify-content: start;
			margin-top: 2px;
		}

		.post-meta time {
			grid-column: auto;
		}

		.post-arrow {
			grid-column: 4;
			grid-row: 1;
			justify-self: end;
		}
	}

	@media (max-width: 520px) {
		.hand-note {
			right: 18px;
			font-size: 11px;
		}

		.hero-spec {
			grid-template-columns: 1fr;
		}

		.spec-row {
			border-right: 0;
		}

		.post-link {
			grid-template-columns: 32px minmax(0, 1fr);
			gap: 10px;
		}

		.post-meta {
			grid-template-columns: 1fr auto;
		}

		.post-meta time,
		.post-meta > span:nth-child(3) {
			grid-column: 1;
		}

		.post-arrow {
			grid-column: 2;
			grid-row: 1 / 3;
		}
	}
</style>

<script is:inline define:vars={{ noMatchesMessage: content.noMatches }}>
	(() => {
		const root = document.querySelector('[data-blog-locale-root]');
		if (!root) return;

		const cards = Array.from(root.querySelectorAll('[data-post-locale]'));
		const emptyState = root.querySelector('[data-locale-empty]');
		const search = root.querySelector('[data-blog-search]');

		const getQueryFromUrl = () => new URL(window.location.href).searchParams.get('q') || '';
		const setStateInUrl = (query) => {
			const url = new URL(window.location.href);
			if (query) url.searchParams.set('q', query);
			else url.searchParams.delete('q');
			window.history.replaceState({}, '', url);
		};

		const applyFilters = (query) => {
			const normalizedQuery = query.trim().toLowerCase();
			let visible = 0;
			for (const card of cards) {
				const matches = !normalizedQuery || (card.getAttribute('data-post-search') || '').includes(normalizedQuery);
				card.hidden = !matches;
				if (matches) visible++;
			}
			if (emptyState) {
				emptyState.hidden = visible > 0;
				emptyState.textContent = noMatchesMessage;
			}
		};

		const initialQuery = getQueryFromUrl();
		if (search) search.value = initialQuery;
		applyFilters(initialQuery);

		search?.addEventListener('input', () => {
			const query = search.value.trim();
			setStateInUrl(query);
			applyFilters(query);
		});
	})();
</script>
