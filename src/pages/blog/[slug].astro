---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import avatar from '../../assets/profile-anime.webp';
import EngagementBar from '../../components/EngagementBarNew.astro';
import Page from '../../components/Page.astro';
import { authorName, getSiteContent, localeMeta, localizePath, normalizeLocale, siteUrl, type SiteLocale } from '../../data/siteContent';
import { getBlogLocaleInfo, getTranslationVariants, type BlogLocale } from '../../utils/blogLocale';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts
		.filter((post) => getBlogLocaleInfo(post).locale === 'en')
		.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post, locale: rawUiLocale, path: rawPath } = Astro.props as {
	post: CollectionEntry<'blog'>;
	locale?: SiteLocale;
	path?: string;
};
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const { Content } = await render(post);
const localeInfo = getBlogLocaleInfo(post);
const postLocale: BlogLocale = localeInfo.locale;
const uiLocale = normalizeLocale(rawUiLocale ?? postLocale);
const variants = getTranslationVariants(allPosts, localeInfo.translationKey);
const blogLocales = ['en', 'id'] as const satisfies readonly BlogLocale[];
const handle = '@NabilrizkiN';

const words = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
const dateLocale = localeMeta[postLocale].dateLocale;
const dateStr = post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });
const siteCopy = getSiteContent(uiLocale);
const blogCopy = siteCopy.blog;
const postPath = rawPath ?? localizePath(`/blog/${post.slug}/`, uiLocale);
const postUrl = new URL(postPath, siteUrl).toString();
const ogImagePath = `/og/blog/${post.slug}.png`;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const localizedSequence = allPosts
	.filter((item) => getBlogLocaleInfo(item).locale === postLocale)
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const currentIndex = localizedSequence.findIndex((item) => item.slug === post.slug);
const nextPost = currentIndex >= 0 ? localizedSequence[currentIndex + 1] ?? null : null;

const alternatePaths = Object.fromEntries(
	blogLocales
		.filter((optionLocale) => variants[optionLocale])
		.map((optionLocale) => [optionLocale, localizePath(`/blog/${variants[optionLocale]!.slug}/`, optionLocale)])
) as Partial<Record<SiteLocale, string>>;

const breadcrumbJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: siteCopy.nav.home, item: new URL(localizePath('/', uiLocale), siteUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: siteCopy.nav.blog, item: new URL(localizePath('/blog/', uiLocale), siteUrl).toString() },
		{ '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
	],
});

const blogPostingJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: `${siteUrl}${ogImagePath}`,
	datePublished: publishedTime,
	dateModified: modifiedTime,
	inLanguage: postLocale,
	author: { '@type': 'Person', name: authorName, url: siteUrl },
	publisher: { '@type': 'Person', name: authorName, url: siteUrl },
	mainEntityOfPage: postUrl,
	url: postUrl,
	keywords: post.data.tags,
});
---

<Page
	title={`${post.data.title} | ${authorName}`}
	description={post.data.description}
	path={postPath}
	locale={uiLocale}
	lang={postLocale}
	ogImage={ogImagePath}
	ogImageAlt={blogCopy.article.ogImageAlt(post.data.title)}
	ogType="article"
	twitterCard="summary_large_image"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	articleTags={post.data.tags}
	ogImageWidth={1200}
	ogImageHeight={630}
	alternatePaths={alternatePaths}
>
	<div class="article-page">
		<div class="back-row">
			<a href={localizePath('/blog/', uiLocale)}>← Blog</a>
		</div>

		<header class="article-header">
			<div class="author-row">
				<Image src={avatar} alt={authorName} width={88} height={88} />
				<div class="author-copy">
					<strong>{authorName}</strong>
					<div>
						<span>{handle}</span>
						<span aria-hidden="true">·</span>
						<time datetime={publishedTime}>{dateStr}</time>
					</div>
				</div>
			</div>

			<h1>{post.data.title}</h1>
			<p class="article-deck">{post.data.description}</p>

			<div class="article-submeta">
				<span>{blogCopy.minReadByLocale[postLocale](readingTime)}</span>
				{post.data.updatedDate && (
					<><span aria-hidden="true">·</span><span>{blogCopy.article.updated} {post.data.updatedDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}</span></>
				)}
			</div>

			<div class="article-tags">
				{post.data.tags.map((tag: string) => <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>)}
			</div>

			<div class="article-engagement">
				<EngagementBar postId={post.slug} title={post.data.title} variant="inline" locale={uiLocale} />
			</div>
		</header>

		<article class="post-content">
			<Content />
		</article>

		{nextPost && (
			<nav class="next-entry" aria-label={uiLocale === 'id' ? 'Tulisan berikutnya' : 'Next article'}>
				<span>{uiLocale === 'id' ? 'Berikutnya' : 'Next'}</span>
				<a href={localizePath(`/blog/${nextPost.slug}/`, uiLocale)}>
					<strong>{nextPost.data.title}</strong>
					<span aria-hidden="true">→</span>
				</a>
			</nav>
		)}
	</div>

	<script is:inline type="application/ld+json" set:html={breadcrumbJson}></script>
	<script is:inline type="application/ld+json" set:html={blogPostingJson}></script>
</Page>

<style>
	.article-page {
		width: min(760px, 100%);
		margin: 0 auto;
		border-inline: 1px solid var(--sheet-line, var(--border));
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.back-row {
		height: 46px;
		padding: 0 18px;
		display: flex;
		align-items: center;
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.back-row a {
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 500;
		color: var(--text);
	}

	.back-row a:hover,
	.back-row a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
		outline: none;
	}

	.article-header {
		padding: 20px 20px 14px;
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.author-row {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 20px;
	}

	.author-row img {
		width: 44px;
		height: 44px;
		border: 1px solid var(--border);
		border-radius: 50%;
		object-fit: cover;
	}

	.author-copy {
		min-width: 0;
		font-family: var(--font-sans);
	}

	.author-copy strong {
		display: block;
		font-size: 14px;
		font-weight: 650;
		line-height: 1.25;
		color: var(--text);
	}

	.author-copy > div {
		margin-top: 2px;
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		font-size: 12px;
		line-height: 1.3;
		color: var(--muted);
	}

	h1 {
		max-width: 19ch;
		margin: 0 0 10px;
		font-family: var(--font-sans);
		font-size: clamp(32px, 5vw, 46px);
		font-weight: 650;
		line-height: 1.05;
		letter-spacing: -0.045em;
	}

	.article-deck {
		max-width: 64ch;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 15px;
		line-height: 1.55;
		color: color-mix(in srgb, var(--text) 82%, var(--muted));
	}

	.article-submeta,
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 5px 9px;
		font-family: var(--font-sans);
		font-size: 12px;
		line-height: 1.35;
		color: var(--muted);
	}

	.article-submeta { margin-top: 12px; }
	.article-tags { margin-top: 7px; }

	.article-engagement {
		margin-top: 12px;
		padding-top: 8px;
		border-top: 1px solid var(--sheet-line, var(--border));
	}

	.post-content {
		max-width: 700px;
		margin: 0 auto;
		padding: 34px 20px 72px;
	}

	.post-content :global(p),
	.post-content :global(li) {
		font-family: var(--font-sans);
		font-size: 17px;
		line-height: 1.78;
		color: var(--text-body);
	}

	.post-content :global(p) { margin: 0 0 1.15em; }
	.post-content :global(ul),
	.post-content :global(ol) { margin: 0 0 1.25em; padding-left: 1.35em; }
	.post-content :global(li) { margin-bottom: 0.35em; }

	.post-content :global(h2) {
		margin: 2em 0 0.7em;
		font-family: var(--font-sans);
		font-size: clamp(25px, 3vw, 30px);
		font-weight: 650;
		line-height: 1.22;
		letter-spacing: -0.03em;
	}

	.post-content :global(h3) {
		margin: 1.7em 0 0.6em;
		font-family: var(--font-sans);
		font-size: 21px;
		font-weight: 650;
		line-height: 1.3;
	}

	.post-content :global(a) {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.post-content :global(blockquote) {
		margin: 1.5em 0;
		padding: 0.1em 0 0.1em 16px;
		border-left: 3px solid var(--border-strong);
		color: var(--muted);
	}

	.post-content :global(blockquote p:last-child) { margin-bottom: 0; }

	.post-content :global(pre) {
		margin: 1.5em 0;
		padding: 16px;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 0;
		background: var(--surface);
	}

	.post-content :global(code) { font-size: 14px; }

	.post-content :global(p code),
	.post-content :global(li code) {
		padding: 2px 5px;
		border: 1px solid var(--border);
		border-radius: 3px;
		background: var(--surface-2);
	}

	:global(html[data-theme='dark']) .post-content :global(pre code span[style*='6A737D']) {
		color: #9a9a9a !important;
	}

	:global(html[data-theme='light']) .post-content :global(pre code span[style*='6A737D']) {
		color: #5f5f5f !important;
	}

	.post-content :global(img) {
		margin: 1.5em 0;
		border: 1px solid var(--border);
		border-radius: 0;
	}

	.post-content :global(hr) {
		margin: 2em 0;
		border: 0;
		border-top: 1px solid var(--border);
	}

	.post-content :global(table) {
		width: 100%;
		margin: 1.5em 0;
		border-collapse: collapse;
		font-family: var(--font-sans);
		font-size: 14px;
	}

	.post-content :global(th),
	.post-content :global(td) {
		padding: 9px 10px;
		border: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	.next-entry {
		padding: 18px 20px 24px;
		border-top: 1px solid var(--sheet-line, var(--border));
	}

	.next-entry > span {
		display: block;
		margin-bottom: 6px;
		font-family: var(--font-sans);
		font-size: 12px;
		color: var(--muted);
	}

	.next-entry a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		color: var(--text);
	}

	.next-entry a:hover strong,
	.next-entry a:focus-visible strong {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.next-entry a:focus-visible { outline: none; }

	.next-entry strong {
		font-family: var(--font-sans);
		font-size: 16px;
		font-weight: 600;
		line-height: 1.35;
	}

	@media (max-width: 720px) {
		.article-page { border-inline: 0; }
		.article-header { padding-inline: 16px; }
		.post-content { padding-inline: 16px; }
		.post-content :global(p),
		.post-content :global(li) { font-size: 16px; line-height: 1.75; }
	}
</style>
