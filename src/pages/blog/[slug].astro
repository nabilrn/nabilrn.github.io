---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import avatar from '../../assets/profile-anime.webp';
import BlogArticleDock from '../../components/blog/BlogArticleDock.astro';
import Page from '../../components/Page.astro';
import { authorName, getSiteContent, siteUrl } from '../../data/siteContent';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const { Content } = await render(post);
const handle = '@NabilrizkiN';

const words = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
const dateLocale = 'en-US';
const dateStr = post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });
const siteCopy = getSiteContent();
const blogCopy = siteCopy.blog;
const postPath = `/blog/${post.slug}/`;
const postUrl = new URL(postPath, siteUrl).toString();
const ogImagePath = `/og/blog/${post.slug}.png`;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const currentIndex = allPosts.findIndex((item) => item.slug === post.slug);
const nextPost = currentIndex >= 0 ? allPosts[currentIndex + 1] ?? null : null;

const breadcrumbJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: siteCopy.nav.home, item: new URL('/', siteUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: siteCopy.nav.blog, item: new URL('/blog/', siteUrl).toString() },
		{ '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
	],
});

const blogPostingJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: `${siteUrl}${ogImagePath}`,
	datePublished: publishedTime,
	dateModified: modifiedTime,
	inLanguage: 'en',
	author: { '@type': 'Person', name: authorName, url: siteUrl },
	publisher: { '@type': 'Person', name: authorName, url: siteUrl },
	mainEntityOfPage: postUrl,
	url: postUrl,
	keywords: post.data.tags,
});
---

<Page
	title={`${post.data.title} | ${authorName}`}
	description={post.data.description}
	path={postPath}
	ogImage={ogImagePath}
	ogImageAlt={blogCopy.article.ogImageAlt(post.data.title)}
	ogType="article"
	twitterCard="summary_large_image"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	articleTags={post.data.tags}
	ogImageWidth={1200}
	ogImageHeight={630}
>
	<div class="article-page">
		<header class="article-header">
			<div class="author-row">
				<Image src={avatar} alt={authorName} width={88} height={88} />
				<div class="author-copy">
					<strong>{authorName}</strong>
					<div>
						<span>{handle}</span>
						<span aria-hidden="true">·</span>
						<time datetime={publishedTime}>{dateStr}</time>
					</div>
				</div>
			</div>

			<h1>{post.data.title}</h1>
			<p class="article-deck">{post.data.description}</p>

			<div class="article-submeta">
				<span>{blogCopy.minRead(readingTime)}</span>
				{post.data.updatedDate && (
					<><span aria-hidden="true">·</span><span>{blogCopy.article.updated} {post.data.updatedDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}</span></>
				)}
			</div>

			<div class="article-tags">
				{post.data.tags.map((tag: string) => <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>)}
			</div>
		</header>

		<article class="post-content">
			<Content />
		</article>

		{nextPost && (
			<nav class="next-entry" aria-label="Next article">
				<span>Next</span>
				<a href={`/blog/${nextPost.slug}/`}>
					<strong>{nextPost.data.title}</strong>
					<span aria-hidden="true">→</span>
				</a>
			</nav>
		)}
	</div>

	<BlogArticleDock
		postId={post.slug}
		title={post.data.title}
		postsHref="/blog/"
		homeHref="/"
	/>

	<script is:inline type="application/ld+json" set:html={breadcrumbJson}></script>
	<script is:inline type="application/ld+json" set:html={blogPostingJson}></script>
</Page>

<style>
	.article-page {
		width: min(760px, 100%);
		margin: 0 auto 86px;
		border-inline: 1px solid var(--sheet-line, var(--border));
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.article-header {
		padding: 16px 20px 11px;
		border-bottom: 1px solid var(--sheet-line, var(--border));
	}

	.author-row {
		display: flex;
		align-items: center;
		gap: 9px;
		margin-bottom: 13px;
	}

	.author-row img {
		width: 40px;
		height: 40px;
		border: 1px solid var(--border);
		border-radius: 50%;
		object-fit: cover;
	}

	.author-copy {
		min-width: 0;
		font-family: var(--font-sans);
	}

	.author-copy strong {
		display: block;
		font-size: 13px;
		font-weight: 650;
		line-height: 1.2;
		color: var(--text);
	}

	.author-copy > div {
		margin-top: 1px;
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		font-size: 11px;
		line-height: 1.25;
		color: var(--muted);
	}

	h1 {
		max-width: 20ch;
		margin: 0 0 7px;
		font-family: var(--font-sans);
		font-size: clamp(30px, 4.4vw, 42px);
		font-weight: 650;
		line-height: 1.03;
		letter-spacing: -0.04em;
	}

	.article-deck {
		max-width: 64ch;
		margin: 0;
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 1.45;
		color: color-mix(in srgb, var(--text) 82%, var(--muted));
	}

	.article-submeta,
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 8px;
		font-family: var(--font-sans);
		font-size: 11px;
		line-height: 1.3;
		color: var(--muted);
	}

	.article-submeta { margin-top: 9px; }
	.article-tags { margin-top: 5px; }

	.post-content {
		max-width: 680px;
		margin: 0 auto;
		padding: 24px 20px 52px;
	}

	.post-content :global(p),
	.post-content :global(li) {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.62;
		color: var(--text-body);
	}

	.post-content :global(p) { margin: 0 0 0.85em; }
	.post-content :global(ul),
	.post-content :global(ol) { margin: 0 0 0.95em; padding-left: 1.35em; }
	.post-content :global(li) { margin-bottom: 0.25em; }

	.post-content :global(h2) {
		margin: 1.55em 0 0.45em;
		font-family: var(--font-sans);
		font-size: clamp(23px, 2.8vw, 27px);
		font-weight: 650;
		line-height: 1.16;
		letter-spacing: -0.025em;
	}

	.post-content :global(h3) {
		margin: 1.35em 0 0.4em;
		font-family: var(--font-sans);
		font-size: 20px;
		font-weight: 650;
		line-height: 1.22;
	}

	.post-content :global(a) {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.post-content :global(blockquote) {
		margin: 1.1em 0;
		padding: 0.05em 0 0.05em 14px;
		border-left: 2px solid var(--border-strong);
		color: var(--muted);
	}

	.post-content :global(blockquote p:last-child) { margin-bottom: 0; }

	.post-content :global(pre) {
		margin: 1.15em 0;
		padding: 14px;
		overflow-x: auto;
		border: 1px solid var(--border);
		border-radius: 0;
		background: var(--surface);
	}

	.post-content :global(code) { font-size: 13px; }

	.post-content :global(p code),
	.post-content :global(li code) {
		padding: 2px 5px;
		border: 1px solid var(--border);
		border-radius: 3px;
		background: var(--surface-2);
	}

	:global(html[data-theme='dark']) .post-content :global(pre code span[style*='6A737D']) {
		color: #9a9a9a !important;
	}

	:global(html[data-theme='light']) .post-content :global(pre code span[style*='6A737D']) {
		color: #5f5f5f !important;
	}

	.post-content :global(img) {
		margin: 1.15em 0;
		border: 1px solid var(--border);
		border-radius: 0;
	}

	.post-content :global(hr) {
		margin: 1.4em 0;
		border: 0;
		border-top: 1px solid var(--border);
	}

	.post-content :global(table) {
		width: 100%;
		margin: 1.15em 0;
		border-collapse: collapse;
		font-family: var(--font-sans);
		font-size: 13px;
	}

	.post-content :global(th),
	.post-content :global(td) {
		padding: 8px 9px;
		border: 1px solid var(--border);
		text-align: left;
		vertical-align: top;
	}

	.next-entry {
		padding: 14px 20px 18px;
		border-top: 1px solid var(--sheet-line, var(--border));
	}

	.next-entry > span {
		display: block;
		margin-bottom: 4px;
		font-family: var(--font-sans);
		font-size: 11px;
		color: var(--muted);
	}

	.next-entry a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		color: var(--text);
	}

	.next-entry a:hover strong,
	.next-entry a:focus-visible strong {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.next-entry a:focus-visible { outline: none; }

	.next-entry strong {
		font-family: var(--font-sans);
		font-size: 15px;
		font-weight: 600;
		line-height: 1.3;
	}

	@media (max-width: 720px) {
		.article-page {
			border-inline: 0;
			margin-bottom: 78px;
		}
		.article-header { padding-inline: 16px; }
		.post-content { padding: 22px 16px 44px; }
		.post-content :global(p),
		.post-content :global(li) { font-size: 15.5px; line-height: 1.65; }
	}
</style>
