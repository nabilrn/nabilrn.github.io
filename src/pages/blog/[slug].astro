---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Page from '../../components/Page.astro';
import EngagementBar from '../../components/EngagementBarNew.astro';
import { authorName, getSiteContent, localeMeta, localizePath, normalizeLocale, siteUrl, type SiteLocale } from '../../data/siteContent';
import { getBlogLocaleInfo, getTranslationVariants, type BlogLocale } from '../../utils/blogLocale';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts
		.filter((post) => getBlogLocaleInfo(post).locale === 'en')
		.map((post) => ({
			params: { slug: post.slug },
			props: { post },
		}));
}

const { post, locale: rawUiLocale, path: rawPath } = Astro.props as { post: CollectionEntry<'blog'>; locale?: SiteLocale; path?: string };
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const { Content } = await render(post);
const localeInfo = getBlogLocaleInfo(post);
const postLocale: BlogLocale = localeInfo.locale;
const uiLocale = normalizeLocale(rawUiLocale ?? postLocale);
const variants = getTranslationVariants(allPosts, localeInfo.translationKey);
const blogLocales = ['en', 'id'] as const satisfies readonly BlogLocale[];

const words = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 200));
const dateLocale = localeMeta[postLocale].dateLocale;
const dateStr = post.data.pubDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' });

const siteCopy = getSiteContent(uiLocale);
const blogCopy = siteCopy.blog;
const postPath = rawPath ?? localizePath(`/blog/${post.slug}/`, uiLocale);
const postUrl = new URL(postPath, siteUrl).toString();
const ogImagePath = `/og/blog/${post.slug}.png`;
const ogImageUrl = `${siteUrl}${ogImagePath}`;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const localizedSequence = allPosts
	.filter((item) => getBlogLocaleInfo(item).locale === postLocale)
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const currentIndex = localizedSequence.findIndex((item) => item.slug === post.slug);
const articleNumber = String(Math.max(0, currentIndex) + 1).padStart(2, '0');
const nextPost = currentIndex >= 0 ? localizedSequence[currentIndex + 1] ?? null : null;

const labels = {
	back: `← ${blogCopy.article.back}`,
	minRead: blogCopy.minReadByLocale[postLocale](readingTime),
	updated: blogCopy.article.updated,
	next: uiLocale === 'id' ? 'tulisan berikutnya' : 'next entry',
	published: uiLocale === 'id' ? 'terbit' : 'published',
	language: uiLocale === 'id' ? 'bahasa' : 'language',
	reading: uiLocale === 'id' ? 'waktu baca' : 'reading time',
	note: uiLocale === 'id' ? 'baca pelan, ambil yang berguna →' : 'read slowly, keep what matters →',
};

const alternatePaths = Object.fromEntries(
	blogLocales
		.filter((optionLocale) => variants[optionLocale])
		.map((optionLocale) => [
			optionLocale,
			localizePath(`/blog/${variants[optionLocale]!.slug}/`, optionLocale),
		])
) as Partial<Record<SiteLocale, string>>;

const breadcrumbJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: siteCopy.nav.home,
			item: new URL(localizePath('/', uiLocale), siteUrl).toString(),
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: siteCopy.nav.blog,
			item: new URL(localizePath('/blog/', uiLocale), siteUrl).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: post.data.title,
			item: postUrl,
		},
	],
});

const blogPostingJson = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	image: ogImageUrl,
	datePublished: publishedTime,
	dateModified: modifiedTime,
	inLanguage: postLocale,
	author: {
		'@type': 'Person',
		name: authorName,
		url: siteUrl,
	},
	publisher: {
		'@type': 'Person',
		name: authorName,
		url: siteUrl,
	},
	mainEntityOfPage: postUrl,
	url: postUrl,
	keywords: post.data.tags,
});
---

<Page
	title={`${post.data.title} | ${authorName}`}
	description={post.data.description}
	path={postPath}
	locale={uiLocale}
	lang={postLocale}
	ogImage={ogImagePath}
	ogImageAlt={blogCopy.article.ogImageAlt(post.data.title)}
	ogType="article"
	twitterCard="summary_large_image"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	articleTags={post.data.tags}
	ogImageWidth={1200}
	ogImageHeight={630}
	alternatePaths={alternatePaths}
>
	<div class="article-sheet">
		<div class="article-topline">
			<a href={localizePath('/blog/', uiLocale)} class="back-link" aria-label={labels.back}>{labels.back}</a>
			<span>ENTRY / {articleNumber}</span>
		</div>

		<header class="article-header">
			<div class="article-heading">
				<p class="hand-note" aria-hidden="true">{labels.note}</p>
				<div class="article-kicker">
					<span>02.{articleNumber}</span>
					<span>BLOG / ARTICLE</span>
				</div>
				<h1>{post.data.title}</h1>
				<p class="article-deck">{post.data.description}</p>
				<div class="post-tags" aria-label="Tags">
					{post.data.tags.map((tag: string) => <span>#{tag.toLowerCase().replace(/\s+/g, '-')}</span>)}
				</div>
			</div>

			<aside class="article-spec" aria-label="Article metadata">
				<div class="spec-row">
					<span>{labels.published}</span>
					<strong>{dateStr}</strong>
				</div>
				<div class="spec-row">
					<span>{labels.reading}</span>
					<strong>{labels.minRead}</strong>
				</div>
				<div class="spec-row">
					<span>{labels.language}</span>
					<strong>{postLocale.toUpperCase()}</strong>
				</div>
				{post.data.updatedDate && (
					<div class="spec-row">
						<span>{labels.updated}</span>
						<strong>{post.data.updatedDate.toLocaleDateString(dateLocale, { year: 'numeric', month: 'short', day: 'numeric' })}</strong>
					</div>
				)}
			</aside>
		</header>

		<div class="article-body-grid">
			<aside class="engagement-rail" aria-label={blogCopy.article.engagementAria}>
				<div class="rail-label" aria-hidden="true">ACTIVITY</div>
				<EngagementBar postId={post.slug} title={post.data.title} variant="floating" locale={uiLocale} />
			</aside>

			<article class="post-main">
				<div class="post-content">
					<Content />
				</div>
			</article>
		</div>

		{nextPost && (
			<nav class="next-entry" aria-label={labels.next}>
				<a href={localizePath(`/blog/${nextPost.slug}/`, uiLocale)}>
					<span class="next-index">NEXT / {String(currentIndex + 2).padStart(2, '0')}</span>
					<strong>{nextPost.data.title}</strong>
					<span class="next-arrow" aria-hidden="true">↗</span>
				</a>
			</nav>
		)}
	</div>

	<script is:inline type="application/ld+json" set:html={breadcrumbJson}></script>
	<script is:inline type="application/ld+json" set:html={blogPostingJson}></script>
</Page>

<style>
	.article-sheet {
		--sheet-line: color-mix(in srgb, var(--border) 78%, var(--bg));
		margin-inline: calc(var(--content-gutter) * -1);
		border-bottom: 1px solid var(--sheet-line);
	}

	.article-topline {
		min-height: 38px;
		padding: 0 clamp(16px, 2.2vw, 26px);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		border-bottom: 1px solid var(--sheet-line);
		font-family: var(--font-mono);
		font-size: 8px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.back-link {
		color: var(--muted);
		transition: color 140ms ease;
	}

	.back-link:hover,
	.back-link:focus-visible {
		color: var(--text);
		outline: none;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-header {
		display: grid;
		grid-template-columns: minmax(0, 1.618fr) minmax(250px, 1fr);
		border-bottom: 2px solid var(--border);
	}

	.article-heading {
		position: relative;
		padding: clamp(30px, 5vw, 64px) clamp(22px, 5vw, 64px) clamp(34px, 5vw, 56px);
		border-right: 1px solid var(--sheet-line);
	}

	.article-kicker {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: clamp(54px, 8vw, 88px);
		font-family: var(--font-mono);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.09em;
		color: var(--muted);
	}

	.article-kicker span:first-child { color: var(--text); }

	.hand-note {
		position: absolute;
		top: clamp(75px, 10vw, 108px);
		right: clamp(24px, 5vw, 64px);
		margin: 0;
		font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
		font-size: 12px;
		line-height: 1.15;
		color: var(--muted);
		transform: rotate(-1.8deg);
	}

	h1 {
		max-width: 19ch;
		margin: 0 0 20px;
		font-family: var(--font-sans);
		font-size: clamp(38px, 5.2vw, 66px);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.055em;
	}

	.article-deck {
		max-width: 68ch;
		margin: 0 0 22px;
		font-family: var(--font-sans);
		font-size: clamp(14px, 1.45vw, 17px);
		line-height: 1.65;
		color: var(--muted);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 8px;
		color: color-mix(in srgb, var(--muted) 88%, var(--text));
	}

	.article-spec {
		display: grid;
		align-content: start;
	}

	.spec-row {
		min-height: 54px;
		padding: 0 clamp(16px, 2.4vw, 28px);
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 18px;
		border-bottom: 1px solid var(--sheet-line);
		font-family: var(--font-mono);
		font-size: 8px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.spec-row strong {
		color: var(--text);
		font-size: 9px;
		font-weight: 500;
		text-align: right;
	}

	.article-body-grid {
		display: grid;
		grid-template-columns: 104px minmax(0, 1fr);
		align-items: start;
	}

	.engagement-rail {
		position: sticky;
		top: 48px;
		min-height: 220px;
		padding: 18px 12px;
		border-right: 1px solid var(--sheet-line);
	}

	.rail-label {
		margin-bottom: 12px;
		font-family: var(--font-mono);
		font-size: 7px;
		letter-spacing: 0.08em;
		color: var(--muted);
		writing-mode: vertical-rl;
	}

	.post-main {
		min-width: 0;
		padding: clamp(34px, 5vw, 70px) clamp(24px, 7vw, 96px) clamp(54px, 7vw, 92px);
	}

	.post-content {
		max-width: 760px;
		margin: 0 auto;
	}

	.post-content :global(p) {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.86;
		margin-bottom: 1.2em;
		color: var(--text-body);
	}

	.post-content :global(h2) {
		position: relative;
		font-family: var(--font-sans);
		font-size: clamp(25px, 3vw, 32px);
		line-height: 1.22;
		letter-spacing: -0.035em;
		margin: 2.35em 0 0.8em;
		padding-top: 18px;
		border-top: 1px solid var(--sheet-line);
	}

	.post-content :global(h3) {
		font-family: var(--font-sans);
		font-size: clamp(20px, 2.4vw, 24px);
		line-height: 1.3;
		letter-spacing: -0.025em;
		margin: 1.8em 0 0.7em;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		margin: 0 0 1.3em;
		padding-left: 1.45em;
	}

	.post-content :global(li) {
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.78;
		color: var(--text-body);
		margin-bottom: 0.38em;
	}

	.post-content :global(a) {
		color: var(--text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.post-content :global(blockquote) {
		position: relative;
		margin: 1.8em 0;
		padding: 18px 20px 18px 28px;
		border: 1px solid var(--sheet-line);
		border-left: 2px solid var(--text);
		color: var(--muted);
	}

	.post-content :global(blockquote p:last-child) { margin-bottom: 0; }

	.post-content :global(code) {
		font-size: 13px;
		background: var(--surface);
		padding: 2px 5px;
		border: 1px solid var(--sheet-line);
		border-radius: 0;
	}

	.post-content :global(pre) {
		position: relative;
		background: var(--surface);
		border: 1px solid var(--sheet-line);
		border-radius: 0;
		padding: 18px;
		overflow-x: auto;
		margin: 1.5em 0;
	}

	.post-content :global(pre::before) {
		content: 'CODE';
		position: absolute;
		top: 6px;
		right: 8px;
		font-family: var(--font-mono);
		font-size: 7px;
		letter-spacing: 0.08em;
		color: var(--muted);
	}

	.post-content :global(pre code) {
		border: none;
		background: none;
		padding: 0;
	}

	:global(html[data-theme='dark']) .post-content :global(pre code span[style*='6A737D']) {
		color: #9a9a9a !important;
	}

	:global(html[data-theme='light']) .post-content :global(pre code span[style*='6A737D']) {
		color: #5f5f5f !important;
	}

	.post-content :global(img) {
		border: 1px solid var(--sheet-line);
		border-radius: 0;
		margin: 1.6em 0;
	}

	.post-content :global(hr) {
		border: 0;
		border-top: 1px solid var(--sheet-line);
		margin: 2.4em 0;
	}

	.next-entry {
		border-top: 2px solid var(--border);
	}

	.next-entry a {
		min-height: 128px;
		padding: 26px clamp(20px, 5vw, 64px);
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr) auto;
		align-items: center;
		gap: 20px;
		transition: background 150ms ease;
	}

	.next-entry a:hover,
	.next-entry a:focus-visible {
		background: var(--surface);
		outline: none;
	}

	.next-index {
		font-family: var(--font-mono);
		font-size: 8px;
		letter-spacing: 0.08em;
		color: var(--muted);
	}

	.next-entry strong {
		font-family: var(--font-sans);
		font-size: clamp(18px, 2.3vw, 26px);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	.next-arrow {
		font-size: 18px;
		transition: transform 150ms ease;
	}

	.next-entry a:hover .next-arrow,
	.next-entry a:focus-visible .next-arrow {
		transform: translate(2px, -2px);
	}

	@media (max-width: 820px) {
		.article-header {
			grid-template-columns: 1fr;
		}

		.article-heading {
			border-right: 0;
			border-bottom: 1px solid var(--sheet-line);
		}

		.article-spec {
			grid-template-columns: repeat(2, 1fr);
		}

		.spec-row:nth-child(odd) {
			border-right: 1px solid var(--sheet-line);
		}

		.article-body-grid {
			grid-template-columns: 1fr;
		}

		.engagement-rail {
			position: static;
			min-height: 0;
			padding: 12px 16px;
			border-right: 0;
			border-bottom: 1px solid var(--sheet-line);
		}

		.rail-label {
			display: none;
		}
	}

	@media (max-width: 520px) {
		.hand-note {
			right: 18px;
			font-size: 10px;
		}

		.article-spec {
			grid-template-columns: 1fr;
		}

		.spec-row:nth-child(odd) {
			border-right: 0;
		}

		.post-main {
			padding-inline: 16px;
		}

		.next-entry a {
			grid-template-columns: 1fr auto;
			gap: 10px;
		}

		.next-index {
			grid-column: 1 / -1;
		}
	}
</style>
