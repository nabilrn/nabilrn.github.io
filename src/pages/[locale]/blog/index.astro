---
import BlogIndexPage from '../../blog/index.astro';
import { localizePath, type SiteLocale } from '../../../data/siteContent';

const localizedBlogLocales = ['id'] as const;

export function getStaticPaths() {
    return localizedBlogLocales.map((locale) => ({
        params: { locale },
        props: {
            locale,
            path: localizePath('/blog/', locale),
        },
    }));
}

const { locale, path } = Astro.props as { locale: SiteLocale; path: string };
---

<BlogIndexPage locale={locale} path={path} />
