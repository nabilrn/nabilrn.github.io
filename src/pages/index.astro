---
import Page from '../components/Page.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import NRNMark from '../components/home/NRNMark.astro';
import RoleFlip from '../components/home/RoleFlip.astro';
import { getSiteContent, localizePath, normalizeLocale, type SiteLocale } from '../data/siteContent';

interface Props {
    locale?: SiteLocale;
    path?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/', locale);
const content = getSiteContent(locale);
const home = content.home;

const rolesByLocale: Record<SiteLocale, string[]> = {
    en: ['Software Engineer', 'IT Infrastructure Builder', 'Lifetime Learner'],
    id: ['Software Engineer', 'IT Infrastructure Builder', 'Pembelajar seumur hidup'],
    cn: ['Software Engineer', 'IT Infrastructure Builder', '终身学习者'],
    jp: ['Software Engineer', 'IT Infrastructure Builder', '生涯学習者'],
    ar: ['Software Engineer', 'IT Infrastructure Builder', 'متعلم مدى الحياة'],
};

const introByLocale: Record<SiteLocale, string> = {
    en: 'Just a dude who likes building useful software, systems, and infrastructure.',
    id: 'Cuma orang yang suka membangun software, sistem, dan infrastruktur yang berguna.',
    cn: '只是一个喜欢构建实用软件、系统和基础设施的人。',
    jp: '役に立つソフトウェア、システム、インフラを作るのが好きな人です。',
    ar: 'مجرد شخص يحب بناء برمجيات وأنظمة وبنية تحتية مفيدة.',
};
---

<Page title={home.seoTitle} description={home.seoDescription} path={pagePath} locale={locale} layoutVariant="portfolio-full">
    <div class="home-redesign" data-home-redesign>
        <HomeHeader locale={locale} />

        <div class="technical-rail" aria-hidden="true"></div>

        <main class="hero-shell">
            <section class="hero" aria-labelledby="hero-name">
                <div class="hero-intro">
                    <div class="identity">
                        <div class="identity-mark" aria-hidden="true">NRN</div>
                        <div class="identity-copy">
                            <h1 id="hero-name">{content.profile.name}</h1>
                            <RoleFlip roles={rolesByLocale[locale]} />
                        </div>
                    </div>

                    <p class="hero-description">{introByLocale[locale]}</p>
                </div>

                <div class="hero-visual">
                    <NRNMark />
                </div>
            </section>

            <div class="stripe-divider" aria-hidden="true"></div>
        </main>
    </div>
</Page>

<style>
    :global(.full-header) {
        display: none;
    }

    /* Higher specificity than PortfolioFullLayout so the home canvas cannot
       fall back to the shared 1280px content width. */
    :global(.full-main.full-main) {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    :global(.full-shell.full-shell) {
        --content-gutter: 0px;
    }

    .home-redesign {
        width: min(1720px, calc(100vw - 48px));
        min-height: 100vh;
        margin: 0 auto;
        overflow-x: clip;
        background: var(--bg);
        color: var(--text);
    }

    .technical-rail {
        width: 100%;
        height: 34px;
        border-bottom: 1px solid var(--border);
        background-color: var(--bg);
        background-image:
            linear-gradient(
                90deg,
                transparent 0,
                transparent calc(50% - 0.5px),
                color-mix(in srgb, var(--border) 65%, transparent) calc(50% - 0.5px),
                color-mix(in srgb, var(--border) 65%, transparent) calc(50% + 0.5px),
                transparent calc(50% + 0.5px)
            );
    }

    .hero-shell {
        width: 100%;
        margin: 0;
        background: var(--bg);
    }

    .hero {
        display: grid;
        grid-template-columns: 56.25% 43.75%;
        min-height: 610px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
    }

    .hero-intro {
        min-width: 0;
        min-height: 610px;
        padding: 54px clamp(42px, 3.4vw, 68px) 44px clamp(42px, 3.7vw, 76px);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: 24px;
        border-right: 1px solid var(--border);
        background: var(--bg);
        overflow: hidden;
    }

    .identity {
        display: flex;
        align-items: center;
        gap: 28px;
        min-width: 0;
    }

    .identity-mark {
        flex: 0 0 116px;
        width: 116px;
        height: 116px;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 50%;
        background: var(--bg);
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 0.04em;
    }

    .identity-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .identity-copy h1 {
        margin: 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(42px, 3vw, 56px);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.05em;
        text-wrap: balance;
    }

    .hero-description {
        width: min(760px, 100%);
        margin: 0;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 19px;
        line-height: 1.55;
        letter-spacing: -0.014em;
        text-wrap: pretty;
    }

    .hero-visual {
        min-width: 0;
        min-height: 610px;
        overflow: hidden;
        background: var(--bg);
    }

    .stripe-divider {
        height: 14px;
        border-bottom: 1px solid var(--border);
        background-color: var(--bg);
        background-image: repeating-linear-gradient(
            135deg,
            transparent 0,
            transparent 7px,
            color-mix(in srgb, var(--border) 72%, transparent) 7px,
            color-mix(in srgb, var(--border) 72%, transparent) 8px
        );
    }

    @media (min-width: 1600px) {
        .hero,
        .hero-intro,
        .hero-visual {
            min-height: 680px;
        }

        .identity-mark {
            flex-basis: 124px;
            width: 124px;
            height: 124px;
        }

        .hero-description {
            font-size: 20px;
        }
    }

    @media (max-width: 900px) {
        .home-redesign {
            width: min(100%, calc(100vw - 24px));
        }

        .hero {
            grid-template-columns: 1fr;
        }

        .hero-intro {
            min-height: 430px;
            padding: 48px 32px 36px;
            border-right: 0;
            border-bottom: 1px solid var(--border);
        }

        .hero-visual {
            min-height: 430px;
        }

        .technical-rail {
            height: 20px;
        }
    }

    @media (max-width: 560px) {
        .home-redesign {
            width: 100%;
        }

        .hero-intro {
            min-height: 360px;
            padding: 36px 18px 28px;
            gap: 16px;
        }

        .identity {
            align-items: flex-end;
            gap: 16px;
        }

        .identity-mark {
            flex-basis: 76px;
            width: 76px;
            height: 76px;
            font-size: 12px;
        }

        .identity-copy h1 {
            font-size: clamp(29px, 8vw, 36px);
        }

        .hero-description {
            font-size: 15px;
            line-height: 1.55;
        }

        .hero-visual {
            min-height: 350px;
        }
    }
</style>
