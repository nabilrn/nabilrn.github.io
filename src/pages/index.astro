---
import Page from '../components/Page.astro';
import { getSiteContent, localizePath, normalizeLocale, type SiteLocale } from '../data/siteContent';

interface Props {
    locale?: SiteLocale;
    path?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/', locale);
const content = getSiteContent(locale);
const home = content.home;
---

<Page title={home.seoTitle} description={home.seoDescription} path={pagePath} locale={locale} layoutVariant="portfolio-full">
    <section class="home-redesign-scaffold" data-home-redesign>
        <h1 class="sr-only">{content.profile.name}</h1>
        <!--
            Intentionally empty foundation for the new Figma-driven homepage.
            The legacy interactive terminal implementation was removed before
            recreating the new technical bento design.
        -->
    </section>
</Page>

<style>
    .home-redesign-scaffold {
        min-height: 100vh;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
