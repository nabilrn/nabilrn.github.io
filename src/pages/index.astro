---
import { getCollection } from 'astro:content';
import Page from '../components/Page.astro';
import GitHubContributionGrid from '../components/GitHubContributionGrid.astro';
import ExperienceRail from '../components/home/ExperienceRail.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import IdentityProfile from '../components/home/IdentityProfile.astro';
import NRMark from '../components/home/NRMark.astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import UiIcon from '../components/icons/UiIcon.astro';
import { webProjects } from '../data/projects';
import { getSiteContent, localizePath, normalizeLocale, type SiteLocale } from '../data/siteContent';

interface Props {
    locale?: SiteLocale;
    path?: string;
}

type DuolingoResponse = {
    users?: Array<{
        streak?: number;
    }>;
};

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/', locale);
const content = getSiteContent(locale);
const home = content.home;

const selectedProjects = webProjects.slice(0, 3);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const localizedPosts = allPosts.filter((post) => (post.data.locale ?? 'en') === locale);
const fallbackPosts = allPosts.filter((post) => (post.data.locale ?? 'en') === 'en');
const latestPosts = (localizedPosts.length > 0 ? localizedPosts : fallbackPosts)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);

const blogPath = localizePath('/blog/', locale);
const projectsPath = localizePath('/projects/', locale);
const education = home.education;

const DUOLINGO_USERNAME = 'bilcikiwir';
const DUOLINGO_FIELDS = 'users{id,username,streak}';
const DUOLINGO_STREAK_FALLBACK = 515;
const duolingoUrl = `https://www.duolingo.com/2017-06-30/users?username=${encodeURIComponent(DUOLINGO_USERNAME)}&fields=${encodeURIComponent(DUOLINGO_FIELDS)}`;
let duolingoStreak = DUOLINGO_STREAK_FALLBACK;

try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);
    const response = await fetch(duolingoUrl, {
        headers: {
            Accept: 'application/json; charset=UTF-8',
            'User-Agent': 'nabilrn-portfolio/1.0',
        },
        signal: controller.signal,
    });
    clearTimeout(timeout);

    if (response.ok) {
        const payload = (await response.json()) as DuolingoResponse;
        const liveStreak = Number(payload.users?.[0]?.streak);
        if (Number.isFinite(liveStreak) && liveStreak > 0) {
            duolingoStreak = liveStreak;
        }
    }
} catch {
    // Static builds must remain healthy even when Duolingo is temporarily unavailable.
}
---

<Page title={home.seoTitle} description={home.seoDescription} path={pagePath} locale={locale} layoutVariant="portfolio-full">
    <div class="home-redesign" data-home-redesign>
        <HomeHeader locale={locale} />

        <main class="portfolio-board">
            <div class="top-layout">
                <section class="identity-board" aria-labelledby="hero-name">
                    <IdentityProfile locale={locale} name={content.profile.name} avatarAlt={content.profile.avatarAlt} />

                    <div class="contribution-region">
                        <div class="region-heading">
                            <span class="heading-label">
                                <BrandIcon name="github" size={13} />
                                <span>{home.contributions.heading}</span>
                            </span>
                            <a href="https://github.com/nabilrn" target="_blank" rel="noopener">
                                <span>GitHub</span>
                                <UiIcon name="arrow-up-right" size={11} strokeWidth={1.5} />
                            </a>
                        </div>
                        <GitHubContributionGrid username="nabilrn" locale={locale} />
                    </div>

                    <div class="location-region compact-region" aria-label="Padang local time and timezone comparison">
                        <div class="location-place">
                            <UiIcon name="map-pin" size={11} strokeWidth={1.5} />
                            <span>Padang, Indonesia</span>
                        </div>
                        <div class="location-time">
                            <span class="status-clock-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <path data-padang-clock-hands d="M12 12 L12 8 M12 12 L15 12"></path>
                                </svg>
                            </span>
                            <span data-padang-time>--:-- --</span>
                        </div>
                        <div class="location-date" data-padang-date>-- --- ----</div>
                        <div class="location-diff" data-padang-diff>// comparing time</div>
                    </div>

                    <div class="streak-region compact-region" aria-label={`Duolingo streak: ${duolingoStreak} days`}>
                        <div class="duo-identity">
                            <BrandIcon name="duolingo" size={20} />
                            <span>@bilcikiwir</span>
                        </div>
                        <div class="streak-value">
                            <span class="streak-flame" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12.3 22c4.2 0 7.2-3 7.2-7.2 0-3.2-1.7-6-5.2-8.8.1 2.4-.8 4-2.2 5-0.2-3.8-2.3-6.8-5.4-9 .3 3.1-1 5.2-2.2 7-1.1 1.6-2 3.3-2 5.8C2.5 19 6 22 12.3 22Z"></path>
                                    <path d="M9.2 18.1c0-1.5.9-2.8 2.9-4.6.2 1.4.8 2.4 1.9 3.2.2-.7.2-1.4 0-2.1 1.1 1 1.8 2.2 1.8 3.5 0 2.1-1.5 3.9-3.5 3.9s-3.1-1.7-3.1-3.9Z"></path>
                                </svg>
                            </span>
                            <strong>{duolingoStreak}</strong>
                            <span class="streak-unit">days</span>
                        </div>
                    </div>

                    <div class="experience-region">
                        <ExperienceRail heading={home.experiences.heading} />
                    </div>

                    <div class="education-region compact-region">
                        <div class="micro-label icon-label">
                            <UiIcon name="graduation-cap" size={12} strokeWidth={1.5} />
                            <span>{education.heading}</span>
                        </div>
                        <div class="region-primary">{education.institution}</div>
                        <div class="region-secondary">{education.degree}</div>
                        <div class="region-meta">{education.gpa} · {education.period}</div>
                    </div>
                </section>

                <section class="nr-region" aria-label="NR identity system">
                    <div class="nr-figure">
                        <NRMark />
                    </div>
                    <p class="nr-note" aria-hidden="true">
                        <span>↖</span>
                        press the mark<br />and move your cursor
                    </p>
                </section>
            </div>

            <div class="bottom-layout">
                <section class="index-region projects-region" aria-labelledby="projects-heading">
                    <header class="index-heading">
                        <div>
                            <span class="micro-label">Selected work</span>
                            <h2 id="projects-heading">{content.nav.projects}</h2>
                        </div>
                        <a href={projectsPath}>
                            <span>View all</span>
                            <UiIcon name="arrow-up-right" size={11} strokeWidth={1.5} />
                        </a>
                    </header>

                    <div class="index-list">
                        {selectedProjects.map((project, index) => (
                            <a class="index-item" href={project.liveUrl} target="_blank" rel="noopener">
                                <span class="index-number">0{index + 1}</span>
                                <span class="index-copy">
                                    <strong>{project.name}</strong>
                                    <span>{project.stack.slice(0, 4).join(' · ')}</span>
                                </span>
                                <span class="index-arrow" aria-hidden="true">
                                    <UiIcon name="arrow-up-right" size={13} strokeWidth={1.5} />
                                </span>
                            </a>
                        ))}
                    </div>
                </section>

                <section class="index-region blog-region" aria-labelledby="blog-heading">
                    <header class="index-heading">
                        <div>
                            <span class="micro-label">Writing</span>
                            <h2 id="blog-heading">{content.nav.blog}</h2>
                        </div>
                        <a href={blogPath}>
                            <span>View all</span>
                            <UiIcon name="arrow-up-right" size={11} strokeWidth={1.5} />
                        </a>
                    </header>

                    <div class="index-list">
                        {latestPosts.map((post, index) => (
                            <a class="index-item" href={localizePath(`/blog/${post.slug}/`, locale)}>
                                <span class="index-number">0{index + 1}</span>
                                <span class="index-copy">
                                    <strong>{post.data.title}</strong>
                                    <span>{post.data.pubDate.toLocaleDateString(locale === 'en' ? 'en-US' : locale === 'id' ? 'id-ID' : locale === 'cn' ? 'zh-CN' : locale === 'jp' ? 'ja-JP' : 'ar-SA', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                                </span>
                                <span class="index-arrow" aria-hidden="true">
                                    <UiIcon name="arrow-up-right" size={13} strokeWidth={1.5} />
                                </span>
                            </a>
                        ))}
                    </div>
                </section>
            </div>
        </main>
    </div>
</Page>

<script is:inline>
    (() => {
        const PADANG_TIME_ZONE = 'Asia/Jakarta';
        const timeTarget = document.querySelector('[data-padang-time]');
        const dateTarget = document.querySelector('[data-padang-date]');
        const diffTarget = document.querySelector('[data-padang-diff]');
        const handsTarget = document.querySelector('[data-padang-clock-hands]');
        if (!timeTarget || !dateTarget || !diffTarget) return;

        const timeFormatter = new Intl.DateTimeFormat('en-US', {
            timeZone: PADANG_TIME_ZONE,
            hour: '2-digit',
            minute: '2-digit',
            hour12: true,
        });
        const dateFormatter = new Intl.DateTimeFormat('en-GB', {
            timeZone: PADANG_TIME_ZONE,
            day: '2-digit',
            month: 'short',
            year: 'numeric',
        });
        const offsetFormatter = new Intl.DateTimeFormat('en-US', {
            timeZone: PADANG_TIME_ZONE,
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hourCycle: 'h23',
        });

        const getPadangOffset = (date) => {
            const parts = offsetFormatter.formatToParts(date);
            const values = Object.fromEntries(parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]));
            const representedUtc = Date.UTC(
                Number(values.year),
                Number(values.month) - 1,
                Number(values.day),
                Number(values.hour),
                Number(values.minute),
                Number(values.second),
            );
            return Math.round((representedUtc - date.getTime()) / 60000);
        };

        const clockHandsPath = (hour, minute) => {
            const h = hour % 12;
            const round = (value) => Math.round(value * 1000) / 1000;
            const minuteAngle = (minute / 60) * 2 * Math.PI;
            const hourAngle = ((h + minute / 60) / 12) * 2 * Math.PI;
            const hx = round(12 + 3.6 * Math.sin(hourAngle));
            const hy = round(12 - 3.6 * Math.cos(hourAngle));
            const mx = round(12 + 6 * Math.sin(minuteAngle));
            const my = round(12 - 6 * Math.cos(minuteAngle));
            return `M12 12 L${hx} ${hy} M12 12 L${mx} ${my}`;
        };

        const render = () => {
            const now = new Date();
            const timeParts = timeFormatter.formatToParts(now);
            const hourPart = timeParts.find((part) => part.type === 'hour')?.value ?? '12';
            const minutePart = timeParts.find((part) => part.type === 'minute')?.value ?? '00';
            const dayPeriod = timeParts.find((part) => part.type === 'dayPeriod')?.value ?? '';

            timeTarget.textContent = `${hourPart}:${minutePart}${dayPeriod ? ` ${dayPeriod}` : ''}`;
            dateTarget.textContent = dateFormatter.format(now).toUpperCase();

            const viewerOffset = -now.getTimezoneOffset();
            const padangOffset = getPadangOffset(now);
            const delta = padangOffset - viewerOffset;
            const absDelta = Math.abs(delta);

            let diffText = '// same time';
            if (absDelta >= 1) {
                const hours = Math.floor(absDelta / 60);
                const minutes = absDelta % 60;
                const pieces = [];
                if (hours) pieces.push(`${hours}h`);
                if (minutes) pieces.push(`${minutes}m`);
                diffText = `// ${pieces.join(' ')} ${delta > 0 ? 'ahead' : 'behind'}`;
            }
            diffTarget.textContent = diffText;

            if (handsTarget) {
                handsTarget.setAttribute('d', clockHandsPath(Number.parseInt(hourPart, 10), Number.parseInt(minutePart, 10)));
            }
        };

        render();
        window.setInterval(render, 30000);
    })();
</script>

<style>
    :global(.full-header) {
        display: none;
    }

    :global(.full-main.full-main) {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    :global(.full-shell.full-shell) {
        --content-gutter: 0px;
    }

    :global(.home-header.home-header.home-header),
    :global(.home-header .home-header-inner) {
        background: var(--bg);
        backdrop-filter: none;
    }

    .home-redesign {
        --phi-major: 61.8034%;
        --phi-minor: 38.1966%;
        --phi-small: 23.6068%;
        --phi-half-small: 11.8034%;
        --phi-mid: 47.2136%;
        --phi-side: 29.1796%;
        --major-stroke: 2px;
        --minor-stroke: 1px;
        --sheet-line: color-mix(in oklab, var(--border) 64%, var(--bg));

        --type-micro: 9px;
        --type-meta: 10px;
        --type-body: 12px;
        --type-item: 15px;
        --type-heading: 22px;

        width: min(1920px, calc(100vw - 32px));
        min-height: 100vh;
        margin: 0 auto;
        background: var(--bg);
        color: var(--text);
        overflow-x: clip;
    }

    .portfolio-board {
        position: relative;
        display: grid;
        min-width: 0;
        min-height: 0;
        padding: 0;
        border-inline: var(--minor-stroke) solid var(--sheet-line);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
        background: var(--bg);
    }

    .top-layout,
    .bottom-layout {
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1.618034fr) minmax(0, 1fr);
        gap: 0;
    }

    .top-layout {
        border-bottom: var(--major-stroke) solid var(--border);
    }

    .identity-board,
    .nr-region,
    .index-region {
        min-width: 0;
        min-height: 0;
        background: var(--bg);
        overflow: hidden;
    }

    .identity-board,
    .projects-region {
        border-right: var(--major-stroke) solid var(--border);
    }

    .identity-board {
        display: grid;
        grid-template-columns:
            minmax(232px, var(--phi-small))
            minmax(0, var(--phi-mid))
            minmax(0, var(--phi-side));
        grid-template-rows:
            clamp(154px, 36%, 162px)
            clamp(50px, var(--phi-half-small), 54px)
            minmax(0, 1fr);
    }

    .micro-label {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--type-micro);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .contribution-region,
    .location-region,
    .education-region,
    .experience-region,
    .streak-region {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .contribution-region {
        grid-column: 2 / 4;
        grid-row: 1;
        padding: clamp(14px, 1.15vw, 19px);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
    }

    .region-heading,
    .index-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .heading-label,
    .icon-label,
    .region-heading a,
    .resume-placeholder,
    .index-heading > a {
        display: inline-flex;
        align-items: center;
    }

    .heading-label,
    .icon-label {
        gap: 6px;
    }

    .region-heading a,
    .resume-placeholder,
    .index-heading > a {
        gap: 4px;
    }

    .region-heading {
        margin-bottom: 10px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: var(--type-body);
        font-weight: 500;
    }

    .region-heading a,
    .resume-placeholder,
    .index-number {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--type-micro);
        font-weight: 400;
        letter-spacing: 0.02em;
    }

    .region-heading a:hover {
        color: var(--text);
    }

    :global(.contribution-region .contribution-panel) {
        border: 0;
        border-radius: 0;
        padding: 0;
        overflow: hidden;
    }

    :global(.contribution-region .contribution-summary),
    :global(.contribution-region .contribution-legend) {
        display: none;
    }

    :global(.contribution-region .contribution-calendar) {
        transform-origin: left top;
    }

    .compact-region {
        padding: clamp(12px, 0.95vw, 17px);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .location-region {
        grid-column: 2;
        grid-row: 2;
        padding-block: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto minmax(0, 1fr);
        align-items: center;
        column-gap: clamp(10px, 0.9vw, 14px);
        border-right: var(--minor-stroke) solid var(--sheet-line);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
    }

    .location-place,
    .location-time,
    .duo-identity,
    .streak-value {
        min-width: 0;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
    }

    .location-place {
        justify-self: start;
        gap: 6px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.015em;
    }

    .location-time {
        justify-self: center;
        gap: 5px;
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 500;
        line-height: 1.2;
    }

    .status-clock-icon {
        width: 13px;
        height: 13px;
        flex: none;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--text) 86%, var(--muted));
    }

    .status-clock-icon svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .location-date,
    .location-diff {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 8.5px;
        line-height: 1.2;
        white-space: nowrap;
    }

    .location-date {
        justify-self: center;
        letter-spacing: 0.035em;
    }

    .location-diff {
        min-width: 0;
        justify-self: end;
        overflow: hidden;
        text-align: right;
        text-overflow: ellipsis;
    }

    .streak-region {
        grid-column: 3;
        grid-row: 2;
        padding-block: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: clamp(12px, 1.1vw, 18px);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
        cursor: default;
    }

    .duo-identity {
        flex: 0 1 auto;
        gap: 7px;
        color: color-mix(in srgb, var(--text) 82%, var(--muted));
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 500;
        line-height: 1;
        transition: color 180ms ease, transform 180ms ease;
    }

    .duo-identity span {
        overflow: hidden;
        color: var(--muted);
        text-overflow: ellipsis;
        transition: color 180ms ease;
    }

    .duo-identity :global(svg) {
        width: 20px;
        height: 20px;
        flex: none;
    }

    .streak-value {
        flex: none;
        margin-left: auto;
        gap: 6px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 550;
        line-height: 1;
        letter-spacing: -0.02em;
        transition: color 180ms ease, text-shadow 180ms ease;
    }

    .streak-value strong {
        color: inherit;
        font: inherit;
        font-weight: 600;
    }

    .streak-unit {
        color: var(--muted);
        font-size: 9.5px;
        font-weight: 400;
        letter-spacing: 0;
        transition: color 180ms ease;
    }

    .streak-flame {
        width: 17px;
        height: 17px;
        flex: none;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--text) 78%, var(--muted));
        transform-origin: 50% 90%;
        transition: color 180ms ease, filter 180ms ease, transform 180ms ease;
    }

    .streak-flame svg {
        width: 100%;
        height: 100%;
        display: block;
    }

    .streak-region:hover .duo-identity,
    .streak-region:hover .duo-identity span {
        color: #58cc02;
    }

    .streak-region:hover .duo-identity {
        transform: translateY(-1px) scale(1.03);
    }

    .streak-region:hover .streak-value {
        color: #f49000;
        text-shadow: 0 0 7px rgba(244, 144, 0, 0.28);
    }

    .streak-region:hover .streak-unit {
        color: color-mix(in srgb, #f49000 70%, var(--muted));
    }

    .streak-region:hover .streak-flame {
        color: #f49000;
        filter: drop-shadow(0 0 4px rgba(244, 144, 0, 0.55)) drop-shadow(0 -2px 5px rgba(255, 194, 0, 0.24));
        animation: streak-flame-burn 620ms ease-in-out infinite alternate;
    }

    @keyframes streak-flame-burn {
        0% { transform: translateY(0) rotate(-1deg) scale(0.98, 1.02); }
        55% { transform: translateY(-1px) rotate(1.5deg) scale(1.04, 0.98); }
        100% { transform: translateY(-1.5px) rotate(-0.5deg) scale(0.99, 1.07); }
    }

    @media (prefers-reduced-motion: reduce) {
        .streak-region:hover .streak-flame {
            animation: none;
        }
    }

    .experience-region {
        grid-column: 2;
        grid-row: 3;
        min-width: 0;
        min-height: 0;
        padding: 0;
        display: block;
        border-right: var(--minor-stroke) solid var(--sheet-line);
        overflow: hidden;
    }

    .education-region {
        grid-column: 3;
        grid-row: 3;
    }

    .region-primary {
        margin-top: 7px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }

    .region-secondary,
    .region-meta {
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: var(--type-meta);
        line-height: 1.4;
    }

    .region-secondary {
        margin-top: 5px;
    }

    .region-meta {
        margin-top: 4px;
    }

    .nr-region {
        position: relative;
    }

    .nr-figure {
        position: absolute;
        inset: 0;
        min-width: 0;
        min-height: 0;
    }

