---
import { getCollection } from 'astro:content';
import Page from '../components/Page.astro';
import GitHubContributionGrid from '../components/GitHubContributionGrid.astro';
import HomeHeader from '../components/home/HomeHeader.astro';
import IdentityProfile from '../components/home/IdentityProfile.astro';
import NRMark from '../components/home/NRMark.astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import UiIcon from '../components/icons/UiIcon.astro';
import { webProjects } from '../data/projects';
import { getSiteContent, localizePath, normalizeLocale, type SiteLocale } from '../data/siteContent';

interface Props {
    locale?: SiteLocale;
    path?: string;
}

const locale = normalizeLocale(Astro.props.locale);
const pagePath = Astro.props.path ?? localizePath('/', locale);
const content = getSiteContent(locale);
const home = content.home;

const selectedProjects = webProjects.slice(0, 3);
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const localizedPosts = allPosts.filter((post) => (post.data.locale ?? 'en') === locale);
const fallbackPosts = allPosts.filter((post) => (post.data.locale ?? 'en') === 'en');
const latestPosts = (localizedPosts.length > 0 ? localizedPosts : fallbackPosts)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);

const blogPath = localizePath('/blog/', locale);
const projectsPath = localizePath('/projects/', locale);
const education = home.education;
const experienceItems = home.experiences.items.slice(0, 2);
---

<Page title={home.seoTitle} description={home.seoDescription} path={pagePath} locale={locale} layoutVariant="portfolio-full">
    <div class="home-redesign" data-home-redesign>
        <HomeHeader locale={locale} />

        <main class="portfolio-board">
            <div class="top-layout">
                <section class="identity-board" aria-labelledby="hero-name">
                    <IdentityProfile locale={locale} name={content.profile.name} avatarAlt={content.profile.avatarAlt} />

                    <div class="contribution-region">
                        <div class="region-heading">
                            <span class="heading-label">
                                <BrandIcon name="github" size={13} />
                                <span>{home.contributions.heading}</span>
                            </span>
                            <a href="https://github.com/nabilrn" target="_blank" rel="noopener">
                                <span>GitHub</span>
                                <UiIcon name="arrow-up-right" size={11} strokeWidth={1.5} />
                            </a>
                        </div>
                        <GitHubContributionGrid username="nabilrn" locale={locale} />
                    </div>

                    <div class="location-region compact-region">
                        <div class="micro-label icon-label">
                            <UiIcon name="map-pin" size={11} strokeWidth={1.5} />
                            <span>Location / timezone</span>
                        </div>
                        <div class="region-primary">Indonesia</div>
                        <div class="region-secondary">UTC+7 · <span data-jakarta-time>--:--</span></div>
                    </div>

                    <div class="streak-region compact-region">
                        <div class="micro-label icon-label">
                            <BrandIcon name="duolingo" size={11} />
                            <span>Duolingo streak</span>
                        </div>
                        <div class="streak-value">— <span>days</span></div>
                        <div class="region-secondary">daily language practice</div>
                    </div>

                    <div class="experience-region compact-region">
                        <div class="region-heading">
                            <span class="heading-label">
                                <UiIcon name="briefcase" size={12} strokeWidth={1.5} />
                                <span>{home.experiences.heading}</span>
                            </span>
                            <span class="resume-placeholder" title="Resume file will be wired after the layout is approved">
                                <UiIcon name="download" size={11} strokeWidth={1.5} />
                                <span>Resume</span>
                            </span>
                        </div>
                        <div class="experience-list">
                            {experienceItems.map((item) => (
                                <div class="experience-row">
                                    <span>{item.title}</span>
                                    <span>{item.period}</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="education-region compact-region">
                        <div class="micro-label icon-label">
                            <UiIcon name="graduation-cap" size={12} strokeWidth={1.5} />
                            <span>{education.heading}</span>
                        </div>
                        <div class="region-primary">{education.institution}</div>
                        <div class="region-secondary">{education.degree}</div>
                        <div class="region-meta">{education.gpa} · {education.period}</div>
                    </div>
                </section>

                <section class="nr-region" aria-label="NR identity system">
                    <div class="nr-figure">
                        <NRMark />
                    </div>
                    <p class="nr-note" aria-hidden="true">
                        <span>↖</span>
                        press the mark<br />and move your cursor
                    </p>
                </section>
            </div>

            <div class="bottom-layout">
                <section class="index-region projects-region" aria-labelledby="projects-heading">
                    <header class="index-heading">
                        <div>
                            <span class="micro-label">Selected work</span>
                            <h2 id="projects-heading">{content.nav.projects}</h2>
                        </div>
                        <a href={projectsPath}>
                            <span>View all</span>
                            <UiIcon name="arrow-up-right" size={11} strokeWidth={1.5} />
                        </a>
                    </header>

                    <div class="index-list">
                        {selectedProjects.map((project, index) => (
                            <a class="index-item" href={project.liveUrl} target="_blank" rel="noopener">
                                <span class="index-number">0{index + 1}</span>
                                <span class="index-copy">
                                    <strong>{project.name}</strong>
                                    <span>{project.stack.slice(0, 4).join(' · ')}</span>
                                </span>
                                <span class="index-arrow" aria-hidden="true">
                                    <UiIcon name="arrow-up-right" size={13} strokeWidth={1.5} />
                                </span>
                            </a>
                        ))}
                    </div>
                </section>

                <section class="index-region blog-region" aria-labelledby="blog-heading">
                    <header class="index-heading">
                        <div>
                            <span class="micro-label">Writing</span>
                            <h2 id="blog-heading">{content.nav.blog}</h2>
                        </div>
                        <a href={blogPath}>
                            <span>View all</span>
                            <UiIcon name="arrow-up-right" size={11} strokeWidth={1.5} />
                        </a>
                    </header>

                    <div class="index-list">
                        {latestPosts.map((post, index) => (
                            <a class="index-item" href={localizePath(`/blog/${post.slug}/`, locale)}>
                                <span class="index-number">0{index + 1}</span>
                                <span class="index-copy">
                                    <strong>{post.data.title}</strong>
                                    <span>{post.data.pubDate.toLocaleDateString(locale === 'en' ? 'en-US' : locale === 'id' ? 'id-ID' : locale === 'cn' ? 'zh-CN' : locale === 'jp' ? 'ja-JP' : 'ar-SA', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                                </span>
                                <span class="index-arrow" aria-hidden="true">
                                    <UiIcon name="arrow-up-right" size={13} strokeWidth={1.5} />
                                </span>
                            </a>
                        ))}
                    </div>
                </section>
            </div>
        </main>
    </div>
</Page>

<script is:inline>
    (() => {
        const targets = document.querySelectorAll('[data-jakarta-time]');
        if (!targets.length) return;
        const formatter = new Intl.DateTimeFormat(undefined, {
            timeZone: 'Asia/Jakarta',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
        });
        const render = () => {
            const value = formatter.format(new Date());
            targets.forEach((target) => { target.textContent = value; });
        };
        render();
        window.setInterval(render, 30000);
    })();
</script>

<style>
    :global(.full-header) {
        display: none;
    }

    :global(.full-main.full-main) {
        width: 100%;
        max-width: none;
        margin: 0;
        padding: 0;
    }

    :global(.full-shell.full-shell) {
        --content-gutter: 0px;
    }

    :global(.home-header.home-header.home-header),
    :global(.home-header .home-header-inner) {
        background: var(--bg);
        backdrop-filter: none;
    }

    .home-redesign {
        --phi-major: 61.8034%;
        --phi-minor: 38.1966%;
        --phi-small: 23.6068%;
        --phi-half-small: 11.8034%;
        --phi-mid: 47.2136%;
        --phi-side: 29.1796%;
        --major-stroke: 2px;
        --minor-stroke: 1px;
        --sheet-line: color-mix(in oklab, var(--border) 64%, var(--bg));

        --type-micro: 9px;
        --type-meta: 10px;
        --type-body: 12px;
        --type-item: 15px;
        --type-heading: 22px;

        width: min(1920px, calc(100vw - 32px));
        min-height: 100vh;
        margin: 0 auto;
        background: var(--bg);
        color: var(--text);
        overflow-x: clip;
    }

    .portfolio-board {
        position: relative;
        display: grid;
        min-width: 0;
        min-height: 0;
        padding: 0;
        border-inline: var(--minor-stroke) solid var(--sheet-line);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
        background: var(--bg);
    }

    .top-layout,
    .bottom-layout {
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1.618034fr) minmax(0, 1fr);
        gap: 0;
    }

    .top-layout {
        border-bottom: var(--major-stroke) solid var(--border);
    }

    .identity-board,
    .nr-region,
    .index-region {
        min-width: 0;
        min-height: 0;
        background: var(--bg);
        overflow: hidden;
    }

    .identity-board,
    .projects-region {
        border-right: var(--major-stroke) solid var(--border);
    }

    .identity-board {
        display: grid;
        grid-template-columns:
            minmax(232px, var(--phi-small))
            minmax(0, var(--phi-mid))
            minmax(0, var(--phi-side));
        grid-template-rows:
            minmax(0, 50%)
            minmax(0, var(--phi-half-small))
            minmax(0, var(--phi-minor));
    }

    .micro-label {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--type-micro);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .contribution-region,
    .location-region,
    .education-region,
    .experience-region,
    .streak-region {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .contribution-region {
        grid-column: 2 / 4;
        grid-row: 1;
        padding: clamp(14px, 1.15vw, 19px);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
    }

    .region-heading,
    .index-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .heading-label,
    .icon-label,
    .region-heading a,
    .resume-placeholder,
    .index-heading > a {
        display: inline-flex;
        align-items: center;
    }

    .heading-label,
    .icon-label {
        gap: 6px;
    }

    .region-heading a,
    .resume-placeholder,
    .index-heading > a {
        gap: 4px;
    }

    .region-heading {
        margin-bottom: 10px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: var(--type-body);
        font-weight: 500;
    }

    .region-heading a,
    .resume-placeholder,
    .index-number {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: var(--type-micro);
        font-weight: 400;
        letter-spacing: 0.02em;
    }

    .region-heading a:hover {
        color: var(--text);
    }

    :global(.contribution-region .contribution-panel) {
        border: 0;
        border-radius: 0;
        padding: 0;
        overflow: hidden;
    }

    :global(.contribution-region .contribution-summary),
    :global(.contribution-region .contribution-legend) {
        display: none;
    }

    :global(.contribution-region .contribution-calendar) {
        transform-origin: left top;
    }

    .compact-region {
        padding: clamp(12px, 0.95vw, 17px);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .location-region {
        grid-column: 2;
        grid-row: 2;
        border-right: var(--minor-stroke) solid var(--sheet-line);
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
    }

    .streak-region {
        grid-column: 3;
        grid-row: 2;
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
    }

    .location-region,
    .streak-region {
        padding-block: 0;
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr);
        align-items: center;
        justify-content: start;
        column-gap: clamp(7px, .75vw, 12px);
    }

    .location-region .region-primary,
    .streak-region .streak-value {
        min-width: 0;
        margin: 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.015em;
        white-space: nowrap;
    }

    .location-region .region-secondary,
    .streak-region .region-secondary {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        font-size: 9.5px;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .location-region .region-secondary::before,
    .streak-region .region-secondary::before {
        content: '·';
        margin-right: clamp(7px, .65vw, 10px);
        color: color-mix(in srgb, var(--muted) 72%, transparent);
    }

    .streak-region .streak-value span {
        color: var(--muted);
        font-size: 9.5px;
        font-weight: 400;
        letter-spacing: 0;
    }

    .experience-region {
        grid-column: 2;
        grid-row: 3;
        border-right: var(--minor-stroke) solid var(--sheet-line);
    }

    .education-region {
        grid-column: 3;
        grid-row: 3;
    }

    .region-primary {
        margin-top: 7px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 550;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }

    .region-secondary,
    .region-meta {
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: var(--type-meta);
        line-height: 1.4;
    }

    .region-secondary {
        margin-top: 5px;
    }

    .region-meta {
        margin-top: 4px;
    }

    .experience-list {
        display: grid;
        gap: 5px;
    }

    .experience-row {
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        color: var(--text-body);
        font-family: var(--font-sans);
        font-size: var(--type-meta);
        line-height: 1.3;
    }

    .experience-row span:first-child {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .experience-row span:last-child {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 8px;
        white-space: nowrap;
    }

    .streak-value {
        margin-top: 6px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: var(--type-heading);
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.05em;
    }

    .streak-value span {
        color: var(--muted);
        font-size: var(--type-meta);
        font-weight: 400;
        letter-spacing: 0;
    }

    .nr-region {
        position: relative;
    }

    .nr-figure {
        position: absolute;
        inset: 0;
        min-width: 0;
        min-height: 0;
    }

    .nr-note {
        position: absolute;
        right: clamp(18px, 1.8vw, 30px);
        bottom: clamp(16px, 1.6vw, 26px);
        z-index: 3;
        margin: 0;
        color: color-mix(in srgb, var(--muted) 70%, transparent);
        font-family: var(--font-sans);
        font-size: var(--type-meta);
        font-style: italic;
        line-height: 1.35;
        transform: rotate(-3deg);
        pointer-events: none;
    }

    .nr-note span {
        display: inline-block;
        margin-right: 4px;
        font-size: var(--type-item);
    }

    .index-region {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .index-heading {
        padding: 13px 20px;
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
    }

    .index-heading h2 {
        margin: 3px 0 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: var(--type-heading);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.04em;
    }

    .index-heading > a {
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: var(--type-meta);
    }

    .index-heading > a:hover {
        color: var(--text);
    }

    .index-list {
        min-height: 0;
        display: grid;
        grid-template-rows: repeat(3, minmax(0, 1fr));
    }

    .index-item {
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-columns: 32px minmax(0, 1fr) 20px;
        align-items: center;
        gap: 12px;
        padding: 10px 20px;
        border-bottom: var(--minor-stroke) solid var(--sheet-line);
        background: transparent;
        transition: background 140ms ease;
    }

    .index-item:last-child {
        border-bottom: 0;
    }

    .index-item:hover {
        background: color-mix(in srgb, var(--surface) 42%, transparent);
    }

    .index-copy {
        min-width: 0;
        display: grid;
        gap: 4px;
    }

    .index-copy strong {
        min-width: 0;
        overflow: hidden;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: var(--type-item);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.025em;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .index-copy > span {
        overflow: hidden;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: var(--type-meta);
        line-height: 1.3;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .index-arrow {
        justify-self: end;
        display: grid;
        place-items: center;
        color: var(--muted);
        transition: color 140ms ease, transform 140ms ease;
    }

    .index-item:hover .index-arrow {
        color: var(--text);
        transform: translate(2px, -2px);
    }

    @media (min-width: 1100px) and (min-height: 760px) {
        :global(html),
        :global(body) {
            height: 100%;
            overflow: hidden;
        }

        .home-redesign {
            height: 100dvh;
            min-height: 0;
            display: grid;
            grid-template-rows: 52px minmax(0, 1fr);
            overflow: hidden;
        }

        .portfolio-board {
            grid-template-rows: minmax(0, 1.618034fr) minmax(0, 1fr);
        }

        .top-layout,
        .bottom-layout,
        .identity-board,
        .nr-region,
        .index-region {
            height: 100%;
        }
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .home-redesign {
            --type-heading: 20px;
            --type-item: 14px;
            width: min(1920px, calc(100vw - 24px));
        }

        .identity-board {
            grid-template-columns:
                minmax(218px, var(--phi-small))
                minmax(0, var(--phi-mid))
                minmax(0, var(--phi-side));
        }

        .contribution-region,
        .compact-region,
        .index-heading,
        .index-item {
            padding-top: 9px;
            padding-bottom: 9px;
        }

        .location-region,
        .streak-region {
            padding-top: 0;
            padding-bottom: 0;
        }
    }

    @media (max-width: 1099px), (max-height: 759px) {
        .home-redesign {
            width: min(100%, calc(100vw - 24px));
            min-height: 100vh;
        }

        .portfolio-board {
            grid-template-rows: auto auto;
            border-top: var(--minor-stroke) solid var(--sheet-line);
        }

        .top-layout,
        .bottom-layout {
            grid-template-columns: 1fr;
        }

        .top-layout {
            border-bottom: var(--major-stroke) solid var(--border);
        }

        .identity-board,
        .projects-region {
            border-right: 0;
        }

        .nr-region {
            min-height: 460px;
            border-top: var(--major-stroke) solid var(--border);
        }

        .identity-board {
            min-height: 620px;
        }

        .index-region {
            min-height: 320px;
        }

        .blog-region {
            border-top: var(--minor-stroke) solid var(--sheet-line);
        }
    }

    @media (max-width: 720px) {
        .home-redesign {
            width: 100%;
            --major-stroke: 1px;
        }

        .portfolio-board {
            border-inline: 0;
        }

        .identity-board {
            display: grid;
            min-height: auto;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto auto auto;
        }

        .contribution-region {
            grid-column: 1 / 3;
            grid-row: 2;
            min-height: 180px;
        }

        .location-region {
            grid-column: 1;
            grid-row: 3;
        }

        .streak-region {
            grid-column: 2;
            grid-row: 3;
        }

        .location-region,
        .streak-region {
            min-height: 110px;
            padding: 14px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
        }

        .location-region .region-primary,
        .streak-region .streak-value {
            margin-top: 6px;
            font-size: 13px;
        }

        .location-region .region-secondary,
        .streak-region .region-secondary {
            margin-top: 4px;
            overflow: visible;
            font-size: var(--type-meta);
            white-space: normal;
            text-overflow: clip;
        }

        .location-region .region-secondary::before,
        .streak-region .region-secondary::before {
            content: none;
        }

        .experience-region {
            grid-column: 1;
            grid-row: 4;
        }

        .education-region {
            grid-column: 2;
            grid-row: 4;
        }

        .nr-region {
            min-height: 360px;
        }
    }
</style>
