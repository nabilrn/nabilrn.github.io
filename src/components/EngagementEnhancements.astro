<div class="portfolio-share-backdrop" data-portfolio-share-dialog hidden>
    <section
        class="portfolio-share-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="portfolio-share-title"
        tabindex="-1"
    >
        <header class="portfolio-share-header">
            <div>
                <span class="portfolio-share-eyebrow">Share</span>
                <h2 id="portfolio-share-title" data-portfolio-share-title>Share this post</h2>
            </div>
            <button type="button" class="portfolio-share-close" aria-label="Close share dialog" data-portfolio-share-close>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </header>

        <div class="portfolio-share-platforms" aria-label="Share options">
            <a class="portfolio-share-platform whatsapp" href="#" target="_blank" rel="noopener noreferrer" data-portfolio-share-platform="whatsapp">
                <span class="portfolio-share-platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12.04 2a9.75 9.75 0 0 0-8.31 14.85L2.4 21.7l4.96-1.3A9.78 9.78 0 1 0 12.04 2Zm0 17.78a8 8 0 0 1-4.08-1.12l-.29-.17-2.94.77.79-2.87-.19-.3a8.02 8.02 0 1 1 6.71 3.69Zm4.4-5.99c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19a7.23 7.23 0 0 1-1.33-1.65c-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.58 1.63-1.15.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" /></svg></span>
                <span>WhatsApp</span>
            </a>
            <a class="portfolio-share-platform x-platform" href="#" target="_blank" rel="noopener noreferrer" data-portfolio-share-platform="x">
                <span class="portfolio-share-platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.37l7.25-8.29L2.98 2h6.4l4.42 5.84L18.9 2Zm-1.09 17.84h1.72L8.44 4.05H6.6l11.21 15.79Z" /></svg></span>
                <span>X</span>
            </a>
            <a class="portfolio-share-platform linkedin" href="#" target="_blank" rel="noopener noreferrer" data-portfolio-share-platform="linkedin">
                <span class="portfolio-share-platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5.34 3.5A1.84 1.84 0 1 1 5.33 7.2a1.84 1.84 0 0 1 .01-3.69ZM3.75 8.65h3.18V20H3.75V8.65Zm5.16 0h3.05v1.55H12c.43-.81 1.49-1.88 3.55-1.88 3.8 0 4.5 2.5 4.5 5.76V20h-3.18v-5.25c0-1.25-.02-2.87-1.75-2.87-1.75 0-2.02 1.37-2.02 2.78V20H8.91V8.65Z" /></svg></span>
                <span>LinkedIn</span>
            </a>
            <a class="portfolio-share-platform facebook" href="#" target="_blank" rel="noopener noreferrer" data-portfolio-share-platform="facebook">
                <span class="portfolio-share-platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13.7 22v-8.7h2.92l.44-3.39H13.7V7.75c0-.98.27-1.65 1.68-1.65h1.8V3.07c-.31-.04-1.38-.13-2.62-.13-2.59 0-4.36 1.58-4.36 4.49v2.5H7.27v3.39h2.93V22h3.5Z" /></svg></span>
                <span>Facebook</span>
            </a>
            <a class="portfolio-share-platform telegram" href="#" target="_blank" rel="noopener noreferrer" data-portfolio-share-platform="telegram">
                <span class="portfolio-share-platform-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m21.56 3.27-3.07 14.46c-.23 1.02-.83 1.27-1.68.79l-4.67-3.44-2.25 2.17c-.25.25-.46.46-.94.46l.33-4.75 8.65-7.82c.38-.34-.08-.53-.58-.19L6.66 11.68 2.05 10.2c-1-.31-1.02-1 .21-1.48l18.01-6.94c.84-.3 1.57.2 1.29 1.49Z" /></svg></span>
                <span>Telegram</span>
            </a>
        </div>

        <div class="portfolio-share-copy-row">
            <input type="text" readonly value="" aria-label="Post link" data-portfolio-share-url />
            <button type="button" data-portfolio-share-copy>Copy</button>
        </div>
    </section>
</div>

<div class="portfolio-engagement-toast" role="status" aria-live="polite" data-portfolio-engagement-toast></div>

<script>
    type MetricsState = {
        views?: number;
        likes?: number;
        shares?: number;
        liked?: boolean;
    };

    type EngagementContext = {
        postId: string;
        apiBase: string;
        title: string;
        url: string;
        likeButton: HTMLButtonElement | null;
        likeCount: HTMLElement | null;
        shareButton: HTMLButtonElement | null;
        shareCount: HTMLElement | null;
        viewsCount: HTMLElement | null;
    };

    const compact = new Intl.NumberFormat('en-US', {
        notation: 'compact',
        maximumFractionDigits: 1,
    });
    const visitorKey = 'portfolio:visitor-id';
    const desiredLikes = new Map<string, boolean>();
    const syncingLikes = new Set<string>();
    const likeRetryTimers = new Map<string, number>();
    let activeShare: EngagementContext | null = null;
    let previousBodyOverflow = '';
    let toastTimer = 0;
    let copyResetTimer = 0;

    const normalizeApiBase = (value?: string) => value?.trim().replace(/\/+$/, '') ?? '';
    const likedKey = (postId: string) => `portfolio:liked:${postId}`;
    const pendingLikeKey = (postId: string) => `portfolio:like-pending:${postId}`;
    const localLikesKey = (postId: string) => `portfolio:likes:${postId}`;
    const localSharesKey = (postId: string) => `portfolio:shares:${postId}`;

    const getVisitorId = () => {
        const existing = localStorage.getItem(visitorKey);
        if (existing) return existing;
        const id = crypto.randomUUID();
        localStorage.setItem(visitorKey, id);
        return id;
    };

    const countFrom = (node: Element | null) => {
        const raw = node?.textContent?.trim() ?? '0';
        const numeric = Number(raw.replace(/[^0-9.-]/g, ''));
        return Number.isFinite(numeric) ? Math.max(0, numeric) : 0;
    };

    const setCount = (node: Element | null, value: unknown) => {
        if (!(node instanceof HTMLElement)) return;
        node.textContent = compact.format(Math.max(0, Number(value) || 0));
    };

    const requestState = async (apiBase: string, postId: string): Promise<MetricsState | null> => {
        if (!apiBase) return null;
        try {
            const response = await fetch(
                `${apiBase}/metrics/${encodeURIComponent(postId)}?visitorId=${encodeURIComponent(getVisitorId())}`,
                { headers: { Accept: 'application/json' }, cache: 'no-store' },
            );
            if (!response.ok) return null;
            return await response.json() as MetricsState;
        } catch {
            return null;
        }
    };

    const postAction = async (
        apiBase: string,
        postId: string,
        body: Record<string, unknown>,
    ): Promise<MetricsState | null> => {
        if (!apiBase) return null;
        try {
            const response = await fetch(`${apiBase}/metrics/${encodeURIComponent(postId)}`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ ...body, visitorId: getVisitorId() }),
            });
            if (!response.ok) return null;
            return await response.json() as MetricsState;
        } catch {
            return null;
        }
    };

    const renderLiked = (button: HTMLButtonElement | null, liked: boolean, animate = false) => {
        if (!button) return;
        button.classList.toggle('liked', liked);
        button.classList.toggle('is-liked', liked);
        button.setAttribute('aria-pressed', String(liked));
        if (!animate || !liked || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        button.classList.remove('bursting');
        void button.offsetWidth;
        button.classList.add('bursting');
        window.setTimeout(() => button.classList.remove('bursting'), 480);
    };

    const allContextsForPost = (postId: string) => {
        const contexts: EngagementContext[] = [];
        document.querySelectorAll<HTMLElement>(`.engage[data-post-id="${CSS.escape(postId)}"]`).forEach((root) => {
            const context = contextFromEngagementRoot(root);
            if (context) contexts.push(context);
        });
        document.querySelectorAll<HTMLElement>(`.tweet-post[data-blog-post-id="${CSS.escape(postId)}"]`).forEach((post) => {
            const context = contextFromHomePost(post);
            if (context) contexts.push(context);
        });
        return contexts;
    };

    const applyState = (context: EngagementContext, state: MetricsState, includeLike = true) => {
        setCount(context.viewsCount, state.views);
        if (includeLike) setCount(context.likeCount, state.likes);
        setCount(context.shareCount, state.shares);
        if (includeLike && typeof state.liked === 'boolean') {
            localStorage.setItem(likedKey(context.postId), state.liked ? '1' : '0');
            desiredLikes.set(context.postId, state.liked);
            renderLiked(context.likeButton, state.liked, false);
        }
    };

    const applyStateEverywhere = (postId: string, state: MetricsState, includeLike = true) => {
        for (const context of allContextsForPost(postId)) applyState(context, state, includeLike);
    };

    function contextFromEngagementRoot(root: HTMLElement): EngagementContext | null {
        const postId = root.dataset.postId?.trim();
        if (!postId) return null;
        const link = root.closest('.feed-post')?.querySelector<HTMLAnchorElement>('.post-content-link[href]');
        const url = link
            ? new URL(link.getAttribute('href') || '/', location.origin).toString()
            : location.href;
        return {
            postId,
            apiBase: normalizeApiBase(root.dataset.apiBase),
            title: root.dataset.title || document.title,
            url,
            likeButton: root.querySelector<HTMLButtonElement>('[data-like-btn]'),
            likeCount: root.querySelector<HTMLElement>('[data-likes]'),
            shareButton: root.querySelector<HTMLButtonElement>('[data-share-trigger]'),
            shareCount: root.querySelector<HTMLElement>('[data-shares]'),
            viewsCount: root.querySelector<HTMLElement>('[data-views]'),
        };
    }

    function contextFromHomePost(post: HTMLElement): EngagementContext | null {
        const postId = post.dataset.blogPostId?.trim();
        const region = post.closest<HTMLElement>('.latest-blog-region[data-blog-metrics-api]');
        const link = post.querySelector<HTMLAnchorElement>('.tweet-copy[href]');
        if (!postId || !link) return null;
        const likeButton = post.querySelector<HTMLButtonElement>('[data-home-like]');
        const shareButton = post.querySelector<HTMLButtonElement>('[data-home-share]');
        return {
            postId,
            apiBase: normalizeApiBase(post.dataset.engagementApi || region?.dataset.blogMetricsApi),
            title: post.dataset.engagementTitle || link.querySelector('strong')?.textContent?.trim() || document.title,
            url: post.dataset.engagementUrl || new URL(link.getAttribute('href') || '/', location.origin).toString(),
            likeButton,
            likeCount: post.querySelector<HTMLElement>('[data-blog-likes]'),
            shareButton,
            shareCount: post.querySelector<HTMLElement>('[data-home-shares]'),
            viewsCount: post.querySelector<HTMLElement>('[data-blog-views]'),
        };
    }

    const makeHomeLikeButton = (metric: HTMLElement, postId: string) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'tweet-metric tweet-action tweet-like-action';
        button.dataset.homeLike = postId;
        button.setAttribute('aria-label', 'Like post');
        button.setAttribute('aria-pressed', 'false');
        const icon = metric.querySelector('svg')?.outerHTML ?? '';
        const count = metric.querySelector<HTMLElement>('[data-blog-likes]')?.textContent ?? '0';
        button.innerHTML = `<span class="heart-shell" aria-hidden="true">${icon}</span><span data-blog-likes>${count}</span>`;
        metric.replaceWith(button);
        return button;
    };

    const makeHomeShareButton = (postId: string) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'tweet-metric tweet-action tweet-share-action';
        button.dataset.homeShare = postId;
        button.setAttribute('aria-label', 'Share post');
        button.setAttribute('aria-haspopup', 'dialog');
        button.setAttribute('aria-expanded', 'false');
        button.title = 'Share post';
        button.innerHTML = `
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <path d="M8.59 13.51l6.83 3.98"></path>
                <path d="M15.42 6.51L8.59 10.49"></path>
            </svg>
            <span data-home-shares>0</span>
        `;
        return button;
    };

    const initializeHomePost = (post: HTMLElement) => {
        if (post.dataset.homeEngagementReady === 'true') return;
        const postId = post.dataset.blogPostId?.trim();
        const engagement = post.querySelector<HTMLElement>('.tweet-engagement');
        const link = post.querySelector<HTMLAnchorElement>('.tweet-copy[href]');
        const region = post.closest<HTMLElement>('.latest-blog-region[data-blog-metrics-api]');
        if (!postId || !engagement || !link) return;

        post.dataset.homeEngagementReady = 'true';
        post.dataset.engagementTitle = link.querySelector('strong')?.textContent?.trim() || document.title;
        post.dataset.engagementUrl = new URL(link.getAttribute('href') || '/', location.origin).toString();
        post.dataset.engagementApi = normalizeApiBase(region?.dataset.blogMetricsApi);

        const existingLikeMetric = Array.from(engagement.querySelectorAll<HTMLElement>('.tweet-metric'))
            .find((metric) => metric.querySelector('[data-blog-likes]'));
        const likeButton = existingLikeMetric instanceof HTMLButtonElement
            ? existingLikeMetric
            : existingLikeMetric
                ? makeHomeLikeButton(existingLikeMetric, postId)
                : null;

        let shareButton = engagement.querySelector<HTMLButtonElement>('[data-home-share]');
        if (!shareButton) {
            shareButton = makeHomeShareButton(postId);
            engagement.appendChild(shareButton);
        }

        const liked = localStorage.getItem(likedKey(postId)) === '1';
        desiredLikes.set(postId, liked);
        renderLiked(likeButton, liked, false);

        const context = contextFromHomePost(post);
        if (!context) return;
        void hydrateContext(context);
    };

    const hydrateContext = async (context: EngagementContext) => {
        const liked = localStorage.getItem(likedKey(context.postId)) === '1';
        desiredLikes.set(context.postId, liked);
        renderLiked(context.likeButton, liked, false);

        if (!context.apiBase) {
            setCount(context.likeCount, localStorage.getItem(localLikesKey(context.postId)) ?? context.likeCount?.textContent ?? 0);
            setCount(context.shareCount, localStorage.getItem(localSharesKey(context.postId)) ?? context.shareCount?.textContent ?? 0);
            return;
        }

        const state = await requestState(context.apiBase, context.postId);
        if (!state) return;
        const hasPendingLike = localStorage.getItem(pendingLikeKey(context.postId)) === '1';
        applyState(context, state, !hasPendingLike);
        if (hasPendingLike) {
            const desired = desiredLikes.get(context.postId) ?? liked;
            const serverLiked = Boolean(state.liked);
            setCount(context.likeCount, Number(state.likes ?? 0) + (desired === serverLiked ? 0 : desired ? 1 : -1));
            void syncLike(context);
        }
    };

    const syncLike = async (context: EngagementContext) => {
        const { postId, apiBase } = context;
        if (!apiBase || syncingLikes.has(postId) || localStorage.getItem(pendingLikeKey(postId)) !== '1') return;
        syncingLikes.add(postId);
        const retry = likeRetryTimers.get(postId);
        if (retry) window.clearTimeout(retry);

        try {
            while (localStorage.getItem(pendingLikeKey(postId)) === '1') {
                const target = desiredLikes.get(postId) ?? false;
                const state = await postAction(apiBase, postId, { action: 'like', liked: target });
                if (!state) throw new Error('like-sync-failed');
                if ((desiredLikes.get(postId) ?? false) !== target) continue;

                localStorage.removeItem(pendingLikeKey(postId));
                const serverLiked = typeof state.liked === 'boolean' ? state.liked : target;
                desiredLikes.set(postId, serverLiked);
                localStorage.setItem(likedKey(postId), serverLiked ? '1' : '0');
                applyStateEverywhere(postId, state, true);
            }
        } catch {
            likeRetryTimers.set(postId, window.setTimeout(() => void syncLike(context), 4000));
        } finally {
            syncingLikes.delete(postId);
        }
    };

    const optimisticLike = (context: EngagementContext) => {
        const currentLiked = context.likeButton?.getAttribute('aria-pressed') === 'true';
        const nextLiked = !currentLiked;
        desiredLikes.set(context.postId, nextLiked);
        localStorage.setItem(likedKey(context.postId), nextLiked ? '1' : '0');
        localStorage.setItem(pendingLikeKey(context.postId), '1');

        for (const surface of allContextsForPost(context.postId)) {
            setCount(surface.likeCount, countFrom(surface.likeCount) + (nextLiked ? 1 : -1));
            renderLiked(surface.likeButton, nextLiked, nextLiked);
        }

        if (context.apiBase) {
            void syncLike(context);
            return;
        }

        localStorage.removeItem(pendingLikeKey(context.postId));
        localStorage.setItem(localLikesKey(context.postId), String(countFrom(context.likeCount)));
    };

    const dialogElements = () => {
        const backdrop = document.querySelector<HTMLElement>('[data-portfolio-share-dialog]');
        return {
            backdrop,
            panel: backdrop?.querySelector<HTMLElement>('.portfolio-share-dialog') ?? null,
            title: backdrop?.querySelector<HTMLElement>('[data-portfolio-share-title]') ?? null,
            urlInput: backdrop?.querySelector<HTMLInputElement>('[data-portfolio-share-url]') ?? null,
            copyButton: backdrop?.querySelector<HTMLButtonElement>('[data-portfolio-share-copy]') ?? null,
            closeButton: backdrop?.querySelector<HTMLButtonElement>('[data-portfolio-share-close]') ?? null,
            platforms: Array.from(backdrop?.querySelectorAll<HTMLAnchorElement>('[data-portfolio-share-platform]') ?? []),
        };
    };

    const configureShareDialog = (context: EngagementContext) => {
        const { title, url } = context;
        const elements = dialogElements();
        if (elements.title) elements.title.textContent = title;
        if (elements.urlInput) elements.urlInput.value = url;
        for (const option of elements.platforms) {
            const platform = option.dataset.portfolioSharePlatform;
            if (platform === 'whatsapp') option.href = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
            if (platform === 'x') option.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
            if (platform === 'linkedin') option.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
            if (platform === 'facebook') option.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
            if (platform === 'telegram') option.href = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
        }
    };

    const openShareDialog = (context: EngagementContext) => {
        const { backdrop, panel, platforms } = dialogElements();
        if (!backdrop) return;
        activeShare = context;
        configureShareDialog(context);
        backdrop.hidden = false;
        context.shareButton?.setAttribute('aria-expanded', 'true');
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        window.requestAnimationFrame(() => {
            const first = platforms[0];
            if (first) first.focus();
            else panel?.focus();
        });
    };

    const closeShareDialog = (restoreFocus = true) => {
        const { backdrop } = dialogElements();
        if (!backdrop) return;
        backdrop.hidden = true;
        document.body.style.overflow = previousBodyOverflow;
        const trigger = activeShare?.shareButton;
        trigger?.setAttribute('aria-expanded', 'false');
        if (restoreFocus) trigger?.focus();
        activeShare = null;
    };

    const showToast = (message: string) => {
        const toast = document.querySelector<HTMLElement>('[data-portfolio-engagement-toast]');
        if (!toast) return;
        window.clearTimeout(toastTimer);
        toast.textContent = message;
        toast.classList.add('visible');
        toastTimer = window.setTimeout(() => toast.classList.remove('visible'), 1800);
    };

    const copyText = async (value: string) => {
        try {
            await navigator.clipboard.writeText(value);
            return true;
        } catch {
            const textarea = document.createElement('textarea');
            textarea.value = value;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            const copied = document.execCommand('copy');
            textarea.remove();
            return copied;
        }
    };

    const recordShare = (context: EngagementContext) => {
        for (const surface of allContextsForPost(context.postId)) {
            setCount(surface.shareCount, countFrom(surface.shareCount) + 1);
        }

        if (!context.apiBase) {
            localStorage.setItem(localSharesKey(context.postId), String(countFrom(context.shareCount)));
            return;
        }

        void postAction(context.apiBase, context.postId, { action: 'share' }).then((state) => {
            if (state) applyStateEverywhere(context.postId, state, false);
        });
    };

    const contextFromTarget = (target: Element, type: 'like' | 'share'): EngagementContext | null => {
        const engageRoot = target.closest<HTMLElement>('.engage[data-post-id]');
        if (engageRoot) return contextFromEngagementRoot(engageRoot);
        const homePost = target.closest<HTMLElement>('.tweet-post[data-blog-post-id]');
        if (homePost) return contextFromHomePost(homePost);
        return null;
    };

    const handleDocumentClick = (event: MouseEvent) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const likeButton = target.closest<HTMLButtonElement>('[data-like-btn], [data-home-like]');
        if (likeButton) {
            const context = contextFromTarget(likeButton, 'like');
            if (!context) return;
            event.preventDefault();
            event.stopPropagation();
            optimisticLike(context);
            return;
        }

        const shareButton = target.closest<HTMLButtonElement>('[data-share-trigger], [data-home-share]');
        if (shareButton) {
            const context = contextFromTarget(shareButton, 'share');
            if (!context) return;
            event.preventDefault();
            event.stopPropagation();
            openShareDialog(context);
            return;
        }

        const closeButton = target.closest<HTMLButtonElement>('[data-portfolio-share-close]');
        if (closeButton) {
            event.preventDefault();
            closeShareDialog(true);
            return;
        }

        const copyButton = target.closest<HTMLButtonElement>('[data-portfolio-share-copy]');
        if (copyButton && activeShare) {
            event.preventDefault();
            const context = activeShare;
            void (async () => {
                const copied = await copyText(context.url);
                if (!copied) return;
                recordShare(context);
                showToast('Link copied');
                window.clearTimeout(copyResetTimer);
                copyButton.textContent = 'Copied';
                copyResetTimer = window.setTimeout(() => { copyButton.textContent = 'Copy'; }, 1500);
            })();
            return;
        }

        const platform = target.closest<HTMLAnchorElement>('[data-portfolio-share-platform]');
        if (platform && activeShare) {
            const context = activeShare;
            recordShare(context);
            closeShareDialog(false);
        }
    };

    const handleDialogBackdrop = (event: MouseEvent) => {
        const target = event.target;
        if (target instanceof HTMLElement && target.matches('[data-portfolio-share-dialog]')) closeShareDialog(true);
    };

    const handleKeydown = (event: KeyboardEvent) => {
        const { backdrop } = dialogElements();
        if (!backdrop || backdrop.hidden) return;
        if (event.key === 'Escape') {
            event.preventDefault();
            closeShareDialog(true);
            return;
        }
        if (event.key !== 'Tab') return;
        const focusable = Array.from(backdrop.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled])'))
            .filter((node) => !node.hasAttribute('hidden'));
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first?.focus();
        }
    };

    const initialize = () => {
        document.querySelectorAll<HTMLElement>('.tweet-post[data-blog-post-id]').forEach(initializeHomePost);
        document.querySelectorAll<HTMLElement>('.engage[data-post-id]').forEach((root) => {
            const context = contextFromEngagementRoot(root);
            if (context) void hydrateContext(context);
        });

        const { backdrop } = dialogElements();
        if (backdrop && backdrop.dataset.portfolioBackdropBound !== 'true') {
            backdrop.dataset.portfolioBackdropBound = 'true';
            backdrop.addEventListener('click', handleDialogBackdrop);
        }
    };

    if (!window.__portfolioEngagementControllerBound) {
        window.__portfolioEngagementControllerBound = true;
        document.addEventListener('click', handleDocumentClick, { capture: true });
        document.addEventListener('keydown', handleKeydown);
        window.addEventListener('online', () => {
            document.querySelectorAll<HTMLElement>('.engage[data-post-id], .tweet-post[data-blog-post-id]').forEach((surface) => {
                const context = surface.matches('.engage')
                    ? contextFromEngagementRoot(surface)
                    : contextFromHomePost(surface);
                if (context) void syncLike(context);
            });
        });
        document.addEventListener('astro:page-load', initialize);
    }

    initialize();
</script>

