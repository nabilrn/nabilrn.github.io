---
import HomeHeader from './home/HomeHeader.astro';
import {
    localizePath,
    normalizeLocale,
    stripLocaleFromPath,
    type SiteLocale,
} from '../data/siteContent';

interface Props {
    currentPath?: string;
    locale?: SiteLocale;
    alternatePaths?: Partial<Record<SiteLocale, string>>;
}

const currentPath = Astro.props.currentPath ?? Astro.url.pathname;
const locale = normalizeLocale(Astro.props.locale);
const alternatePaths = Astro.props.alternatePaths;
const unlocalizedPath = stripLocaleFromPath(currentPath || '/');
const normalizedPath = unlocalizedPath.endsWith('/') ? unlocalizedPath : `${unlocalizedPath}/`;
const isHomePage = normalizedPath === '/';
const isBlogPage = normalizedPath.startsWith('/blog/');
const languageTargets = {
    en: alternatePaths?.en ?? localizePath(unlocalizedPath, 'en'),
    id: alternatePaths?.id ?? localizePath(unlocalizedPath, 'id'),
};
---

<div
    class="full-shell"
    data-site-shell
    data-section={isBlogPage ? 'blog' : isHomePage ? 'overview' : 'none'}
    data-lang-en={languageTargets.en}
    data-lang-id={languageTargets.id}
>
    {!isHomePage && (
        <div class:list={['content-header', { 'is-blog': isBlogPage }]}>
            <HomeHeader locale={locale} />
        </div>
    )}

    <main class="full-main">
        <slot />
    </main>
</div>

<style>
    .full-shell {
        width: min(1920px, calc(100vw - 32px));
        min-height: 100vh;
        margin: 0 auto;
        --content-gutter: 0px;
        --sheet-line: color-mix(in srgb, var(--border) 72%, var(--bg));
    }

    .full-main {
        width: 100%;
        min-height: calc(100vh - 52px);
        margin: 0;
        padding: 0 0 72px;
    }

    .content-header :global(.home-nav-link.is-active) {
        color: var(--muted);
    }

    .content-header.is-blog :global(.home-nav-link[href$='/blog/']) {
        color: var(--text);
    }

    @media (max-width: 760px) {
        .full-shell {
            width: 100%;
        }

        .full-main {
            min-height: calc(100vh - 48px);
            padding-bottom: 56px;
        }
    }
</style>

<script is:inline>
    (() => {
        const root = document.querySelector('[data-site-shell]');
        if (!(root instanceof HTMLElement)) return;

        const section = root.dataset.section || 'none';
        const navLinks = root.querySelectorAll('.home-nav-link');
        navLinks.forEach((link) => link.removeAttribute('aria-current'));

        if (section === 'blog') {
            const blogLink = Array.from(navLinks).find((link) => link.getAttribute('href')?.endsWith('/blog/'));
            blogLink?.setAttribute('aria-current', 'page');
        }

        root.querySelectorAll('.home-language-option').forEach((link) => {
            if (!(link instanceof HTMLAnchorElement)) return;
            const code = link.querySelector('span')?.textContent?.trim().toLowerCase();
            if (code === 'en' && root.dataset.langEn) link.href = root.dataset.langEn;
            if (code === 'id' && root.dataset.langId) link.href = root.dataset.langId;
        });
    })();
</script>
