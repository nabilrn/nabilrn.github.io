---
import { getCollection } from 'astro:content';
import ThemeToggle from './ThemeToggle.astro';
import {
    getSiteContent,
    localeMeta,
    localizePath,
    normalizeLocale,
    stripLocaleFromPath,
    supportedLocales,
    type SiteLocale,
} from '../data/siteContent';
import { getBlogLocaleInfo } from '../utils/blogLocale';

interface Props {
    currentPath?: string;
    locale?: SiteLocale;
    alternatePaths?: Partial<Record<SiteLocale, string>>;
}

const blogPosts = await getCollection('blog', ({ data }) => !data.draft);
const postCount = new Set(blogPosts.map((post) => getBlogLocaleInfo(post).translationKey)).size;
const currentPath = Astro.props.currentPath ?? Astro.url.pathname;
const alternatePaths = Astro.props.alternatePaths;
const locale = normalizeLocale(Astro.props.locale);
const content = getSiteContent(locale);
const unlocalizedPath = stripLocaleFromPath(currentPath || '/');
const normalizedPath = unlocalizedPath.endsWith('/') ? unlocalizedPath : `${unlocalizedPath}/`;
const isHomePage = normalizedPath === '/';
const isBlogPage = normalizedPath.startsWith('/blog/');
const homePath = localizePath('/', locale);
const blogPath = localizePath('/blog/', locale);
const localeFlags: Record<'en' | 'id', string> = {
    en: 'EN',
    id: 'ID',
};
const languageLinks = supportedLocales.map((item) => ({
    locale: item,
    label: localeMeta[item].label,
    flag: localeFlags[item],
    href: alternatePaths?.[item] ?? localizePath(unlocalizedPath, item),
    active: item === locale,
}));
const activeLink = languageLinks.find((item) => item.active) ?? languageLinks[0];
---

<div class="full-shell">
    <header class="full-header">
        <div class="full-header-inner">
            <a href={homePath} class="brand" aria-label={`${content.nav.home} — Nabil Rizki Navisa`}>
                <span class="brand-index" aria-hidden="true">00</span>
                <span class="brand-user">nabil@nabilrn</span><span class="brand-path">:~</span>
            </a>

            <nav class="page-nav" aria-label={content.nav.ariaPageNavigation}>
                <a href={homePath} class={isHomePage ? 'page-nav-item active' : 'page-nav-item'} aria-current={isHomePage ? 'page' : undefined}>
                    <span class="nav-index">01</span>
                    <span>{content.nav.overview}</span>
                </a>
                <a href={blogPath} class={isBlogPage ? 'page-nav-item active' : 'page-nav-item'} aria-current={isBlogPage ? 'page' : undefined}>
                    <span class="nav-index">02</span>
                    <span>{content.nav.blog}</span>
                    <span class="page-nav-badge">[{String(postCount).padStart(2, '0')}]</span>
                </a>
            </nav>

            <div class="header-actions">
                <div class="language-dropdown" id="lang-dropdown">
                    <button type="button" class="lang-trigger" id="lang-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label={content.nav.ariaLanguageNavigation}>
                        <span class="lang-flag">{activeLink.flag}</span>
                        <span class="lang-label">{activeLink.label}</span>
                        <span class="lang-chevron" aria-hidden="true">↓</span>
                    </button>
                    <ul class="lang-menu" id="lang-menu" role="listbox" aria-label={content.nav.ariaLanguageNavigation}>
                        {languageLinks.map((item, index) => (
                            <li role="option" aria-selected={item.active ? 'true' : 'false'}>
                                <a href={item.href} class={item.active ? 'lang-option active' : 'lang-option'}>
                                    <span class="lang-option-index">0{index + 1}</span>
                                    <span class="lang-flag">{item.flag}</span>
                                    <span>{item.label}</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
                <ThemeToggle locale={locale} />
            </div>
        </div>
    </header>

    <main class="full-main">
        <slot />
    </main>
</div>

<style>
    .full-shell {
        min-height: 100vh;
        --content-gutter: clamp(14px, 2.4vw, 28px);
        --shell-max: 1240px;
        --shell-line: color-mix(in srgb, var(--border) 78%, var(--bg));
    }

    .full-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: color-mix(in srgb, var(--bg) 94%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--shell-line);
    }

    .full-header-inner {
        width: min(var(--shell-max), calc(100% - 28px));
        min-height: 48px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(170px, 0.85fr) auto minmax(170px, 0.85fr);
        align-items: stretch;
        border-inline: 1px solid var(--shell-line);
    }

    .brand,
    .page-nav-item,
    .header-actions {
        min-height: 48px;
    }

    .brand {
        padding: 0 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        border-right: 1px solid var(--shell-line);
    }

    .brand-index,
    .nav-index,
    .lang-option-index {
        color: var(--muted);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.05em;
    }

    .brand-user { color: var(--text); }
    .brand-path { color: var(--muted); }

    .page-nav {
        display: flex;
        min-width: 0;
    }

    .page-nav-item {
        position: relative;
        padding: 0 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-right: 1px solid var(--shell-line);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        white-space: nowrap;
        transition: color 140ms ease, background 140ms ease;
    }

    .page-nav-item:first-child {
        border-left: 0;
    }

    .page-nav-item::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: transparent;
    }

    .page-nav-item:hover,
    .page-nav-item:focus-visible {
        color: var(--text);
        background: color-mix(in srgb, var(--surface) 72%, transparent);
    }

    .page-nav-item.active {
        color: var(--text);
    }

    .page-nav-item.active::after {
        background: var(--text);
    }

    .page-nav-badge {
        color: var(--muted);
        font-size: 9px;
        letter-spacing: 0;
    }

    .header-actions {
        min-width: 0;
        padding-left: 12px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .brand:focus-visible,
    .page-nav-item:focus-visible,
    .lang-trigger:focus-visible,
    .lang-option:focus-visible {
        outline: 1px solid var(--text);
        outline-offset: -3px;
    }

    .language-dropdown {
        position: relative;
    }

    .lang-trigger {
        min-height: 30px;
        padding: 0 9px;
        display: flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--shell-line);
        border-radius: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        cursor: pointer;
    }

    .lang-trigger:hover {
        border-color: var(--border-strong);
        background: var(--surface);
    }

    .lang-flag {
        color: var(--text);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .lang-label { color: var(--muted); }
    .lang-chevron { color: var(--muted); transition: transform 140ms ease; }
    .language-dropdown.open .lang-chevron { transform: rotate(180deg); }

    .lang-menu {
        display: none;
        position: absolute;
        top: calc(100% + 5px);
        right: 0;
        min-width: 174px;
        padding: 0;
        margin: 0;
        list-style: none;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 0;
        box-shadow: none;
        z-index: 50;
    }

    .language-dropdown.open .lang-menu {
        display: block;
    }

    .lang-menu li + li {
        border-top: 1px solid var(--shell-line);
    }

    .lang-option {
        min-height: 34px;
        padding: 0 9px;
        display: grid;
        grid-template-columns: 20px 22px 1fr;
        align-items: center;
        gap: 5px;
        border-radius: 0;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--muted);
        transition: background 120ms ease, color 120ms ease;
    }

    .lang-option:hover,
    .lang-option.active {
        background: var(--surface);
        color: var(--text);
    }

    .full-main {
        width: min(var(--shell-max), calc(100% - 28px));
        min-height: calc(100vh - 48px);
        margin: 0 auto;
        padding: 0 var(--content-gutter) 88px;
        border-inline: 1px solid var(--shell-line);
    }

    @media (max-width: 760px) {
        .full-header-inner {
            width: calc(100% - 16px);
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-rows: 44px 39px;
        }

        .brand,
        .header-actions {
            min-height: 44px;
        }

        .brand {
            grid-column: 1;
            grid-row: 1;
            border-right: 1px solid var(--shell-line);
        }

        .header-actions {
            grid-column: 2;
            grid-row: 1;
            padding: 0 7px;
        }

        .page-nav {
            grid-column: 1 / 3;
            grid-row: 2;
            border-top: 1px solid var(--shell-line);
        }

        .page-nav-item {
            min-height: 39px;
            padding-inline: 12px;
        }

        .full-main {
            width: calc(100% - 16px);
            min-height: calc(100vh - 83px);
            padding-inline: 12px;
            padding-bottom: 64px;
        }
    }

    @media (max-width: 480px) {
        .brand-index,
        .lang-label { display: none; }
        .brand { padding-inline: 10px; }
    }
</style>

<script is:inline>
    (() => {
        const dropdown = document.getElementById('lang-dropdown');
        const trigger = document.getElementById('lang-trigger');
        if (!(dropdown instanceof HTMLElement) || !(trigger instanceof HTMLButtonElement)) return;

        trigger.addEventListener('click', (event) => {
            event.stopPropagation();
            const isOpen = dropdown.classList.toggle('open');
            trigger.setAttribute('aria-expanded', String(isOpen));
        });

        document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !dropdown.contains(event.target)) {
                dropdown.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && dropdown.classList.contains('open')) {
                dropdown.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.focus();
            }
        });
    })();
</script>
