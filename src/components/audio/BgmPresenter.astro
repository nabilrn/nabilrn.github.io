---
import { BGM_TRACK } from '../../lib/bgm';

interface Props {
	variant?: 'home' | 'floating' | 'dock';
}

const { variant = 'home' } = Astro.props;
const bars = Array.from({ length: 48 }, (_, index) => index);
const playLabel = `Play ${BGM_TRACK.title} by ${BGM_TRACK.artist}`;
const pauseLabel = `Pause ${BGM_TRACK.title} by ${BGM_TRACK.artist}`;
---

<div class={`bgm-presenter ${variant}`} data-bgm-presenter data-bgm-variant={variant}>
	<button
		type="button"
		class="bgm-toggle"
		data-bgm-toggle
		data-play-label={playLabel}
		data-pause-label={pauseLabel}
		aria-label={playLabel}
		aria-pressed="false"
	>
		<span class="bgm-vinyl" aria-hidden="true">
			<span></span>
		</span>
	</button>

	<div class="bgm-wave" aria-hidden="true">
		{bars.map((bar) => <i data-bgm-bar data-index={bar}></i>)}
	</div>

	<time class="bgm-time" data-bgm-time>00:00 / 03:16</time>
</div>

<style>
	.bgm-presenter {
		--bgm-wave-width: 154px;
		--bgm-wave-height: 30px;
		--bgm-vinyl-size: 31px;
		--bgm-vinyl-disc: #171717;
		--bgm-vinyl-edge: rgb(255 255 255 / 16%);
		--bgm-vinyl-groove: rgb(255 255 255 / 10%);
		--bgm-vinyl-highlight: rgb(255 255 255 / 16%);
		--bgm-vinyl-label: #5b5b5b;
		--bgm-vinyl-label-mark: rgb(255 255 255 / 48%);
		--bgm-vinyl-spindle: #090909;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: max-content;
		max-width: 100%;
		color: color-mix(in srgb, var(--text) 72%, var(--muted));
		font-family: var(--font-mono);
		pointer-events: auto;
	}

	:global(html[data-theme='light']) .bgm-presenter {
		--bgm-vinyl-disc: #2b2b2b;
		--bgm-vinyl-edge: rgb(0 0 0 / 32%);
		--bgm-vinyl-groove: rgb(255 255 255 / 18%);
		--bgm-vinyl-highlight: rgb(255 255 255 / 34%);
		--bgm-vinyl-label: #b7b7b7;
		--bgm-vinyl-label-mark: rgb(38 38 38 / 72%);
		--bgm-vinyl-spindle: #252525;
	}

	.bgm-toggle {
		width: var(--bgm-vinyl-size);
		height: var(--bgm-vinyl-size);
		flex: none;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.bgm-toggle:focus-visible {
		outline: 1px solid color-mix(in srgb, var(--text) 48%, transparent);
		outline-offset: 3px;
	}

	.bgm-vinyl {
		position: relative;
		width: 100%;
		height: 100%;
		display: block;
		overflow: hidden;
		border-radius: 50%;
		background:
			radial-gradient(circle at 42% 34%, color-mix(in srgb, var(--bgm-vinyl-highlight) 24%, transparent) 0 9%, transparent 24%),
			var(--bgm-vinyl-disc);
		box-shadow:
			inset 0 0 0 1px var(--bgm-vinyl-edge),
			inset 0 0 6px rgb(255 255 255 / 5%),
			0 1px 2px rgb(0 0 0 / 26%);
		transform-origin: 50% 50%;
		will-change: transform;
	}

	.bgm-vinyl::before {
		content: '';
		position: absolute;
		inset: 3px;
		border-radius: 50%;
		background:
			radial-gradient(circle at 50% 50%,
				transparent 0 30%,
				var(--bgm-vinyl-groove) 31% 32%,
				transparent 33% 49%,
				var(--bgm-vinyl-groove) 50% 51%,
				transparent 52% 69%,
				var(--bgm-vinyl-groove) 70% 71%,
				transparent 72% 100%);
		opacity: .92;
		pointer-events: none;
	}

	.bgm-vinyl::after {
		content: '';
		position: absolute;
		inset: 1px;
		border-radius: 50%;
		background: conic-gradient(
			from -38deg,
			transparent 0 10%,
			var(--bgm-vinyl-highlight) 14% 17%,
			transparent 21% 58%,
			color-mix(in srgb, var(--bgm-vinyl-highlight) 56%, transparent) 62% 64%,
			transparent 68% 100%
		);
		pointer-events: none;
	}

	.bgm-vinyl > span {
		position: absolute;
		inset: 34%;
		z-index: 2;
		display: block;
		border-radius: 50%;
		background: var(--bgm-vinyl-label);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--bgm-vinyl-edge) 82%, transparent),
			inset 0 0 0 1px rgb(255 255 255 / 8%);
	}

	.bgm-vinyl > span::before {
		content: '';
		position: absolute;
		width: 26%;
		height: 1px;
		left: 57%;
		top: 31%;
		border-radius: 999px;
		background: var(--bgm-vinyl-label-mark);
		box-shadow: 0 3px 0 color-mix(in srgb, var(--bgm-vinyl-label-mark) 62%, transparent);
		transform: rotate(-24deg);
		transform-origin: center;
	}

	.bgm-vinyl > span::after {
		content: '';
		position: absolute;
		inset: 39%;
		border-radius: 50%;
		background: var(--bgm-vinyl-spindle);
		box-shadow: 0 0 0 1px color-mix(in srgb, var(--bgm-vinyl-edge) 64%, transparent);
	}

	:global(html[data-bgm-state='playing']) .bgm-vinyl {
		animation: bgm-vinyl-spin 2.2s linear infinite;
	}

	@keyframes bgm-vinyl-spin {
		to { transform: rotate(360deg); }
	}

	.bgm-wave {
		position: relative;
		width: var(--bgm-wave-width);
		height: var(--bgm-wave-height);
		flex: none;
		display: grid;
		grid-template-columns: repeat(48, minmax(0, 1fr));
		align-items: center;
		gap: 1px;
		overflow: hidden;
	}

	.bgm-wave i {
		--level: .18;
		position: relative;
		width: 1px;
		height: calc(var(--bgm-wave-height) - 4px);
		justify-self: center;
		display: block;
		background: color-mix(in srgb, var(--muted) 52%, var(--bg));
		opacity: .5;
		transform: scaleY(var(--level));
		transform-origin: center;
		transition: background-color 120ms linear, opacity 120ms linear;
		will-change: transform;
	}

	.bgm-wave i[data-bgm-played] {
		background: color-mix(in srgb, var(--text) 88%, var(--bg));
		opacity: .96;
	}

	.bgm-time {
		min-width: 74px;
		color: color-mix(in srgb, var(--muted) 82%, var(--bg));
		font-size: 8px;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		letter-spacing: .02em;
		white-space: nowrap;
	}

	.bgm-presenter.home {
		position: absolute;
		top: clamp(14px, 1.2vw, 20px);
		left: clamp(16px, 1.4vw, 24px);
		z-index: 5;
	}

	.bgm-presenter.floating {
		position: fixed;
		left: 50%;
		bottom: max(16px, env(safe-area-inset-bottom));
		z-index: 119;
		padding: 7px 10px;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, var(--bg) 86%, transparent);
		box-shadow: 0 10px 32px color-mix(in srgb, #000 18%, transparent);
		backdrop-filter: blur(16px) saturate(1.05);
		-webkit-backdrop-filter: blur(16px) saturate(1.05);
		transform: translateX(-50%);
	}

	.bgm-presenter.dock {
		--bgm-wave-width: 108px;
		--bgm-wave-height: 26px;
		--bgm-vinyl-size: 28px;
		gap: 6px;
		padding-inline: 4px;
	}

	.bgm-presenter.dock .bgm-time {
		min-width: 68px;
		font-size: 7px;
	}

	@media (max-width: 520px) {
		.bgm-presenter.home {
			top: 10px;
			left: 10px;
			--bgm-wave-width: 118px;
			--bgm-vinyl-size: 28px;
		}

		.bgm-presenter.home .bgm-time {
			min-width: 66px;
			font-size: 7px;
		}

		.bgm-presenter.floating {
			--bgm-wave-width: 116px;
			--bgm-vinyl-size: 28px;
			bottom: max(10px, env(safe-area-inset-bottom));
			padding: 6px 8px;
		}

		.bgm-presenter.floating .bgm-time {
			min-width: 66px;
			font-size: 7px;
		}

		.bgm-presenter.dock {
			--bgm-wave-width: 62px;
			--bgm-wave-height: 24px;
			--bgm-vinyl-size: 24px;
			gap: 4px;
			padding-inline: 1px;
		}

		.bgm-presenter.dock .bgm-time {
			min-width: 54px;
			font-size: 6.5px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html[data-bgm-state='playing']) .bgm-vinyl {
			animation: none;
		}
	}
</style>
