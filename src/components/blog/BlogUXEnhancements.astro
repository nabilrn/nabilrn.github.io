    }

    [data-blog-feed-root][data-search-active='true'] .feed-post:not([hidden]) {
        background: color-mix(in srgb, var(--surface) 20%, transparent);
    }

    [data-blog-feed-root][data-search-active='true'] .feed-post:not([hidden]):hover {
        background: color-mix(in srgb, var(--surface) 50%, transparent);
    }

    @media (max-width: 520px) {
        .article-back-link {
            margin-bottom: 9px;
            min-height: 28px;
            font-size: 10.5px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .article-back-link { transition: none; }
        .article-back-link:hover,
        .article-back-link:focus-visible { transform: none; }
    }
</style>