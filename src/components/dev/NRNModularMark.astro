---
type Point = { x: number; y: number };
type Placement = { kind: 'n' | 'r'; ox: number; oy: number };
type WallState = { normal: string; pressed: string };
type Surface = { points: Point[]; visible: boolean[] };

const ISO_STEP = 22;
const ISO_X = ISO_STEP * Math.cos(Math.PI / 6);
const ISO_Y = ISO_STEP * Math.sin(Math.PI / 6);
const DEPTH = 16;
const PRESS_DISTANCE = 8;
const ORIGIN = { x: 450, y: 120 };

// Original modular NRN plan-view geometry. Keep this simple enough that the
// 3D rendering can stay explicit and readable.
const N_OUTER: Point[] = [
    { x: 0, y: 0 },
    { x: 1.4, y: 0 },
    { x: 3.6, y: 4.9 },
    { x: 3.6, y: 0 },
    { x: 5, y: 0 },
    { x: 5, y: 7 },
    { x: 3.6, y: 7 },
    { x: 1.4, y: 2.1 },
    { x: 1.4, y: 7 },
    { x: 0, y: 7 },
];

const R_OUTER: Point[] = [
    { x: 0, y: 0 },
    { x: 1.4, y: 0 },
    { x: 4, y: 0 },
    { x: 5.2, y: 1.2 },
    { x: 5.2, y: 3.4 },
    { x: 4.2, y: 4.4 },
    { x: 3.1, y: 4.4 },
    { x: 5.2, y: 7 },
    { x: 3.4, y: 7 },
    { x: 1.8, y: 4.5 },
    { x: 1.4, y: 4.5 },
    { x: 1.4, y: 7 },
    { x: 0, y: 7 },
];

const R_HOLE: Point[] = [
    { x: 1.4, y: 1.2 },
    { x: 3.7, y: 1.2 },
    { x: 4, y: 1.5 },
    { x: 4, y: 2.8 },
    { x: 3.7, y: 3.1 },
    { x: 1.4, y: 3.1 },
];

const PLACEMENTS: Placement[] = [
    { kind: 'n', ox: 0, oy: 0 },
    { kind: 'r', ox: 7, oy: 0 },
    { kind: 'n', ox: 14, oy: 0 },
];

const project = (point: Point, placement: Placement): Point => {
    const x = point.x + placement.ox;
    const y = point.y + placement.oy;
    return {
        x: ORIGIN.x + (x - y) * ISO_X,
        y: ORIGIN.y + (x + y) * ISO_Y,
    };
};

const shifted = (point: Point, dy: number): Point => ({ x: point.x, y: point.y + dy });
const move = (point: Point) => `${point.x.toFixed(3)} ${point.y.toFixed(3)}`;

const polygonPath = (points: Point[], dy = 0) => {
    const [first, ...rest] = points.map((point) => shifted(point, dy));
    return `M ${move(first)} ${rest.map((point) => `L ${move(point)}`).join(' ')} Z`;
};

const projectedPolygon = (shape: Point[], placement: Placement) => shape.map((point) => project(point, placement));

const glyphPath = (placement: Placement, dy = 0) => {
    if (placement.kind === 'n') return polygonPath(projectedPolygon(N_OUTER, placement), dy);
    return `${polygonPath(projectedPolygon(R_OUTER, placement), dy)} ${polygonPath(projectedPolygon(R_HOLE, placement), dy)}`;
};

const GLYPHS = PLACEMENTS.map((placement) => ({
    path: glyphPath(placement),
    fillRule: placement.kind === 'r' ? 'evenodd' : 'nonzero',
}));

// Surface orientation determines which side-wall faces exist. Stroke visibility
// is handled separately so adjacent visible faces do not create false seams.
const makeSurface = (shape: Point[], placement: Placement, inner = false): Surface => {
    const points = projectedPolygon(shape, placement);
    const visible = points.map((a, index) => {
        const b = points[(index + 1) % points.length];
        const dx = b.x - a.x;
        return inner ? dx > 0.1 : dx <= 0.1;
    });
    return { points, visible };
};

const SURFACES: Surface[] = PLACEMENTS.flatMap((placement) => {
    if (placement.kind === 'n') return [makeSurface(N_OUTER, placement)];
    return [makeSurface(R_OUTER, placement), makeSurface(R_HOLE, placement, true)];
});

const wallPath = (a: Point, b: Point, topShift: number) => {
    const aTop = shifted(a, topShift);
    const bTop = shifted(b, topShift);
    const bBottom = shifted(b, DEPTH);
    const aBottom = shifted(a, DEPTH);
    return `M ${move(aTop)} L ${move(bTop)} L ${move(bBottom)} L ${move(aBottom)} Z`;
};

const WALLS: WallState[] = SURFACES.flatMap((surface) =>
    surface.points.flatMap((a, index) => {
        if (!surface.visible[index]) return [];
        const b = surface.points[(index + 1) % surface.points.length];
        return [{
            normal: wallPath(a, b, 0),
            pressed: wallPath(a, b, PRESS_DISTANCE),
        }];
    }),
);

const structuralPath = (topShift: number) => {
    const chunks: string[] = PLACEMENTS.map((placement) => glyphPath(placement, topShift));
    const connectorKeys = new Set<string>();

    for (const surface of SURFACES) {
        const count = surface.points.length;

        // Bottom edges are visible only where a visible wall face exists.
        surface.points.forEach((a, index) => {
            if (!surface.visible[index]) return;
            const b = surface.points[(index + 1) % count];
            chunks.push(`M ${move(shifted(a, DEPTH))} L ${move(shifted(b, DEPTH))}`);
        });

        // A vertical edge belongs only at the boundary between a visible and a
        // hidden face. This removes the internal seams produced by connecting
        // every visible wall endpoint.
        surface.points.forEach((point, index) => {
            const incomingVisible = surface.visible[(index - 1 + count) % count];
            const outgoingVisible = surface.visible[index];
            if (incomingVisible === outgoingVisible) return;

            const key = `${point.x.toFixed(3)}:${point.y.toFixed(3)}`;
            if (connectorKeys.has(key)) return;
            connectorKeys.add(key);
            chunks.push(`M ${move(shifted(point, topShift))} L ${move(shifted(point, DEPTH))}`);
        });
    }

    return chunks.join(' ');
};

const STROKE_NORMAL = structuralPath(0);
const STROKE_PRESSED = structuralPath(PRESS_DISTANCE);

// Construction rulers are literal extensions of the NRN lattice through real
// bottom vertices, matching the reference's technical-drawing behavior.
const POSITIVE_AXIS = { x: Math.cos(Math.PI / 6), y: Math.sin(Math.PI / 6) };
const NEGATIVE_AXIS = { x: Math.cos(Math.PI / 6), y: -Math.sin(Math.PI / 6) };
const guideThrough = (anchor: Point, direction: Point, extent = 1200) =>
    `M ${move({ x: anchor.x - direction.x * extent, y: anchor.y - direction.y * extent })} ` +
    `L ${move({ x: anchor.x + direction.x * extent, y: anchor.y + direction.y * extent })}`;

const LEFT_N = PLACEMENTS[0];
const CENTER_R = PLACEMENTS[1];
const RIGHT_N = PLACEMENTS[2];

const GUIDE_PATHS = [
    // One lattice row passes through the left N and R bottom geometry.
    guideThrough(shifted(project(N_OUTER[9], LEFT_N), DEPTH), POSITIVE_AXIS),
    // Parallel lattice row through the far-right N.
    guideThrough(shifted(project(N_OUTER[4], RIGHT_N), DEPTH), POSITIVE_AXIS),
    // Opposite lattice family through a real R bottom vertex.
    guideThrough(shifted(project(R_OUTER[1], CENTER_R), DEPTH), NEGATIVE_AXIS),
];
---

<div class="modular-stage" data-modular-stage>
    <button class="modular-button" type="button" data-modular-button aria-label="Press experimental modular NRN mark">
        <svg
            class="modular-svg"
            data-modular-svg
            viewBox="270 70 580 360"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
        >
            <defs>
                <pattern id="nrn-modular-pattern" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M-1 1l2 -2M0 10l10 -10M9 11l2 -2" class="modular-pattern-line" />
                </pattern>

                <path id="nrn-modular-structural-stroke" data-modular-stroke d={STROKE_NORMAL} />

                <radialGradient id="nrn-modular-gradient" data-modular-gradient cx="560" cy="250" r="190" gradientUnits="userSpaceOnUse">
                    <stop offset="0" class="modular-glow-start" />
                    <stop offset="1" class="modular-glow-end" />
                </radialGradient>
            </defs>

            <g class="modular-guides" stroke-width="1" stroke-dasharray="4 2">
                {GUIDE_PATHS.map((path) => <path d={path} />)}
            </g>

            <g class="modular-walls" fill-rule="evenodd" clip-rule="evenodd">
                {WALLS.map((wall) => (
                    <path data-modular-wall data-normal-d={wall.normal} data-pressed-d={wall.pressed} d={wall.normal} />
                ))}
            </g>

            <g data-modular-top class="modular-top">
                <g class="modular-face-background">
                    {GLYPHS.map((glyph) => <path d={glyph.path} fill-rule={glyph.fillRule} clip-rule={glyph.fillRule} />)}
                </g>
                <g class="modular-face-pattern">
                    {GLYPHS.map((glyph) => <path d={glyph.path} fill-rule={glyph.fillRule} clip-rule={glyph.fillRule} />)}
                </g>
            </g>

            <use href="#nrn-modular-structural-stroke" class="modular-stroke-base" />
            <use href="#nrn-modular-structural-stroke" class="modular-stroke-glow" />

            <text class="modular-fig-label" x="292" y="414">FIG. B / NRN MODULAR SYSTEM</text>
        </svg>
    </button>
</div>

<style>
    .modular-stage {
        width: 100%;
        height: 100%;
        min-height: 0;
        overflow: hidden;
        background: var(--bg);
        --modular-background: var(--bg);
        --modular-foreground: var(--text);
        --modular-pattern: color-mix(in oklab, var(--modular-foreground) 12%, var(--modular-background));
        --modular-stroke: color-mix(in oklab, var(--modular-foreground) 16%, var(--modular-background));
        --modular-line: color-mix(in oklab, var(--border) 64%, var(--modular-background));
    }

    .modular-button {
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .modular-button:focus-visible {
        outline: 1px solid color-mix(in srgb, var(--text) 60%, transparent);
        outline-offset: -4px;
    }

    .modular-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .modular-pattern-line {
        fill: none;
        stroke: var(--modular-pattern);
        stroke-width: 1;
    }

    .modular-guides {
        fill: none;
        stroke: var(--modular-line);
        opacity: .82;
        pointer-events: none;
    }

    .modular-walls,
    .modular-face-background {
        fill: var(--modular-background);
    }

    .modular-face-pattern {
        fill: url(#nrn-modular-pattern);
    }

    .modular-top {
        transition: transform 170ms cubic-bezier(.2,.8,.2,1);
    }

    .modular-stroke-base,
    .modular-stroke-glow {
        fill: none;
        stroke-width: 1;
        stroke-linecap: butt;
        stroke-linejoin: miter;
        pointer-events: none;
    }

    .modular-stroke-base {
        stroke: var(--modular-stroke);
    }

    .modular-stroke-glow {
        stroke: url(#nrn-modular-gradient);
    }

    .modular-glow-start {
        stop-color: #fff;
        stop-opacity: 1;
    }

    .modular-glow-end {
        stop-color: #52525b;
        stop-opacity: 0;
    }

    .modular-fig-label {
        fill: color-mix(in srgb, var(--muted) 48%, var(--bg));
        font-family: var(--font-mono);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: .05em;
        user-select: none;
    }
</style>

<script define:vars={{ STROKE_NORMAL, STROKE_PRESSED, PRESS_DISTANCE }}>
    const roots = document.querySelectorAll('[data-modular-stage]');

    roots.forEach((root) => {
        if (!(root instanceof HTMLElement) || root.dataset.modularReady === 'true') return;
        root.dataset.modularReady = 'true';

        const button = root.querySelector('[data-modular-button]');
        const svg = root.querySelector('[data-modular-svg]');
        const gradient = root.querySelector('[data-modular-gradient]');
        const top = root.querySelector('[data-modular-top]');
        const stroke = root.querySelector('[data-modular-stroke]');
        const walls = Array.from(root.querySelectorAll('[data-modular-wall]'));
        if (!(button instanceof HTMLButtonElement) || !(svg instanceof SVGSVGElement) || !(gradient instanceof SVGRadialGradientElement) || !(top instanceof SVGGElement) || !(stroke instanceof SVGPathElement)) return;

        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let targetX = 560;
        let targetY = 250;
        let currentX = targetX;
        let currentY = targetY;
        let raf = 0;
        let pressed = false;

        const paintGradient = () => {
            currentX += (targetX - currentX) * 0.18;
            currentY += (targetY - currentY) * 0.18;
            gradient.setAttribute('cx', currentX.toFixed(2));
            gradient.setAttribute('cy', currentY.toFixed(2));
            if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
                raf = requestAnimationFrame(paintGradient);
            } else {
                raf = 0;
            }
        };

        const onPointerMove = (event) => {
            if (!finePointer.matches || reducedMotion.matches) return;
            const ctm = svg.getScreenCTM();
            if (!ctm) return;
            const point = svg.createSVGPoint();
            point.x = event.clientX;
            point.y = event.clientY;
            const local = point.matrixTransform(ctm.inverse());
            targetX = local.x;
            targetY = local.y;
            if (!raf) raf = requestAnimationFrame(paintGradient);
        };

        const setPressed = (nextPressed) => {
            if (pressed === nextPressed) return;
            pressed = nextPressed;
            top.style.transform = nextPressed ? `translateY(${PRESS_DISTANCE}px)` : 'translateY(0px)';
            stroke.setAttribute('d', nextPressed ? STROKE_PRESSED : STROKE_NORMAL);
            walls.forEach((wall) => {
                if (!(wall instanceof SVGPathElement)) return;
                const d = nextPressed ? wall.dataset.pressedD : wall.dataset.normalD;
                if (d) wall.setAttribute('d', d);
            });
        };

        window.addEventListener('pointermove', onPointerMove, { passive: true });
        button.addEventListener('pointerdown', () => setPressed(true));
        button.addEventListener('pointerup', () => setPressed(false));
        button.addEventListener('pointercancel', () => setPressed(false));
        button.addEventListener('pointerleave', () => setPressed(false));
        button.addEventListener('blur', () => setPressed(false));
    });
</script>
