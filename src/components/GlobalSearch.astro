<dialog class="global-search" data-global-search aria-labelledby="global-search-title">
  <div class="global-search-panel" data-global-search-panel>
    <div class="global-search-input-row">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <label class="global-search-label" for="global-search-input">
        <span id="global-search-title" class="visually-hidden">Search portfolio</span>
        <input
          id="global-search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search pages, projects, blog, components..."
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="global-search-results"
          data-global-search-input
        />
      </label>
      <kbd class="global-search-escape">ESC</kbd>
    </div>

    <div class="global-search-meta" aria-live="polite" data-global-search-status>
      Type to search public portfolio content.
    </div>

    <div
      id="global-search-results"
      class="global-search-results"
      role="listbox"
      aria-label="Search results"
      data-global-search-results
    ></div>

    <footer class="global-search-footer" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>Enter</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </footer>
  </div>
</dialog>

<script>
  import { scoreSearchEntry, type SearchEntry } from '../lib/search';

  interface SearchIndexPayload {
    generatedAt: string;
    count: number;
    entries: SearchEntry[];
  }

  const dialog = document.querySelector('[data-global-search]');
  const panel = dialog?.querySelector('[data-global-search-panel]');
  const input = dialog?.querySelector('[data-global-search-input]');
  const results = dialog?.querySelector('[data-global-search-results]');
  const status = dialog?.querySelector('[data-global-search-status]');

  if (
    dialog instanceof HTMLDialogElement &&
    panel instanceof HTMLElement &&
    input instanceof HTMLInputElement &&
    results instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    let entries: SearchEntry[] | null = null;
    let loadPromise: Promise<SearchEntry[]> | null = null;
    let visibleEntries: SearchEntry[] = [];
    let activeIndex = -1;

    const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform);
    document.querySelectorAll('[data-global-search-shortcut]').forEach((node) => {
      node.textContent = isMac ? '⌘K' : 'Ctrl K';
    });

    const setStatus = (message: string) => {
      status.textContent = message;
    };

    const loadIndex = async () => {
      if (entries) return entries;
      if (loadPromise) return loadPromise;

      loadPromise = fetch('/search-index.json', {
        headers: { Accept: 'application/json' },
        credentials: 'same-origin',
      })
        .then(async (response) => {
          if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
          const payload = await response.json() as SearchIndexPayload;
          if (!Array.isArray(payload.entries)) throw new Error('Search index payload is invalid.');
          entries = payload.entries;
          return entries;
        })
        .finally(() => {
          loadPromise = null;
        });

      return loadPromise;
    };

    const groupLabel = (entry: SearchEntry) => {
      if (entry.kind === 'component') return entry.category;
      return entry.category;
    };

    const updateActive = (nextIndex: number) => {
      const resultNodes = Array.from(results.querySelectorAll<HTMLElement>('[data-search-result]'));
      if (!resultNodes.length) {
        activeIndex = -1;
        input.removeAttribute('aria-activedescendant');
        return;
      }

      activeIndex = ((nextIndex % resultNodes.length) + resultNodes.length) % resultNodes.length;
      resultNodes.forEach((node, index) => {
        const active = index === activeIndex;
        node.dataset.active = active ? 'true' : 'false';
        node.setAttribute('aria-selected', active ? 'true' : 'false');
        if (active) {
          input.setAttribute('aria-activedescendant', node.id);
          node.scrollIntoView({ block: 'nearest' });
        }
      });
    };

    const renderResults = (query: string) => {
      if (!entries) return;

      const trimmed = query.trim();
      const ranked = entries
        .map((entry) => ({ entry, score: scoreSearchEntry(entry, trimmed) }))
        .filter(({ score }) => score > 0)
        .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title));

      visibleEntries = ranked.slice(0, trimmed ? 14 : 10).map(({ entry }) => entry);
      results.replaceChildren();

      if (!visibleEntries.length) {
        const empty = document.createElement('p');
        empty.className = 'global-search-empty';
        empty.textContent = `No matches for “${trimmed}”.`;
        results.append(empty);
        setStatus('No matching public content.');
        updateActive(-1);
        return;
      }

      let lastGroup = '';
      visibleEntries.forEach((entry, index) => {
        const group = groupLabel(entry);
        if (group !== lastGroup) {
          const heading = document.createElement('p');
          heading.className = 'global-search-group';
          heading.textContent = group;
          results.append(heading);
          lastGroup = group;
        }

        const link = document.createElement('a');
        link.id = `global-search-result-${index}`;
        link.className = 'global-search-result';
        link.href = entry.href;
        link.dataset.searchResult = 'true';
        link.dataset.active = 'false';
        link.setAttribute('role', 'option');
        link.setAttribute('aria-selected', 'false');
        if (entry.external) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }

        const copy = document.createElement('span');
        copy.className = 'global-search-result-copy';

        const title = document.createElement('strong');
        title.textContent = entry.title;

        const description = document.createElement('span');
        description.textContent = entry.description;

        const kind = document.createElement('span');
        kind.className = 'global-search-result-kind';
        kind.textContent = entry.kind;

        copy.append(title, description);
        link.append(copy, kind);
        link.addEventListener('mouseenter', () => updateActive(index));
        link.addEventListener('focus', () => updateActive(index));
        link.addEventListener('click', () => dialog.close());
        results.append(link);
      });

      setStatus(trimmed
        ? `${visibleEntries.length} result${visibleEntries.length === 1 ? '' : 's'} shown.`
        : 'Quick access to pages, projects, recent writing, and components.');
      updateActive(0);
    };

    const openSearch = async () => {
      if (!dialog.open) dialog.showModal();
      input.setAttribute('aria-expanded', 'true');
      input.value = '';
      results.replaceChildren();
      setStatus(entries ? 'Quick access to portfolio content.' : 'Loading search index…');
      requestAnimationFrame(() => input.focus());

      try {
        await loadIndex();
        renderResults('');
      } catch (error) {
        console.error(error);
        visibleEntries = [];
        activeIndex = -1;
        results.replaceChildren();
        const failed = document.createElement('p');
        failed.className = 'global-search-empty';
        failed.textContent = 'Search index could not be loaded.';
        results.append(failed);
        setStatus('Search is temporarily unavailable.');
      }
    };

    const closeSearch = () => {
      if (dialog.open) dialog.close();
    };

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-global-search-open]')) {
        event.preventDefault();
        void openSearch();
      }
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) closeSearch();
        else void openSearch();
      }
    });

    input.addEventListener('input', () => renderResults(input.value));
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        updateActive(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        updateActive(activeIndex - 1);
      } else if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault();
        const active = results.querySelector<HTMLElement>(`#global-search-result-${activeIndex}`);
        active?.click();
      }
    });

    dialog.addEventListener('close', () => {
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeSearch();
    });
  }
</script>

<style>
  .global-search {
    width: min(680px, calc(100vw - 28px));
    max-width: 680px;
    max-height: min(72vh, 660px);
    margin: min(14vh, 120px) auto auto;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--text);
  }

  .global-search::backdrop {
    background: color-mix(in srgb, #000 62%, transparent);
    backdrop-filter: blur(3px);
    animation: global-search-backdrop-in 150ms ease both;
  }

  .global-search-panel {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 9px;
    background: color-mix(in srgb, var(--bg) 96%, var(--surface));
    box-shadow: var(--shadow);
    animation: global-search-panel-in 165ms cubic-bezier(.2, .8, .2, 1) both;
  }

  .global-search-input-row {
    min-height: 54px;
    padding: 0 14px;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .global-search-input-row > svg {
    width: 19px;
    height: 19px;
  }

  .global-search-label {
    min-width: 0;
    display: block;
  }

  .global-search-label input {
    width: 100%;
    height: 52px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1;
  }

  .global-search-label input::placeholder { color: var(--muted); }

  .global-search-escape,
  .global-search-footer kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 20px;
    padding: 0 5px;
    border: 1px solid var(--border);
    border-bottom-color: var(--border-strong);
    border-radius: 4px;
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
  }

  .global-search-meta {
    min-height: 34px;
    padding: 9px 14px 8px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.35;
  }

  .global-search-results {
    max-height: min(52vh, 470px);
    padding: 7px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .global-search-group {
    margin: 0;
    padding: 8px 9px 5px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .global-search-result {
    min-height: 49px;
    padding: 8px 9px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    border: 1px solid transparent;
    border-radius: 5px;
    color: inherit;
    text-decoration: none;
  }

  .global-search-result[data-active='true'] {
    border-color: var(--border);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .global-search-result:focus-visible {
    outline: 0;
  }

  .global-search-result-copy {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .global-search-result-copy strong {
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 620;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .global-search-result-copy > span {
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .global-search-result-kind {
    color: color-mix(in srgb, var(--muted) 78%, transparent);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1;
    text-transform: uppercase;
  }

  .global-search-empty {
    margin: 0;
    padding: 28px 14px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 12px;
    text-align: center;
  }

  .global-search-footer {
    min-height: 38px;
    padding: 8px 11px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 10px;
  }

  .global-search-footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .global-search-footer kbd {
    min-width: 19px;
    min-height: 18px;
    padding-inline: 4px;
    font-size: 8px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes global-search-panel-in {
    from { opacity: 0; transform: translateY(-8px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @keyframes global-search-backdrop-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 560px) {
    .global-search {
      width: calc(100vw - 16px);
      margin-top: 8px;
      max-height: calc(100dvh - 16px);
    }

    .global-search-results { max-height: calc(100dvh - 190px); }
    .global-search-footer { justify-content: flex-start; gap: 10px; overflow: hidden; }
    .global-search-result-kind { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .global-search::backdrop,
    .global-search-panel { animation: none; }
  }
</style>
