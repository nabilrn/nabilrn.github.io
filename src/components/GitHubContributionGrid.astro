---
import { getSiteContent, normalizeLocale, type SiteLocale } from '../data/siteContent';
import HandwrittenNote from './home/HandwrittenNote.astro';
import { getGitHubContributions } from '../lib/githubContributions';

interface Props {
    username?: string;
    locale?: SiteLocale;
}

interface ContributionDay {
    date: string;
    count: number;
    level: number;
    isFuture: boolean;
}

const { username = 'nabilrn', locale: rawLocale } = Astro.props;
const locale = normalizeLocale(rawLocale);
const copy = getSiteContent(locale).home.contributions;

// Geometry and information hierarchy are adapted from ChanhDai's MIT-licensed
// GitHub Contributions component, which credits Kibo UI's contribution graph.
// We keep the Astro implementation framework-free while preserving the useful
// open-source ideas: rolling-year activities, square blocks, month labels,
// per-day tooltips, technical figure caption, and Less -> More legend.
const activities = await getGitHubContributions(username);
const activityMap = new Map(activities.map((activity) => [activity.date, activity]));

const toUtcDay = (date: Date) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
const toDateKey = (date: Date) => date.toISOString().slice(0, 10);
const addDays = (date: Date, days: number) => {
    const next = new Date(date);
    next.setUTCDate(next.getUTCDate() + days);
    return next;
};

const today = toUtcDay(new Date());
const currentWeekEnd = addDays(today, 6 - today.getUTCDay());
const start = addDays(currentWeekEnd, -(53 * 7 - 1));
const weekCount = 53;

const days: ContributionDay[] = Array.from({ length: weekCount * 7 }, (_, index) => {
    const date = addDays(start, index);
    const dateKey = toDateKey(date);
    const activity = activityMap.get(dateKey);
    const isFuture = date > today;

    return {
        date: dateKey,
        count: isFuture ? 0 : activity?.count ?? 0,
        level: isFuture ? 0 : activity?.level ?? 0,
        isFuture,
    };
});

const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const rawMonthLabels = Array.from({ length: weekCount }, (_, weekIndex) => {
    const firstDay = days[weekIndex * 7];
    const month = new Date(`${firstDay.date}T00:00:00Z`).getUTCMonth();
    const previous = weekIndex > 0
        ? new Date(`${days[(weekIndex - 1) * 7].date}T00:00:00Z`).getUTCMonth()
        : -1;

    return month !== previous ? { weekIndex, label: monthNames[month] } : null;
}).filter((value): value is { weekIndex: number; label: string } => Boolean(value));

const monthLabels = rawMonthLabels.filter(({ weekIndex }, index, labels) => {
    const minimumWeeks = 3;
    const next = labels[index + 1];
    const previous = labels[index - 1];

    if (!previous && next) return next.weekIndex - weekIndex >= minimumWeeks;
    if (!next) return weekCount - weekIndex >= minimumWeeks;
    return true;
});

const visibleDays = days.filter((day) => !day.isFuture);
const total = visibleDays.reduce((sum, day) => sum + day.count, 0);
const firstDate = visibleDays[0]?.date ?? toDateKey(start);
const lastDate = visibleDays.at(-1)?.date ?? toDateKey(today);
const formatFigureDate = (date: string) => {
    const [year, month, day] = date.split('-');
    return `${day}.${month}.${year}`;
};
const formatTooltipDate = (date: string) => {
    const value = new Date(`${date}T00:00:00Z`);
    return new Intl.DateTimeFormat(locale === 'id' ? 'id-ID' : 'en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(value);
};
---

<figure class="contribution-panel" aria-labelledby="github-activity-caption">
    <div class="contribution-annotation-layer" aria-hidden="true">
        <HandwrittenNote text="my activity" class="activity-note" arrowVariant="shallow" />
    </div>

    {activities.length > 0 ? (
        <>
            <div class="contribution-calendar" aria-label={copy.chartAlt} style={`--week-count:${weekCount};`}>
                <div class="month-row" aria-hidden="true">
                    {monthLabels.map((month) => (
                        <span style={`grid-column:${month.weekIndex + 1};`}>{month.label}</span>
                    ))}
                </div>

                <div class="contribution-grid">
                    {days.map((day) => {
                        if (day.isFuture) return <span class="contribution-day is-future"></span>;

                        const tooltip = copy.contributionLabel(day.count, formatTooltipDate(day.date));
                        return (
                            <span
                                class="contribution-day"
                                data-level={day.level}
                                data-contribution-tooltip={tooltip}
                                aria-label={tooltip}
                                tabindex="0"
                            ></span>
                        );
                    })}
                </div>
            </div>

            <div class="graph-footer">
                <figcaption id="github-activity-caption" class="graph-caption">
                    <span class="figure-number">Fig. 02.</span>
                    <span class="caption-copy">
                        {copy.totalLabel(total)}, {formatFigureDate(firstDate)} — {formatFigureDate(lastDate)}. Source:{' '}
                        <a href={`https://github.com/${username}`} target="_blank" rel="noopener">GitHub</a>.
                    </span>
                </figcaption>

                <div class="contribution-legend" aria-hidden="true">
                    <span>{copy.less}</span>
                    {[0, 1, 2, 3, 4].map((level) => <span class="legend-cell" data-level={level}></span>)}
                    <span>{copy.more}</span>
                </div>
            </div>
        </>
    ) : (
        <div class="contribution-fallback" role="status">
            GitHub activity is temporarily unavailable.
        </div>
    )}
</figure>

<style>
    /* Transitional parent integration while the home board still owns the old
       contribution-region shell. The graph itself is now the section title. */
    :global(.contribution-region) {
        padding: clamp(9px, .8vw, 13px) clamp(12px, 1vw, 16px) !important;
    }

    :global(.contribution-region > .region-heading) {
        display: none !important;
    }

    :global(.contribution-region .contribution-legend) {
        display: flex !important;
    }

    .contribution-panel {
        /* 53 weeks + 52 one-pixel gaps. This makes the cells consume the
           available inline size instead of relying on a viewport-specific guess. */
        --cell-gap: 1px;
        --cell-size: clamp(8px, calc((100cqw - 52px) / 53), 12px);
        --level-0: color-mix(in srgb, var(--muted) 9%, transparent);
        --level-1: color-mix(in srgb, var(--muted) 24%, transparent);
        --level-2: color-mix(in srgb, var(--muted) 42%, transparent);
        --level-3: color-mix(in srgb, var(--muted) 62%, transparent);
        --level-4: color-mix(in srgb, var(--muted) 84%, transparent);

        position: relative;
        width: 100%;
        min-width: 0;
        height: 100%;
        margin: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        container-type: inline-size;
        overflow: visible;
    }

    .contribution-annotation-layer {
        position: absolute;
        inset: 0;
        z-index: 4;
        pointer-events: none;
        overflow: visible;
    }

    :global(.contribution-annotation-layer .activity-note) {
        right: 14px;
        top: -2px;
        --note-font-size: 13.5px;
        --note-arrow-width: 34px;
        --note-arrow-height: 14px;
        --note-arrow-gap: -1px;
        transform: rotate(-2deg);
        transform-origin: right top;
    }

    .contribution-calendar {
        width: max-content;
        max-width: 100%;
        padding-top: 0;
        overflow: visible;
    }

    .month-row,
    .contribution-grid {
        display: grid;
        grid-template-columns: repeat(var(--week-count), var(--cell-size));
        column-gap: var(--cell-gap);
    }

    .month-row {
        min-height: 12px;
        margin-bottom: 5px;
        color: color-mix(in srgb, var(--muted) 82%, transparent);
        font-family: var(--font-sans);
        font-size: 9px;
        line-height: 1;
        user-select: none;
    }

    .month-row span {
        white-space: nowrap;
    }

    .contribution-grid {
        grid-template-rows: repeat(7, var(--cell-size));
        grid-auto-flow: column;
        row-gap: var(--cell-gap);
    }

    .contribution-day,
    .legend-cell {
        width: var(--cell-size);
        height: var(--cell-size);
        display: block;
        border: 0;
        border-radius: 0;
        background: var(--level-0);
    }

    .contribution-day[data-level='1'],
    .legend-cell[data-level='1'] { background: var(--level-1); }
    .contribution-day[data-level='2'],
    .legend-cell[data-level='2'] { background: var(--level-2); }
    .contribution-day[data-level='3'],
    .legend-cell[data-level='3'] { background: var(--level-3); }
    .contribution-day[data-level='4'],
    .legend-cell[data-level='4'] { background: var(--level-4); }

    .contribution-day.is-future {
        visibility: hidden;
    }

    .contribution-day:not(.is-future) {
        cursor: default;
        outline: 1px solid transparent;
        outline-offset: 1px;
        transition: background 100ms ease, outline-color 100ms ease;
    }

    .contribution-day:hover,
    .contribution-day:focus-visible {
        outline-color: color-mix(in srgb, var(--text) 78%, transparent);
        background: color-mix(in srgb, var(--text) 88%, transparent);
        z-index: 2;
    }

    .contribution-day:focus-visible {
        outline-width: 2px;
    }

    .graph-footer {
        width: 100%;
        margin-top: 11px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
    }

    .graph-caption {
        min-width: 0;
        color: var(--text-body);
        font-family: var(--font-sans);
        font-size: 10px;
        line-height: 1.35;
        text-wrap: balance;
    }

    .figure-number {
        margin-right: 7px;
        color: color-mix(in srgb, var(--muted) 78%, transparent);
        font-family: var(--font-mono);
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .graph-caption a {
        color: var(--text);
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent);
        text-underline-offset: 2px;
    }

    .contribution-legend {
        flex: none;
        align-items: center;
        gap: 3px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 9.5px;
        white-space: nowrap;
    }

    .contribution-legend .legend-cell {
        --cell-size: 8px;
    }

    .contribution-fallback {
        min-height: 110px;
        display: grid;
        place-items: center;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 10px;
    }

    :global(.contribution-floating-tooltip) {
        position: fixed;
        z-index: 1100;
        left: 0;
        top: 0;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 10px;
        line-height: 1.2;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, calc(-100% - 7px));
        transition: opacity 120ms ease, transform 120ms ease;
    }

    :global(.contribution-floating-tooltip.is-visible) {
        opacity: 1;
        transform: translate(-50%, calc(-100% - 10px));
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        :global(.contribution-region) {
            padding-top: 8px !important;
            padding-bottom: 8px !important;
        }

        .contribution-panel {
            --cell-size: clamp(7px, calc((100cqw - 52px) / 53), 11.5px);
        }

        :global(.contribution-annotation-layer .activity-note) {
            right: 12px;
            top: -3px;
            --note-font-size: 12.5px;
            --note-arrow-width: 32px;
            --note-arrow-height: 13px;
        }

        .graph-footer {
            margin-top: 9px;
        }

        .graph-caption,
        .contribution-legend {
            font-size: 9px;
        }

        .contribution-legend .legend-cell {
            --cell-size: 8px;
        }
    }

    @media (max-width: 640px) {
        .contribution-panel {
            --cell-size: 6px;
            --cell-gap: 2px;
        }

        .contribution-calendar {
            max-width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            scrollbar-width: none;
        }

        .contribution-calendar::-webkit-scrollbar {
            display: none;
        }

        .graph-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

        .month-row {
            font-size: 7px;
        }

        .contribution-annotation-layer {
            display: none;
        }
    }
</style>

<script>
    const tooltipClass = 'contribution-floating-tooltip';
    let tooltip = document.querySelector<HTMLElement>(`.${tooltipClass}`);

    if (!tooltip) {
        tooltip = document.createElement('div');
        tooltip.className = tooltipClass;
        tooltip.setAttribute('role', 'tooltip');
        document.body.appendChild(tooltip);
    }

    const hideTooltip = () => tooltip?.classList.remove('is-visible');
    const showTooltip = (cell: HTMLElement) => {
        if (!tooltip) return;
        const label = cell.dataset.contributionTooltip;
        if (!label) return;

        tooltip.textContent = label;
        tooltip.style.left = '0px';
        tooltip.style.top = '0px';
        tooltip.classList.add('is-visible');

        const rect = cell.getBoundingClientRect();
        const tooltipRect = tooltip.getBoundingClientRect();
        const half = tooltipRect.width / 2;
        const left = Math.max(8 + half, Math.min(window.innerWidth - 8 - half, rect.left + rect.width / 2));
        const top = Math.max(tooltipRect.height + 12, rect.top);

        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${top}px`;
    };

    document.querySelectorAll<HTMLElement>('[data-contribution-tooltip]').forEach((cell) => {
        if (cell.dataset.tooltipReady === 'true') return;
        cell.dataset.tooltipReady = 'true';
        cell.addEventListener('pointerenter', () => showTooltip(cell));
        cell.addEventListener('pointerleave', hideTooltip);
        cell.addEventListener('focus', () => showTooltip(cell));
        cell.addEventListener('blur', hideTooltip);
    });

    window.addEventListener('blur', hideTooltip);
</script>
