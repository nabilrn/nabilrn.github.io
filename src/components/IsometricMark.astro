---
import { buildIsometricGeometry, type IsometricCharacter } from '../lib/isometricGeometry';

interface Props {
  character: IsometricCharacter;
  depth?: number;
  hatch?: boolean;
  guides?: boolean;
  class?: string;
}

const {
  character,
  depth = 28,
  hatch = true,
  guides = true,
  class: className,
} = Astro.props;

const geometry = buildIsometricGeometry({ character, depth });
const patternId = `isometric-hatch-${character.toLowerCase()}-${Math.round(depth)}`;
---

<svg
  class:list={['isometric-mark', className]}
  viewBox={geometry.viewBox}
  role="img"
  aria-label={`Isometric ${character}`}
  data-isometric-character={character}
>
  <defs>
    <pattern id={patternId} width="10" height="10" patternUnits="userSpaceOnUse">
      <path d="M-2 2 L2 -2 M0 10 L10 0 M8 12 L12 8" class="isometric-hatch-line" />
    </pattern>
  </defs>

  {guides && geometry.guidePaths.map((path) => <path d={path} class="isometric-guide" />)}
  {geometry.walls.map((path) => <path d={path} class="isometric-wall" />)}
  <path d={geometry.bottomPath} class="isometric-structure" />
  <path d={geometry.connectorPath} class="isometric-structure" />
  <path d={geometry.topPath} class="isometric-top-fill" fill-rule="evenodd" />
  {hatch && <path d={geometry.topPath} fill={`url(#${patternId})`} fill-rule="evenodd" />}
  <path d={geometry.topPath} class="isometric-structure" fill-rule="evenodd" />
</svg>

<style>
  .isometric-mark {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .isometric-wall,
  .isometric-top-fill {
    fill: var(--bg);
  }

  .isometric-wall,
  .isometric-structure {
    stroke: color-mix(in srgb, var(--text) 26%, var(--bg));
    stroke-width: 1;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }

  .isometric-structure,
  .isometric-guide,
  .isometric-hatch-line {
    fill: none;
  }

  .isometric-guide {
    stroke: color-mix(in srgb, var(--text) 9%, var(--bg));
    stroke-width: 1;
  }

  .isometric-hatch-line {
    stroke: color-mix(in srgb, var(--text) 15%, var(--bg));
    stroke-width: 1;
  }
</style>
