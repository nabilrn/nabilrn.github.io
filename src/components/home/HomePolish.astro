<style is:global>
    /* The project rail should keep moving after an external project tab returns
       focus to the portfolio. The old hover/focus pause state could stay latched
       until the user clicked elsewhere. */
    .home-redesign .project-carousel-panel:hover .project-carousel-track,
    .home-redesign .project-carousel-panel:focus-within .project-carousel-track {
        animation-play-state: running !important;
    }

    /* Remove the generic diagonal external-link glyph everywhere it is rendered
       through UiIcon. Functional direction cues such as download and scroll stay. */
    svg:has(> path[d='M7 17 17 7']) {
        display: none !important;
    }

    .home-header .design-reference > span[aria-hidden='true']:not(.design-reference-verified) {
        display: none !important;
    }

    .home-header .design-reference[data-design-reference-polished='true'] > span:first-child,
    .home-header .design-reference[data-design-reference-polished='true'] > strong {
        color: transparent !important;
        background: linear-gradient(
            90deg,
            color-mix(in srgb, var(--muted) 82%, transparent) 0%,
            color-mix(in srgb, var(--text) 92%, var(--muted)) 42%,
            var(--text) 50%,
            color-mix(in srgb, var(--text) 92%, var(--muted)) 58%,
            color-mix(in srgb, var(--muted) 82%, transparent) 100%
        );
        background-size: 220% 100%;
        background-clip: text;
        -webkit-background-clip: text;
        filter: drop-shadow(0 0 4px color-mix(in srgb, var(--text) 18%, transparent));
        animation: design-reference-shimmer 3.8s ease-in-out infinite;
    }

    .home-header .design-reference-verified {
        width: 13px;
        height: 13px;
        flex: none;
        display: grid;
        place-items: center;
        margin-left: 1px;
        color: #f4c430;
        filter:
            drop-shadow(0 0 3px rgb(244 196 48 / 68%))
            drop-shadow(0 0 7px rgb(244 196 48 / 30%));
        animation: design-reference-gold-pulse 2.8s ease-in-out infinite;
    }

    .home-header .design-reference-verified svg {
        width: 100%;
        height: 100%;
        display: block;
        fill: currentColor;
    }

    .home-redesign[data-home-redesign] .streak-region[data-profile-link='duolingo']::before {
        content: 'View @bilcikiwir on Duolingo' !important;
    }

    .home-redesign[data-home-redesign] .nr-song-credit::after {
        content: "Visit Sharou's YouTube channel" !important;
    }

    .home-redesign .nr-song-credit {
        align-items: center !important;
        gap: 5px !important;
        font-size: 9.5px !important;
        color: color-mix(in srgb, var(--muted) 78%, var(--bg)) !important;
    }

    .home-redesign .nr-song-credit strong {
        color: color-mix(in srgb, var(--text) 70%, var(--bg)) !important;
        font-weight: 550 !important;
    }

    .home-redesign .nr-youtube-icon {
        width: 14px;
        height: 14px;
        flex: none;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--muted) 78%, var(--bg));
        filter: grayscale(1);
        opacity: .82;
        transition: color 160ms ease, filter 160ms ease, opacity 160ms ease, transform 160ms ease;
    }

    .home-redesign .nr-youtube-icon svg {
        width: 14px;
        height: 14px;
        display: block;
        fill: currentColor;
    }

    .home-redesign .nr-song-credit:hover .nr-youtube-icon,
    .home-redesign .nr-song-credit:focus-visible .nr-youtube-icon {
        color: #ff0000;
        filter: none;
        opacity: 1;
        transform: scale(1.06);
    }

    @keyframes design-reference-shimmer {
        0% { background-position: 115% 0; }
        54%, 100% { background-position: -115% 0; }
    }

    @keyframes design-reference-gold-pulse {
        0%, 100% { opacity: .88; transform: scale(.97); }
        50% { opacity: 1; transform: scale(1.04); }
    }

    @media (max-width: 1099px) {
        .home-redesign .nr-song-credit {
            font-size: 8.5px !important;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-header .design-reference[data-design-reference-polished='true'] > span:first-child,
        .home-header .design-reference[data-design-reference-polished='true'] > strong,
        .home-header .design-reference-verified {
            animation: none !important;
        }
    }
</style>

<script>
    const diagonalArrows = /[↗↖↘↙]/g;
    const verifiedPath = 'M24 12a4.454 4.454 0 0 0-2.564-3.91 4.437 4.437 0 0 0-.948-4.578 4.436 4.436 0 0 0-4.577-.948A4.44 4.44 0 0 0 12 0a4.423 4.423 0 0 0-3.9 2.564 4.434 4.434 0 0 0-2.43-.178 4.425 4.425 0 0 0-2.158 1.126 4.42 4.42 0 0 0-1.12 2.156 4.42 4.42 0 0 0 .183 2.421A4.456 4.456 0 0 0 0 12a4.465 4.465 0 0 0 2.576 3.91 4.433 4.433 0 0 0 .936 4.577 4.459 4.459 0 0 0 4.577.95A4.454 4.454 0 0 0 12 24a4.439 4.439 0 0 0 3.91-2.563 4.26 4.26 0 0 0 5.526-5.526A4.453 4.453 0 0 0 24 12Zm-13.709 4.917-4.38-4.378 1.652-1.663 2.646 2.646L15.83 7.4l1.72 1.591-7.258 7.926Z';
    const youtubePath = 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.017 3.017 0 0 0 2.121 2.136c1.872.505 9.377.505 9.377.505s7.505 0 9.377-.505a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12Z';

    const stripDiagonalArrows = (root: Element) => {
        const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
        let node = walker.nextNode();
        while (node) {
            const value = node.nodeValue;
            if (value && diagonalArrows.test(value)) {
                node.nodeValue = value.replace(diagonalArrows, '').replace(/\s{2,}/g, ' ');
            }
            diagonalArrows.lastIndex = 0;
            node = walker.nextNode();
        }
    };

    const polishDesignReferences = () => {
        document.querySelectorAll<HTMLElement>('.design-reference').forEach((reference) => {
            if (reference.dataset.designReferencePolished === 'true') return;
            reference.dataset.designReferencePolished = 'true';

            const tooltip = reference.querySelector<HTMLElement>('.design-reference-tooltip');
            if (tooltip) tooltip.textContent = 'visit chanhdai.com';

            const title = reference.querySelector('strong');
            if (!title) return;

            const badge = document.createElement('span');
            badge.className = 'design-reference-verified';
            badge.setAttribute('aria-hidden', 'true');
            badge.innerHTML = `<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="${verifiedPath}" /></svg>`;
            title.insertAdjacentElement('afterend', badge);
        });
    };

    const polishSongCredit = () => {
        document.querySelectorAll<HTMLElement>('.nr-song-credit').forEach((credit) => {
            if (credit.dataset.youtubePolished === 'true') return;
            credit.dataset.youtubePolished = 'true';

            credit.querySelectorAll('span[aria-hidden="true"]').forEach((node) => node.remove());

            const icon = document.createElement('span');
            icon.className = 'nr-youtube-icon';
            icon.setAttribute('aria-hidden', 'true');
            icon.innerHTML = `<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="${youtubePath}" /></svg>`;
            credit.prepend(icon);
        });
    };

    let nrSfxContext: AudioContext | null = null;

    const playNrClick = async () => {
        try {
            nrSfxContext ??= new AudioContext();
            if (nrSfxContext.state === 'suspended') await nrSfxContext.resume();

            const context = nrSfxContext;
            const now = context.currentTime;

            const tick = context.createOscillator();
            const tickGain = context.createGain();
            tick.type = 'square';
            tick.frequency.setValueAtTime(720, now);
            tick.frequency.exponentialRampToValueAtTime(260, now + 0.028);
            tickGain.gain.setValueAtTime(0.0001, now);
            tickGain.gain.exponentialRampToValueAtTime(0.025, now + 0.002);
            tickGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.035);
            tick.connect(tickGain).connect(context.destination);
            tick.start(now);
            tick.stop(now + 0.04);

            const thunk = context.createOscillator();
            const thunkGain = context.createGain();
            thunk.type = 'triangle';
            thunk.frequency.setValueAtTime(150, now + 0.004);
            thunk.frequency.exponentialRampToValueAtTime(82, now + 0.045);
            thunkGain.gain.setValueAtTime(0.0001, now + 0.004);
            thunkGain.gain.exponentialRampToValueAtTime(0.035, now + 0.008);
            thunkGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.052);
            thunk.connect(thunkGain).connect(context.destination);
            thunk.start(now + 0.004);
            thunk.stop(now + 0.055);
        } catch {
            // Audio feedback is decorative; playback must still work if Web Audio is unavailable.
        }
    };

    const initNrClickSfx = () => {
        document.querySelectorAll<HTMLButtonElement>('[data-nr-button]').forEach((button) => {
            if (button.dataset.nrClickSfx === 'true') return;
            button.dataset.nrClickSfx = 'true';
            button.addEventListener('click', () => void playNrClick());
        });
    };

    const resumeProjectCarousels = () => {
        document.querySelectorAll<HTMLElement>('.project-carousel-track').forEach((track) => {
            track.getAnimations().forEach((animation) => animation.play());
        });
    };

    const polishUi = () => {
        document.querySelectorAll<HTMLElement>('.home-header, .home-redesign').forEach(stripDiagonalArrows);
        polishDesignReferences();
        polishSongCredit();
        initNrClickSfx();
        resumeProjectCarousels();
    };

    const start = () => {
        polishUi();
        requestAnimationFrame(polishUi);
        window.setTimeout(polishUi, 120);

        const observer = new MutationObserver(() => polishUi());
        observer.observe(document.body, { childList: true, subtree: true });
        window.setTimeout(() => observer.disconnect(), 2000);

        window.addEventListener('pageshow', resumeProjectCarousels);
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') resumeProjectCarousels();
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
        start();
    }
</script>
