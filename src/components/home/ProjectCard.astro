---
import { Image } from 'astro:assets';
import type { WebProject } from '../../data/projects';
import BrandIcon from '../icons/BrandIcon.astro';
import UiIcon from '../icons/UiIcon.astro';
import ProjectTechIcon from './ProjectTechIcon.astro';

interface Props {
    project: WebProject;
    duplicate?: boolean;
}

const { project, duplicate = false } = Astro.props;
const domain = project.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
const tabIndex = duplicate ? -1 : undefined;
const ignoredStackItems = new Set(['Localization', 'Globe.GL']);
const visibleStack = project.stack.filter((item) => !ignoredStackItems.has(item)).slice(0, 5);
---

<article class="project-card" aria-hidden={duplicate ? 'true' : undefined}>
    <a
        class="project-preview"
        href={project.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        tabindex={tabIndex}
        aria-label={`Open ${project.name}`}
    >
        <div class="mac-window-bar" aria-hidden="true">
            <span class="mac-window-controls">
                <i class="mac-dot mac-dot-close"></i>
                <i class="mac-dot mac-dot-minimize"></i>
                <i class="mac-dot mac-dot-maximize"></i>
            </span>
            <span class="mac-address">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="10" width="12" height="9" rx="2"></rect>
                    <path d="M9 10V7a3 3 0 0 1 6 0v3"></path>
                </svg>
                <span>{domain}</span>
            </span>
            <span class="mac-window-spacer"></span>
        </div>

        <div class="project-image-wrap">
            <Image
                src={project.screenshot}
                alt={`${project.name} website preview`}
                class="project-image"
                loading="lazy"
            />
        </div>
    </a>

    <div class="project-info">
        <div class="project-title-row">
            <strong>{project.name}</strong>
            <span class="project-links">
                {project.repoUrl && (
                    <a
                        class="project-action project-action-github"
                        href={project.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        tabindex={tabIndex}
                        aria-label={`${project.name} GitHub repository`}
                    >
                        <BrandIcon name="github" size={12} />
                        <span>GitHub</span>
                    </a>
                )}
                <a
                    class="project-action"
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabindex={tabIndex}
                    aria-label={`Visit ${project.name}`}
                >
                    <span>Live</span>
                    <UiIcon name="arrow-up-right" size={10} strokeWidth={1.5} />
                </a>
            </span>
        </div>

        <div class="project-tech-stack" aria-label={`${project.name} technology stack`}>
            {visibleStack.map((item) => <ProjectTechIcon name={item} duplicate={duplicate} />)}
        </div>
    </div>
</article>

<style>
    .project-card {
        --project-line: color-mix(in oklab, var(--border) 64%, var(--bg));

        position: relative;
        width: clamp(218px, 18vw, 276px);
        height: 100%;
        min-width: 0;
        min-height: 0;
        flex: none;
        display: grid;
        grid-template-rows: minmax(92px, 1fr) auto;
        border: 1px solid var(--project-line);
        background: var(--bg);
        overflow: hidden;
        transition: border-color 160ms ease, transform 160ms ease;
    }

    .project-card:hover,
    .project-card:focus-within {
        border-color: color-mix(in srgb, var(--text) 42%, var(--border));
        transform: translateY(-1px);
    }

    .project-preview {
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-rows: 22px minmax(0, 1fr);
        overflow: hidden;
        border-bottom: 1px solid var(--project-line);
        background: var(--surface);
        outline: none;
    }

    .mac-window-bar {
        min-width: 0;
        padding: 0 7px;
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr) 48px;
        align-items: center;
        gap: 5px;
        border-bottom: 1px solid var(--project-line);
        background: color-mix(in srgb, var(--surface) 82%, var(--bg));
    }

    .mac-window-controls {
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .mac-dot {
        width: 6px;
        height: 6px;
        display: block;
        border: 1px solid color-mix(in srgb, var(--text) 14%, var(--border));
        border-radius: 50%;
        background: color-mix(in srgb, var(--muted) 36%, var(--surface));
        transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }

    .project-card:hover .mac-dot-close,
    .project-card:focus-within .mac-dot-close {
        border-color: #e0443e;
        background: #ff5f57;
    }

    .project-card:hover .mac-dot-minimize,
    .project-card:focus-within .mac-dot-minimize {
        border-color: #d89b16;
        background: #febc2e;
    }

    .project-card:hover .mac-dot-maximize,
    .project-card:focus-within .mac-dot-maximize {
        border-color: #18a73d;
        background: #28c840;
    }

    .mac-address {
        min-width: 0;
        height: 14px;
        padding: 0 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
        background: color-mix(in srgb, var(--bg) 72%, var(--surface));
        color: color-mix(in srgb, var(--muted) 88%, var(--text));
        font-family: var(--font-mono);
        font-size: 6.6px;
        line-height: 1;
    }

    .mac-address svg {
        width: 7px;
        height: 7px;
        flex: none;
        opacity: 0.72;
    }

    .mac-address span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mac-window-spacer {
        width: 48px;
    }

    .project-image-wrap {
        position: relative;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        background: var(--surface);
    }

    .project-image-wrap :global(img) {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: center top;
        filter: grayscale(1) saturate(0.12) contrast(1.03) brightness(0.78);
        opacity: 0.9;
        transform: scale(1.001);
        transition: filter 260ms ease, opacity 260ms ease, transform 260ms ease;
    }

    .project-card:hover .project-image-wrap :global(img),
    .project-card:focus-within .project-image-wrap :global(img) {
        filter: grayscale(0) saturate(1) contrast(1) brightness(0.94);
        opacity: 1;
        transform: scale(1.012);
    }

    .project-info {
        min-width: 0;
        padding: 7px 9px 8px;
        display: grid;
        gap: 5px;
    }

    .project-title-row {
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .project-title-row > strong {
        min-width: 0;
        overflow: hidden;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 11.5px;
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.02em;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .project-links {
        flex: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .project-action {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 7.5px;
        line-height: 1;
        white-space: nowrap;
        transition: color 140ms ease, transform 140ms ease;
    }

    .project-action:hover,
    .project-action:focus-visible {
        color: var(--text);
        transform: translateY(-1px);
        outline: none;
    }

    .project-action-github :global(svg) {
        opacity: 0.82;
    }

    .project-tech-stack {
        min-width: 0;
        min-height: 15px;
        display: flex;
        align-items: center;
        gap: 7px;
        overflow: visible;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .project-card {
            width: clamp(205px, 17.2vw, 260px);
            grid-template-rows: minmax(78px, 1fr) auto;
        }

        .project-preview {
            grid-template-rows: 20px minmax(0, 1fr);
        }

        .mac-window-bar {
            grid-template-columns: 44px minmax(0, 1fr) 44px;
            padding-inline: 6px;
        }

        .mac-window-spacer {
            width: 44px;
        }

        .project-info {
            padding-top: 6px;
            padding-bottom: 7px;
            gap: 4px;
        }

        .project-title-row > strong {
            font-size: 11px;
        }

        .project-tech-stack {
            gap: 6px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .project-card,
        .project-image-wrap :global(img),
        .project-action,
        .mac-dot {
            transition: none;
        }
    }
</style>