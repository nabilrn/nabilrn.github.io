<script>
  const forceStrict24HourChart = () => {
    const region = document.querySelector<HTMLElement>('.analytics-region');
    if (!region) return;

    const period = region.querySelector<HTMLElement>('[data-analytics-period]');
    const spark = region.querySelector<HTMLElement>('[data-analytics-spark]');
    const chartWrap = region.querySelector<HTMLElement>('[data-analytics-chart-wrap]');
    const captionStart = region.querySelector<HTMLElement>('[data-analytics-caption-start]');
    const captionEnd = region.querySelector<HTMLElement>('[data-analytics-caption-end]');
    if (!spark || !period) return;

    const isLegacyMode = /30\s*d|30\s*days/i.test(period.textContent ?? '');
    const hasWrongBucketCount = spark.children.length !== 24;
    if (!isLegacyMode && !hasWrongBucketCount) return;

    period.textContent = 'last 24h';
    if (captionStart) captionStart.textContent = '24h ago';
    if (captionEnd) captionEnd.textContent = 'now';
    chartWrap?.setAttribute('aria-label', 'Pageviews during the last 24 hours');
    spark.setAttribute('aria-label', 'Hourly analytics during the last 24 hours');

    const formatter = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const now = new Date();
    now.setMinutes(0, 0, 0);

    const bars = Array.from({ length: 24 }, (_, index) => {
      const start = new Date(now);
      start.setHours(start.getHours() - (23 - index));
      const end = new Date(start.getTime() + 3_600_000);
      const detail = `${formatter.format(start)}–${formatter.format(end)} · hourly data unavailable`;
      const bar = document.createElement('span');
      bar.style.height = '2px';
      bar.tabIndex = 0;
      bar.setAttribute('role', 'listitem');
      bar.setAttribute('aria-label', detail);
      bar.dataset.analyticsTooltip = detail;
      return bar;
    });
    spark.replaceChildren(...bars);
  };

  let queued = false;
  const queueCheck = () => {
    if (queued) return;
    queued = true;
    queueMicrotask(() => {
      queued = false;
      forceStrict24HourChart();
    });
  };

  const observer = new MutationObserver(queueCheck);
  observer.observe(document.documentElement, {
    childList: true,
    subtree: true,
    characterData: true,
  });

  queueCheck();
  window.addEventListener('load', queueCheck, { once: true });
</script>
