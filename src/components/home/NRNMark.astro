---
type Point = { x: number; y: number };
type Tile = { x: number; y: number };
type Edge = { a: Point; b: Point };
type Letter = {
    id: string;
    tiles: Tile[];
    topEdges: Edge[];
    sideEdges: Edge[];
    sideCorners: Point[];
};

const VIEWBOX_WIDTH = 1236;
const VIEWBOX_HEIGHT = 761;
const DEPTH = 28;

// Approved Figma geometry uses a 56x28 isometric tile (28px half-step).
const N_TILES: Tile[] = [
    { x: 168, y: 0 },
    { x: 336, y: 84 },
    { x: 140, y: 14 },
    { x: 308, y: 98 },
    { x: 112, y: 28 },
    { x: 280, y: 112 },
    { x: 84, y: 42 },
    { x: 252, y: 126 },
    { x: 56, y: 56 },
    { x: 224, y: 140 },
    { x: 28, y: 70 },
    { x: 196, y: 154 },
    { x: 0, y: 84 },
    { x: 168, y: 168 },
    { x: 168, y: 28 },
    { x: 168, y: 56 },
    { x: 168, y: 84 },
    { x: 168, y: 112 },
    { x: 168, y: 140 },
];

const R_TILES: Tile[] = [
    { x: 188, y: 20 },
    { x: 216, y: 34 },
    { x: 244, y: 48 },
    { x: 272, y: 62 },
    { x: 160, y: 34 },
    { x: 272, y: 90 },
    { x: 132, y: 48 },
    { x: 244, y: 104 },
    { x: 104, y: 62 },
    { x: 132, y: 76 },
    { x: 160, y: 90 },
    { x: 188, y: 104 },
    { x: 76, y: 76 },
    { x: 132, y: 104 },
    { x: 48, y: 90 },
    { x: 132, y: 132 },
    { x: 20, y: 104 },
    { x: 132, y: 160 },
];

const diamondPoints = ({ x, y }: Tile): Point[] => [
    { x: x + 28, y },
    { x: x + 56, y: y + 14 },
    { x: x + 28, y: y + 28 },
    { x, y: y + 14 },
];

const pointKey = ({ x, y }: Point) => `${x.toFixed(3)},${y.toFixed(3)}`;
const edgeKey = (a: Point, b: Point) => {
    const ak = pointKey(a);
    const bk = pointKey(b);
    return ak < bk ? `${ak}|${bk}` : `${bk}|${ak}`;
};

const buildBoundary = (tiles: Tile[]) => {
    const edges = new Map<string, { edge: Edge; count: number; edgeIndex: number }>();

    tiles.forEach((tile) => {
        const points = diamondPoints(tile);
        points.forEach((a, edgeIndex) => {
            const b = points[(edgeIndex + 1) % points.length];
            const key = edgeKey(a, b);
            const existing = edges.get(key);
            if (existing) existing.count += 1;
            else edges.set(key, { edge: { a, b }, count: 1, edgeIndex });
        });
    });

    const topEdges = Array.from(edges.values())
        .filter(({ count }) => count === 1)
        .map(({ edge }) => edge);

    // On this isometric projection only the two downward-facing diamond edges
    // form visible extrusion walls. Internal tile edges are cancelled above.
    const sideEdges = Array.from(edges.values())
        .filter(({ count, edgeIndex }) => count === 1 && (edgeIndex === 1 || edgeIndex === 2))
        .map(({ edge }) => edge);

    const cornerMap = new Map<string, { point: Point; vectors: Point[] }>();
    sideEdges.forEach(({ a, b }) => {
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const length = Math.hypot(dx, dy) || 1;
        const vector = { x: dx / length, y: dy / length };
        const reverse = { x: -vector.x, y: -vector.y };

        const aKey = pointKey(a);
        const bKey = pointKey(b);
        const atA = cornerMap.get(aKey) ?? { point: a, vectors: [] };
        const atB = cornerMap.get(bKey) ?? { point: b, vectors: [] };
        atA.vectors.push(vector);
        atB.vectors.push(reverse);
        cornerMap.set(aKey, atA);
        cornerMap.set(bKey, atB);
    });

    const sideCorners = Array.from(cornerMap.values())
        .filter(({ vectors }) => {
            if (vectors.length !== 2) return true;
            const [first, second] = vectors;
            return Math.abs(first.x * second.y - first.y * second.x) > 0.001;
        })
        .map(({ point }) => point);

    return { topEdges, sideEdges, sideCorners };
};

const offsetPoint = (point: Point, x: number, y: number): Point => ({ x: point.x + x, y: point.y + y });
const offsetTiles = (tiles: Tile[], x: number, y: number): Tile[] =>
    tiles.map((tile) => ({ x: tile.x + x, y: tile.y + y }));
const offsetEdges = (edges: Edge[], x: number, y: number): Edge[] =>
    edges.map(({ a, b }) => ({ a: offsetPoint(a, x, y), b: offsetPoint(b, x, y) }));

const createLetter = (id: string, tiles: Tile[], offsetX: number, offsetY: number): Letter => {
    const boundary = buildBoundary(tiles);
    return {
        id,
        tiles: offsetTiles(tiles, offsetX, offsetY),
        topEdges: offsetEdges(boundary.topEdges, offsetX, offsetY),
        sideEdges: offsetEdges(boundary.sideEdges, offsetX, offsetY),
        sideCorners: boundary.sideCorners.map((point) => offsetPoint(point, offsetX, offsetY)),
    };
};

// Positions are taken from approved Figma frame 89:411.
const letters: Letter[] = [
    createLetter('n-left', N_TILES, 204, 127),
    createLetter('r', R_TILES, 450, 248),
    createLetter('n-right', N_TILES, 673, 364),
];

const pointsString = (points: Point[], press = 0) =>
    points.map(({ x, y }) => `${x.toFixed(2)},${(y + press).toFixed(2)}`).join(' ');

const sidePointsString = ({ a, b }: Edge, press = 0) =>
    [
        { x: a.x, y: a.y + press },
        { x: b.x, y: b.y + press },
        { x: b.x, y: b.y + DEPTH },
        { x: a.x, y: a.y + DEPTH },
    ]
        .map(({ x, y }) => `${x.toFixed(2)},${y.toFixed(2)}`)
        .join(' ');

const topStrokePath = (edges: Edge[], press = 0) =>
    edges
        .map(({ a, b }) => `M${a.x.toFixed(2)} ${(a.y + press).toFixed(2)}L${b.x.toFixed(2)} ${(b.y + press).toFixed(2)}`)
        .join('');

const sideStrokePath = (edges: Edge[], corners: Point[], press = 0) => {
    const path: string[] = [];
    edges.forEach(({ a, b }) => {
        path.push(
            `M${a.x.toFixed(2)} ${(a.y + DEPTH).toFixed(2)}L${b.x.toFixed(2)} ${(b.y + DEPTH).toFixed(2)}`,
        );
    });
    corners.forEach(({ x, y }) => {
        path.push(`M${x.toFixed(2)} ${(y + press).toFixed(2)}L${x.toFixed(2)} ${(y + DEPTH).toFixed(2)}`);
    });
    return path.join('');
};
---

<div class="nrn-stage" data-nrn-stage>
    <button
        class="nrn-mark"
        type="button"
        data-nrn-mark
        aria-label="Press the interactive NRN mark"
        aria-pressed="false"
    >
        <svg
            class="nrn-svg"
            data-nrn-svg
            viewBox={`0 0 ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Raised isometric NRN monogram"
        >
            <defs>
                <pattern id="nrn-face-pattern" x="0" y="0" width="12" height="12" patternUnits="userSpaceOnUse">
                    <path d="M-4 12L12 -4M2 16L16 2" class="nrn-pattern-line" />
                </pattern>

                <radialGradient
                    id="nrn-radial-gradient"
                    data-nrn-gradient
                    cx={VIEWBOX_WIDTH / 2}
                    cy={VIEWBOX_HEIGHT / 2}
                    r="310"
                    gradientUnits="userSpaceOnUse"
                >
                    <stop offset="0" class="nrn-glow-start" />
                    <stop offset="1" class="nrn-glow-end" />
                </radialGradient>
            </defs>

            <g class="nrn-guides" aria-hidden="true">
                <path d="M24 704L1188 32" />
                <path d="M-96 182L916 766" />
                <path d="M198 -46L1210 538" />
            </g>

            {letters.map((letter) => (
                <g
                    data-letter
                    data-top-edges={JSON.stringify(letter.topEdges)}
                    data-side-edges={JSON.stringify(letter.sideEdges)}
                    data-side-corners={JSON.stringify(letter.sideCorners)}
                >
                    <g class="nrn-side-layer" aria-hidden="true">
                        {letter.sideEdges.map((edge) => (
                            <polygon
                                class="nrn-side"
                                data-side-edge={JSON.stringify(edge)}
                                points={sidePointsString(edge)}
                            />
                        ))}
                    </g>

                    <g class="nrn-top-layer" data-nrn-top aria-hidden="true">
                        {letter.tiles.map((tile) => {
                            const points = diamondPoints(tile);
                            return (
                                <g data-top-tile data-points={JSON.stringify(points)}>
                                    <polygon class="nrn-top-bg" data-top-bg points={pointsString(points)} />
                                    <polygon class="nrn-top-pattern" data-top-pattern points={pointsString(points)} />
                                </g>
                            );
                        })}
                    </g>

                    <g class="nrn-stroke-layer" aria-hidden="true">
                        <path
                            class="nrn-stroke-base nrn-top-stroke"
                            data-top-stroke-base
                            d={topStrokePath(letter.topEdges)}
                        />
                        <path
                            class="nrn-stroke-glow nrn-top-stroke"
                            data-top-stroke-glow
                            d={topStrokePath(letter.topEdges)}
                        />
                        <path
                            class="nrn-stroke-base nrn-side-stroke"
                            data-side-stroke-base
                            d={sideStrokePath(letter.sideEdges, letter.sideCorners)}
                        />
                        <path
                            class="nrn-stroke-glow nrn-side-stroke"
                            data-side-stroke-glow
                            d={sideStrokePath(letter.sideEdges, letter.sideCorners)}
                        />
                    </g>
                </g>
            ))}

            <text class="nrn-fig-label" x="64" y="688">FIG. 01 / NRN SYSTEM</text>
        </svg>
    </button>

    <div class="nrn-note" aria-hidden="true">
        <svg viewBox="0 0 54 54">
            <path d="M49 6C37 8 28 14 23 23C18 31 19 39 24 45" />
            <path d="M17 39L24 46L31 39" />
        </svg>
        <span>
            follows your cursor
            <small>click the mark</small>
        </span>
    </div>
</div>

<style>
    .nrn-stage {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        color: var(--text);
        background: var(--bg);
        --nrn-top: color-mix(in srgb, var(--surface) 55%, var(--bg));
        --nrn-side: color-mix(in srgb, var(--surface) 22%, var(--bg));
        --nrn-outline: color-mix(in srgb, var(--text) 55%, var(--bg));
        --nrn-hatch: color-mix(in srgb, var(--text) 29%, var(--bg));
    }

    .nrn-mark {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .nrn-mark:focus-visible {
        outline: 1px solid color-mix(in srgb, var(--text) 72%, transparent);
        outline-offset: -5px;
    }

    .nrn-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nrn-guides {
        fill: none;
        stroke: color-mix(in srgb, var(--text) 8%, var(--bg));
        stroke-width: 1;
        stroke-dasharray: 5 5;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
    }

    .nrn-pattern-line {
        fill: none;
        stroke: var(--nrn-hatch);
        stroke-width: 0.9;
        opacity: 0.48;
        vector-effect: non-scaling-stroke;
    }

    .nrn-side {
        fill: var(--nrn-side);
        stroke: none;
    }

    .nrn-top-bg {
        fill: var(--nrn-top);
        stroke: none;
    }

    .nrn-top-pattern {
        fill: url(#nrn-face-pattern);
        stroke: none;
    }

    .nrn-stroke-base,
    .nrn-stroke-glow {
        fill: none;
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-top-stroke {
        stroke-width: 1.35;
    }

    .nrn-side-stroke {
        stroke-width: 1.2;
    }

    .nrn-stroke-base {
        stroke: var(--nrn-outline);
    }

    .nrn-stroke-glow {
        stroke: url(#nrn-radial-gradient);
        pointer-events: none;
    }

    .nrn-glow-start {
        stop-color: color-mix(in srgb, var(--text) 98%, var(--bg));
        stop-opacity: 1;
    }

    .nrn-glow-end {
        stop-color: color-mix(in srgb, var(--text) 55%, var(--bg));
        stop-opacity: 0;
    }

    .nrn-fig-label {
        fill: color-mix(in srgb, var(--muted) 62%, var(--bg));
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.04em;
        user-select: none;
    }

    .nrn-note {
        position: absolute;
        right: 5%;
        bottom: 11%;
        display: flex;
        align-items: flex-end;
        gap: 4px;
        color: color-mix(in srgb, var(--text) 72%, var(--muted));
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: clamp(11px, 0.95vw, 15px);
        font-style: italic;
        line-height: 1.2;
        transform: rotate(-3deg);
        pointer-events: none;
        user-select: none;
    }

    .nrn-note span {
        display: flex;
        flex-direction: column;
    }

    .nrn-note small {
        margin-top: 2px;
        font: inherit;
        opacity: 0.76;
    }

    .nrn-note svg {
        width: 48px;
        height: 48px;
        overflow: visible;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.05;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.78;
        transform: rotate(-12deg) translateY(4px);
    }

    @media (max-width: 720px) {
        .nrn-note {
            right: 4%;
            bottom: 8%;
        }
    }

    @media (hover: none) {
        .nrn-note {
            display: none;
        }
    }
</style>

<script>
    type Point = { x: number; y: number };
    type Edge = { a: Point; b: Point };
    type SpringState = { value: number; velocity: number };
    type LetterRuntime = {
        topTiles: Array<{ element: SVGPolygonElement; points: Point[] }>;
        sidePolygons: Array<{ element: SVGPolygonElement; edge: Edge }>;
        topEdges: Edge[];
        sideEdges: Edge[];
        sideCorners: Point[];
        topStrokes: SVGPathElement[];
        sideStrokes: SVGPathElement[];
    };

    const VIEWBOX_W = 1236;
    const VIEWBOX_H = 761;
    const EXTRUSION_DEPTH = 28;
    const PRESS_DEPTH = 16;

    const springAdvance = (
        state: SpringState,
        target: number,
        stiffness: number,
        damping: number,
        mass: number,
        dt: number,
    ) => {
        const substep = 1 / 240;
        const steps = Math.max(1, Math.ceil(dt / substep));
        const h = dt / steps;

        for (let index = 0; index < steps; index += 1) {
            const force = -stiffness * (state.value - target) - damping * state.velocity;
            const acceleration = force / mass;
            state.velocity += acceleration * h;
            state.value += state.velocity * h;
        }
    };

    const pointsToString = (points: Point[], press: number) =>
        points.map((point) => `${point.x.toFixed(2)},${(point.y + press).toFixed(2)}`).join(' ');

    const sideToString = (edge: Edge, press: number) =>
        [
            { x: edge.a.x, y: edge.a.y + press },
            { x: edge.b.x, y: edge.b.y + press },
            { x: edge.b.x, y: edge.b.y + EXTRUSION_DEPTH },
            { x: edge.a.x, y: edge.a.y + EXTRUSION_DEPTH },
        ]
            .map((point) => `${point.x.toFixed(2)},${point.y.toFixed(2)}`)
            .join(' ');

    const topToPath = (edges: Edge[], press: number) =>
        edges
            .map(
                ({ a, b }) =>
                    `M${a.x.toFixed(2)} ${(a.y + press).toFixed(2)}L${b.x.toFixed(2)} ${(b.y + press).toFixed(2)}`,
            )
            .join('');

    const sideToPath = (edges: Edge[], corners: Point[], press: number) => {
        const path: string[] = [];
        edges.forEach(({ a, b }) => {
            path.push(
                `M${a.x.toFixed(2)} ${(a.y + EXTRUSION_DEPTH).toFixed(2)}L${b.x.toFixed(2)} ${(b.y + EXTRUSION_DEPTH).toFixed(2)}`,
            );
        });
        corners.forEach(({ x, y }) => {
            path.push(
                `M${x.toFixed(2)} ${(y + press).toFixed(2)}L${x.toFixed(2)} ${(y + EXTRUSION_DEPTH).toFixed(2)}`,
            );
        });
        return path.join('');
    };

    const springLoop = (root: HTMLElement) => {
        if (root.dataset.nrnReady === 'true') return;
        root.dataset.nrnReady = 'true';

        const mark = root.querySelector<HTMLButtonElement>('[data-nrn-mark]');
        if (!mark) return;

        const svg = mark.querySelector<SVGSVGElement>('[data-nrn-svg]');
        const gradient = mark.querySelector<SVGRadialGradientElement>('[data-nrn-gradient]');
        if (!svg || !gradient) return;

        const letters: LetterRuntime[] = Array.from(mark.querySelectorAll<SVGGElement>('[data-letter]')).map(
            (group) => ({
                topTiles: Array.from(group.querySelectorAll<SVGPolygonElement>('[data-top-bg]')).map((element) => ({
                    element,
                    points: JSON.parse(element.closest<SVGGElement>('[data-top-tile]')?.dataset.points ?? '[]') as Point[],
                })),
                sidePolygons: Array.from(group.querySelectorAll<SVGPolygonElement>('[data-side-edge]')).map(
                    (element) => ({
                        element,
                        edge: JSON.parse(element.dataset.sideEdge ?? '{}') as Edge,
                    }),
                ),
                topEdges: JSON.parse(group.dataset.topEdges ?? '[]') as Edge[],
                sideEdges: JSON.parse(group.dataset.sideEdges ?? '[]') as Edge[],
                sideCorners: JSON.parse(group.dataset.sideCorners ?? '[]') as Point[],
                topStrokes: Array.from(
                    group.querySelectorAll<SVGPathElement>('[data-top-stroke-base], [data-top-stroke-glow]'),
                ),
                sideStrokes: Array.from(
                    group.querySelectorAll<SVGPathElement>('[data-side-stroke-base], [data-side-stroke-glow]'),
                ),
            }),
        );

        // Add the hatch polygons to each tile runtime while retaining one source set of points.
        letters.forEach((letter, letterIndex) => {
            const group = mark.querySelectorAll<SVGGElement>('[data-letter]')[letterIndex];
            const bgTiles = letter.topTiles;
            const patternTiles = Array.from(group.querySelectorAll<SVGPolygonElement>('[data-top-pattern]'));
            patternTiles.forEach((pattern, tileIndex) => {
                const source = bgTiles[tileIndex];
                if (!source) return;
                letter.topTiles.push({ element: pattern, points: source.points });
            });
        });

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
        const cursorX: SpringState = { value: VIEWBOX_W / 2, velocity: 0 };
        const cursorY: SpringState = { value: VIEWBOX_H / 2, velocity: 0 };
        const press: SpringState = { value: 0, velocity: 0 };
        let cursorTargetX = VIEWBOX_W / 2;
        let cursorTargetY = VIEWBOX_H / 2;
        let pressTarget = 0;
        let pressed = false;
        let inView = true;
        let raf = 0;
        let lastTime = performance.now();
        let audioContext: AudioContext | null = null;

        const renderPress = (value: number) => {
            letters.forEach((letter) => {
                letter.topTiles.forEach(({ element, points }) => {
                    element.setAttribute('points', pointsToString(points, value));
                });
                letter.sidePolygons.forEach(({ element, edge }) => {
                    element.setAttribute('points', sideToString(edge, value));
                });

                const topPath = topToPath(letter.topEdges, value);
                letter.topStrokes.forEach((element) => element.setAttribute('d', topPath));

                const sidePath = sideToPath(letter.sideEdges, letter.sideCorners, value);
                letter.sideStrokes.forEach((element) => element.setAttribute('d', sidePath));
            });
        };

        const playClick = () => {
            try {
                audioContext ??= new AudioContext();
                const now = audioContext.currentTime;
                const oscillator = audioContext.createOscillator();
                const gain = audioContext.createGain();
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(155, now);
                oscillator.frequency.exponentialRampToValueAtTime(92, now + 0.055);
                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.exponentialRampToValueAtTime(0.055, now + 0.006);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.07);
                oscillator.connect(gain);
                gain.connect(audioContext.destination);
                oscillator.start(now);
                oscillator.stop(now + 0.075);
            } catch {
                // Audio is optional; interaction remains fully functional without it.
            }
        };

        const pressDown = () => {
            if (pressed) return;
            pressed = true;
            pressTarget = PRESS_DEPTH;
            mark.setAttribute('aria-pressed', 'true');
        };

        const release = (withSound = true) => {
            if (!pressed) return;
            pressed = false;
            pressTarget = 0;
            mark.setAttribute('aria-pressed', 'false');
            if (withSound) playClick();
        };

        const onPointerMove = (event: PointerEvent) => {
            if (!finePointer.matches) return;
            cursorTargetX = (event.clientX / Math.max(window.innerWidth, 1)) * VIEWBOX_W;
            cursorTargetY = (event.clientY / Math.max(window.innerHeight, 1)) * VIEWBOX_H;
        };

        window.addEventListener('pointermove', onPointerMove, { passive: true });

        mark.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            mark.setPointerCapture?.(event.pointerId);
            pressDown();
        });
        mark.addEventListener('pointerup', (event) => {
            if (mark.hasPointerCapture?.(event.pointerId)) mark.releasePointerCapture?.(event.pointerId);
            release(true);
        });
        mark.addEventListener('pointercancel', () => release(false));
        mark.addEventListener('lostpointercapture', () => release(false));
        mark.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            pressDown();
        });
        mark.addEventListener('keyup', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            release(true);
        });
        mark.addEventListener('blur', () => release(false));

        const observer = new IntersectionObserver(
            ([entry]) => {
                inView = entry?.isIntersecting ?? true;
            },
            { threshold: 0.01 },
        );
        observer.observe(root);

        const tick = (now: number) => {
            const dt = Math.min((now - lastTime) / 1000, 0.05);
            lastTime = now;

            if (reducedMotion.matches) {
                cursorX.value = cursorTargetX;
                cursorY.value = cursorTargetY;
                cursorX.velocity = 0;
                cursorY.velocity = 0;
                press.value = pressTarget;
                press.velocity = 0;
            } else {
                springAdvance(cursorX, cursorTargetX, 300, 30, 0.1, dt);
                springAdvance(cursorY, cursorTargetY, 300, 30, 0.1, dt);
                springAdvance(press, pressTarget, 200, 18, 0.5, dt);
            }

            if (inView) {
                gradient.setAttribute('cx', cursorX.value.toFixed(2));
                gradient.setAttribute('cy', cursorY.value.toFixed(2));
                renderPress(press.value);
            }

            raf = requestAnimationFrame(tick);
        };

        renderPress(0);
        raf = requestAnimationFrame(tick);

        window.addEventListener(
            'pagehide',
            () => {
                cancelAnimationFrame(raf);
                observer.disconnect();
                window.removeEventListener('pointermove', onPointerMove);
            },
            { once: true },
        );
    };

    document.querySelectorAll<HTMLElement>('[data-nrn-stage]').forEach(springLoop);
</script>
