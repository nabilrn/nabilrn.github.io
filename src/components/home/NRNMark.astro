---
const VIEWBOX_X = 40;
const VIEWBOX_Y = 20;
const VIEWBOX_WIDTH = 888;
const VIEWBOX_HEIGHT = 560;

// Final approved geometry from Figma frame 233:291 (NRN 3D — FINAL).
const N_FRONT_PATH = 'M 0 84 L 28 70 L 162.39999389648438 137.1999969482422 L 140 14 L 168 0 L 336 84 L 308 98 L 173.60000610351562 30.799999237060547 L 196 154 L 168 168 L 0 84 Z';
const N_EXTRUSION_PATH = 'M 0.23104122281074524 82.61089324951172 L 0 110.60993957519531 L 27.883525848388672 124.84050750732422 L 157.21035766601562 61.504119873046875 L 139.64866638183594 153.7637176513672 L 139.41763305664062 181.7627716064453 L 167.30116271972656 195.9933319091797 L 335.9885559082031 113.38243865966797 L 336.2196044921875 85.38338470458984 L 308.3360900878906 71.15282440185547 L 179.00926208496094 134.4872589111328 L 196.57093811035156 42.229610443115234 L 196.80197143554688 14.230565071105957 L 168.91844177246094 0 L 0.23104122281074524 82.61089324951172 Z';
const N_DEPTH_PATH = 'M 0 97.84967041015625 L 0.2227897346019745 70.8505859375 M 139.58937072753906 26.999080657958984 L 139.81216430664062 0';
const R_FRONT_PATH = 'M 168 0 L 240.36923217773438 36.18461608886719 C 277.8461570739746 54.923078536987305 283.01537322998047 74.30768966674805 257.1692199707031 87.23076629638672 C 231.32306671142578 100.15384292602539 193.84615898132324 98.21538543701172 165.41539001464844 84 L 138.27691650390625 153.13845825195312 L 102.0923080444336 135.04615783691406 L 124.06153869628906 73.66153717041016 L 99.5076904296875 61.38461685180664 L 27.13846206665039 97.56922912597656 L 0 84 L 168 0 Z M 169.2923126220703 26.492307662963867 L 214.5230712890625 49.10769271850586 C 236.49230194091797 60.09230899810791 241.66153526306152 69.13846349716187 231.3230743408203 74.30769348144531 C 220.98461246490479 79.47692441940308 202.8923110961914 76.89230823516846 180.92308044433594 65.9076919555664 L 135.6923065185547 43.29230880737305 L 169.2923126220703 26.492307662963867 Z';

const LEFT_N_MATRIX = 'matrix(-0.999965966 -0.008251472 -0.008251472 0.999965966 440.330566 75.151489)';
const LEFT_N_DEPTH_MATRIX = 'matrix(-0.999965966 -0.008251472 -0.008251472 0.999965966 271.807373 171.153687)';
const RIGHT_N_MATRIX = 'matrix(-0.999965966 -0.008251472 -0.008251472 0.999965966 866.330566 275.151489)';
const RIGHT_N_DEPTH_MATRIX = 'matrix(-0.999965966 -0.008251472 -0.008251472 0.999965966 697.807373 371.153687)';
const R_MATRIX = 'matrix(0.999965966 0.008251472 -0.008251472 0.999965966 332.126709 179.541138)';
const R_BACK_MATRIX = 'matrix(0.999965966 0.008251472 -0.008251472 0.999965966 331.895668 207.540185)';

// The hatch is one global field, not one pattern per letter. This keeps N → R → N
// phase, direction and spacing continuous exactly as approved in Figma.
const HATCH_DIRECTION = { x: 0.5885843638383417, y: 0.808435802426522 };
const HATCH_NORMAL = { x: -0.808435802426522, y: 0.5885843638383417 };
const HATCH_SPACING = 5.357116234906698;
const HATCH_LENGTH = 1500;
const HATCH_PHASE = 0;

const hatchCorners = [
    { x: VIEWBOX_X, y: VIEWBOX_Y },
    { x: VIEWBOX_X + VIEWBOX_WIDTH, y: VIEWBOX_Y },
    { x: VIEWBOX_X, y: VIEWBOX_Y + VIEWBOX_HEIGHT },
    { x: VIEWBOX_X + VIEWBOX_WIDTH, y: VIEWBOX_Y + VIEWBOX_HEIGHT },
];
const hatchProjection = hatchCorners.map(({ x, y }) => x * HATCH_NORMAL.x + y * HATCH_NORMAL.y);
const hatchMin = Math.min(...hatchProjection) - 120;
const hatchMax = Math.max(...hatchProjection) + 120;
const hatchStart = Math.floor((hatchMin - HATCH_PHASE) / HATCH_SPACING) * HATCH_SPACING + HATCH_PHASE;
const hatchSegments: string[] = [];
for (let offset = hatchStart; offset <= hatchMax; offset += HATCH_SPACING) {
    const cx = HATCH_NORMAL.x * offset;
    const cy = HATCH_NORMAL.y * offset;
    const x1 = cx - HATCH_DIRECTION.x * HATCH_LENGTH;
    const y1 = cy - HATCH_DIRECTION.y * HATCH_LENGTH;
    const x2 = cx + HATCH_DIRECTION.x * HATCH_LENGTH;
    const y2 = cy + HATCH_DIRECTION.y * HATCH_LENGTH;
    hatchSegments.push(`M ${x1.toFixed(3)} ${y1.toFixed(3)} L ${x2.toFixed(3)} ${y2.toFixed(3)}`);
}
const GLOBAL_HATCH_PATH = hatchSegments.join(' ');

const R_CONNECTORS = 'M 0 84 L 0 112 M 27.138462 97.569229 L 27.138462 125.569229 M 102.092308 135.046158 L 102.092308 163.046158 M 138.276917 153.138458 L 138.276917 181.138458 M 257.16922 87.230767 L 257.16922 115.230767';
---

<div class="nrn-stage" data-nrn-stage>
    <button
        class="nrn-mark"
        type="button"
        data-nrn-mark
        aria-label="Press the interactive NRN mark"
        aria-pressed="false"
    >
        <svg
            class="nrn-svg"
            data-nrn-svg
            viewBox={`${VIEWBOX_X} ${VIEWBOX_Y} ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
            preserveAspectRatio="xMidYMid meet"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Continuous isometric NRN monogram"
        >
            <defs>
                <clipPath id="nrn-surface-clip" clipPathUnits="userSpaceOnUse">
                    <path d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" clip-rule="evenodd" />
                    <path d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </clipPath>

                <radialGradient
                    id="nrn-radial-gradient"
                    data-nrn-gradient
                    cx="484"
                    cy="300"
                    r="260"
                    gradientUnits="userSpaceOnUse"
                >
                    <stop offset="0" class="nrn-glow-start" />
                    <stop offset="1" class="nrn-glow-end" />
                </radialGradient>
            </defs>

            <g class="nrn-guides" aria-hidden="true">
                <path d="M 24 568 L 936 42" />
                <path d="M -20 132 L 894 660" />
                <path d="M 174 -24 L 948 422" />
            </g>

            <g data-nrn-art>
                <!-- N left: exact visible extrusion from the approved Figma geometry. -->
                <g class="nrn-side-layer" aria-hidden="true">
                    <path class="nrn-side-stroke" d={N_EXTRUSION_PATH} transform="translate(103.417725 73.765259)" />
                    <path class="nrn-side-glow" d={N_EXTRUSION_PATH} transform="translate(103.417725 73.765259)" />
                    <path class="nrn-depth-stroke" d={N_DEPTH_PATH} transform={LEFT_N_DEPTH_MATRIX} />
                    <path class="nrn-depth-glow" d={N_DEPTH_PATH} transform={LEFT_N_DEPTH_MATRIX} />
                </g>

                <!-- R: same 28px depth system, with the front surface masking hidden rear edges. -->
                <g class="nrn-side-layer" aria-hidden="true">
                    <path class="nrn-side-stroke nrn-r-back" d={R_FRONT_PATH} transform={R_BACK_MATRIX} fill-rule="evenodd" />
                    <path class="nrn-side-glow" d={R_FRONT_PATH} transform={R_BACK_MATRIX} fill-rule="evenodd" />
                    <path class="nrn-depth-stroke" d={R_CONNECTORS} transform={R_MATRIX} />
                    <path class="nrn-depth-glow" d={R_CONNECTORS} transform={R_MATRIX} />
                </g>

                <!-- N right: exact duplicate of the approved N with its final aligned transform. -->
                <g class="nrn-side-layer" aria-hidden="true">
                    <path class="nrn-side-stroke" d={N_EXTRUSION_PATH} transform="translate(529.417725 273.765259)" />
                    <path class="nrn-side-glow" d={N_EXTRUSION_PATH} transform="translate(529.417725 273.765259)" />
                    <path class="nrn-depth-stroke" d={N_DEPTH_PATH} transform={RIGHT_N_DEPTH_MATRIX} />
                    <path class="nrn-depth-glow" d={N_DEPTH_PATH} transform={RIGHT_N_DEPTH_MATRIX} />
                </g>

                <!-- Opaque-to-background front surfaces emulate solid geometry while remaining visually fill-less. -->
                <g class="nrn-front-fill" aria-hidden="true">
                    <path d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" />
                    <path d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </g>

                <!-- One global hatch field is clipped by all three surfaces, so the lines visually continue across NRN. -->
                <path
                    class="nrn-global-hatch"
                    d={GLOBAL_HATCH_PATH}
                    clip-path="url(#nrn-surface-clip)"
                    aria-hidden="true"
                />

                <g class="nrn-front-strokes" aria-hidden="true">
                    <path class="nrn-front-stroke" d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path class="nrn-front-glow" d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path class="nrn-front-stroke" d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" />
                    <path class="nrn-front-glow" d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" />
                    <path class="nrn-front-stroke" d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                    <path class="nrn-front-glow" d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </g>
            </g>

            <text class="nrn-fig-label" x="70" y="538">FIG. 01 / NRN SYSTEM</text>
        </svg>
    </button>

    <div class="nrn-note" aria-hidden="true">
        <svg viewBox="0 0 54 54">
            <path d="M49 6C37 8 28 14 23 23C18 31 19 39 24 45" />
            <path d="M17 39L24 46L31 39" />
        </svg>
        <span>
            follows your cursor
            <small>click the mark</small>
        </span>
    </div>
</div>

<style>
    .nrn-stage {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        color: var(--text);
        background: var(--bg);
        --nrn-outline: color-mix(in srgb, var(--text) 55%, var(--bg));
        --nrn-side-outline: color-mix(in srgb, var(--text) 46%, var(--bg));
        --nrn-hatch: color-mix(in srgb, var(--text) 49%, var(--bg));
    }

    .nrn-mark {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .nrn-mark:focus-visible {
        outline: 1px solid color-mix(in srgb, var(--text) 72%, transparent);
        outline-offset: -5px;
    }

    .nrn-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nrn-guides {
        fill: none;
        stroke: color-mix(in srgb, var(--text) 7%, var(--bg));
        stroke-width: 1;
        stroke-dasharray: 5 5;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
    }

    .nrn-front-fill path {
        fill: var(--bg);
        stroke: none;
    }

    .nrn-side-stroke,
    .nrn-side-glow,
    .nrn-depth-stroke,
    .nrn-depth-glow,
    .nrn-front-stroke,
    .nrn-front-glow,
    .nrn-global-hatch {
        fill: none;
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-side-stroke,
    .nrn-depth-stroke {
        stroke: var(--nrn-side-outline);
    }

    .nrn-side-stroke {
        stroke-width: 1.25;
    }

    .nrn-depth-stroke {
        stroke-width: 1;
    }

    .nrn-front-stroke {
        stroke: var(--nrn-outline);
        stroke-width: 1.25;
    }

    .nrn-global-hatch {
        stroke: var(--nrn-hatch);
        stroke-width: 0.45;
        opacity: 0.66;
        pointer-events: none;
    }

    .nrn-side-glow,
    .nrn-depth-glow,
    .nrn-front-glow {
        stroke: url(#nrn-radial-gradient);
        pointer-events: none;
    }

    .nrn-side-glow,
    .nrn-front-glow {
        stroke-width: 1.25;
    }

    .nrn-depth-glow {
        stroke-width: 1;
    }

    .nrn-glow-start {
        stop-color: color-mix(in srgb, var(--text) 98%, var(--bg));
        stop-opacity: 0.95;
    }

    .nrn-glow-end {
        stop-color: color-mix(in srgb, var(--text) 52%, var(--bg));
        stop-opacity: 0;
    }

    .nrn-fig-label {
        fill: color-mix(in srgb, var(--muted) 58%, var(--bg));
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        user-select: none;
    }

    .nrn-note {
        position: absolute;
        right: 4.5%;
        bottom: 9%;
        display: flex;
        align-items: flex-end;
        gap: 4px;
        color: color-mix(in srgb, var(--text) 72%, var(--muted));
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: clamp(11px, 0.95vw, 15px);
        font-style: italic;
        line-height: 1.2;
        transform: rotate(-3deg);
        pointer-events: none;
        user-select: none;
    }

    .nrn-note span {
        display: flex;
        flex-direction: column;
    }

    .nrn-note small {
        margin-top: 2px;
        font: inherit;
        opacity: 0.76;
    }

    .nrn-note svg {
        width: 48px;
        height: 48px;
        overflow: visible;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.05;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.78;
        transform: rotate(-12deg) translateY(4px);
    }

    @media (max-width: 720px) {
        .nrn-note {
            right: 3%;
            bottom: 6%;
        }
    }

    @media (hover: none) {
        .nrn-note {
            display: none;
        }
    }
</style>

<script>
    type SpringState = { value: number; velocity: number };

    const VIEW_X = 40;
    const VIEW_Y = 20;
    const VIEW_W = 888;
    const VIEW_H = 560;
    const PRESS_DEPTH = 5;

    const springAdvance = (
        state: SpringState,
        target: number,
        stiffness: number,
        damping: number,
        mass: number,
        dt: number,
    ) => {
        const substep = 1 / 240;
        const steps = Math.max(1, Math.ceil(dt / substep));
        const h = dt / steps;
        for (let index = 0; index < steps; index += 1) {
            const force = -stiffness * (state.value - target) - damping * state.velocity;
            const acceleration = force / mass;
            state.velocity += acceleration * h;
            state.value += state.velocity * h;
        }
    };

    const springLoop = (root: HTMLElement) => {
        if (root.dataset.nrnReady === 'true') return;
        root.dataset.nrnReady = 'true';

        const mark = root.querySelector<HTMLButtonElement>('[data-nrn-mark]');
        const svg = root.querySelector<SVGSVGElement>('[data-nrn-svg]');
        const art = root.querySelector<SVGGElement>('[data-nrn-art]');
        const gradient = root.querySelector<SVGRadialGradientElement>('[data-nrn-gradient]');
        if (!mark || !svg || !art || !gradient) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
        const cursorX: SpringState = { value: VIEW_X + VIEW_W / 2, velocity: 0 };
        const cursorY: SpringState = { value: VIEW_Y + VIEW_H / 2, velocity: 0 };
        const press: SpringState = { value: 0, velocity: 0 };
        let cursorTargetX = cursorX.value;
        let cursorTargetY = cursorY.value;
        let pressTarget = 0;
        let pressed = false;
        let inView = true;
        let raf = 0;
        let lastTime = performance.now();
        let audioContext: AudioContext | null = null;

        const onPointerMove = (event: PointerEvent) => {
            if (!finePointer.matches) return;
            const rect = svg.getBoundingClientRect();
            if (!rect.width || !rect.height) return;
            const px = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
            const py = Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height));
            cursorTargetX = VIEW_X + px * VIEW_W;
            cursorTargetY = VIEW_Y + py * VIEW_H;
        };

        const playClick = () => {
            try {
                audioContext ??= new AudioContext();
                const now = audioContext.currentTime;
                const oscillator = audioContext.createOscillator();
                const gain = audioContext.createGain();
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(155, now);
                oscillator.frequency.exponentialRampToValueAtTime(92, now + 0.055);
                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.exponentialRampToValueAtTime(0.04, now + 0.006);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.07);
                oscillator.connect(gain);
                gain.connect(audioContext.destination);
                oscillator.start(now);
                oscillator.stop(now + 0.075);
            } catch {
                // Audio is optional.
            }
        };

        const pressDown = () => {
            if (pressed) return;
            pressed = true;
            pressTarget = PRESS_DEPTH;
            mark.setAttribute('aria-pressed', 'true');
        };

        const release = (withSound = true) => {
            if (!pressed) return;
            pressed = false;
            pressTarget = 0;
            mark.setAttribute('aria-pressed', 'false');
            if (withSound) playClick();
        };

        window.addEventListener('pointermove', onPointerMove, { passive: true });
        mark.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            mark.setPointerCapture?.(event.pointerId);
            pressDown();
        });
        mark.addEventListener('pointerup', (event) => {
            if (mark.hasPointerCapture?.(event.pointerId)) mark.releasePointerCapture?.(event.pointerId);
            release(true);
        });
        mark.addEventListener('pointercancel', () => release(false));
        mark.addEventListener('lostpointercapture', () => release(false));
        mark.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            pressDown();
        });
        mark.addEventListener('keyup', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            release(true);
        });
        mark.addEventListener('blur', () => release(false));

        const observer = new IntersectionObserver(
            ([entry]) => {
                inView = entry?.isIntersecting ?? true;
            },
            { threshold: 0.01 },
        );
        observer.observe(root);

        const tick = (now: number) => {
            const dt = Math.min((now - lastTime) / 1000, 0.05);
            lastTime = now;

            if (reducedMotion.matches) {
                cursorX.value = cursorTargetX;
                cursorY.value = cursorTargetY;
                press.value = pressTarget;
                cursorX.velocity = 0;
                cursorY.velocity = 0;
                press.velocity = 0;
            } else {
                springAdvance(cursorX, cursorTargetX, 300, 30, 0.1, dt);
                springAdvance(cursorY, cursorTargetY, 300, 30, 0.1, dt);
                springAdvance(press, pressTarget, 190, 19, 0.5, dt);
            }

            if (inView) {
                gradient.setAttribute('cx', cursorX.value.toFixed(2));
                gradient.setAttribute('cy', cursorY.value.toFixed(2));
                art.setAttribute('transform', `translate(0 ${press.value.toFixed(2)})`);
            }

            raf = requestAnimationFrame(tick);
        };

        raf = requestAnimationFrame(tick);
        window.addEventListener(
            'pagehide',
            () => {
                cancelAnimationFrame(raf);
                observer.disconnect();
                window.removeEventListener('pointermove', onPointerMove);
            },
            { once: true },
        );
    };

    document.querySelectorAll<HTMLElement>('[data-nrn-stage]').forEach(springLoop);
</script>
