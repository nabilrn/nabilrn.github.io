---
type PlanePoint = { x: number; y: number };
type ScreenPoint = { x: number; y: number };

type Beam = {
    id: string;
    plane: PlanePoint[];
    screen: ScreenPoint[];
    averageY: number;
};

const VIEWBOX_WIDTH = 640;
const VIEWBOX_HEIGHT = 360;
const DEPTH = 30;

const rectangle = (x: number, y: number, width: number, height: number): PlanePoint[] => [
    { x, y },
    { x: x + width, y },
    { x: x + width, y: y + height },
    { x, y: y + height },
];

const thickSegment = (
    x1: number,
    y1: number,
    x2: number,
    y2: number,
    width: number,
): PlanePoint[] => {
    const dx = x2 - x1;
    const dy = y2 - y1;
    const length = Math.hypot(dx, dy) || 1;
    const normalX = (-dy / length) * (width / 2);
    const normalY = (dx / length) * (width / 2);

    return [
        { x: x1 + normalX, y: y1 + normalY },
        { x: x2 + normalX, y: y2 + normalY },
        { x: x2 - normalX, y: y2 - normalY },
        { x: x1 - normalX, y: y1 - normalY },
    ];
};

const project = ({ x, y }: PlanePoint): ScreenPoint => ({
    x: 220 + (x - y) * 0.82,
    y: 25 + (x + y) * 0.62,
});

const beamSpecs: Array<{ id: string; polygon: PlanePoint[] }> = [
    // N — three continuous strokes.
    { id: 'n1-left', polygon: rectangle(0, 120, 20, 120) },
    { id: 'n1-diagonal', polygon: thickSegment(18, 124, 82, 236, 20) },
    { id: 'n1-right', polygon: rectangle(80, 120, 20, 120) },

    // R — one stem, bowl strokes, and one diagonal leg.
    { id: 'r-stem', polygon: rectangle(130, 0, 20, 120) },
    { id: 'r-top', polygon: rectangle(130, 0, 80, 20) },
    { id: 'r-bowl-right', polygon: rectangle(190, 0, 20, 62) },
    { id: 'r-middle', polygon: rectangle(130, 50, 70, 20) },
    { id: 'r-leg', polygon: thickSegment(178, 64, 224, 116, 20) },

    // N — three continuous strokes.
    { id: 'n2-left', polygon: rectangle(260, -120, 20, 120) },
    { id: 'n2-diagonal', polygon: thickSegment(278, -116, 342, -4, 20) },
    { id: 'n2-right', polygon: rectangle(340, -120, 20, 120) },
];

const beams: Beam[] = beamSpecs
    .map(({ id, polygon }) => {
        const screen = polygon.map(project);
        return {
            id,
            plane: polygon,
            screen,
            averageY: screen.reduce((sum, point) => sum + point.y, 0) / screen.length,
        };
    })
    .sort((a, b) => a.averageY - b.averageY);

const pointsString = (points: ScreenPoint[], press = 0) =>
    points.map(({ x, y }) => `${x.toFixed(2)},${(y + press).toFixed(2)}`).join(' ');

const sidePointsString = (points: ScreenPoint[], edgeIndex: number, press = 0) => {
    const start = points[edgeIndex];
    const end = points[(edgeIndex + 1) % points.length];
    return [
        { x: start.x, y: start.y + press },
        { x: end.x, y: end.y + press },
        { x: end.x, y: end.y + DEPTH },
        { x: start.x, y: start.y + DEPTH },
    ]
        .map(({ x, y }) => `${x.toFixed(2)},${y.toFixed(2)}`)
        .join(' ');
};

const strokePath = (points: ScreenPoint[], press = 0) => {
    const top = points.map(({ x, y }) => ({ x, y: y + press }));
    const bottom = points.map(({ x, y }) => ({ x, y: y + DEPTH }));
    const path: string[] = [];

    path.push(`M${top[0].x.toFixed(2)} ${top[0].y.toFixed(2)}`);
    top.slice(1).forEach((point) => path.push(`L${point.x.toFixed(2)} ${point.y.toFixed(2)}`));
    path.push('Z');

    path.push(`M${bottom[0].x.toFixed(2)} ${bottom[0].y.toFixed(2)}`);
    bottom.slice(1).forEach((point) => path.push(`L${point.x.toFixed(2)} ${point.y.toFixed(2)}`));
    path.push('Z');

    top.forEach((point, index) => {
        const bottomPoint = bottom[index];
        path.push(
            `M${point.x.toFixed(2)} ${point.y.toFixed(2)}L${bottomPoint.x.toFixed(2)} ${bottomPoint.y.toFixed(2)}`,
        );
    });

    return path.join('');
};
---

<div class="nrn-stage" data-nrn-stage>
    <button
        class="nrn-mark"
        type="button"
        data-nrn-mark
        aria-label="Press the interactive NRN mark"
        aria-pressed="false"
    >
        <svg
            class="nrn-svg"
            data-nrn-svg
            viewBox={`0 0 ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Isometric NRN monogram"
        >
            <defs>
                <pattern id="nrn-face-pattern" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M-1 1l2 -2M0 10l10 -10M9 11l2 -2" class="nrn-pattern-line" />
                </pattern>

                <radialGradient
                    id="nrn-radial-gradient"
                    data-nrn-gradient
                    cx={VIEWBOX_WIDTH / 2}
                    cy={VIEWBOX_HEIGHT / 2}
                    r="200"
                    gradientUnits="userSpaceOnUse"
                >
                    <stop offset="0" class="nrn-glow-start" />
                    <stop offset="1" class="nrn-glow-end" />
                </radialGradient>
            </defs>

            <g class="nrn-guides" aria-hidden="true">
                <path d="M-250 550L890 -108" />
                <path d="M855 540L-285 -118" />
                <path d="M965 475L-175 -183" />
            </g>

            <g class="nrn-side-layer" aria-hidden="true">
                {beams.map((beam, beamIndex) => (
                    <g
                        data-beam-sides
                        data-index={beamIndex}
                        data-points={JSON.stringify(beam.screen)}
                    >
                        {beam.screen.map((_, edgeIndex) => (
                            <polygon
                                class={`nrn-side nrn-side-${edgeIndex}`}
                                data-side={edgeIndex}
                                points={sidePointsString(beam.screen, edgeIndex)}
                            />
                        ))}
                    </g>
                ))}
            </g>

            <g class="nrn-top-layer" aria-hidden="true">
                {beams.map((beam, beamIndex) => (
                    <g data-beam-top data-index={beamIndex} data-points={JSON.stringify(beam.screen)}>
                        <polygon class="nrn-top-bg" data-top-bg points={pointsString(beam.screen)} />
                        <polygon class="nrn-top-pattern" data-top-pattern points={pointsString(beam.screen)} />
                    </g>
                ))}
            </g>

            <g class="nrn-stroke-layer" aria-hidden="true">
                {beams.map((beam, beamIndex) => (
                    <g data-beam-stroke data-index={beamIndex} data-points={JSON.stringify(beam.screen)}>
                        <path class="nrn-stroke-base" data-stroke-base d={strokePath(beam.screen)} />
                        <path class="nrn-stroke-glow" data-stroke-glow d={strokePath(beam.screen)} />
                    </g>
                ))}
            </g>

            <text class="nrn-fig-label" x="34" y="326">Fig. 1.</text>
        </svg>
    </button>

    <div class="nrn-note" aria-hidden="true">
        <svg viewBox="0 0 54 54">
            <path d="M49 6C37 8 28 14 23 23C18 31 19 39 24 45" />
            <path d="M17 39L24 46L31 39" />
        </svg>
        <span>
            follows your cursor
            <small>click the mark</small>
        </span>
    </div>
</div>

<style>
    .nrn-stage {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        color: var(--text);
        background: var(--bg);
        --nrn-pattern: color-mix(in srgb, var(--text) 12%, var(--bg));
        --nrn-stroke: color-mix(in srgb, var(--text) 17%, var(--bg));
    }

    .nrn-mark {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .nrn-mark:focus-visible {
        outline: 1px solid color-mix(in srgb, var(--text) 72%, transparent);
        outline-offset: -5px;
    }

    .nrn-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nrn-guides {
        fill: none;
        stroke: color-mix(in srgb, var(--text) 9%, var(--bg));
        stroke-width: 1;
        stroke-dasharray: 4 3;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
    }

    .nrn-pattern-line {
        fill: none;
        stroke: var(--nrn-pattern);
        stroke-width: 1;
    }

    .nrn-side {
        fill: var(--bg);
        stroke: none;
    }

    .nrn-side-1,
    .nrn-side-2 {
        fill: color-mix(in srgb, var(--surface) 58%, var(--bg));
    }

    .nrn-top-bg {
        fill: var(--bg);
    }

    .nrn-top-pattern {
        fill: url(#nrn-face-pattern);
    }

    .nrn-stroke-base,
    .nrn-stroke-glow {
        fill: none;
        stroke-width: 1;
        stroke-linejoin: round;
        stroke-linecap: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-stroke-base {
        stroke: var(--nrn-stroke);
    }

    .nrn-stroke-glow {
        stroke: url(#nrn-radial-gradient);
        pointer-events: none;
    }

    .nrn-glow-start {
        stop-color: color-mix(in srgb, var(--text) 96%, var(--bg));
        stop-opacity: 1;
    }

    .nrn-glow-end {
        stop-color: color-mix(in srgb, var(--text) 52%, var(--bg));
        stop-opacity: 0;
    }

    .nrn-fig-label {
        fill: color-mix(in srgb, var(--muted) 58%, var(--bg));
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.035em;
        user-select: none;
    }

    .nrn-note {
        position: absolute;
        right: 4.5%;
        bottom: 12%;
        display: flex;
        align-items: flex-end;
        gap: 3px;
        color: color-mix(in srgb, var(--text) 72%, var(--muted));
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: clamp(11px, 0.95vw, 15px);
        font-style: italic;
        line-height: 1.2;
        transform: rotate(-3deg);
        pointer-events: none;
        user-select: none;
    }

    .nrn-note span {
        display: flex;
        flex-direction: column;
    }

    .nrn-note small {
        margin-top: 2px;
        font: inherit;
        opacity: 0.76;
    }

    .nrn-note svg {
        width: 48px;
        height: 48px;
        overflow: visible;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.05;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.78;
        transform: rotate(-12deg) translateY(4px);
    }

    @media (max-width: 720px) {
        .nrn-note {
            right: 4%;
            bottom: 8%;
        }
    }

    @media (hover: none) {
        .nrn-note {
            display: none;
        }
    }
</style>

<script>
    type Point = { x: number; y: number };
    type SpringState = { value: number; velocity: number };

    const VIEWBOX_W = 640;
    const VIEWBOX_H = 360;
    const EXTRUSION_DEPTH = 30;
    const PRESS_DEPTH = 16;

    const springAdvance = (
        state: SpringState,
        target: number,
        stiffness: number,
        damping: number,
        mass: number,
        dt: number,
    ) => {
        const substep = 1 / 240;
        const steps = Math.max(1, Math.ceil(dt / substep));
        const h = dt / steps;

        for (let index = 0; index < steps; index += 1) {
            const force = -stiffness * (state.value - target) - damping * state.velocity;
            const acceleration = force / mass;
            state.velocity += acceleration * h;
            state.value += state.velocity * h;
        }
    };

    const pointsToString = (points: Point[], press: number) =>
        points.map((point) => `${point.x.toFixed(2)},${(point.y + press).toFixed(2)}`).join(' ');

    const sideToString = (points: Point[], edgeIndex: number, press: number) => {
        const start = points[edgeIndex];
        const end = points[(edgeIndex + 1) % points.length];
        return [
            { x: start.x, y: start.y + press },
            { x: end.x, y: end.y + press },
            { x: end.x, y: end.y + EXTRUSION_DEPTH },
            { x: start.x, y: start.y + EXTRUSION_DEPTH },
        ]
            .map((point) => `${point.x.toFixed(2)},${point.y.toFixed(2)}`)
            .join(' ');
    };

    const strokeToPath = (points: Point[], press: number) => {
        const top = points.map((point) => ({ x: point.x, y: point.y + press }));
        const bottom = points.map((point) => ({ x: point.x, y: point.y + EXTRUSION_DEPTH }));
        const path: string[] = [];

        path.push(`M${top[0].x.toFixed(2)} ${top[0].y.toFixed(2)}`);
        top.slice(1).forEach((point) => path.push(`L${point.x.toFixed(2)} ${point.y.toFixed(2)}`));
        path.push('Z');

        path.push(`M${bottom[0].x.toFixed(2)} ${bottom[0].y.toFixed(2)}`);
        bottom.slice(1).forEach((point) => path.push(`L${point.x.toFixed(2)} ${point.y.toFixed(2)}`));
        path.push('Z');

        top.forEach((point, index) => {
            const bottomPoint = bottom[index];
            path.push(
                `M${point.x.toFixed(2)} ${point.y.toFixed(2)}L${bottomPoint.x.toFixed(2)} ${bottomPoint.y.toFixed(2)}`,
            );
        });

        return path.join('');
    };

    const playClick = () => {
        try {
            const AudioContextCtor =
                window.AudioContext ??
                (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
            if (!AudioContextCtor) return;

            const context = new AudioContextCtor();
            const now = context.currentTime;
            const gain = context.createGain();
            const high = context.createOscillator();
            const low = context.createOscillator();

            high.type = 'triangle';
            high.frequency.setValueAtTime(930, now);
            high.frequency.exponentialRampToValueAtTime(560, now + 0.04);
            low.type = 'sine';
            low.frequency.setValueAtTime(210, now);
            low.frequency.exponentialRampToValueAtTime(140, now + 0.065);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.exponentialRampToValueAtTime(0.048, now + 0.005);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.075);

            high.connect(gain);
            low.connect(gain);
            gain.connect(context.destination);
            high.start(now);
            low.start(now);
            high.stop(now + 0.08);
            low.stop(now + 0.08);
            window.setTimeout(() => void context.close(), 130);
        } catch {
            // Sound is decorative only.
        }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-nrn-mark]').forEach((mark) => {
        if (mark.dataset.initialized === 'true') return;
        mark.dataset.initialized = 'true';

        const svg = mark.querySelector<SVGSVGElement>('[data-nrn-svg]');
        const gradient = mark.querySelector<SVGRadialGradientElement>('[data-nrn-gradient]');
        if (!svg || !gradient) return;

        const topGroups = Array.from(mark.querySelectorAll<SVGGElement>('[data-beam-top]'));
        const sideGroups = Array.from(mark.querySelectorAll<SVGGElement>('[data-beam-sides]'));
        const strokeGroups = Array.from(mark.querySelectorAll<SVGGElement>('[data-beam-stroke]'));

        const parsePoints = (group: SVGGElement) => JSON.parse(group.dataset.points ?? '[]') as Point[];
        const pointsByIndex = new Map<number, Point[]>();
        [...topGroups, ...sideGroups, ...strokeGroups].forEach((group) => {
            const index = Number(group.dataset.index ?? '-1');
            if (index >= 0 && !pointsByIndex.has(index)) pointsByIndex.set(index, parsePoints(group));
        });

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

        const cursorX: SpringState = { value: VIEWBOX_W / 2, velocity: 0 };
        const cursorY: SpringState = { value: VIEWBOX_H / 2, velocity: 0 };
        const press: SpringState = { value: 0, velocity: 0 };

        let cursorTargetX = VIEWBOX_W / 2;
        let cursorTargetY = VIEWBOX_H / 2;
        let pressTarget = 0;
        let isInView = true;
        let frame = 0;
        let lastTime = performance.now();

        const renderPress = (value: number) => {
            topGroups.forEach((group) => {
                const index = Number(group.dataset.index ?? '-1');
                const points = pointsByIndex.get(index);
                if (!points) return;
                group.querySelectorAll<SVGPolygonElement>('[data-top-bg], [data-top-pattern]').forEach((polygon) => {
                    polygon.setAttribute('points', pointsToString(points, value));
                });
            });

            sideGroups.forEach((group) => {
                const index = Number(group.dataset.index ?? '-1');
                const points = pointsByIndex.get(index);
                if (!points) return;
                group.querySelectorAll<SVGPolygonElement>('[data-side]').forEach((polygon) => {
                    const edgeIndex = Number(polygon.dataset.side ?? '0');
                    polygon.setAttribute('points', sideToString(points, edgeIndex, value));
                });
            });

            strokeGroups.forEach((group) => {
                const index = Number(group.dataset.index ?? '-1');
                const points = pointsByIndex.get(index);
                if (!points) return;
                const path = strokeToPath(points, value);
                group.querySelectorAll<SVGPathElement>('[data-stroke-base], [data-stroke-glow]').forEach((stroke) => {
                    stroke.setAttribute('d', path);
                });
            });
        };

        const tick = (now: number) => {
            const dt = Math.min(0.032, Math.max(0.001, (now - lastTime) / 1000));
            lastTime = now;

            if (isInView) {
                if (!reducedMotion.matches && finePointer.matches) {
                    springAdvance(cursorX, cursorTargetX, 300, 30, 0.1, dt);
                    springAdvance(cursorY, cursorTargetY, 300, 30, 0.1, dt);
                } else {
                    cursorX.value = cursorTargetX;
                    cursorY.value = cursorTargetY;
                }

                if (!reducedMotion.matches) {
                    springAdvance(press, pressTarget, 200, 18, 0.5, dt);
                } else {
                    press.value = pressTarget ? 7 : 0;
                    press.velocity = 0;
                }

                gradient.setAttribute('cx', cursorX.value.toFixed(2));
                gradient.setAttribute('cy', cursorY.value.toFixed(2));
                renderPress(press.value);
            }

            frame = window.requestAnimationFrame(tick);
        };

        const handleGlobalMouseMove = (event: MouseEvent) => {
            if (!finePointer.matches || reducedMotion.matches) return;
            cursorTargetX = (event.clientX / Math.max(1, window.innerWidth)) * VIEWBOX_W;
            cursorTargetY = (event.clientY / Math.max(1, window.innerHeight)) * VIEWBOX_H;
        };

        const pressDown = () => {
            pressTarget = PRESS_DEPTH;
            mark.setAttribute('aria-pressed', 'true');
        };

        const pressUp = (withSound: boolean) => {
            if (pressTarget === 0) return;
            pressTarget = 0;
            mark.setAttribute('aria-pressed', 'false');
            if (withSound) playClick();
        };

        mark.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            mark.setPointerCapture?.(event.pointerId);
            pressDown();
        });
        mark.addEventListener('pointerup', (event) => {
            if (event.button !== 0) return;
            pressUp(true);
        });
        mark.addEventListener('pointercancel', () => pressUp(false));
        mark.addEventListener('lostpointercapture', () => pressUp(false));

        mark.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            pressDown();
        });
        mark.addEventListener('keyup', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            pressUp(true);
        });

        const observer = new IntersectionObserver(
            ([entry]) => {
                isInView = entry?.isIntersecting ?? true;
            },
            { rootMargin: '80px' },
        );
        observer.observe(svg);

        window.addEventListener('mousemove', handleGlobalMouseMove, { passive: true });
        frame = window.requestAnimationFrame(tick);

        window.addEventListener(
            'pagehide',
            () => {
                window.cancelAnimationFrame(frame);
                window.removeEventListener('mousemove', handleGlobalMouseMove);
                observer.disconnect();
            },
            { once: true },
        );
    });
</script>
