---
type PlanePoint = { x: number; y: number };
type ScreenPoint = { x: number; y: number };
type BarDefinition = {
    id: string;
    x1: number;
    y1: number;
    x2: number;
    y2: number;
    width: number;
};

const viewWidth = 556;
const viewHeight = 354;
const originX = 139;
const originY = 24;
const isoX = 23;
const isoY = 11.5;
const depth = 30;

const project = ({ x, y }: PlanePoint): ScreenPoint => ({
    x: originX + (x - y) * isoX,
    y: originY + (x + y) * isoY,
});

const rectangleAroundLine = (bar: BarDefinition): PlanePoint[] => {
    const dx = bar.x2 - bar.x1;
    const dy = bar.y2 - bar.y1;
    const length = Math.hypot(dx, dy) || 1;
    const nx = (-dy / length) * (bar.width / 2);
    const ny = (dx / length) * (bar.width / 2);

    return [
        { x: bar.x1 + nx, y: bar.y1 + ny },
        { x: bar.x2 + nx, y: bar.y2 + ny },
        { x: bar.x2 - nx, y: bar.y2 - ny },
        { x: bar.x1 - nx, y: bar.y1 - ny },
    ];
};

const toPoints = (points: ScreenPoint[]) =>
    points.map((point) => `${point.x.toFixed(2)},${point.y.toFixed(2)}`).join(' ');

const barDefinitions: BarDefinition[] = [
    // N
    { id: 'n1-left', x1: 0.55, y1: 0.45, x2: 0.55, y2: 5.55, width: 0.82 },
    { id: 'n1-diagonal', x1: 0.75, y1: 0.55, x2: 3.35, y2: 5.45, width: 0.76 },
    { id: 'n1-right', x1: 3.55, y1: 0.45, x2: 3.55, y2: 5.55, width: 0.82 },

    // R
    { id: 'r-left', x1: 5.55, y1: 0.45, x2: 5.55, y2: 5.55, width: 0.82 },
    { id: 'r-top', x1: 5.55, y1: 0.55, x2: 8.35, y2: 0.55, width: 0.82 },
    { id: 'r-mid', x1: 5.55, y1: 2.95, x2: 8.15, y2: 2.95, width: 0.82 },
    { id: 'r-bowl', x1: 8.35, y1: 0.70, x2: 8.35, y2: 2.78, width: 0.82 },
    { id: 'r-leg', x1: 7.25, y1: 3.12, x2: 8.80, y2: 5.55, width: 0.82 },

    // N
    { id: 'n2-left', x1: 10.55, y1: 0.45, x2: 10.55, y2: 5.55, width: 0.82 },
    { id: 'n2-diagonal', x1: 10.75, y1: 0.55, x2: 13.35, y2: 5.45, width: 0.76 },
    { id: 'n2-right', x1: 13.55, y1: 0.45, x2: 13.55, y2: 5.55, width: 0.82 },
];

const bars = barDefinitions.map((definition) => {
    const top = rectangleAroundLine(definition).map(project);
    const bottom = top.map((point) => ({ x: point.x, y: point.y + depth }));
    const sides = top.map((point, index) => {
        const next = (index + 1) % top.length;
        return [point, top[next], bottom[next], bottom[index]];
    });

    return {
        id: definition.id,
        topPoints: toPoints(top),
        sides: sides.map((points, index) => ({
            id: `${definition.id}-side-${index}`,
            points,
            pointsString: toPoints(points),
        })),
    };
});
---

<div class="nrn-stage" data-nrn-stage>
    <button
        class="nrn-mark"
        type="button"
        data-nrn-mark
        aria-label="Press the interactive NRN mark"
        aria-pressed="false"
    >
        <svg
            class="nrn-svg"
            data-nrn-svg
            viewBox={`0 0 ${viewWidth} ${viewHeight}`}
            role="img"
            aria-label="Isometric NRN monogram"
        >
            <defs>
                <pattern id="nrn-face-pattern" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M-1 1l2-2M0 10L10 0M9 11l2-2" class="nrn-hatch-line" />
                </pattern>

                <radialGradient
                    id="nrn-spotlight"
                    data-nrn-spotlight
                    cx="278"
                    cy="177"
                    r="190"
                    gradientUnits="userSpaceOnUse"
                >
                    <stop offset="0" class="nrn-spotlight-start" />
                    <stop offset="1" class="nrn-spotlight-end" />
                </radialGradient>
            </defs>

            <g class="nrn-guides" aria-hidden="true">
                <path d="M-478 757L1255 -243" />
                <path d="M977 789L-755 -211" />
                <path d="M1144 693L-588 -307" />
            </g>

            <g class="nrn-prisms" aria-hidden="true">
                {bars.map((bar) => (
                    <g class="nrn-prism" data-prism={bar.id}>
                        <g class="nrn-side-group">
                            {bar.sides.map((side) => (
                                <polygon
                                    class="nrn-side"
                                    data-nrn-side
                                    data-top-a={`${side.points[0].x},${side.points[0].y}`}
                                    data-top-b={`${side.points[1].x},${side.points[1].y}`}
                                    data-bottom-b={`${side.points[2].x},${side.points[2].y}`}
                                    data-bottom-a={`${side.points[3].x},${side.points[3].y}`}
                                    points={side.pointsString}
                                />
                            ))}
                        </g>

                        <g class="nrn-top-layer" data-nrn-top-layer>
                            <polygon class="nrn-top-base" points={bar.topPoints} />
                            <polygon class="nrn-top-hatch" points={bar.topPoints} />
                            <polygon class="nrn-top-outline" points={bar.topPoints} />
                        </g>
                    </g>
                ))}
            </g>

            <g class="nrn-spotlight-geometry" aria-hidden="true">
                {bars.map((bar) => (
                    <g>
                        <g class="nrn-top-layer" data-nrn-top-layer>
                            <polygon class="nrn-spotlight-top" points={bar.topPoints} />
                        </g>
                        {bar.sides.map((side) => (
                            <polygon
                                class="nrn-spotlight-side"
                                data-nrn-side
                                data-top-a={`${side.points[0].x},${side.points[0].y}`}
                                data-top-b={`${side.points[1].x},${side.points[1].y}`}
                                data-bottom-b={`${side.points[2].x},${side.points[2].y}`}
                                data-bottom-a={`${side.points[3].x},${side.points[3].y}`}
                                points={side.pointsString}
                            />
                        ))}
                    </g>
                ))}
            </g>

            <text class="nrn-fig-label" x="34" y="326">FIG. 01 / NRN SYSTEM</text>
        </svg>
    </button>

    <div class="nrn-note" aria-hidden="true">
        <svg viewBox="0 0 54 54">
            <path d="M50 6C37 7 26 14 21 24C17 31 18 39 23 45" />
            <path d="M16 39L23 46L30 39" />
        </svg>
        <span>click around</span>
    </div>
</div>

<style>
    .nrn-stage {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        color: var(--text);
        background: var(--bg);
    }

    .nrn-mark {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .nrn-mark:focus-visible {
        outline: 1px solid color-mix(in srgb, var(--text) 70%, transparent);
        outline-offset: -5px;
    }

    .nrn-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nrn-guides {
        fill: none;
        stroke: color-mix(in srgb, var(--muted) 18%, var(--bg));
        stroke-width: 1;
        stroke-dasharray: 4 2;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
    }

    .nrn-side {
        fill: var(--bg);
        stroke: color-mix(in srgb, var(--text) 18%, var(--bg));
        stroke-width: 1;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-top-base {
        fill: var(--bg);
    }

    .nrn-top-hatch {
        fill: url(#nrn-face-pattern);
        opacity: 0.92;
    }

    .nrn-top-outline {
        fill: none;
        stroke: color-mix(in srgb, var(--text) 28%, var(--bg));
        stroke-width: 1;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-hatch-line {
        fill: none;
        stroke: color-mix(in srgb, var(--text) 14%, var(--bg));
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }

    .nrn-spotlight-geometry {
        pointer-events: none;
    }

    .nrn-spotlight-top,
    .nrn-spotlight-side {
        fill: none;
        stroke: url(#nrn-spotlight);
        stroke-width: 1.15;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-spotlight-start {
        stop-color: var(--text);
        stop-opacity: 0.88;
    }

    .nrn-spotlight-end {
        stop-color: var(--muted);
        stop-opacity: 0;
    }

    .nrn-top-layer {
        will-change: transform;
    }

    .nrn-fig-label {
        fill: color-mix(in srgb, var(--muted) 74%, var(--bg));
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.02em;
        pointer-events: none;
    }

    .nrn-note {
        position: absolute;
        right: 7.5%;
        bottom: 13%;
        display: flex;
        align-items: flex-end;
        gap: 3px;
        color: color-mix(in srgb, var(--text) 72%, var(--muted));
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: clamp(12px, 1vw, 17px);
        font-style: italic;
        transform: rotate(2deg);
        pointer-events: none;
        user-select: none;
    }

    .nrn-note svg {
        width: 48px;
        height: 48px;
        overflow: visible;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.1;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.82;
        transform: rotate(-12deg) translateY(4px);
    }

    @media (max-width: 720px) {
        .nrn-note {
            right: 5%;
            bottom: 9%;
        }
    }
</style>

<script>
    type NrnState = 'idle' | 'hover' | 'pressed';
    type Point = { x: number; y: number };

    const VIEW_WIDTH = 556;
    const VIEW_HEIGHT = 354;
    const PRESS_DEPTH = 16;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

    const playClick = () => {
        try {
            const AudioContextCtor = window.AudioContext ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
            if (!AudioContextCtor) return;

            const context = new AudioContextCtor();
            const now = context.currentTime;
            const gain = context.createGain();
            const high = context.createOscillator();
            const low = context.createOscillator();

            high.type = 'triangle';
            high.frequency.setValueAtTime(860, now);
            high.frequency.exponentialRampToValueAtTime(510, now + 0.042);
            low.type = 'sine';
            low.frequency.setValueAtTime(190, now);
            low.frequency.exponentialRampToValueAtTime(128, now + 0.064);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.exponentialRampToValueAtTime(0.045, now + 0.005);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.072);

            high.connect(gain);
            low.connect(gain);
            gain.connect(context.destination);
            high.start(now);
            low.start(now);
            high.stop(now + 0.078);
            low.stop(now + 0.078);
            window.setTimeout(() => void context.close(), 120);
        } catch {
            // Sound is decorative only.
        }
    };

    const parsePoint = (value: string | undefined): Point => {
        const [x = 0, y = 0] = (value ?? '0,0').split(',').map(Number);
        return { x, y };
    };

    document.querySelectorAll<HTMLButtonElement>('[data-nrn-mark]').forEach((mark) => {
        if (mark.dataset.initialized === 'true') return;
        mark.dataset.initialized = 'true';

        const svg = mark.querySelector<SVGSVGElement>('[data-nrn-svg]');
        const gradient = mark.querySelector<SVGRadialGradientElement>('[data-nrn-spotlight]');
        const topLayers = Array.from(mark.querySelectorAll<SVGGElement>('[data-nrn-top-layer]'));
        const sides = Array.from(mark.querySelectorAll<SVGPolygonElement>('[data-nrn-side]')).map((side) => ({
            node: side,
            topA: parsePoint(side.dataset.topA),
            topB: parsePoint(side.dataset.topB),
            bottomB: parsePoint(side.dataset.bottomB),
            bottomA: parsePoint(side.dataset.bottomA),
        }));

        if (!svg || !gradient) return;

        let state: NrnState = 'idle';
        let pressValue = 0;
        let pressVelocity = 0;
        let pressTarget = 0;
        let lastFrame = performance.now();

        let glowX = VIEW_WIDTH / 2;
        let glowY = VIEW_HEIGHT / 2;
        let glowVelocityX = 0;
        let glowVelocityY = 0;
        let glowTargetX = glowX;
        let glowTargetY = glowY;

        let frame = 0;
        let inView = true;

        const applyGeometry = () => {
            const offset = pressValue * PRESS_DEPTH;
            topLayers.forEach((layer) => {
                layer.setAttribute('transform', `translate(0 ${offset.toFixed(3)})`);
            });

            sides.forEach(({ node, topA, topB, bottomB, bottomA }) => {
                node.setAttribute(
                    'points',
                    [
                        `${topA.x.toFixed(2)},${(topA.y + offset).toFixed(2)}`,
                        `${topB.x.toFixed(2)},${(topB.y + offset).toFixed(2)}`,
                        `${bottomB.x.toFixed(2)},${bottomB.y.toFixed(2)}`,
                        `${bottomA.x.toFixed(2)},${bottomA.y.toFixed(2)}`,
                    ].join(' '),
                );
            });
        };

        const applyGlow = () => {
            gradient.setAttribute('cx', glowX.toFixed(2));
            gradient.setAttribute('cy', glowY.toFixed(2));
        };

        const tick = (now: number) => {
            const dt = Math.min((now - lastFrame) / 1000, 0.032);
            lastFrame = now;

            if (reducedMotion.matches) {
                pressValue = pressTarget;
                pressVelocity = 0;
            } else {
                const mass = 0.5;
                const stiffness = 200;
                const damping = 18;
                const acceleration = (stiffness * (pressTarget - pressValue) - damping * pressVelocity) / mass;
                pressVelocity += acceleration * dt;
                pressValue += pressVelocity * dt;
            }

            if (finePointer.matches && !reducedMotion.matches && inView) {
                const glowMass = 0.1;
                const glowStiffness = 300;
                const glowDamping = 30;

                const ax = (glowStiffness * (glowTargetX - glowX) - glowDamping * glowVelocityX) / glowMass;
                const ay = (glowStiffness * (glowTargetY - glowY) - glowDamping * glowVelocityY) / glowMass;
                glowVelocityX += ax * dt;
                glowVelocityY += ay * dt;
                glowX += glowVelocityX * dt;
                glowY += glowVelocityY * dt;
            } else {
                glowX = glowTargetX;
                glowY = glowTargetY;
            }

            applyGeometry();
            applyGlow();
            frame = requestAnimationFrame(tick);
        };

        const syncState = (next: NrnState) => {
            state = next;
            mark.dataset.state = next;
            mark.setAttribute('aria-pressed', String(next === 'pressed'));
        };

        const press = () => {
            pressTarget = 1;
            syncState('pressed');
        };

        const release = (withSound = false) => {
            if (state !== 'pressed') return;
            pressTarget = 0;
            if (withSound) playClick();
            syncState(mark.matches(':hover') || mark.matches(':focus-visible') ? 'hover' : 'idle');
        };

        const updateGlobalGlowTarget = (event: MouseEvent) => {
            if (!finePointer.matches || reducedMotion.matches || !inView) return;
            glowTargetX = (event.clientX / Math.max(window.innerWidth, 1)) * VIEW_WIDTH;
            glowTargetY = (event.clientY / Math.max(window.innerHeight, 1)) * VIEW_HEIGHT;
        };

        const observer = new IntersectionObserver(
            ([entry]) => {
                inView = entry?.isIntersecting ?? true;
            },
            { rootMargin: '80px' },
        );
        observer.observe(svg);

        window.addEventListener('mousemove', updateGlobalGlowTarget, { passive: true });

        mark.addEventListener('pointerenter', () => {
            if (state !== 'pressed') syncState('hover');
        });
        mark.addEventListener('pointerleave', () => {
            if (state === 'pressed') release(false);
            syncState('idle');
        });
        mark.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            mark.setPointerCapture?.(event.pointerId);
            press();
        });
        mark.addEventListener('pointerup', (event) => {
            if (event.button !== 0) return;
            release(true);
        });
        mark.addEventListener('pointercancel', () => release(false));

        mark.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            press();
        });
        mark.addEventListener('keyup', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            release(true);
        });
        mark.addEventListener('focus', () => {
            if (state !== 'pressed') syncState('hover');
        });
        mark.addEventListener('blur', () => {
            release(false);
            syncState('idle');
        });

        frame = requestAnimationFrame(tick);

        document.addEventListener(
            'astro:before-swap',
            () => {
                cancelAnimationFrame(frame);
                observer.disconnect();
                window.removeEventListener('mousemove', updateGlobalGlowTarget);
            },
            { once: true },
        );
    });
</script>
