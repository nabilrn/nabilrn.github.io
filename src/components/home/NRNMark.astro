---
const VIEWBOX_X = 60;
const VIEWBOX_Y = 45;
const VIEWBOX_WIDTH = 825;
const VIEWBOX_HEIGHT = 470;
const PRESS_DISTANCE = 14;
const FULL_DEPTH = 28;

// Approved top-surface geometry from the final Figma NRN mark.
const N_FRONT_PATH = 'M 0 84 L 28 70 L 162.39999389648438 137.1999969482422 L 140 14 L 168 0 L 336 84 L 308 98 L 173.60000610351562 30.799999237060547 L 196 154 L 168 168 L 0 84 Z';
const R_FRONT_PATH = 'M 168 0 L 240.36923217773438 36.18461608886719 C 277.8461570739746 54.923078536987305 283.01537322998047 74.30768966674805 257.1692199707031 87.23076629638672 C 231.32306671142578 100.15384292602539 193.84615898132324 98.21538543701172 165.41539001464844 84 L 138.27691650390625 153.13845825195312 L 102.0923080444336 135.04615783691406 L 124.06153869628906 73.66153717041016 L 99.5076904296875 61.38461685180664 L 27.13846206665039 97.56922912597656 L 0 84 L 168 0 Z M 169.2923126220703 26.492307662963867 L 214.5230712890625 49.10769271850586 C 236.49230194091797 60.09230899810791 241.66153526306152 69.13846349716187 231.3230743408203 74.30769348144531 C 220.98461246490479 79.47692441940308 202.8923110961914 76.89230823516846 180.92308044433594 65.9076919555664 L 135.6923065185547 43.29230880737305 L 169.2923126220703 26.492307662963867 Z';

const LEFT_N_MATRIX = 'matrix(-0.999965966 -0.008251472 -0.008251472 0.999965966 440.330566 75.151489)';
const RIGHT_N_MATRIX = 'matrix(-0.999965966 -0.008251472 -0.008251472 0.999965966 866.330566 275.151489)';
const R_MATRIX = 'matrix(0.999965966 0.008251472 -0.008251472 0.999965966 332.126709 179.541138)';

const LETTERS = [
    { key: 'n-left', path: N_FRONT_PATH, transform: LEFT_N_MATRIX, fillRule: 'nonzero' },
    { key: 'r-center', path: R_FRONT_PATH, transform: R_MATRIX, fillRule: 'evenodd' },
    { key: 'n-right', path: N_FRONT_PATH, transform: RIGHT_N_MATRIX, fillRule: 'nonzero' },
];

// Painter-style swept solids. Every successive front layer covers the hidden parts
// of the layer behind it, so the browser performs the same visibility cleanup that
// made the Figma sweep study read as one solid 3D button instead of wireframe blocks.
const NORMAL_SWEEP_DEPTHS = Array.from({ length: FULL_DEPTH - 1 }, (_, index) => FULL_DEPTH - 1 - index); // 27..1
const PRESSED_SWEEP_DEPTHS = Array.from(
    { length: FULL_DEPTH - PRESS_DISTANCE - 1 },
    (_, index) => FULL_DEPTH - 1 - index,
); // 27..15

// Keep the approved cross-hatch as one global field so its phase reads continuously N → R → N.
const HATCH_DIRECTION = { x: 0.5885843638383417, y: 0.808435802426522 };
const HATCH_NORMAL = { x: -0.808435802426522, y: 0.5885843638383417 };
const HATCH_SPACING = 5.357116234906698;
const HATCH_LENGTH = 1500;
const hatchCorners = [
    { x: VIEWBOX_X, y: VIEWBOX_Y },
    { x: VIEWBOX_X + VIEWBOX_WIDTH, y: VIEWBOX_Y },
    { x: VIEWBOX_X, y: VIEWBOX_Y + VIEWBOX_HEIGHT },
    { x: VIEWBOX_X + VIEWBOX_WIDTH, y: VIEWBOX_Y + VIEWBOX_HEIGHT },
];
const hatchProjection = hatchCorners.map(({ x, y }) => x * HATCH_NORMAL.x + y * HATCH_NORMAL.y);
const hatchMin = Math.min(...hatchProjection) - 120;
const hatchMax = Math.max(...hatchProjection) + 120;
const hatchStart = Math.floor(hatchMin / HATCH_SPACING) * HATCH_SPACING;
const hatchSegments: string[] = [];
for (let offset = hatchStart; offset <= hatchMax; offset += HATCH_SPACING) {
    const cx = HATCH_NORMAL.x * offset;
    const cy = HATCH_NORMAL.y * offset;
    const x1 = cx - HATCH_DIRECTION.x * HATCH_LENGTH;
    const y1 = cy - HATCH_DIRECTION.y * HATCH_LENGTH;
    const x2 = cx + HATCH_DIRECTION.x * HATCH_LENGTH;
    const y2 = cy + HATCH_DIRECTION.y * HATCH_LENGTH;
    hatchSegments.push(`M ${x1.toFixed(3)} ${y1.toFixed(3)} L ${x2.toFixed(3)} ${y2.toFixed(3)}`);
}
const GLOBAL_HATCH_PATH = hatchSegments.join(' ');
---

<div class="nrn-stage" data-nrn-stage>
    <button
        class="nrn-mark"
        type="button"
        data-nrn-mark
        aria-label="Press the interactive NRN mark"
        aria-pressed="false"
    >
        <svg
            class="nrn-svg"
            data-nrn-svg
            viewBox={`${VIEWBOX_X} ${VIEWBOX_Y} ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
            preserveAspectRatio="xMidYMid meet"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Continuous isometric NRN monogram"
        >
            <defs>
                <clipPath id="nrn-surface-clip" clipPathUnits="userSpaceOnUse">
                    <path d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" clip-rule="evenodd" />
                    <path d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </clipPath>

                <radialGradient
                    id="nrn-radial-gradient"
                    data-nrn-gradient
                    cx="472"
                    cy="280"
                    r="300"
                    gradientUnits="userSpaceOnUse"
                >
                    <stop offset="0" class="nrn-glow-start" />
                    <stop offset="1" class="nrn-glow-end" />
                </radialGradient>
            </defs>

            <g class="nrn-guides" aria-hidden="true">
                <path d="M 24 568 L 936 42" />
                <path d="M -20 132 L 894 660" />
                <path d="M 174 -24 L 948 422" />
            </g>

            <!-- NORMAL swept solid: back outline first, then opaque frontward slices.
                 Each slice masks hidden geometry from the slice behind it. -->
            <g data-solid-normal aria-hidden="true">
                <g class="nrn-bottom-base">
                    {LETTERS.map((letter) => (
                        <g transform={letter.transform}>
                            <path
                                d={letter.path}
                                transform={`translate(0 ${FULL_DEPTH})`}
                                fill-rule={letter.fillRule}
                            />
                        </g>
                    ))}
                </g>
                <g class="nrn-bottom-glow">
                    {LETTERS.map((letter) => (
                        <g transform={letter.transform}>
                            <path
                                d={letter.path}
                                transform={`translate(0 ${FULL_DEPTH})`}
                                fill-rule={letter.fillRule}
                            />
                        </g>
                    ))}
                </g>

                {NORMAL_SWEEP_DEPTHS.map((depth) => (
                    <g class="nrn-sweep-depth" data-depth={depth}>
                        {LETTERS.map((letter) => (
                            <g transform={letter.transform}>
                                <path
                                    class="nrn-sweep-layer"
                                    d={letter.path}
                                    transform={`translate(0 ${depth})`}
                                    fill-rule={letter.fillRule}
                                />
                            </g>
                        ))}
                    </g>
                ))}
            </g>

            <!-- PRESSED swept solid: same bottom plane, but only offsets 15..28 remain.
                 This is the exact topological change produced by pressing 14px down. -->
            <g data-solid-pressed aria-hidden="true" opacity="0">
                <g class="nrn-bottom-base">
                    {LETTERS.map((letter) => (
                        <g transform={letter.transform}>
                            <path
                                d={letter.path}
                                transform={`translate(0 ${FULL_DEPTH})`}
                                fill-rule={letter.fillRule}
                            />
                        </g>
                    ))}
                </g>
                <g class="nrn-bottom-glow">
                    {LETTERS.map((letter) => (
                        <g transform={letter.transform}>
                            <path
                                d={letter.path}
                                transform={`translate(0 ${FULL_DEPTH})`}
                                fill-rule={letter.fillRule}
                            />
                        </g>
                    ))}
                </g>

                {PRESSED_SWEEP_DEPTHS.map((depth) => (
                    <g class="nrn-sweep-depth" data-depth={depth}>
                        {LETTERS.map((letter) => (
                            <g transform={letter.transform}>
                                <path
                                    class="nrn-sweep-layer"
                                    d={letter.path}
                                    transform={`translate(0 ${depth})`}
                                    fill-rule={letter.fillRule}
                                />
                            </g>
                        ))}
                    </g>
                ))}
            </g>

            <!-- Exact approved top surface. It is the rigid cap that moves continuously. -->
            <g data-nrn-surface>
                <g class="nrn-front-fill" aria-hidden="true">
                    <path d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" />
                    <path d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </g>

                <path
                    class="nrn-global-hatch"
                    d={GLOBAL_HATCH_PATH}
                    clip-path="url(#nrn-surface-clip)"
                    aria-hidden="true"
                />

                <g class="nrn-top-base" aria-hidden="true">
                    <path d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" />
                    <path d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </g>
                <g class="nrn-top-glow" aria-hidden="true">
                    <path d={N_FRONT_PATH} transform={LEFT_N_MATRIX} />
                    <path d={R_FRONT_PATH} transform={R_MATRIX} fill-rule="evenodd" />
                    <path d={N_FRONT_PATH} transform={RIGHT_N_MATRIX} />
                </g>
            </g>

            <text class="nrn-fig-label" x="78" y="495">FIG. 01 / NRN SYSTEM</text>
        </svg>
    </button>

    <div class="nrn-note" aria-hidden="true">
        <svg viewBox="0 0 54 54">
            <path d="M49 6C37 8 28 14 23 23C18 31 19 39 24 45" />
            <path d="M17 39L24 46L31 39" />
        </svg>
        <span>
            follows your cursor
            <small>click the mark</small>
        </span>
    </div>
</div>

<style>
    .nrn-stage {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        color: var(--text);
        background: var(--bg);
        --nrn-top-stroke: color-mix(in srgb, var(--text) 34%, var(--bg));
        --nrn-bottom-stroke: color-mix(in srgb, var(--text) 27%, var(--bg));
        --nrn-sweep-stroke: color-mix(in srgb, var(--text) 21%, var(--bg));
        --nrn-hatch: color-mix(in srgb, var(--text) 24%, var(--bg));
    }

    .nrn-mark {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .nrn-mark:focus-visible {
        outline: 1px solid color-mix(in srgb, var(--text) 62%, transparent);
        outline-offset: -5px;
    }

    .nrn-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nrn-guides {
        fill: none;
        stroke: color-mix(in srgb, var(--text) 7%, var(--bg));
        stroke-width: 1;
        stroke-dasharray: 5 5;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
    }

    .nrn-sweep-layer,
    .nrn-front-fill path {
        fill: var(--bg);
    }

    .nrn-sweep-layer {
        stroke: var(--nrn-sweep-stroke);
        stroke-width: 0.34;
        stroke-opacity: 0.24;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }

    .nrn-bottom-base,
    .nrn-bottom-glow,
    .nrn-top-base,
    .nrn-top-glow,
    .nrn-global-hatch {
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
        pointer-events: none;
    }

    .nrn-bottom-base {
        stroke: var(--nrn-bottom-stroke);
        stroke-width: 1.15;
    }

    .nrn-bottom-glow {
        stroke: url(#nrn-radial-gradient);
        stroke-width: 1.15;
    }

    .nrn-top-base {
        stroke: var(--nrn-top-stroke);
        stroke-width: 1.45;
    }

    .nrn-top-glow {
        stroke: url(#nrn-radial-gradient);
        stroke-width: 1.45;
    }

    .nrn-global-hatch {
        stroke: var(--nrn-hatch);
        stroke-width: 0.5;
        opacity: 0.74;
    }

    .nrn-glow-start {
        stop-color: var(--text);
        stop-opacity: 1;
    }

    .nrn-glow-end {
        stop-color: color-mix(in srgb, var(--text) 40%, var(--bg));
        stop-opacity: 0;
    }

    .nrn-fig-label {
        fill: color-mix(in srgb, var(--muted) 50%, var(--bg));
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        user-select: none;
    }

    .nrn-note {
        position: absolute;
        right: 3%;
        top: 58%;
        display: flex;
        align-items: flex-end;
        gap: 5px;
        color: color-mix(in srgb, var(--text) 72%, var(--muted));
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: clamp(12px, 1vw, 16px);
        font-style: italic;
        line-height: 1.2;
        transform: rotate(-3deg);
        pointer-events: none;
        user-select: none;
    }

    .nrn-note span {
        display: flex;
        flex-direction: column;
    }

    .nrn-note small {
        margin-top: 2px;
        font: inherit;
        opacity: 0.76;
    }

    .nrn-note svg {
        width: 50px;
        height: 50px;
        overflow: visible;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.05;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.78;
        transform: rotate(-12deg) translateY(4px);
    }

    @media (max-width: 720px) {
        .nrn-note {
            top: auto;
            right: 3%;
            bottom: 8%;
        }
    }

    @media (hover: none) {
        .nrn-note {
            display: none;
        }
    }
</style>

<script>
    type SpringState = { value: number; velocity: number };

    const PRESS_DEPTH = 14;

    const springAdvance = (
        state: SpringState,
        target: number,
        stiffness: number,
        damping: number,
        mass: number,
        dt: number,
    ) => {
        const substep = 1 / 240;
        const steps = Math.max(1, Math.ceil(dt / substep));
        const h = dt / steps;
        for (let index = 0; index < steps; index += 1) {
            const force = -stiffness * (state.value - target) - damping * state.velocity;
            const acceleration = force / mass;
            state.velocity += acceleration * h;
            state.value += state.velocity * h;
        }
    };

    const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
    const smoothstep = (edge0: number, edge1: number, value: number) => {
        const x = clamp01((value - edge0) / Math.max(edge1 - edge0, 0.0001));
        return x * x * (3 - 2 * x);
    };

    const setupNRN = (root: HTMLElement) => {
        if (root.dataset.nrnReady === 'true') return;
        root.dataset.nrnReady = 'true';

        const mark = root.querySelector<HTMLButtonElement>('[data-nrn-mark]');
        const svg = root.querySelector<SVGSVGElement>('[data-nrn-svg]');
        const surface = root.querySelector<SVGGElement>('[data-nrn-surface]');
        const normalSolid = root.querySelector<SVGGElement>('[data-solid-normal]');
        const pressedSolid = root.querySelector<SVGGElement>('[data-solid-pressed]');
        const gradient = root.querySelector<SVGRadialGradientElement>('[data-nrn-gradient]');
        if (!mark || !svg || !surface || !normalSolid || !pressedSolid || !gradient) return;

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
        const cursorX: SpringState = { value: 472, velocity: 0 };
        const cursorY: SpringState = { value: 280, velocity: 0 };
        const press: SpringState = { value: 0, velocity: 0 };

        let cursorTargetX = cursorX.value;
        let cursorTargetY = cursorY.value;
        let pressTarget = 0;
        let pressed = false;
        let inView = true;
        let raf = 0;
        let lastTime = performance.now();
        let audioContext: AudioContext | null = null;

        const onPointerMove = (event: PointerEvent) => {
            if (!finePointer.matches) return;
            const ctm = svg.getScreenCTM();
            if (!ctm) return;
            const point = svg.createSVGPoint();
            point.x = event.clientX;
            point.y = event.clientY;
            const local = point.matrixTransform(ctm.inverse());
            cursorTargetX = local.x;
            cursorTargetY = local.y;
        };

        const playClick = () => {
            try {
                audioContext ??= new AudioContext();
                const now = audioContext.currentTime;
                const oscillator = audioContext.createOscillator();
                const gain = audioContext.createGain();
                oscillator.type = 'triangle';
                oscillator.frequency.setValueAtTime(210, now);
                oscillator.frequency.exponentialRampToValueAtTime(82, now + 0.045);
                gain.gain.setValueAtTime(0.0001, now);
                gain.gain.exponentialRampToValueAtTime(0.05, now + 0.004);
                gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.075);
                oscillator.connect(gain);
                gain.connect(audioContext.destination);
                oscillator.start(now);
                oscillator.stop(now + 0.08);
            } catch {
                // Sound is decorative; interaction remains functional without it.
            }
        };

        const pressDown = () => {
            if (pressed) return;
            pressed = true;
            pressTarget = PRESS_DEPTH;
            mark.setAttribute('aria-pressed', 'true');
        };

        const release = (withSound = true) => {
            if (!pressed) return;
            pressed = false;
            pressTarget = 0;
            mark.setAttribute('aria-pressed', 'false');
            if (withSound) playClick();
        };

        window.addEventListener('pointermove', onPointerMove, { passive: true });
        mark.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            mark.setPointerCapture?.(event.pointerId);
            pressDown();
        });
        mark.addEventListener('pointerup', (event) => {
            if (mark.hasPointerCapture?.(event.pointerId)) mark.releasePointerCapture?.(event.pointerId);
            release(true);
        });
        mark.addEventListener('pointercancel', () => release(false));
        mark.addEventListener('lostpointercapture', () => release(false));
        mark.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            pressDown();
        });
        mark.addEventListener('keyup', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            release(true);
        });
        mark.addEventListener('blur', () => release(false));

        const observer = new IntersectionObserver(
            ([entry]) => {
                inView = entry?.isIntersecting ?? true;
            },
            { rootMargin: '80px', threshold: 0.01 },
        );
        observer.observe(root);

        const renderPress = (value: number) => {
            surface.setAttribute('transform', `translate(0 ${value.toFixed(3)})`);

            const progress = clamp01(value / PRESS_DEPTH);
            const pressedMix = smoothstep(0.34, 0.66, progress);
            normalSolid.setAttribute('opacity', (1 - pressedMix).toFixed(4));
            pressedSolid.setAttribute('opacity', pressedMix.toFixed(4));
        };

        const tick = (now: number) => {
            const dt = Math.min((now - lastTime) / 1000, 0.05);
            lastTime = now;

            if (reducedMotion.matches) {
                cursorX.value = cursorTargetX;
                cursorY.value = cursorTargetY;
                cursorX.velocity = 0;
                cursorY.velocity = 0;
                press.value = pressTarget;
                press.velocity = 0;
            } else {
                springAdvance(cursorX, cursorTargetX, 300, 30, 0.1, dt);
                springAdvance(cursorY, cursorTargetY, 300, 30, 0.1, dt);
                springAdvance(press, pressTarget, 200, 18, 0.5, dt);
            }

            if (inView) {
                gradient.setAttribute('cx', cursorX.value.toFixed(2));
                gradient.setAttribute('cy', cursorY.value.toFixed(2));
                renderPress(press.value);
            }
            raf = requestAnimationFrame(tick);
        };

        renderPress(0);
        raf = requestAnimationFrame(tick);

        window.addEventListener(
            'pagehide',
            () => {
                cancelAnimationFrame(raf);
                observer.disconnect();
                window.removeEventListener('pointermove', onPointerMove);
            },
            { once: true },
        );
    };

    document.querySelectorAll<HTMLElement>('[data-nrn-stage]').forEach(setupNRN);
</script>
