---
const patterns = [
    [
        '10001',
        '11001',
        '10101',
        '10101',
        '10011',
        '10011',
        '10001',
    ],
    [
        '11110',
        '10001',
        '10001',
        '11110',
        '10100',
        '10010',
        '10001',
    ],
    [
        '10001',
        '11001',
        '10101',
        '10101',
        '10011',
        '10011',
        '10001',
    ],
] as const;

const halfW = 16;
const halfH = 8;
const stepX = 18;
const stepY = 9;
const depth = 13;
const baseX = 48;
const baseY = 174;
const letterStride = 7;

const blocks = patterns.flatMap((pattern, letterIndex) =>
    pattern.flatMap((row, rowIndex) =>
        [...row].flatMap((filled, colIndex) => {
            if (filled !== '1') return [];
            const col = colIndex + letterIndex * letterStride;
            const x = baseX + (col + rowIndex) * stepX;
            const y = baseY + (rowIndex - col) * stepY;
            return [{ x, y }];
        }),
    ),
);

const topPoints = (x: number, y: number) =>
    `${x},${y} ${x + halfW},${y - halfH} ${x + halfW * 2},${y} ${x + halfW},${y + halfH}`;
const leftPoints = (x: number, y: number) =>
    `${x},${y} ${x + halfW},${y + halfH} ${x + halfW},${y + halfH + depth} ${x},${y + depth}`;
const rightPoints = (x: number, y: number) =>
    `${x + halfW},${y + halfH} ${x + halfW * 2},${y} ${x + halfW * 2},${y + depth} ${x + halfW},${y + halfH + depth}`;
---

<div class="nrn-stage" data-nrn-stage>
    <button
        class="nrn-mark"
        type="button"
        data-nrn-mark
        aria-label="Press the interactive NRN mark"
        aria-pressed="false"
    >
        <svg class="nrn-svg" data-nrn-svg viewBox="0 0 560 320" role="img" aria-label="Isometric NRN monogram">
            <defs>
                <radialGradient id="nrn-pointer-glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0.22" />
                    <stop offset="42%" stop-color="currentColor" stop-opacity="0.08" />
                    <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                </radialGradient>
            </defs>

            <g class="nrn-guides" aria-hidden="true">
                <line x1="-20" y1="258" x2="480" y2="8" />
                <line x1="58" y1="320" x2="558" y2="70" />
                <line x1="94" y1="-14" x2="558" y2="218" />
                <line x1="0" y1="58" x2="500" y2="308" />
                {Array.from({ length: 8 }, (_, index) => (
                    <line x1={80 + index * 58} y1="34" x2={80 + index * 58} y2="286" />
                ))}
                {Array.from({ length: 5 }, (_, index) => (
                    <line x1="30" y1={72 + index * 48} x2="530" y2={72 + index * 48} />
                ))}
            </g>

            <circle class="nrn-glow" data-nrn-glow cx="390" cy="128" r="98" fill="url(#nrn-pointer-glow)" />

            <g class="nrn-extrusion" aria-hidden="true">
                {blocks.map(({ x, y }) => (
                    <g>
                        <polygon class="nrn-face nrn-face-left" points={leftPoints(x, y)} />
                        <polygon class="nrn-face nrn-face-right" points={rightPoints(x, y)} />
                    </g>
                ))}
            </g>

            <g class="nrn-top" data-nrn-top>
                {blocks.map(({ x, y }) => (
                    <polygon class="nrn-face nrn-face-top" points={topPoints(x, y)} />
                ))}
            </g>

            <text class="nrn-fig-label" x="34" y="292">FIG. 01 / NRN SYSTEM</text>
        </svg>
    </button>

    <div class="nrn-note" aria-hidden="true">
        <svg viewBox="0 0 54 54">
            <path d="M50 6C37 7 26 14 21 24C17 31 18 39 23 45" />
            <path d="M16 39L23 46L30 39" />
        </svg>
        <span>click around</span>
    </div>
</div>

<style>
    .nrn-stage {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        color: var(--text);
        background:
            linear-gradient(color-mix(in srgb, var(--border) 45%, transparent) 1px, transparent 1px),
            linear-gradient(90deg, color-mix(in srgb, var(--border) 45%, transparent) 1px, transparent 1px);
        background-size: 78px 66px;
        background-position: 42px 70px;
    }

    .nrn-mark {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
        padding: 0;
        background: transparent;
        color: var(--text);
        cursor: pointer;
        touch-action: manipulation;
        -webkit-tap-highlight-color: transparent;
    }

    .nrn-mark:focus-visible {
        outline: 1px solid var(--text);
        outline-offset: -5px;
    }

    .nrn-svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .nrn-guides {
        fill: none;
        stroke: color-mix(in srgb, var(--border) 72%, transparent);
        stroke-width: 1;
        opacity: 0.7;
    }

    .nrn-glow {
        opacity: 0;
        transition: opacity 180ms ease;
        pointer-events: none;
    }

    .nrn-mark.is-hovering .nrn-glow,
    .nrn-mark:focus-visible .nrn-glow {
        opacity: 1;
    }

    .nrn-face {
        vector-effect: non-scaling-stroke;
        stroke-linejoin: round;
    }

    .nrn-face-left {
        fill: color-mix(in srgb, var(--surface-2) 88%, transparent);
        stroke: color-mix(in srgb, var(--muted) 58%, var(--border));
        stroke-width: 0.8;
    }

    .nrn-face-right {
        fill: color-mix(in srgb, var(--surface) 94%, transparent);
        stroke: color-mix(in srgb, var(--muted) 66%, var(--border));
        stroke-width: 0.9;
    }

    .nrn-top {
        transform-box: fill-box;
        transform-origin: center;
        transition:
            transform 330ms cubic-bezier(0.18, 1.42, 0.38, 1),
            filter 180ms ease;
        will-change: transform;
    }

    .nrn-face-top {
        fill: color-mix(in srgb, var(--surface) 72%, transparent);
        stroke: color-mix(in srgb, var(--text) 54%, var(--border));
        stroke-width: 0.95;
        transition: fill 180ms ease, stroke 180ms ease;
    }

    .nrn-mark.is-hovering .nrn-face-top,
    .nrn-mark:focus-visible .nrn-face-top {
        fill: color-mix(in srgb, var(--surface-2) 76%, transparent);
        stroke: color-mix(in srgb, var(--text) 72%, var(--border));
    }

    .nrn-mark.is-pressed .nrn-top {
        transform: translateY(11px);
        transition-duration: 90ms;
        transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }

    .nrn-mark.is-rebounding .nrn-top {
        animation: nrn-rebound 410ms cubic-bezier(0.16, 1.34, 0.3, 1);
    }

    .nrn-fig-label {
        fill: var(--muted);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.02em;
    }

    .nrn-note {
        position: absolute;
        right: 8.5%;
        bottom: 18%;
        display: flex;
        align-items: flex-end;
        gap: 2px;
        color: color-mix(in srgb, var(--text) 72%, var(--muted));
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: clamp(12px, 1vw, 17px);
        font-style: italic;
        transform: rotate(3deg);
        pointer-events: none;
        user-select: none;
    }

    .nrn-note svg {
        width: 48px;
        height: 48px;
        overflow: visible;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.15;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: 0.8;
        transform: rotate(-12deg) translateY(4px);
    }

    @keyframes nrn-rebound {
        0% { transform: translateY(11px); }
        48% { transform: translateY(-2.5px); }
        72% { transform: translateY(1.25px); }
        100% { transform: translateY(0); }
    }

    @media (max-width: 720px) {
        .nrn-note {
            right: 6%;
            bottom: 10%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .nrn-top,
        .nrn-face-top,
        .nrn-glow {
            transition: none !important;
            animation: none !important;
        }

        .nrn-mark.is-pressed .nrn-top {
            transform: translateY(5px);
        }
    }
</style>

<script>
    type NrnState = 'idle' | 'hover' | 'pressed';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const playClick = () => {
        try {
            const AudioContextCtor = window.AudioContext ?? (window as typeof window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
            if (!AudioContextCtor) return;

            const context = new AudioContextCtor();
            const now = context.currentTime;
            const gain = context.createGain();
            const high = context.createOscillator();
            const low = context.createOscillator();

            high.type = 'triangle';
            high.frequency.setValueAtTime(920, now);
            high.frequency.exponentialRampToValueAtTime(540, now + 0.045);
            low.type = 'sine';
            low.frequency.setValueAtTime(210, now);
            low.frequency.exponentialRampToValueAtTime(135, now + 0.065);

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.exponentialRampToValueAtTime(0.055, now + 0.006);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.075);

            high.connect(gain);
            low.connect(gain);
            gain.connect(context.destination);
            high.start(now);
            low.start(now);
            high.stop(now + 0.08);
            low.stop(now + 0.08);
            window.setTimeout(() => void context.close(), 130);
        } catch {
            // Sound is purely decorative; interaction still works without Web Audio.
        }
    };

    document.querySelectorAll<HTMLButtonElement>('[data-nrn-mark]').forEach((mark) => {
        if (mark.dataset.initialized === 'true') return;
        mark.dataset.initialized = 'true';

        const svg = mark.querySelector<SVGSVGElement>('[data-nrn-svg]');
        const glow = mark.querySelector<SVGCircleElement>('[data-nrn-glow]');
        if (!svg || !glow) return;

        let state: NrnState = 'idle';
        let reboundTimer = 0;

        const syncState = (next: NrnState) => {
            state = next;
            mark.classList.toggle('is-hovering', next === 'hover' || next === 'pressed');
            mark.classList.toggle('is-pressed', next === 'pressed');
            mark.setAttribute('aria-pressed', String(next === 'pressed'));
        };

        const updateGlow = (event: PointerEvent) => {
            const bounds = svg.getBoundingClientRect();
            if (bounds.width === 0 || bounds.height === 0) return;
            const x = ((event.clientX - bounds.left) / bounds.width) * 560;
            const y = ((event.clientY - bounds.top) / bounds.height) * 320;
            glow.setAttribute('cx', x.toFixed(2));
            glow.setAttribute('cy', y.toFixed(2));
        };

        const press = () => {
            window.clearTimeout(reboundTimer);
            mark.classList.remove('is-rebounding');
            syncState('pressed');
        };

        const release = (withSound = false) => {
            if (state !== 'pressed') return;
            if (withSound) playClick();

            mark.classList.remove('is-pressed');
            mark.classList.add('is-rebounding');
            mark.setAttribute('aria-pressed', 'false');
            state = 'hover';

            reboundTimer = window.setTimeout(() => {
                mark.classList.remove('is-rebounding');
                syncState(mark.matches(':hover') || mark.matches(':focus-visible') ? 'hover' : 'idle');
            }, reducedMotion.matches ? 40 : 430);
        };

        mark.addEventListener('pointerenter', (event) => {
            syncState('hover');
            updateGlow(event);
        });
        mark.addEventListener('pointermove', updateGlow);
        mark.addEventListener('pointerleave', () => {
            if (state === 'pressed') release(false);
            syncState('idle');
        });
        mark.addEventListener('pointerdown', (event) => {
            if (event.button !== 0) return;
            mark.setPointerCapture?.(event.pointerId);
            updateGlow(event);
            press();
        });
        mark.addEventListener('pointerup', (event) => {
            if (event.button !== 0) return;
            release(true);
        });
        mark.addEventListener('pointercancel', () => release(false));

        mark.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            press();
        });
        mark.addEventListener('keyup', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            release(true);
        });
        mark.addEventListener('focus', () => syncState('hover'));
        mark.addEventListener('blur', () => syncState('idle'));
    });
</script>
