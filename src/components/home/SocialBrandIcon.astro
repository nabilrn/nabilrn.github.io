---
import BrandIcon from '../icons/BrandIcon.astro';

type SocialBrand = 'github' | 'linkedin' | 'x' | 'gmail' | 'threads';

interface Props {
    name: SocialBrand;
    size?: number;
    class?: string;
}

const { name, size = 16, class: className } = Astro.props;

const simplePaths = {
    gmail: 'M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z',
    threads: 'M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098c1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015c-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164c1.43 1.783 3.631 2.698 6.54 2.717c2.623-.02 4.358-.631 5.8-2.045c1.647-1.613 1.618-3.593 1.09-4.798c-.31-.71-.873-1.3-1.634-1.75c-.192 1.352-.622 2.446-1.284 3.272c-.886 1.102-2.14 1.704-3.73 1.79c-1.202.065-2.361-.218-3.259-.801c-1.063-.689-1.685-1.74-1.752-2.964c-.065-1.19.408-2.285 1.33-3.082c.88-.76 2.119-1.207 3.583-1.291a14 14 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757c-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32l-1.757-1.18c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388q.163.07.321.142c1.49.7 2.58 1.761 3.154 3.07c.797 1.82.871 4.79-1.548 7.158c-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69q-.362 0-.739.021c-1.836.103-2.98.946-2.916 2.143c.067 1.256 1.452 1.839 2.784 1.767c1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221',
} as const;
---

<span class:list={['social-brand-icon', className]} data-brand={name} style={`--social-icon-size:${size}px`}>
    <span class="social-brand-mono" aria-hidden="true">
        {name === 'gmail' || name === 'threads'
            ? (
                <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={name === 'gmail' ? simplePaths.gmail : simplePaths.threads} />
                </svg>
            )
            : <BrandIcon name={name} size={size} />}
    </span>

    <span class="social-brand-color" aria-hidden="true">
        {name === 'github' && <BrandIcon name="github" size={size} />}
        {name === 'linkedin' && <BrandIcon name="linkedin" size={size} />}
        {name === 'x' && <BrandIcon name="x" size={size} />}
        {(name === 'gmail' || name === 'threads') && (
            <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={name === 'gmail' ? simplePaths.gmail : simplePaths.threads} />
            </svg>
        )}
    </span>
</span>

<style>
    .social-brand-icon {
        position: relative;
        width: var(--social-icon-size);
        height: var(--social-icon-size);
        display: grid;
        place-items: center;
    }

    .social-brand-mono,
    .social-brand-color {
        grid-area: 1 / 1;
        display: grid;
        place-items: center;
        line-height: 0;
        transition: opacity 140ms ease, transform 140ms ease;
    }

    .social-brand-mono {
        opacity: 1;
    }

    .social-brand-color {
        opacity: 0;
    }

    [data-brand='linkedin'] .social-brand-color {
        color: #0a66c2;
    }

    [data-brand='gmail'] .social-brand-color {
        color: #ea4335;
    }

    [data-brand='github'] .social-brand-color,
    [data-brand='x'] .social-brand-color,
    [data-brand='threads'] .social-brand-color {
        color: var(--text);
    }

    :global(.social-links a:hover) .social-brand-mono,
    :global(.social-links a:focus-visible) .social-brand-mono {
        opacity: 0;
        transform: scale(.94);
    }

    :global(.social-links a:hover) .social-brand-color,
    :global(.social-links a:focus-visible) .social-brand-color {
        opacity: 1;
        transform: scale(1.04);
    }
</style>
