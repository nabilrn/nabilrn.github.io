---
import BrandIcon from '../icons/BrandIcon.astro';

interface Props {
    repo?: string;
}

const { repo = 'nabilrn/nabilrn.github.io' } = Astro.props;
const repoUrl = `https://github.com/${repo}`;
---

<a
    class="github-stars"
    href={repoUrl}
    target="_blank"
    rel="noopener"
    data-github-stars
    data-repo={repo}
    title="GitHub stars"
    aria-label="View source repository on GitHub"
>
    <BrandIcon name="github" size={15} />
    <span class="github-stars-count" data-github-stars-count>0</span>
    <span class="sr-only">GitHub stars</span>
</a>

<script is:inline>
    (() => {
        const TTL = 24 * 60 * 60 * 1000;
        const compact = new Intl.NumberFormat('en', {
            notation: 'compact',
            maximumFractionDigits: 1,
        });

        const format = (value) => compact.format(value).toLowerCase();

        document.querySelectorAll('[data-github-stars]').forEach((root) => {
            const repo = root.getAttribute('data-repo');
            const countNode = root.querySelector('[data-github-stars-count]');
            if (!repo || !countNode) return;

            const cacheKey = `portfolio:github-stars:${repo}`;

            const render = (count) => {
                const safeCount = Number.isFinite(count) ? count : 0;
                countNode.textContent = format(safeCount);
                root.setAttribute('title', `${safeCount.toLocaleString('en')} GitHub stars`);
                root.setAttribute('aria-label', `${safeCount.toLocaleString('en')} GitHub stars — view source repository`);
            };

            try {
                const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
                if (cached && Date.now() - cached.timestamp < TTL && Number.isFinite(cached.count)) {
                    render(cached.count);
                    return;
                }
            } catch {
                // Ignore malformed or unavailable storage.
            }

            fetch(`https://api.github.com/repos/${repo}`, {
                headers: { Accept: 'application/vnd.github+json' },
            })
                .then((response) => {
                    if (!response.ok) throw new Error('GitHub stars request failed');
                    return response.json();
                })
                .then((data) => {
                    const count = Number(data?.stargazers_count) || 0;
                    render(count);
                    try {
                        localStorage.setItem(cacheKey, JSON.stringify({ count, timestamp: Date.now() }));
                    } catch {
                        // Storage is an optimization only.
                    }
                })
                .catch(() => {
                    // Keep the static fallback when GitHub is unavailable.
                });
        });
    })();
</script>

<style>
    .github-stars {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0 4px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        line-height: 1;
        transition: color 140ms ease;
    }

    .github-stars:hover {
        color: var(--text);
    }

    .github-stars-count {
        min-width: 1ch;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>
