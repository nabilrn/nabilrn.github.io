---
import EducationOverlayBase from './EducationOverlayBase.astro';
import ProjectCarouselOverlay from './ProjectCarouselOverlay.astro';
import LowerSectionsOverlay from './LowerSectionsOverlay.astro';
---

<EducationOverlayBase />
<ProjectCarouselOverlay />
<LowerSectionsOverlay />

<script is:inline>
    (() => {
        const desktop = window.matchMedia('(min-width: 721px)').matches;
        const loading = desktop ? 'eager' : 'lazy';
        const fetchPriority = desktop ? 'low' : 'auto';

        const configureTemplateImages = (templateSelector, imageSelector) => {
            const template = document.querySelector(templateSelector);
            if (!(template instanceof HTMLTemplateElement)) return;

            template.content.querySelectorAll(imageSelector).forEach((node) => {
                if (!(node instanceof HTMLImageElement)) return;
                node.loading = loading;
                node.decoding = 'async';
                node.fetchPriority = fetchPriority;
            });
        };

        configureTemplateImages(
            '[data-education-template]',
            '.education-logo, .education-photo img',
        );
        configureTemplateImages(
            '[data-lower-sections-template]',
            '.tweet-avatar',
        );
    })();
</script>

<style is:global>
    @media (min-width: 1100px) and (min-height: 760px) {
        .home-redesign .portfolio-board .bottom-layout {
            grid-template-columns:
                minmax(0, 47.2136fr)
                minmax(0, 23.6068fr)
                minmax(0, 29.1796fr);
        }
    }

    @media (max-width: 1099px), (max-height: 759px) {
        .home-redesign .portfolio-board .bottom-layout {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
