---
const mapsHref = 'https://www.google.com/maps/search/?api=1&query=Universitas%20Andalas%2C%20Limau%20Manis%2C%20Pauh%2C%20Padang%2C%20Sumatera%20Barat';
const logoSrc = 'https://fti.unand.ac.id/en/informasi/berita-dan-peristiwa/item/download/25_1ba5358f423fd20c18051fec9e856b64.html';
const campusSrc = 'https://www.unand.ac.id/images/gedung%20rektorat.jpg';
---

<template data-education-template>
    <div class="education-panel">
        <header class="education-header">
            <div class="education-heading">my education</div>

            <a
                class="education-map-link"
                href={mapsHref}
                target="_blank"
                rel="noopener"
                aria-label="See Universitas Andalas on Google Maps"
            >
                <span class="education-map-pin education-map-pin-mono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                        <circle cx="12" cy="10" r="2.5"></circle>
                    </svg>
                </span>
                <span class="education-map-pin education-map-pin-color" aria-hidden="true">
                    <img src="https://www.google.com/images/branding/product/ico/maps15_bnuw3a_32dp.ico" alt="" />
                </span>
                <span class="education-map-tooltip" role="tooltip">See on Google Maps</span>
            </a>
        </header>

        <div class="education-body">
            <div class="education-identity">
                <div class="education-logo-wrap" aria-hidden="true">
                    <img class="education-logo" src={logoSrc} alt="" />
                </div>

                <div class="education-copy">
                    <strong class="education-school">Universitas Andalas</strong>
                    <div class="education-meta-line" aria-label="Bachelor of Information Systems, GPA 3.71 out of 4.00">
                        <span class="education-major">B.InfoSys</span>
                        <span class="education-separator" aria-hidden="true">·</span>
                        <span class="education-gpa">GPA 3.71 / 4.00</span>
                    </div>
                </div>
            </div>

            <div class="education-photo" aria-label="Universitas Andalas rectorate building">
                <img src={campusSrc} alt="Universitas Andalas rectorate building" />
            </div>
        </div>
    </div>
</template>

<style is:global>
    .home-redesign .identity-board .education-region {
        padding: 0 !important;
        display: block !important;
        justify-content: initial !important;
        background: var(--bg);
        overflow: hidden;
    }

    .home-redesign .education-region > .micro-label,
    .home-redesign .education-region > .region-primary,
    .home-redesign .education-region > .region-secondary,
    .home-redesign .education-region > .region-meta {
        display: none !important;
    }

    .home-redesign .education-panel {
        --education-line: color-mix(in oklab, var(--border) 64%, var(--bg));

        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        background: var(--bg);
    }

    .home-redesign .education-header {
        box-sizing: border-box;
        width: 100%;
        height: 36px;
        min-width: 0;
        padding: 8px 12px 7px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--education-line);
    }

    .home-redesign .education-heading {
        flex: none;
        width: max-content;
        color: var(--muted);
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: 15px;
        font-weight: 400;
        line-height: 1;
        transform: rotate(-1.2deg);
        transform-origin: left center;
        user-select: none;
    }

    .home-redesign .education-map-link {
        position: relative;
        flex: none;
        width: 18px;
        height: 18px;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--muted) 88%, transparent);
        transition: color 160ms ease, transform 160ms ease;
    }

    .home-redesign .education-map-link:hover,
    .home-redesign .education-map-link:focus-visible {
        color: var(--text);
        transform: translateY(-1px) scale(1.04);
        outline: none;
    }

    .home-redesign .education-map-pin {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        transition: opacity 180ms ease, transform 180ms ease;
    }

    .home-redesign .education-map-pin-mono {
        opacity: 1;
    }

    .home-redesign .education-map-pin-mono svg {
        width: 14px;
        height: 14px;
    }

    .home-redesign .education-map-pin-color {
        opacity: 0;
        transform: scale(0.88);
    }

    .home-redesign .education-map-pin-color img {
        width: 16px;
        height: 16px;
        display: block;
        object-fit: contain;
    }

    .home-redesign .education-map-link:hover .education-map-pin-mono,
    .home-redesign .education-map-link:focus-visible .education-map-pin-mono {
        opacity: 0;
        transform: scale(0.88);
    }

    .home-redesign .education-map-link:hover .education-map-pin-color,
    .home-redesign .education-map-link:focus-visible .education-map-pin-color {
        opacity: 1;
        transform: scale(1);
    }

    .home-redesign .education-map-tooltip {
        position: absolute;
        z-index: 10;
        right: calc(100% + 7px);
        top: 50%;
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 450;
        line-height: 1.2;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translate(3px, -50%);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .home-redesign .education-map-link:hover .education-map-tooltip,
    .home-redesign .education-map-link:focus-visible .education-map-tooltip {
        opacity: 1;
        transform: translate(0, -50%);
    }

    .home-redesign .education-body {
        min-width: 0;
        min-height: 0;
        padding: 9px 12px 11px;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        row-gap: 10px;
    }

    .home-redesign .education-identity {
        min-width: 0;
        display: grid;
        grid-template-columns: 27px minmax(0, 1fr);
        align-items: center;
        column-gap: 7px;
    }

    .home-redesign .education-logo-wrap {
        width: 27px;
        height: 32px;
        display: grid;
        place-items: center;
    }

    .home-redesign .education-logo {
        width: 25px;
        max-height: 29px;
        display: block;
        object-fit: contain;
        filter: grayscale(1) saturate(0) contrast(1.05) brightness(1.08);
        opacity: 0.86;
        transition: filter 260ms ease, opacity 260ms ease, transform 260ms ease;
    }

    .home-redesign .education-logo-wrap:hover .education-logo {
        filter: grayscale(0) saturate(1) contrast(1) brightness(1);
        opacity: 1;
        transform: translateY(-1px);
    }

    .home-redesign .education-copy {
        min-width: 0;
        min-height: 32px;
        display: grid;
        grid-template-rows: auto auto;
        align-content: center;
        row-gap: 3px;
    }

    .home-redesign .education-school {
        min-width: 0;
        overflow: hidden;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(13.75px, 1.07vw, 14.5px);
        font-weight: 600;
        line-height: 1.05;
        letter-spacing: -0.025em;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .home-redesign .education-meta-line {
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: 5px;
        overflow: hidden;
        white-space: nowrap;
        line-height: 1.12;
    }

    .home-redesign .education-major {
        flex: none;
        color: var(--text-body);
        font-family: var(--font-sans);
        font-size: 9.75px;
        font-weight: 450;
    }

    .home-redesign .education-separator {
        flex: none;
        color: color-mix(in srgb, var(--muted) 84%, transparent);
        font-family: var(--font-mono);
        font-size: 9px;
    }

    .home-redesign .education-gpa {
        min-width: 0;
        overflow: hidden;
        color: color-mix(in srgb, var(--text-body) 92%, var(--muted));
        font-family: var(--font-mono);
        font-size: 9.5px;
        font-weight: 500;
        letter-spacing: 0.002em;
        text-overflow: ellipsis;
    }

    .home-redesign .education-photo {
        min-width: 0;
        min-height: 0;
        margin-bottom: 6px;
        overflow: hidden;
        border-block: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
        background: var(--surface);
    }

    .home-redesign .education-photo img {
        width: 100%;
        height: 100%;
        min-height: 0;
        display: block;
        object-fit: cover;
        object-position: center 41%;
        filter: grayscale(1) saturate(0.15) contrast(1.05) brightness(0.72);
        opacity: 0.86;
        transition: filter 320ms ease, opacity 320ms ease, transform 320ms ease;
    }

    .home-redesign .education-photo:hover img {
        filter: grayscale(0) saturate(1) contrast(1) brightness(0.94);
        opacity: 1;
        transform: scale(1.004);
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .home-redesign .education-header {
            height: 32px;
            padding-top: 6px;
            padding-bottom: 5px;
        }

        .home-redesign .education-heading {
            font-size: 14px;
        }

        .home-redesign .education-map-link {
            width: 17px;
            height: 17px;
        }

        .home-redesign .education-map-pin-mono svg {
            width: 13px;
            height: 13px;
        }

        .home-redesign .education-map-pin-color img {
            width: 15px;
            height: 15px;
        }

        .home-redesign .education-body {
            padding-top: 8px;
            padding-bottom: 10px;
            row-gap: 9px;
        }

        .home-redesign .education-identity {
            grid-template-columns: 25px minmax(0, 1fr);
            column-gap: 6px;
        }

        .home-redesign .education-logo-wrap {
            width: 25px;
            height: 30px;
        }

        .home-redesign .education-logo {
            width: 23px;
            max-height: 27px;
        }

        .home-redesign .education-copy {
            min-height: 30px;
            row-gap: 2px;
        }

        .home-redesign .education-school {
            font-size: 13.5px;
        }

        .home-redesign .education-major {
            font-size: 9.25px;
        }

        .home-redesign .education-gpa {
            font-size: 9px;
        }

        .home-redesign .education-meta-line {
            gap: 4px;
        }

        .home-redesign .education-photo {
            margin-bottom: 5px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-redesign .education-logo,
        .home-redesign .education-map-link,
        .home-redesign .education-map-pin,
        .home-redesign .education-map-tooltip,
        .home-redesign .education-photo img {
            transition: none;
        }
    }
</style>

<script>
    const template = document.querySelector<HTMLTemplateElement>('[data-education-template]');
    const region = document.querySelector<HTMLElement>('.education-region');

    if (template && region && !region.querySelector('.education-panel')) {
        region.replaceChildren(template.content.cloneNode(true));
    }
</script>
