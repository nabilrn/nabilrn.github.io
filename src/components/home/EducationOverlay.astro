---
const mapsHref = 'https://www.google.com/maps/search/?api=1&query=Universitas%20Andalas%2C%20Limau%20Manis%2C%20Pauh%2C%20Padang%2C%20Sumatera%20Barat';
---

<template data-education-map-template>
    <a
        class="education-map-link"
        href={mapsHref}
        target="_blank"
        rel="noopener"
        aria-label="See Universitas Andalas on Google Maps"
    >
        <span class="education-map-pin education-map-pin-mono" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
                <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
        </span>
        <span class="education-map-pin education-map-pin-color" aria-hidden="true">
            <img src="https://www.google.com/images/branding/product/ico/maps15_bnuw3a_32dp.ico" alt="" />
        </span>
        <span class="education-map-tooltip" role="tooltip">See on Google Maps</span>
    </a>
</template>

<style is:global>
    /* Treat the institution name, degree and GPA as one identity block.
       The crest is centered against the whole three-line block rather than
       against the title line alone. */
    .home-redesign .identity-board .education-region {
        position: relative;
        isolation: isolate;
        display: grid !important;
        grid-template-columns: 26px minmax(0, 1fr) 27px !important;
        grid-template-rows: auto auto auto auto minmax(0, 1fr) !important;
        column-gap: 8px !important;
        row-gap: 1px !important;
        align-content: start !important;
        justify-content: stretch !important;
        padding: 8px 12px 8px !important;
        background: var(--bg);
        overflow: hidden;
    }

    .home-redesign .education-region > * {
        min-width: 0;
    }

    .home-redesign .education-region .icon-label {
        grid-column: 1 / 4;
        grid-row: 1;
        margin: 0 0 4px !important;
        gap: 0 !important;
        color: color-mix(in srgb, var(--muted) 86%, transparent);
        font-size: 8.5px;
        line-height: 1;
        letter-spacing: 0.09em;
    }

    .home-redesign .education-region .icon-label > svg {
        display: none;
    }

    /* Disable the transitional crest that was attached only to the title row. */
    .home-redesign .education-region .region-primary::before {
        content: none !important;
        display: none !important;
    }

    /* The crest belongs to the entire identity group. */
    .home-redesign .education-region::before {
        content: '';
        grid-column: 1;
        grid-row: 2 / 5;
        align-self: center;
        justify-self: center;
        width: 24px;
        height: 30px;
        background-image: url('https://fti.unand.ac.id/en/informasi/berita-dan-peristiwa/item/download/25_1ba5358f423fd20c18051fec9e856b64.html');
        background-repeat: no-repeat;
        background-position: center;
        background-size: 24px auto;
        filter: grayscale(1) saturate(0) contrast(1.05) brightness(1.08);
        opacity: 0.82;
        transition: filter 280ms ease, opacity 280ms ease, transform 280ms ease;
    }

    .home-redesign .education-region .region-primary,
    .home-redesign .education-region .region-secondary,
    .home-redesign .education-region .region-meta {
        grid-column: 2;
        margin: 0 !important;
        padding: 0 !important;
        min-width: 0;
    }

    .home-redesign .education-region .region-primary {
        grid-row: 2;
        align-self: end;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(13px, 1.03vw, 15px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.025em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .home-redesign .education-region .region-secondary {
        grid-row: 3;
        color: var(--text-body);
        font-family: var(--font-sans);
        font-size: 9.5px;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .home-redesign .education-region .region-meta {
        grid-row: 4;
        min-height: 10px;
        color: transparent;
        font-size: 0;
        line-height: 1;
    }

    .home-redesign .education-region .region-meta::before {
        content: 'GPA 3.71 / 4.00' !important;
        position: static !important;
        display: block !important;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 8.5px;
        line-height: 1.15;
        letter-spacing: 0.005em;
    }

    .home-redesign .education-region .region-meta::after {
        content: none !important;
        display: none !important;
    }

    /* Keep the campus image as the visual anchor and reclaim the old location row. */
    .home-redesign .education-region::after {
        top: clamp(82px, 10.5vh, 92px) !important;
        bottom: 8px !important;
    }

    .home-redesign .education-region:hover::before,
    .home-redesign .education-region:focus-within::before {
        filter: grayscale(0) saturate(1) contrast(1) brightness(1);
        opacity: 1;
        transform: translateY(-1px);
    }

    .home-redesign .education-map-link {
        grid-column: 3;
        grid-row: 2 / 5;
        position: relative !important;
        z-index: 7 !important;
        align-self: center;
        justify-self: end;
        right: auto !important;
        top: auto !important;
        width: 27px !important;
        height: 27px !important;
        min-width: 0 !important;
        display: grid !important;
        place-items: center;
        border: 1px solid color-mix(in srgb, var(--text) 18%, var(--border));
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 22%, transparent);
        color: color-mix(in srgb, var(--muted) 92%, transparent);
        transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .home-redesign .education-map-link:hover,
    .home-redesign .education-map-link:focus-visible {
        border-color: color-mix(in srgb, var(--text) 44%, var(--border));
        background: color-mix(in srgb, var(--surface) 62%, transparent);
        transform: translateY(-1px);
        outline: none;
    }

    .home-redesign .education-map-pin {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        transition: opacity 180ms ease, transform 180ms ease;
    }

    .home-redesign .education-map-pin-mono {
        opacity: 1;
    }

    .home-redesign .education-map-pin-mono svg {
        width: 14px;
        height: 14px;
    }

    .home-redesign .education-map-pin-color {
        opacity: 0;
        transform: scale(0.88);
    }

    .home-redesign .education-map-pin-color img {
        width: 17px;
        height: 17px;
        display: block;
        object-fit: contain;
    }

    .home-redesign .education-map-link:hover .education-map-pin-mono,
    .home-redesign .education-map-link:focus-visible .education-map-pin-mono {
        opacity: 0;
        transform: scale(0.88);
    }

    .home-redesign .education-map-link:hover .education-map-pin-color,
    .home-redesign .education-map-link:focus-visible .education-map-pin-color {
        opacity: 1;
        transform: scale(1);
    }

    .home-redesign .education-map-tooltip {
        position: absolute;
        right: -1px;
        bottom: calc(100% + 8px);
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 450;
        line-height: 1.2;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateY(3px);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .home-redesign .education-map-link:hover .education-map-tooltip,
    .home-redesign .education-map-link:focus-visible .education-map-tooltip {
        opacity: 1;
        transform: translateY(0);
    }

    .home-redesign .education-region:focus-within::after {
        filter: grayscale(0) saturate(1) contrast(1) brightness(0.94);
        opacity: 1;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .home-redesign .identity-board .education-region {
            grid-template-columns: 24px minmax(0, 1fr) 25px !important;
            column-gap: 7px !important;
            padding-top: 7px !important;
        }

        .home-redesign .education-region::before {
            width: 22px;
            height: 28px;
            background-size: 22px auto;
        }

        .home-redesign .education-map-link {
            width: 25px !important;
            height: 25px !important;
        }

        .home-redesign .education-region .region-primary {
            font-size: 13px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-redesign .education-region::before,
        .home-redesign .education-map-link,
        .home-redesign .education-map-pin,
        .home-redesign .education-map-tooltip {
            transition: none;
        }
    }
</style>

<script>
    const template = document.querySelector<HTMLTemplateElement>('[data-education-map-template]');
    const region = document.querySelector<HTMLElement>('.education-region');

    if (template && region && !region.querySelector('.education-map-link')) {
        region.append(template.content.cloneNode(true));
    }
</script>
