---
import UiIcon from '../icons/UiIcon.astro';

interface Props {
    heading: string;
}

const { heading } = Astro.props;

const resumeHref = 'https://drive.google.com/uc?export=download&id=1ynLaBBeJue9JrGGVVJcTzlhoHGd1SQeV';

// Homepage copy stays intentionally compact; the public resume remains the
// detailed source of truth for responsibilities, impact, and technical scope.
const experienceItems = [
    {
        organization: 'NeoCentral · Department of Information Systems, Universitas Andalas',
        role: 'Software Engineer · Full Stack, Mobile & Platform',
        period: 'Aug 2025 — May 2026',
    },
    {
        organization: 'TKITI · Universitas Andalas',
        role: 'Coordinator Assistant',
        period: 'Mar 2025 — Mar 2026',
    },
    {
        organization: 'Department of Information Systems, Universitas Andalas',
        role: 'Teaching Assistant · Android Development Practicum',
        period: 'Aug 2025 — Dec 2025',
    },
    {
        organization: 'UPT Perpustakaan Universitas Andalas · Library Analytics',
        role: 'Software Engineer',
        period: 'Aug 2025 — Nov 2025',
    },
    {
        organization: 'Bank Nagari · Technology & Digitalization Division',
        role: 'Programmer Intern · Full Stack / Backend',
        period: 'Jan 2025 — Apr 2025',
    },
    {
        organization: 'Laboratory of Basic Computing, Universitas Andalas',
        role: 'Research & Development Staff',
        period: 'Aug 2024 — Mar 2025',
    },
] as const;
---

<div class="experience-panel">
    <header class="experience-header">
        <div class="experience-heading">
            <UiIcon name="briefcase" size={12} strokeWidth={1.5} />
            <span>{heading}</span>
        </div>

        <a
            class="resume-cta"
            href={resumeHref}
            target="_blank"
            rel="noopener"
            aria-label="Download public resume PDF"
        >
            <UiIcon name="download" size={11} strokeWidth={1.5} />
            <span>Resume</span>
        </a>
    </header>

    <div
        class="experience-scroll"
        role="region"
        aria-label="Work experience history"
        tabindex="0"
    >
        <div class="experience-timeline">
            {experienceItems.map((item) => (
                <article class="experience-entry">
                    <span class="timeline-dot" aria-hidden="true"></span>
                    <div class="experience-copy">
                        <strong class="experience-organization">{item.organization}</strong>
                        <div class="experience-meta">
                            <span class="experience-role">{item.role}</span>
                            <time class="experience-period">{item.period}</time>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</div>

<style>
    .experience-panel {
        --experience-line: color-mix(in oklab, var(--border) 64%, var(--bg));
        --timeline-line: color-mix(in srgb, var(--muted) 30%, transparent);
        width: 100%;
        height: 100%;
        min-width: 0;
        min-height: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
    }

    .experience-header {
        min-width: 0;
        padding: 9px clamp(12px, 0.95vw, 17px) 8px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--experience-line);
    }

    .experience-heading,
    .resume-cta {
        min-width: 0;
        display: inline-flex;
        align-items: center;
    }

    .experience-heading {
        flex: none;
        gap: 6px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 550;
        line-height: 1.2;
    }

    .resume-cta {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        flex: none;
        gap: 5px;
        padding: 4px 7px;
        border: 1px solid color-mix(in srgb, var(--text) 22%, var(--border));
        border-radius: 4px;
        background: color-mix(in srgb, var(--surface) 22%, transparent);
        color: color-mix(in srgb, var(--text) 82%, var(--muted));
        font-family: var(--font-mono);
        font-size: 8.5px;
        line-height: 1;
        letter-spacing: 0.015em;
        white-space: nowrap;
        transition:
            color 160ms ease,
            background 160ms ease,
            border-color 160ms ease,
            box-shadow 160ms ease,
            transform 160ms ease;
    }

    .resume-cta::after {
        content: '';
        position: absolute;
        inset: -1px;
        z-index: -1;
        width: 34%;
        background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--text) 12%, transparent), transparent);
        transform: translateX(-180%) skewX(-18deg);
        animation: resume-glint 4.8s ease-in-out infinite;
        pointer-events: none;
    }

    .resume-cta:hover,
    .resume-cta:focus-visible {
        color: var(--bg);
        background: var(--text);
        border-color: var(--text);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--text) 18%, transparent), 0 0 12px color-mix(in srgb, var(--text) 12%, transparent);
        transform: translateY(-1px);
        outline: none;
    }

    .resume-cta:hover :global(svg),
    .resume-cta:focus-visible :global(svg) {
        transform: translateY(1px);
    }

    .resume-cta :global(svg) {
        transition: transform 160ms ease;
    }

    @keyframes resume-glint {
        0%, 68% { transform: translateX(-180%) skewX(-18deg); }
        82%, 100% { transform: translateX(430%) skewX(-18deg); }
    }

    .experience-scroll {
        min-width: 0;
        min-height: 0;
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior-y: contain;
        scrollbar-gutter: stable;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--muted) 34%, transparent) transparent;
        outline: none;
    }

    .experience-scroll::-webkit-scrollbar {
        width: 4px;
    }

    .experience-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .experience-scroll::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: color-mix(in srgb, var(--muted) 34%, transparent);
    }

    .experience-scroll:focus-visible {
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--muted) 30%, transparent);
    }

    .experience-timeline {
        position: relative;
        min-width: 0;
        padding: 5px 0 6px;
    }

    .experience-timeline::before {
        content: '';
        position: absolute;
        left: clamp(16px, 1.15vw, 20px);
        top: 14px;
        bottom: 15px;
        width: 1px;
        background: var(--timeline-line);
        pointer-events: none;
    }

    .experience-entry {
        position: relative;
        min-width: 0;
        display: grid;
        grid-template-columns: clamp(32px, 2.4vw, 38px) minmax(0, 1fr);
        padding: 8px clamp(12px, 0.95vw, 17px) 9px 0;
        background: transparent;
        transition: background 140ms ease;
    }

    .experience-entry:hover {
        background: color-mix(in srgb, var(--surface) 24%, transparent);
    }

    .timeline-dot {
        position: relative;
        z-index: 2;
        justify-self: center;
        align-self: start;
        width: 5px;
        height: 5px;
        margin-top: 4px;
        border: 1px solid color-mix(in srgb, var(--muted) 68%, transparent);
        border-radius: 50%;
        background: var(--bg);
        box-shadow: 0 0 0 2px var(--bg);
        transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
    }

    .experience-entry:hover .timeline-dot {
        border-color: color-mix(in srgb, var(--text) 82%, transparent);
        background: color-mix(in srgb, var(--text) 74%, transparent);
        transform: scale(1.08);
    }

    .experience-copy {
        min-width: 0;
        display: grid;
        gap: 4px;
    }

    .experience-organization {
        min-width: 0;
        overflow: hidden;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 10.5px;
        font-weight: 550;
        line-height: 1.25;
        letter-spacing: -0.015em;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .experience-meta {
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        gap: 10px;
    }

    .experience-role {
        min-width: 0;
        overflow: hidden;
        color: var(--text-body);
        font-family: var(--font-sans);
        font-size: 9.5px;
        line-height: 1.25;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .experience-period {
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 8px;
        line-height: 1.2;
        white-space: nowrap;
    }

    @media (prefers-reduced-motion: reduce) {
        .resume-cta::after {
            animation: none;
        }
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .experience-header {
            padding-top: 7px;
            padding-bottom: 6px;
        }

        .experience-entry {
            padding-top: 7px;
            padding-bottom: 8px;
        }
    }

    @media (max-width: 720px) {
        .experience-header {
            padding: 11px 14px 9px;
        }

        .experience-timeline::before {
            left: 17px;
        }

        .experience-entry {
            grid-template-columns: 34px minmax(0, 1fr);
            padding: 10px 14px 11px 0;
        }

        .experience-meta {
            grid-template-columns: 1fr;
            gap: 3px;
        }

        .experience-period {
            justify-self: start;
        }
    }
</style>

<style is:global>
    /* Education still lives inline in index.astro; keep this pass purely
       geometric so the section can be visually locked before extracting it. */
    .home-redesign .identity-board .education-region {
        position: relative;
        isolation: isolate;
        display: grid !important;
        grid-template-rows: auto auto auto auto minmax(0, 1fr);
        align-content: start;
        justify-content: stretch !important;
        gap: 2px;
        padding: 8px 12px 28px !important;
        background: var(--bg);
        overflow: hidden;
    }

    .home-redesign .education-region > * {
        position: relative;
        z-index: 2;
        min-width: 0;
    }

    .home-redesign .education-region .icon-label {
        gap: 0;
        margin: 0 0 2px;
        color: color-mix(in srgb, var(--muted) 86%, transparent);
        font-size: 8.5px;
        line-height: 1;
        letter-spacing: 0.09em;
    }

    .home-redesign .education-region .icon-label > svg {
        display: none;
    }

    .home-redesign .education-region .region-primary {
        margin: 0 !important;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(13px, 1.03vw, 15px);
        font-weight: 600;
        line-height: 1.1;
        letter-spacing: -0.025em;
        white-space: nowrap;
    }

    .home-redesign .education-region .region-primary::before {
        content: '';
        flex: none;
        width: 24px;
        height: 28px;
        background-image: url('https://fti.unand.ac.id/en/informasi/berita-dan-peristiwa/item/download/25_1ba5358f423fd20c18051fec9e856b64.html');
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        filter: grayscale(1) saturate(0) contrast(1.05) brightness(1.08);
        opacity: 0.78;
        transition: filter 280ms ease, opacity 280ms ease, transform 280ms ease;
    }

    .home-redesign .education-region .region-secondary {
        margin: 0 !important;
        padding-left: 32px;
        color: var(--text-body);
        font-family: var(--font-sans);
        font-size: 9.5px;
        line-height: 1.2;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .home-redesign .education-region .region-meta {
        position: static !important;
        min-height: 10px;
        margin: 0 !important;
        padding-left: 32px;
        color: transparent;
        font-size: 0;
        line-height: 1;
    }

    .home-redesign .education-region .region-meta::before {
        content: 'GPA 3.71 / 4.00';
        position: static;
        display: block;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 8.5px;
        line-height: 1.15;
        letter-spacing: 0.005em;
    }

    .home-redesign .education-region::after {
        content: '';
        position: absolute;
        z-index: 1;
        left: 12px;
        right: 12px;
        top: clamp(82px, 10.5vh, 96px);
        bottom: 28px;
        border-block: 1px solid color-mix(in srgb, var(--border) 84%, transparent);
        background-color: var(--surface);
        background-image: url('https://www.unand.ac.id/images/gedung%20rektorat.jpg');
        background-repeat: no-repeat;
        background-position: center 46%;
        background-size: cover;
        filter: grayscale(1) saturate(0.15) contrast(1.05) brightness(0.72);
        opacity: 0.84;
        pointer-events: none;
        transition: filter 320ms ease, opacity 320ms ease;
    }

    .home-redesign .education-region .region-meta::after {
        content: '⌖  Limau Manis · Padang, Indonesia';
        position: absolute;
        z-index: 3;
        left: 12px;
        bottom: 9px;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 8px;
        line-height: 1.2;
        letter-spacing: 0.01em;
        white-space: nowrap;
        pointer-events: none;
    }

    .home-redesign .education-region .region-primary:hover::before {
        filter: grayscale(0) saturate(1) contrast(1) brightness(1);
        opacity: 1;
        transform: translateY(-1px);
    }

    .home-redesign .education-region:hover::after {
        filter: grayscale(0) saturate(1) contrast(1) brightness(0.94);
        opacity: 1;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .home-redesign .identity-board .education-region {
            gap: 1px;
            padding-top: 7px !important;
        }

        .home-redesign .education-region .region-primary {
            font-size: 13px;
        }

        .home-redesign .education-region .region-primary::before {
            width: 23px;
            height: 27px;
        }

        .home-redesign .education-region .region-secondary,
        .home-redesign .education-region .region-meta {
            padding-left: 31px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-redesign .education-region .region-primary::before,
        .home-redesign .education-region::after {
            transition: none;
        }
    }
</style>
