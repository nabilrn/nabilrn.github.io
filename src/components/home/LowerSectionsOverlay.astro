---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../../assets/profile-anime.webp';
import { getSiteContent } from '../../data/siteContent';
import { getMetricsApiBase } from '../../lib/metrics';
import VerifiedIcon from './VerifiedIcon.astro';

const content = getSiteContent();
const METRICS_API = getMetricsApiBase();

const cleanMarkdown = (value: string) => value
  .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
  .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
  .replace(/<[^>]+>/g, '')
  .replace(/[*_`~]/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const narrativeExcerpt = (body: string, fallback: string) => {
  const paragraph = body
    .split(/\n\s*\n/)
    .map((part) => part.trim())
    .find((part) => part
      && !part.startsWith('#')
      && !part.startsWith('>')
      && !part.startsWith('```')
      && !part.startsWith('---')
      && !part.startsWith('!['));
  const clean = cleanMarkdown(paragraph ?? fallback);
  return clean.length > 250 ? `${clean.slice(0, 247).trimEnd()}…` : clean;
};

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2)
  .map((post) => ({
    id: post.slug,
    title: post.data.title,
    excerpt: narrativeExcerpt(post.body, post.data.description),
    href: `/blog/${post.slug}/`,
    date: post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
  }));
---

<template data-lower-sections-template>
  <section class="analytics-region" aria-labelledby="analytics-heading" data-analytics-api={METRICS_API}>
    <header class="lower-panel-header">
      <h2 id="analytics-heading" class="lower-panel-heading">analytics</h2>
      <span class="analytics-period">last 24h</span>
    </header>

    <div class="analytics-body">
      <div class="analytics-primary">
        <div class="analytics-stat"><strong data-analytics-visitors>—</strong><span>visitors</span></div>
        <div class="analytics-stat analytics-stat-secondary"><strong data-analytics-pageviews>—</strong><span>pageviews</span></div>
      </div>

      <div class="analytics-chart-wrap" aria-label="Pageviews during the last 24 hours">
        <div class="analytics-spark" data-analytics-spark role="list" aria-label="Hourly pageviews during the last 24 hours"></div>
        <div class="analytics-chart-ticks" aria-hidden="true">
          <span>24h</span><span>18h</span><span>12h</span><span>6h</span><span>now</span>
        </div>
      </div>

      <div class="analytics-top-page">
        <span class="analytics-label">top page</span>
        <span class="analytics-page-path" data-analytics-top-page>—</span>
      </div>
    </div>
  </section>

  <section class="latest-blog-region" aria-labelledby="latest-blog-heading" data-blog-metrics-api={METRICS_API}>
    <header class="lower-panel-header">
      <h2 id="latest-blog-heading" class="lower-panel-heading">my blog</h2>
      <a class="blog-all-link" href="/blog/">all posts</a>
    </header>

    <div class="blog-feed">
      {posts.map((post) => (
        <article class="tweet-post" data-blog-post-id={post.id}>
          <div class="tweet-author-row">
            <Image class="tweet-avatar" src={avatar} alt="" width={28} height={28} />
            <div class="tweet-author-copy">
              <div class="tweet-name-row">
                <strong>{content.profile.name}</strong>
                <span class="tweet-verified" aria-label="Verified"><VerifiedIcon size={12} /></span>
              </div>
              <span class="tweet-handle">@NabilrizkiN · {post.date}</span>
            </div>
          </div>

          <a class="tweet-copy" href={post.href}>
            <strong>{post.title}</strong>
            <p>{post.excerpt}</p>
          </a>

          <div class="tweet-meta-row">
            <div class="tweet-engagement" aria-label="Post engagement">
              <span class="tweet-metric" title="Views">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.2-6 9-6 9 6 9 6-3.2 6-9 6-9-6-9-6Z"/><circle cx="12" cy="12" r="2.25"/></svg>
                <span data-blog-views>—</span>
              </span>
              <span class="tweet-metric" title="Likes">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 4.7a5.4 5.4 0 0 0-7.6 0L12 5.9l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.7a5.4 5.4 0 0 0 0-7.6Z"/></svg>
                <span data-blog-likes>—</span>
              </span>
            </div>
            <a class="tweet-read-link" href={post.href}>read</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</template>

<style is:global>
  .home-redesign .projects-region { border-right: var(--major-stroke) solid var(--border); }
  .home-redesign .analytics-region,
  .home-redesign .latest-blog-region {
    min-width: 0;
    min-height: 0;
    height: 100%;
    display: grid;
    grid-template-rows: 32px minmax(0, 1fr);
    background: var(--bg);
    overflow: hidden;
  }
  .home-redesign .analytics-region { border-right: var(--minor-stroke) solid var(--sheet-line); }
  .home-redesign .lower-panel-header {
    height: 32px;
    padding: 6px clamp(10px, .8vw, 14px) 5px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-bottom: var(--minor-stroke) solid var(--sheet-line);
  }
  .home-redesign .lower-panel-heading {
    margin: 0;
    color: var(--muted);
    font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
    transform: rotate(-1.15deg);
  }
  .home-redesign .analytics-period,
  .home-redesign .blog-all-link {
    color: color-mix(in srgb, var(--muted) 84%, transparent);
    font-family: var(--font-mono);
    font-size: 7.5px;
    line-height: 1;
    letter-spacing: .03em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .home-redesign .blog-all-link:hover,
  .home-redesign .blog-all-link:focus-visible { color: var(--text); outline: none; }

  .home-redesign .analytics-body {
    min-height: 0;
    padding: clamp(9px, .75vw, 13px);
    display: grid;
    grid-template-rows: auto minmax(54px, 1fr) auto;
    gap: 8px;
  }
  .home-redesign .analytics-primary { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .home-redesign .analytics-stat { min-width: 0; display: grid; gap: 2px; }
  .home-redesign .analytics-stat-secondary { padding-left: 9px; border-left: var(--minor-stroke) solid var(--sheet-line); }
  .home-redesign .analytics-stat strong {
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: clamp(20px, 1.55vw, 27px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.045em;
    text-overflow: ellipsis;
  }
  .home-redesign .analytics-stat span,
  .home-redesign .analytics-label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 7.5px;
    line-height: 1.2;
  }
  .home-redesign .analytics-chart-wrap { min-height: 0; display: grid; grid-template-rows: minmax(42px, 1fr) auto; gap: 5px; }
  .home-redesign .analytics-spark {
    min-height: 42px;
    display: grid;
    grid-template-columns: repeat(24, minmax(1px, 1fr));
    align-items: end;
    gap: 2px;
    border-bottom: var(--minor-stroke) solid var(--sheet-line);
    background-image:
      linear-gradient(to bottom, transparent 32%, color-mix(in srgb, var(--border) 54%, transparent) 33%, transparent 34%),
      linear-gradient(to bottom, transparent 65%, color-mix(in srgb, var(--border) 42%, transparent) 66%, transparent 67%);
  }
  .home-redesign .analytics-spark > span {
    width: 100%;
    min-height: 0;
    background: color-mix(in srgb, var(--text) 58%, var(--muted));
    opacity: .72;
    outline: none;
    transform-origin: bottom;
    transition: height 220ms ease, opacity 120ms ease, background-color 120ms ease;
  }
  .home-redesign .analytics-spark > span[data-empty='true'] { background: transparent; opacity: 0; }
  .home-redesign .analytics-spark > span:not([data-empty='true']):hover,
  .home-redesign .analytics-spark > span:not([data-empty='true']):focus-visible { background: var(--text); opacity: 1; }
  .home-redesign .analytics-chart-ticks {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    color: color-mix(in srgb, var(--muted) 76%, transparent);
    font-family: var(--font-mono);
    font-size: 6.5px;
    line-height: 1;
  }
  .home-redesign .analytics-chart-ticks span:nth-child(2),
  .home-redesign .analytics-chart-ticks span:nth-child(3),
  .home-redesign .analytics-chart-ticks span:nth-child(4) { text-align: center; }
  .home-redesign .analytics-chart-ticks span:last-child { text-align: right; }
  .home-redesign .analytics-top-page {
    padding-top: 6px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    border-top: var(--minor-stroke) solid var(--sheet-line);
  }
  .home-redesign .analytics-page-path {
    min-width: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--text) 86%, var(--muted));
    font-family: var(--font-mono);
    font-size: 8px;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .analytics-floating-tooltip {
    position: fixed;
    z-index: 1200;
    left: 0;
    top: 0;
    padding: 5px 7px;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: color-mix(in srgb, var(--surface) 96%, var(--bg));
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 9.5px;
    line-height: 1.25;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, calc(-100% - 6px));
  }
  .analytics-floating-tooltip.is-visible { opacity: 1; transform: translate(-50%, calc(-100% - 9px)); }

  .home-redesign .blog-feed { min-height: 0; display: grid; grid-template-rows: repeat(2, minmax(0, 1fr)); }
  .home-redesign .tweet-post {
    min-width: 0;
    min-height: 0;
    padding: 8px clamp(10px, .8vw, 14px) 7px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 5px;
    overflow: hidden;
  }
  .home-redesign .tweet-post + .tweet-post { border-top: var(--minor-stroke) solid var(--sheet-line); }
  .home-redesign .tweet-author-row { display: flex; align-items: center; gap: 7px; }
  .home-redesign .tweet-avatar {
    width: 24px;
    height: 24px;
    flex: none;
    border: var(--minor-stroke) solid var(--sheet-line);
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.02);
  }
  .home-redesign .tweet-author-copy { min-width: 0; display: grid; gap: 1px; }
  .home-redesign .tweet-name-row { display: flex; align-items: center; gap: 4px; }
  .home-redesign .tweet-name-row strong {
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-redesign .tweet-verified { width: 12px; height: 12px; display: grid; place-items: center; color: var(--text); }
  .home-redesign .tweet-handle { color: var(--muted); font-family: var(--font-sans); font-size: 7.5px; }
  .home-redesign .tweet-copy { min-width: 0; min-height: 0; display: grid; align-content: start; gap: 3px; color: inherit; text-decoration: none; overflow: hidden; }
  .home-redesign .tweet-copy strong {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text);
    font-family: var(--font-sans);
    font-size: clamp(11px, .8vw, 12.5px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -.025em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  .home-redesign .tweet-copy p {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: color-mix(in srgb, var(--muted) 92%, var(--text));
    font-family: var(--font-sans);
    font-size: clamp(8.5px, .62vw, 9.5px);
    line-height: 1.32;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .home-redesign .tweet-copy:hover strong,
  .home-redesign .tweet-copy:focus-visible strong { text-decoration: underline; text-underline-offset: 2px; }
  .home-redesign .tweet-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .home-redesign .tweet-engagement,
  .home-redesign .tweet-metric,
  .home-redesign .tweet-read-link { display: inline-flex; align-items: center; }
  .home-redesign .tweet-engagement { gap: 11px; }
  .home-redesign .tweet-metric { gap: 4px; color: var(--muted); font-family: var(--font-mono); font-size: 7.5px; }
  .home-redesign .tweet-metric svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
  .home-redesign .tweet-read-link { color: var(--muted); font-family: var(--font-mono); font-size: 7.5px; text-decoration: none; }
  .home-redesign .tweet-read-link:hover,
  .home-redesign .tweet-read-link:focus-visible { color: var(--text); outline: none; }

  @media (max-width: 1099px), (max-height: 759px) {
    .home-redesign .projects-region,
    .home-redesign .analytics-region { border-right: 0; border-bottom: var(--minor-stroke) solid var(--sheet-line); }
    .home-redesign .analytics-region,
    .home-redesign .latest-blog-region { min-height: 260px; }
  }
</style>

<script>
  type HourPoint = { hour?: string; views?: number; visitors?: number };
  type Summary = {
    generatedAt?: string;
    visitors?: number;
    pageviews?: number;
    topPage?: { path?: string; views?: number };
    last24Hours?: HourPoint[];
  };
  type ChartPoint = { label: string; views: number; visitors: number };

  const template = document.querySelector<HTMLTemplateElement>('[data-lower-sections-template]');
  const bottomLayout = document.querySelector<HTMLElement>('.bottom-layout');
  const oldBlogRegion = bottomLayout?.querySelector<HTMLElement>('.blog-region');
  if (template && bottomLayout && oldBlogRegion && !bottomLayout.querySelector('.analytics-region')) {
    oldBlogRegion.replaceWith(template.content.cloneNode(true));
  }

  const analyticsRegion = document.querySelector<HTMLElement>('.analytics-region');
  const blogRegion = document.querySelector<HTMLElement>('.latest-blog-region');
  const normalizeApiBase = (value?: string) => value?.trim().replace(/\/+$/, '') ?? '';
  const apiBase = normalizeApiBase(analyticsRegion?.dataset.analyticsApi);
  const blogApiBase = normalizeApiBase(blogRegion?.dataset.blogMetricsApi) || apiBase;
  const visitorsEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-visitors]');
  const pageviewsEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-pageviews]');
  const topPageEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-top-page]');
  const sparkEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-spark]');

  const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
  const exact = new Intl.NumberFormat('en-US');
  const hourFormat = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
  const dayFormat = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short' });

  const getVisitorId = () => {
    const key = 'portfolio:visitor-id';
    const existing = localStorage.getItem(key);
    if (existing) return existing;
    const id = crypto.randomUUID();
    localStorage.setItem(key, id);
    return id;
  };

  let tooltip = document.querySelector<HTMLElement>('.analytics-floating-tooltip');
  if (!tooltip) {
    tooltip = document.createElement('div');
    tooltip.className = 'analytics-floating-tooltip';
    tooltip.setAttribute('role', 'tooltip');
    document.body.appendChild(tooltip);
  }
  const hideTooltip = () => tooltip?.classList.remove('is-visible');
  const showTooltip = (bar: HTMLElement) => {
    if (!tooltip) return;
    const label = bar.dataset.analyticsTooltip;
    if (!label) return;
    tooltip.textContent = label;
    tooltip.classList.add('is-visible');
    const rect = bar.getBoundingClientRect();
    const tip = tooltip.getBoundingClientRect();
    const half = tip.width / 2;
    tooltip.style.left = `${Math.max(8 + half, Math.min(innerWidth - 8 - half, rect.left + rect.width / 2))}px`;
    tooltip.style.top = `${Math.max(tip.height + 12, rect.top)}px`;
  };

  const hourlyPoints = (values?: HourPoint[]): ChartPoint[] => (values ?? []).map((item, index) => {
    const fallback = new Date(Date.now() - (23 - index) * 3_600_000);
    const parsed = item.hour ? new Date(item.hour) : fallback;
    const start = Number.isNaN(parsed.getTime()) ? fallback : parsed;
    const end = new Date(start.getTime() + 3_600_000);
    return {
      label: `${dayFormat.format(start)} · ${hourFormat.format(start)}–${hourFormat.format(end)}`,
      views: Math.max(0, Number(item.views ?? 0)),
      visitors: Math.max(0, Number(item.visitors ?? 0)),
    };
  });

  const renderSpark = (points: ChartPoint[]) => {
    if (!sparkEl) return;
    sparkEl.replaceChildren();
    const max = Math.max(0, ...points.map((point) => point.views));
    for (const point of points) {
      const empty = point.views === 0 || max === 0;
      const bar = document.createElement('span');
      bar.style.height = `${empty ? 0 : Math.max(12, (point.views / max) * 100)}%`;
      bar.dataset.empty = String(empty);
      bar.tabIndex = empty ? -1 : 0;
      bar.setAttribute('role', 'listitem');
      const label = `${point.label} · ${exact.format(point.views)} pageviews · ${exact.format(point.visitors)} visitors`;
      bar.setAttribute('aria-label', label);
      bar.dataset.analyticsTooltip = label;
      if (!empty) {
        bar.addEventListener('pointerenter', () => showTooltip(bar));
        bar.addEventListener('pointerleave', hideTooltip);
        bar.addEventListener('focus', () => showTooltip(bar));
        bar.addEventListener('blur', hideTooltip);
      }
      sparkEl.appendChild(bar);
    }
  };

  const renderUnavailable = () => {
    if (visitorsEl) visitorsEl.textContent = '—';
    if (pageviewsEl) pageviewsEl.textContent = '—';
    if (topPageEl) topPageEl.textContent = '—';
    renderSpark([]);
  };

  const renderSummary = (summary: Summary) => {
    const valid = typeof summary.generatedAt === 'string'
      && Array.isArray(summary.last24Hours)
      && summary.last24Hours.length === 24;
    if (!valid) {
      renderUnavailable();
      return;
    }
    if (visitorsEl) visitorsEl.textContent = compact.format(Number(summary.visitors ?? 0));
    if (pageviewsEl) pageviewsEl.textContent = compact.format(Number(summary.pageviews ?? 0));
    if (topPageEl) topPageEl.textContent = summary.topPage?.path || '/';
    renderSpark(hourlyPoints(summary.last24Hours));
  };

  renderUnavailable();

  void (async () => {
    if (!apiBase) return;
    const isLocalPreview = location.hostname === 'localhost' || location.hostname === '127.0.0.1';

    if (!isLocalPreview) {
      try {
        await fetch(`${apiBase}/analytics/view`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ path: location.pathname, visitorId: getVisitorId() }),
          keepalive: true,
        });
      } catch {
        // Analytics must never block page rendering.
      }
    }

    try {
      const response = await fetch(`${apiBase}/analytics/summary`, { headers: { Accept: 'application/json' }, cache: 'no-store' });
      if (!response.ok) throw new Error(`analytics summary ${response.status}`);
      const summary = await response.json() as Summary;
      renderSummary(summary);
    } catch {
      renderUnavailable();
    }
  })();

  document.querySelectorAll<HTMLElement>('.tweet-post[data-blog-post-id]').forEach((post) => {
    const postId = post.dataset.blogPostId?.trim();
    const views = post.querySelector<HTMLElement>('[data-blog-views]');
    const likes = post.querySelector<HTMLElement>('[data-blog-likes]');
    if (!postId || !blogApiBase) return;

    void (async () => {
      try {
        const response = await fetch(`${blogApiBase}/metrics/${encodeURIComponent(postId)}`, { headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error(`blog metrics ${response.status}`);
        const metrics = await response.json() as { views?: number; likes?: number };
        if (views) views.textContent = compact.format(Number(metrics.views ?? 0));
        if (likes) likes.textContent = compact.format(Number(metrics.likes ?? 0));
      } catch {
        if (views) views.textContent = '—';
        if (likes) likes.textContent = '—';
      }
    })();
  });

  window.addEventListener('blur', hideTooltip);
</script>
