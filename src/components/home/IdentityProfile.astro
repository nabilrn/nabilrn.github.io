---
import { Image } from 'astro:assets';
import avatar from '../../assets/profile-anime.webp';
import type { SiteLocale } from '../../data/siteContent';
import BrandIcon from '../icons/BrandIcon.astro';
import UiIcon from '../icons/UiIcon.astro';
import HandwrittenNote from './HandwrittenNote.astro';
import RoleFlip from './RoleFlip.astro';
import SkillWaterfall from './SkillWaterfall.astro';

interface Props {
    locale: SiteLocale;
    name: string;
    avatarAlt: string;
}

const { locale, name, avatarAlt } = Astro.props;

const rolesByLocale: Record<SiteLocale, string[]> = {
    en: ['Software Engineer', 'IT Infrastructure Builder', 'Lifetime Learner'],
    id: ['Software Engineer', 'IT Infrastructure Builder', 'Pembelajar seumur hidup'],
    cn: ['Software Engineer', 'IT Infrastructure Builder', '终身学习者'],
    jp: ['Software Engineer', 'IT Infrastructure Builder', '生涯学習者'],
    ar: ['Software Engineer', 'IT Infrastructure Builder', 'متعلم مدى الحياة'],
};

const socialLinks = [
    { label: 'GitHub', href: 'https://github.com/nabilrn', brand: 'github' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nabilrizkinavisa2004', brand: 'linkedin' },
    { label: 'X', href: 'https://x.com/NabilrizkiN', brand: 'x' },
    { label: 'Email', href: 'mailto:nabilrizkinavisa@gmail.com', ui: 'mail' },
] as const;
---

<div class="identity-profile">
    <div class="avatar-wrap">
        <Image src={avatar} alt={avatarAlt} width={128} height={128} />
    </div>

    <div class="identity-name-row">
        <h1 id="hero-name">{name}</h1>
        <span class="verified-mark" aria-label="Verified">
            <UiIcon name="badge-check" size={17} strokeWidth={1.5} />
        </span>
    </div>

    <RoleFlip roles={rolesByLocale[locale]} />

    <div class="social-block">
        <HandwrittenNote text="my social" class="social-note" />
        <nav class="social-links" aria-label="Social links">
            {socialLinks.map((item) => (
                <a
                    href={item.href}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener' : undefined}
                    title={item.label}
                    aria-label={item.label}
                >
                    {'brand' in item
                        ? <BrandIcon name={item.brand} size={16} />
                        : <UiIcon name={item.ui} size={16} strokeWidth={1.7} />}
                </a>
            ))}
        </nav>
    </div>

    <div class="waterfall-wrap">
        <SkillWaterfall />
    </div>
</div>

<style>
    .identity-profile {
        grid-column: 1;
        grid-row: 1 / 4;
        min-width: 0;
        min-height: 0;
        padding: clamp(14px, 1.15vw, 20px);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        border-right: 1px solid color-mix(in oklab, var(--border) 64%, var(--bg));
        overflow: hidden;
    }

    .avatar-wrap {
        width: clamp(112px, 7vw, 128px);
        aspect-ratio: 1;
        flex: none;
        overflow: hidden;
        border: 1px solid var(--border-strong);
        border-radius: 50%;
        background: var(--surface);
    }

    .avatar-wrap :global(img) {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: 50% 45%;
    }

    .identity-name-row {
        width: 100%;
        margin-top: 14px;
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
    }

    .identity-name-row h1 {
        min-width: 0;
        margin: 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(19px, 1.45vw, 22px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }

    .verified-mark {
        width: 18px;
        height: 18px;
        flex: none;
        display: grid;
        place-items: center;
        color: var(--muted);
    }

    :global(.identity-profile .role-flip) {
        margin-top: 7px;
        font-family: var(--font-sans);
        font-size: 12px;
    }

    .social-block {
        position: relative;
        width: 100%;
        margin-top: 38px;
    }

    .social-links {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .social-links a {
        width: 32px;
        height: 32px;
        flex: none;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        color: color-mix(in srgb, var(--muted) 88%, transparent);
        background: color-mix(in srgb, var(--surface) 24%, transparent);
        transition: color 140ms ease, border-color 140ms ease, background 140ms ease;
    }

    .social-links a:hover,
    .social-links a:focus-visible {
        color: var(--text);
        border-color: var(--muted);
        background: color-mix(in srgb, var(--surface) 55%, transparent);
        outline: none;
    }

    :global(.social-block .social-note) {
        right: 12px;
        top: -33px;
        transform: rotate(-5deg);
    }

    .waterfall-wrap {
        width: 100%;
        min-height: 0;
        flex: 1;
        margin-top: 18px;
        overflow: hidden;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .identity-profile {
            padding: 12px;
        }

        .avatar-wrap {
            width: 88px;
        }

        .identity-name-row {
            margin-top: 9px;
        }

        .identity-name-row h1 {
            font-size: 18px;
        }

        :global(.identity-profile .role-flip) {
            margin-top: 5px;
            font-size: 10px;
        }

        .social-block {
            margin-top: 31px;
        }

        .social-links {
            gap: 6px;
        }

        .social-links a {
            width: 28px;
            height: 28px;
        }

        :global(.social-block .social-note) {
            right: 8px;
            top: -29px;
            transform: scale(.9) rotate(-5deg);
            transform-origin: right bottom;
        }

        .waterfall-wrap {
            margin-top: 12px;
        }
    }

    @media (max-width: 720px) {
        .identity-profile {
            grid-column: 1 / 3;
            grid-row: 1;
            min-height: 640px;
            padding: 20px;
            border-right: 0;
            border-bottom: 1px solid color-mix(in oklab, var(--border) 64%, var(--bg));
        }

        .avatar-wrap {
            width: 120px;
        }

        .waterfall-wrap {
            min-height: 300px;
        }
    }
</style>
