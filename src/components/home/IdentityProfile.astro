---
import { Image } from 'astro:assets';
import avatar from '../../assets/profile-anime.webp';
import type { SiteLocale } from '../../data/siteContent';
import EducationOverlay from './EducationOverlay.astro';
import HandwrittenNote from './HandwrittenNote.astro';
import RoleFlip from './RoleFlip.astro';
import SkillWaterfall from './SkillWaterfall.astro';
import SocialBrandIcon from './SocialBrandIcon.astro';
import VerifiedIcon from './VerifiedIcon.astro';

interface Props {
    locale: SiteLocale;
    name: string;
    avatarAlt: string;
}

const { locale, name, avatarAlt } = Astro.props;
const contactHref = 'mailto:nabilrizkinavisa@gmail.com';

const flipSentences = [
    'i use a cheap android phone.',
    'my laptop is a potato.',
    "i'm a nerd.",
    'just a regular tech dude.',
    'daily prompter.',
];

const socialLinks = [
    { label: 'GitHub', href: 'https://github.com/nabilrn', brand: 'github' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nabilrizkinavisa2004', brand: 'linkedin' },
    { label: 'X', href: 'https://x.com/NabilrizkiN', brand: 'x' },
    { label: 'Threads', href: 'https://www.threads.com/@nabilrizkinavisa?hl=en', brand: 'threads' },
] as const;
---

<div class="identity-profile" data-locale={locale}>
    <div class="avatar-stage">
        <div class="avatar-contact-cluster">
            <div class="avatar-wrap">
                <Image src={avatar} alt={avatarAlt} width={320} height={320} />
            </div>

            <a class="avatar-contact" href={contactHref} aria-label="Get in touch by email">
                <SocialBrandIcon name="gmail" size={12} />
                <span>get in touch</span>
            </a>
        </div>

        <HandwrittenNote text="my activity" class="profile-activity-note" arrowVariant="shallow" />
    </div>

    <div class="identity-copy">
        <div class="identity-name-row">
            <h1 id="hero-name">{name}</h1>
            <span class="verified-mark" aria-label="Verified">
                <VerifiedIcon size={17} />
            </span>
        </div>

        <div class="identity-subtitle">
            <RoleFlip roles={flipSentences} />
        </div>
    </div>

    <div class="social-block">
        <div class="social-annotation-layer" aria-hidden="true">
            <HandwrittenNote text="my social" class="social-note" arrowVariant="shallow" />
        </div>

        <nav class="social-links" aria-label="Social links">
            {socialLinks.map((item) => (
                <a
                    href={item.href}
                    target="_blank"
                    rel="noopener"
                    aria-label={item.label}
                    data-tooltip={item.label}
                >
                    <SocialBrandIcon name={item.brand} size={16} />
                </a>
            ))}
        </nav>
    </div>

    <div class="waterfall-wrap">
        <SkillWaterfall />
    </div>

    <EducationOverlay />
</div>

<style>
    .identity-profile {
        --profile-pad: clamp(14px, 1.1vw, 18px);
        --profile-line: color-mix(in oklab, var(--border) 64%, var(--bg));
        --waterfall-height: clamp(190px, 22vh, 225px);

        position: relative;
        z-index: 5;
        grid-column: 1;
        grid-row: 1 / 4;
        min-width: 0;
        min-height: 0;
        padding: var(--profile-pad);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        border-right: 1px solid var(--profile-line);
        overflow: visible;
    }

    .avatar-stage {
        position: relative;
        z-index: 6;
        width: calc(100% + (var(--profile-pad) * 2));
        margin: calc(var(--profile-pad) * -1) calc(var(--profile-pad) * -1) 0;
        padding: var(--profile-pad) var(--profile-pad) 14px;
        isolation: isolate;
        overflow: visible;
    }

    .avatar-stage::before,
    .avatar-stage::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        z-index: -1;
        height: 1px;
        background: var(--profile-line);
        pointer-events: none;
    }

    .avatar-stage::before {
        top: 45%;
        opacity: 0.48;
    }

    .avatar-stage::after {
        bottom: 0;
    }

    .avatar-contact-cluster {
        position: relative;
        width: max-content;
    }

    .avatar-wrap {
        position: relative;
        width: clamp(136px, 9.2vw, 160px);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 50%;
        background: var(--surface);
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent),
            inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    }

    .avatar-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
        pointer-events: none;
    }

    .avatar-wrap :global(img) {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: 50% 45%;
    }

    .avatar-contact {
        position: absolute;
        right: -68px;
        bottom: 10px;
        z-index: 8;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 7px;
        border: 1px solid color-mix(in srgb, var(--border-strong) 88%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--bg) 94%, transparent);
        color: color-mix(in srgb, var(--muted) 88%, transparent);
        font-family: var(--font-mono);
        font-size: 8px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.01em;
        white-space: nowrap;
        text-decoration: none;
        box-shadow: 0 5px 14px color-mix(in srgb, #000 12%, transparent);
        transition: color 150ms ease, border-color 150ms ease, background 150ms ease, transform 150ms ease;
    }

    .avatar-contact:hover,
    .avatar-contact:focus-visible {
        color: var(--text);
        border-color: color-mix(in srgb, var(--text) 32%, var(--border));
        background: color-mix(in srgb, var(--surface) 68%, var(--bg));
        transform: translateY(-1px);
        outline: none;
    }

    .avatar-contact:hover :global([data-brand='gmail'] .social-brand-mono),
    .avatar-contact:focus-visible :global([data-brand='gmail'] .social-brand-mono) {
        opacity: 0;
        transform: scale(.94);
    }

    .avatar-contact:hover :global([data-brand='gmail'] .social-brand-color),
    .avatar-contact:focus-visible :global([data-brand='gmail'] .social-brand-color) {
        opacity: 1;
        transform: scale(1.04);
    }

    :global(.avatar-stage .profile-activity-note) {
        z-index: 12;
        top: 4px;
        right: -8px;
        --note-font-size: 13px;
        --note-arrow-width: 34px;
        --note-arrow-height: 17px;
        --note-arrow-gap: 0px;
        transform: rotate(-3deg);
        transform-origin: center top;
    }

    :global(.avatar-stage .profile-activity-note .arrow-shallow) {
        transform: scaleX(-1);
        transform-origin: center;
    }

    :global(.home-redesign .contribution-annotation-layer) {
        display: none !important;
    }

    .identity-copy {
        width: calc(100% + (var(--profile-pad) * 2));
        margin-inline: calc(var(--profile-pad) * -1);
        border-bottom: 1px solid var(--profile-line);
    }

    .identity-name-row {
        width: 100%;
        min-width: 0;
        padding: 10px var(--profile-pad) 9px;
        display: flex;
        align-items: center;
        gap: 7px;
        border-bottom: 1px solid var(--profile-line);
    }

    .identity-name-row h1 {
        min-width: 0;
        margin: 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(19px, 1.35vw, 22px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }

    .verified-mark {
        width: 17px;
        height: 17px;
        flex: none;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--text) 92%, transparent);
    }

    .identity-subtitle {
        min-height: 38px;
        padding: 8px var(--profile-pad) 9px;
        display: flex;
        align-items: center;
    }

    :global(.identity-subtitle .role-flip) {
        font-size: 12px;
        line-height: 1.35;
    }

    .social-block {
        position: relative;
        width: 100%;
        margin-top: 16px;
    }

    .social-annotation-layer {
        position: absolute;
        inset: 0;
        z-index: 4;
        pointer-events: none;
        overflow: visible;
    }

    :global(.social-annotation-layer .social-note) {
        right: -5px;
        top: -23px;
        --note-font-size: 15px;
        --note-arrow-width: 36px;
        --note-arrow-height: 16px;
        --note-arrow-gap: -1px;
        transform: rotate(-4deg);
        transform-origin: right top;
    }

    .social-links {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .social-links a {
        position: relative;
        width: 32px;
        height: 32px;
        flex: none;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        color: color-mix(in srgb, var(--muted) 88%, transparent);
        background: color-mix(in srgb, var(--surface) 24%, transparent);
        transition: color 140ms ease, border-color 140ms ease, background 140ms ease, transform 140ms ease;
    }

    .social-links a::before,
    .social-links a::after {
        position: absolute;
        left: 50%;
        z-index: 10;
        pointer-events: none;
        opacity: 0;
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .social-links a::before {
        content: attr(data-tooltip);
        bottom: calc(100% + 9px);
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 10px;
        line-height: 1.2;
        white-space: nowrap;
        transform: translate(-50%, 3px);
    }

    .social-links a::after {
        content: '';
        bottom: calc(100% + 5px);
        width: 5px;
        height: 5px;
        border-right: 1px solid var(--border-strong);
        border-bottom: 1px solid var(--border-strong);
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        transform: translate(-50%, 3px) rotate(45deg);
    }

    .social-links a:hover,
    .social-links a:focus-visible {
        color: var(--text);
        border-color: var(--muted);
        background: color-mix(in srgb, var(--surface) 55%, transparent);
        transform: translateY(-1px);
        outline: none;
    }

    .social-links a:hover::before,
    .social-links a:hover::after,
    .social-links a:focus-visible::before,
    .social-links a:focus-visible::after {
        opacity: 1;
    }

    .social-links a:hover::before,
    .social-links a:focus-visible::before {
        transform: translate(-50%, 0);
    }

    .social-links a:hover::after,
    .social-links a:focus-visible::after {
        transform: translate(-50%, 0) rotate(45deg);
    }

    .waterfall-wrap {
        width: 100%;
        height: var(--waterfall-height);
        min-height: 0;
        flex: none;
        margin-top: 10px;
        overflow: hidden;
    }

    :global(.location-place[data-profile-link='maps']) {
        position: relative;
        text-decoration: none;
        transition: color 150ms ease, transform 150ms ease;
    }

    :global(.location-place[data-profile-link='maps']:hover),
    :global(.location-place[data-profile-link='maps']:focus-visible) {
        color: var(--text);
        transform: translateY(-1px);
        outline: none;
    }

    :global(.location-map-icon) {
        position: relative;
        width: 12px;
        height: 12px;
        flex: none;
        display: grid;
        place-items: center;
    }

    :global(.location-map-icon > *) {
        grid-area: 1 / 1;
    }

    :global(.location-map-brand) {
        width: 12px;
        height: 12px;
        display: block;
        object-fit: contain;
        opacity: 0;
        transform: scale(.86);
        transition: opacity 150ms ease, transform 150ms ease;
    }

    :global(.location-map-mono) {
        display: grid;
        place-items: center;
        opacity: 1;
        transition: opacity 150ms ease, transform 150ms ease;
    }

    :global(.location-place[data-profile-link='maps']:hover .location-map-mono),
    :global(.location-place[data-profile-link='maps']:focus-visible .location-map-mono) {
        opacity: 0;
        transform: scale(.86);
    }

    :global(.location-place[data-profile-link='maps']:hover .location-map-brand),
    :global(.location-place[data-profile-link='maps']:focus-visible .location-map-brand) {
        opacity: 1;
        transform: scale(1);
    }

    :global(.profile-link-tooltip) {
        position: absolute;
        z-index: 20;
        left: 0;
        bottom: calc(100% + 8px);
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 450;
        line-height: 1.2;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateY(3px);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    :global(.location-place[data-profile-link='maps']:hover .profile-link-tooltip),
    :global(.location-place[data-profile-link='maps']:focus-visible .profile-link-tooltip) {
        opacity: 1;
        transform: translateY(0);
    }

    :global(.streak-region[data-profile-link='duolingo']) {
        cursor: pointer !important;
        text-decoration: none;
        outline: none;
    }

    :global(.streak-region[data-profile-link='duolingo']:focus-visible) {
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 22%, var(--border));
    }

    :global(.streak-region[data-profile-link='duolingo']:focus-visible .duo-identity),
    :global(.streak-region[data-profile-link='duolingo']:focus-visible .duo-identity span) {
        color: #58cc02;
    }

    :global(.streak-region[data-profile-link='duolingo']:focus-visible .streak-value),
    :global(.streak-region[data-profile-link='duolingo']:focus-visible .streak-flame) {
        color: #f49000;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .identity-profile {
            --profile-pad: 12px;
            --waterfall-height: clamp(138px, 19vh, 158px);
        }

        .avatar-stage {
            padding-bottom: 10px;
        }

        .avatar-wrap {
            width: 128px;
        }

        .avatar-contact {
            right: -64px;
            bottom: 8px;
            padding: 4px 6px;
            font-size: 7.5px;
        }

        :global(.avatar-stage .profile-activity-note) {
            top: 2px;
            right: -4px;
            --note-font-size: 12.5px;
            --note-arrow-width: 31px;
            --note-arrow-height: 15px;
        }

        .identity-name-row {
            padding-top: 8px;
            padding-bottom: 7px;
        }

        .identity-name-row h1 {
            font-size: 18px;
        }

        .identity-subtitle {
            min-height: 32px;
            padding-top: 6px;
            padding-bottom: 7px;
        }

        :global(.identity-subtitle .role-flip) {
            font-size: 11px;
            line-height: 1.3;
        }

        .social-block {
            margin-top: 13px;
        }

        .social-links {
            gap: 6px;
        }

        .social-links a {
            width: 28px;
            height: 28px;
        }

        :global(.social-annotation-layer .social-note) {
            right: -4px;
            top: -20px;
            --note-font-size: 13px;
            --note-arrow-width: 31px;
            --note-arrow-height: 14px;
        }

        .waterfall-wrap {
            margin-top: 8px;
        }
    }

    @media (max-width: 720px) {
        .identity-profile {
            --profile-pad: 20px;
            --waterfall-height: 300px;
            grid-column: 1 / 3;
            grid-row: 1;
            min-height: 680px;
            border-right: 0;
            border-bottom: 1px solid var(--profile-line);
            overflow: hidden;
        }

        .avatar-wrap {
            width: 136px;
        }

        .avatar-contact {
            right: -70px;
        }

        :global(.avatar-stage .profile-activity-note),
        .social-annotation-layer {
            display: none;
        }
    }
</style>

<script>
    const PADANG_MAPS_URL = 'https://www.google.com/maps/search/?api=1&query=Padang%2C%20Sumatera%20Barat%2C%20Indonesia';
    const DUOLINGO_PROFILE_URL = 'https://www.duolingo.com/profile/bilcikiwir?via=share_profile_link';

    const locationPlace = document.querySelector<HTMLElement>('.location-place');
    if (locationPlace && locationPlace.tagName !== 'A') {
        const link = document.createElement('a');
        link.className = locationPlace.className;
        link.href = PADANG_MAPS_URL;
        link.target = '_blank';
        link.rel = 'noopener';
        link.dataset.profileLink = 'maps';
        link.setAttribute('aria-label', 'See Padang, Indonesia on Google Maps');

        while (locationPlace.firstChild) link.append(locationPlace.firstChild);

        const originalIcon = link.firstElementChild;
        if (originalIcon) {
            const iconWrap = document.createElement('span');
            iconWrap.className = 'location-map-icon';
            const monoWrap = document.createElement('span');
            monoWrap.className = 'location-map-mono';
            monoWrap.append(originalIcon);
            iconWrap.append(monoWrap);

            const mapsIcon = document.createElement('img');
            mapsIcon.className = 'location-map-brand';
            mapsIcon.src = 'https://www.google.com/images/branding/product/ico/maps15_bnuw3a_32dp.ico';
            mapsIcon.alt = '';
            mapsIcon.setAttribute('aria-hidden', 'true');
            iconWrap.append(mapsIcon);
            link.prepend(iconWrap);
        }

        const tooltip = document.createElement('span');
        tooltip.className = 'profile-link-tooltip';
        tooltip.textContent = 'See Padang on Google Maps';
        tooltip.setAttribute('role', 'tooltip');
        link.append(tooltip);

        locationPlace.replaceWith(link);
    }

    const streakRegion = document.querySelector<HTMLElement>('.streak-region');
    if (streakRegion && streakRegion.tagName !== 'A') {
        const link = document.createElement('a');
        link.className = streakRegion.className;
        link.href = DUOLINGO_PROFILE_URL;
        link.target = '_blank';
        link.rel = 'noopener';
        link.dataset.profileLink = 'duolingo';
        link.setAttribute(
            'aria-label',
            `${streakRegion.getAttribute('aria-label') ?? 'Duolingo streak'}, open @bilcikiwir profile`,
        );

        while (streakRegion.firstChild) link.append(streakRegion.firstChild);
        streakRegion.replaceWith(link);
    }
</script>
