---
import { Image } from 'astro:assets';
import avatar from '../../assets/profile-anime.webp';
import type { SiteLocale } from '../../data/siteContent';
import BrandIcon from '../icons/BrandIcon.astro';
import UiIcon from '../icons/UiIcon.astro';
import HandwrittenNote from './HandwrittenNote.astro';
import RoleFlip from './RoleFlip.astro';
import SkillWaterfall from './SkillWaterfall.astro';
import VerifiedIcon from './VerifiedIcon.astro';

interface Props {
    locale: SiteLocale;
    name: string;
    avatarAlt: string;
}

const { locale, name, avatarAlt } = Astro.props;

const flipSentences = [
    'i use a cheap android phone.',
    'my laptop is a potato.',
    "i'm a nerd.",
    'just a regular tech dude.',
    'daily prompter.',
];

const socialLinks = [
    { label: 'GitHub', href: 'https://github.com/nabilrn', brand: 'github' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nabilrizkinavisa2004', brand: 'linkedin' },
    { label: 'X', href: 'https://x.com/NabilrizkiN', brand: 'x' },
    { label: 'Email', href: 'mailto:nabilrizkinavisa@gmail.com', ui: 'mail' },
] as const;
---

<div class="identity-profile" data-locale={locale}>
    <div class="avatar-stage">
        <div class="avatar-wrap">
            <Image src={avatar} alt={avatarAlt} width={320} height={320} />
        </div>
    </div>

    <div class="identity-copy">
        <div class="identity-name-row">
            <h1 id="hero-name">{name}</h1>
            <span class="verified-mark" aria-label="Verified">
                <VerifiedIcon size={17} />
            </span>
        </div>

        <div class="identity-subtitle">
            <RoleFlip roles={flipSentences} />
        </div>
    </div>

    <div class="social-block">
        <HandwrittenNote text="my social" class="social-note" />
        <nav class="social-links" aria-label="Social links">
            {socialLinks.map((item) => (
                <a
                    href={item.href}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener' : undefined}
                    title={item.label}
                    aria-label={item.label}
                >
                    {'brand' in item
                        ? <BrandIcon name={item.brand} size={16} />
                        : <UiIcon name={item.ui} size={16} strokeWidth={1.7} />}
                </a>
            ))}
        </nav>
    </div>

    <div class="waterfall-wrap">
        <SkillWaterfall />
    </div>
</div>

<style>
    .identity-profile {
        --profile-pad: clamp(14px, 1.1vw, 18px);
        --profile-line: color-mix(in oklab, var(--border) 64%, var(--bg));

        grid-column: 1;
        grid-row: 1 / 4;
        min-width: 0;
        min-height: 0;
        padding: var(--profile-pad);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        border-right: 1px solid var(--profile-line);
        overflow: hidden;
    }

    .avatar-stage {
        position: relative;
        width: calc(100% + (var(--profile-pad) * 2));
        margin: calc(var(--profile-pad) * -1) calc(var(--profile-pad) * -1) 0;
        padding: var(--profile-pad) var(--profile-pad) 14px;
        isolation: isolate;
    }

    .avatar-stage::before,
    .avatar-stage::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        z-index: -1;
        height: 1px;
        background: var(--profile-line);
        pointer-events: none;
    }

    .avatar-stage::before {
        top: 45%;
        opacity: 0.48;
    }

    .avatar-stage::after {
        bottom: 0;
    }

    .avatar-wrap {
        position: relative;
        width: clamp(136px, 9.2vw, 160px);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 50%;
        background: var(--surface);
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent),
            inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    }

    .avatar-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
        pointer-events: none;
    }

    .avatar-wrap :global(img) {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: 50% 45%;
    }

    .identity-copy {
        width: calc(100% + (var(--profile-pad) * 2));
        margin-inline: calc(var(--profile-pad) * -1);
        border-bottom: 1px solid var(--profile-line);
    }

    .identity-name-row {
        width: 100%;
        min-width: 0;
        padding: 10px var(--profile-pad) 9px;
        display: flex;
        align-items: center;
        gap: 7px;
        border-bottom: 1px solid var(--profile-line);
    }

    .identity-name-row h1 {
        min-width: 0;
        margin: 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(19px, 1.35vw, 22px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }

    .verified-mark {
        width: 17px;
        height: 17px;
        flex: none;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--text) 92%, transparent);
    }

    .identity-subtitle {
        min-height: 34px;
        padding: 7px var(--profile-pad) 8px;
        display: flex;
        align-items: center;
    }

    :global(.identity-subtitle .role-flip) {
        font-size: 10.5px;
    }

    .social-block {
        position: relative;
        width: 100%;
        margin-top: 36px;
    }

    .social-links {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .social-links a {
        width: 32px;
        height: 32px;
        flex: none;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        color: color-mix(in srgb, var(--muted) 88%, transparent);
        background: color-mix(in srgb, var(--surface) 24%, transparent);
        transition: color 140ms ease, border-color 140ms ease, background 140ms ease, transform 140ms ease;
    }

    .social-links a:hover,
    .social-links a:focus-visible {
        color: var(--text);
        border-color: var(--muted);
        background: color-mix(in srgb, var(--surface) 55%, transparent);
        transform: translateY(-1px);
        outline: none;
    }

    :global(.social-block .social-note) {
        right: 8px;
        top: -32px;
        transform: rotate(-5deg);
    }

    .waterfall-wrap {
        width: 100%;
        min-height: 0;
        flex: 1;
        margin-top: 16px;
        overflow: hidden;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .identity-profile {
            --profile-pad: 12px;
        }

        .avatar-stage {
            padding-bottom: 10px;
        }

        .avatar-wrap {
            width: 128px;
        }

        .identity-name-row {
            padding-top: 8px;
            padding-bottom: 7px;
        }

        .identity-name-row h1 {
            font-size: 18px;
        }

        .identity-subtitle {
            min-height: 28px;
            padding-top: 5px;
            padding-bottom: 6px;
        }

        :global(.identity-subtitle .role-flip) {
            font-size: 9.5px;
        }

        .social-block {
            margin-top: 30px;
        }

        .social-links {
            gap: 6px;
        }

        .social-links a {
            width: 28px;
            height: 28px;
        }

        :global(.social-block .social-note) {
            right: 5px;
            top: -28px;
            transform: scale(.88) rotate(-5deg);
            transform-origin: right bottom;
        }

        .waterfall-wrap {
            margin-top: 11px;
        }
    }

    @media (max-width: 720px) {
        .identity-profile {
            --profile-pad: 20px;
            grid-column: 1 / 3;
            grid-row: 1;
            min-height: 680px;
            border-right: 0;
            border-bottom: 1px solid var(--profile-line);
        }

        .avatar-wrap {
            width: 136px;
        }

        .waterfall-wrap {
            min-height: 300px;
        }
    }
</style>
