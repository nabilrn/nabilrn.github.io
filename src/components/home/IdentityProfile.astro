---
import { Image } from 'astro:assets';
import avatar from '../../assets/profile-anime.webp';
import type { SiteLocale } from '../../data/siteContent';
import HandwrittenNote from './HandwrittenNote.astro';
import RoleFlip from './RoleFlip.astro';
import SkillWaterfall from './SkillWaterfall.astro';
import SocialBrandIcon from './SocialBrandIcon.astro';
import VerifiedIcon from './VerifiedIcon.astro';

interface Props {
    locale: SiteLocale;
    name: string;
    avatarAlt: string;
}

type DuolingoResponse = {
    users?: Array<{
        streak?: number;
    }>;
};

const { locale, name, avatarAlt } = Astro.props;

const flipSentences = [
    'i use a cheap android phone.',
    'my laptop is a potato.',
    "i'm a nerd.",
    'just a regular tech dude.',
    'daily prompter.',
];

const socialLinks = [
    { label: 'GitHub', href: 'https://github.com/nabilrn', brand: 'github' },
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nabilrizkinavisa2004', brand: 'linkedin' },
    { label: 'X', href: 'https://x.com/NabilrizkiN', brand: 'x' },
    { label: 'Gmail', href: 'mailto:nabilrizkinavisa@gmail.com', brand: 'gmail' },
] as const;

const DUOLINGO_USERNAME = 'bilcikiwir';
const DUOLINGO_FIELDS = 'users{id,username,streak}';
const DUOLINGO_STREAK_FALLBACK = 515;
const duolingoUrl = `https://www.duolingo.com/2017-06-30/users?username=${encodeURIComponent(DUOLINGO_USERNAME)}&fields=${encodeURIComponent(DUOLINGO_FIELDS)}`;

let duolingoStreak = DUOLINGO_STREAK_FALLBACK;

try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);
    const response = await fetch(duolingoUrl, {
        headers: {
            Accept: 'application/json; charset=UTF-8',
            'User-Agent': 'nabilrn-portfolio/1.0',
        },
        signal: controller.signal,
    });
    clearTimeout(timeout);

    if (response.ok) {
        const payload = (await response.json()) as DuolingoResponse;
        const liveStreak = Number(payload.users?.[0]?.streak);
        if (Number.isFinite(liveStreak) && liveStreak > 0) {
            duolingoStreak = liveStreak;
        }
    }
} catch {
    // Keep the last known streak so an upstream Duolingo failure never breaks
    // a static portfolio build. The browser gets one more direct refresh below.
}
---

<div class="identity-profile" data-locale={locale}>
    <div class="avatar-stage">
        <div class="avatar-wrap">
            <Image src={avatar} alt={avatarAlt} width={320} height={320} />
        </div>
    </div>

    <div class="identity-copy">
        <div class="identity-name-row">
            <h1 id="hero-name">{name}</h1>
            <span class="verified-mark" aria-label="Verified">
                <VerifiedIcon size={17} />
            </span>
        </div>

        <div class="identity-subtitle">
            <RoleFlip roles={flipSentences} />
        </div>
    </div>

    <div class="social-block">
        <div class="social-annotation-layer" aria-hidden="true">
            <HandwrittenNote text="my social" class="social-note" arrowVariant="shallow" />
        </div>

        <nav class="social-links" aria-label="Social links">
            {socialLinks.map((item) => (
                <a
                    href={item.href}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener' : undefined}
                    aria-label={item.label}
                    data-tooltip={item.label}
                >
                    <SocialBrandIcon name={item.brand} size={16} />
                </a>
            ))}
        </nav>
    </div>

    <div class="waterfall-wrap">
        <SkillWaterfall />
    </div>
</div>

<script is:inline define:vars={{ duolingoStreak, duolingoUrl }}>
    (() => {
        const PADANG_TIME_ZONE = 'Asia/Jakarta';
        const CACHE_KEY = 'nabilrn:duolingo-streak:v1';
        const CACHE_TTL = 30 * 60 * 1000;

        const run = () => {
            const locationRegion = document.querySelector('.location-region');
            const streakRegion = document.querySelector('.streak-region');

            if (locationRegion) {
                const locationLabel = locationRegion.querySelector('.micro-label span');
                const timeSlot = locationRegion.querySelector('.region-primary');
                const diffSlot = locationRegion.querySelector('.region-secondary');

                if (locationLabel) locationLabel.textContent = 'Padang, Indonesia';

                if (timeSlot) {
                    timeSlot.innerHTML = `
                        <span class="status-clock-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9"></circle>
                                <path data-padang-clock-hands d="M12 12 L12 8 M12 12 L15 12"></path>
                            </svg>
                        </span>
                        <span data-padang-time>--:-- --</span>
                    `;
                }

                if (diffSlot) {
                    diffSlot.textContent = '// comparing time';
                    diffSlot.setAttribute('data-padang-diff', '');
                }

                const clockFormatter = new Intl.DateTimeFormat('en-US', {
                    timeZone: PADANG_TIME_ZONE,
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true,
                });

                const clockHandsPath = (hour, minute) => {
                    const h = hour % 12;
                    const round = (n) => Math.round(n * 1000) / 1000;
                    const minuteAngle = (minute / 60) * 2 * Math.PI;
                    const hourAngle = ((h + minute / 60) / 12) * 2 * Math.PI;
                    const hx = round(12 + 3.6 * Math.sin(hourAngle));
                    const hy = round(12 - 3.6 * Math.cos(hourAngle));
                    const mx = round(12 + 6 * Math.sin(minuteAngle));
                    const my = round(12 - 6 * Math.cos(minuteAngle));
                    return `M12 12 L${hx} ${hy} M12 12 L${mx} ${my}`;
                };

                const renderClock = () => {
                    const now = new Date();
                    const parts = clockFormatter.formatToParts(now);
                    const hourPart = parts.find((part) => part.type === 'hour')?.value ?? '12';
                    const minutePart = parts.find((part) => part.type === 'minute')?.value ?? '00';
                    const dayPeriod = parts.find((part) => part.type === 'dayPeriod')?.value ?? '';
                    const timeText = `${hourPart}:${minutePart}${dayPeriod ? ` ${dayPeriod}` : ''}`;

                    const viewerOffset = -now.getTimezoneOffset();
                    const targetOffset = Math.round(
                        (new Date(now.toLocaleString('en-US', { timeZone: PADANG_TIME_ZONE })).getTime()
                            - new Date(now.toLocaleString('en-US', { timeZone: 'UTC' })).getTime()) / 60000,
                    );
                    const delta = targetOffset - viewerOffset;
                    const absDelta = Math.abs(delta);

                    let diffText = '// same time';
                    if (absDelta >= 1) {
                        const hours = Math.floor(absDelta / 60);
                        const minutes = absDelta % 60;
                        const pieces = [];
                        if (hours) pieces.push(`${hours}h`);
                        if (minutes) pieces.push(`${minutes}m`);
                        diffText = `// ${pieces.join(' ')} ${delta > 0 ? 'ahead' : 'behind'}`;
                    }

                    const timeTarget = locationRegion.querySelector('[data-padang-time]');
                    const diffTarget = locationRegion.querySelector('[data-padang-diff]');
                    const handsTarget = locationRegion.querySelector('[data-padang-clock-hands]');
                    if (timeTarget) timeTarget.textContent = timeText;
                    if (diffTarget) diffTarget.textContent = diffText;
                    if (handsTarget) {
                        handsTarget.setAttribute('d', clockHandsPath(Number.parseInt(hourPart, 10), Number.parseInt(minutePart, 10)));
                    }
                };

                renderClock();
                window.setInterval(renderClock, 30000);
            }

            if (streakRegion) {
                const label = streakRegion.querySelector('.micro-label span');
                const value = streakRegion.querySelector('.streak-value');
                const secondary = streakRegion.querySelector('.region-secondary');

                if (label) label.textContent = '@bilcikiwir';
                if (secondary) secondary.remove();
                if (value) {
                    value.innerHTML = `
                        <span class="streak-flame" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12.3 22c4.2 0 7.2-3 7.2-7.2 0-3.2-1.7-6-5.2-8.8.1 2.4-.8 4-2.2 5-0.2-3.8-2.3-6.8-5.4-9 .3 3.1-1 5.2-2.2 7-1.1 1.6-2 3.3-2 5.8C2.5 19 6 22 12.3 22Z"></path>
                                <path d="M9.2 18.1c0-1.5.9-2.8 2.9-4.6.2 1.4.8 2.4 1.9 3.2.2-.7.2-1.4 0-2.1 1.1 1 1.8 2.2 1.8 3.5 0 2.1-1.5 3.9-3.5 3.9s-3.1-1.7-3.1-3.9Z"></path>
                            </svg>
                        </span>
                        <strong data-duolingo-streak>${duolingoStreak}</strong>
                        <span class="streak-unit">days</span>
                    `;
                }

                streakRegion.setAttribute('aria-label', `Duolingo streak: ${duolingoStreak} days`);

                const streakTarget = streakRegion.querySelector('[data-duolingo-streak]');
                const setStreak = (nextValue) => {
                    const parsed = Number(nextValue);
                    if (!Number.isFinite(parsed) || parsed <= 0) return;
                    if (streakTarget) streakTarget.textContent = String(parsed);
                    streakRegion.setAttribute('aria-label', `Duolingo streak: ${parsed} days`);
                };

                try {
                    const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null');
                    if (cached && Date.now() - cached.timestamp < CACHE_TTL) {
                        setStreak(cached.value);
                        return;
                    }
                } catch {}

                fetch(duolingoUrl, {
                    method: 'GET',
                    credentials: 'omit',
                    headers: { Accept: 'application/json; charset=UTF-8' },
                })
                    .then((response) => response.ok ? response.json() : null)
                    .then((payload) => {
                        const liveStreak = payload?.users?.[0]?.streak;
                        if (!Number.isFinite(Number(liveStreak)) || Number(liveStreak) <= 0) return;
                        setStreak(liveStreak);
                        try {
                            localStorage.setItem(CACHE_KEY, JSON.stringify({ value: Number(liveStreak), timestamp: Date.now() }));
                        } catch {}
                    })
                    .catch(() => {});
            }
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', run, { once: true });
        } else {
            run();
        }
    })();
</script>

<style>
    .identity-profile {
        --profile-pad: clamp(14px, 1.1vw, 18px);
        --profile-line: color-mix(in oklab, var(--border) 64%, var(--bg));
        --waterfall-height: clamp(190px, 22vh, 225px);

        position: relative;
        grid-column: 1;
        grid-row: 1 / 4;
        min-width: 0;
        min-height: 0;
        padding: var(--profile-pad);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        border-right: 1px solid var(--profile-line);
        overflow: visible;
    }

    .avatar-stage {
        position: relative;
        width: calc(100% + (var(--profile-pad) * 2));
        margin: calc(var(--profile-pad) * -1) calc(var(--profile-pad) * -1) 0;
        padding: var(--profile-pad) var(--profile-pad) 14px;
        isolation: isolate;
    }

    .avatar-stage::before,
    .avatar-stage::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        z-index: -1;
        height: 1px;
        background: var(--profile-line);
        pointer-events: none;
    }

    .avatar-stage::before {
        top: 45%;
        opacity: 0.48;
    }

    .avatar-stage::after {
        bottom: 0;
    }

    .avatar-wrap {
        position: relative;
        width: clamp(136px, 9.2vw, 160px);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 50%;
        background: var(--surface);
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--text) 8%, transparent),
            inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
    }

    .avatar-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 10%, transparent);
        pointer-events: none;
    }

    .avatar-wrap :global(img) {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        object-position: 50% 45%;
    }

    .identity-copy {
        width: calc(100% + (var(--profile-pad) * 2));
        margin-inline: calc(var(--profile-pad) * -1);
        border-bottom: 1px solid var(--profile-line);
    }

    .identity-name-row {
        width: 100%;
        min-width: 0;
        padding: 10px var(--profile-pad) 9px;
        display: flex;
        align-items: center;
        gap: 7px;
        border-bottom: 1px solid var(--profile-line);
    }

    .identity-name-row h1 {
        min-width: 0;
        margin: 0;
        color: var(--text);
        font-family: var(--font-sans);
        font-size: clamp(19px, 1.35vw, 22px);
        font-weight: 600;
        line-height: 1.08;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }

    .verified-mark {
        width: 17px;
        height: 17px;
        flex: none;
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--text) 92%, transparent);
    }

    .identity-subtitle {
        min-height: 38px;
        padding: 8px var(--profile-pad) 9px;
        display: flex;
        align-items: center;
    }

    :global(.identity-subtitle .role-flip) {
        font-size: 12px;
        line-height: 1.35;
    }

    .social-block {
        position: relative;
        width: 100%;
        margin-top: 16px;
    }

    .social-annotation-layer {
        position: absolute;
        inset: 0;
        z-index: 4;
        pointer-events: none;
        overflow: visible;
    }

    :global(.social-annotation-layer .social-note) {
        right: -5px;
        top: -23px;
        --note-font-size: 15px;
        --note-arrow-width: 36px;
        --note-arrow-height: 16px;
        --note-arrow-gap: -1px;
        transform: rotate(-4deg);
        transform-origin: right top;
    }

    .social-links {
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 8px;
    }

    .social-links a {
        position: relative;
        width: 32px;
        height: 32px;
        flex: none;
        display: grid;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        color: color-mix(in srgb, var(--muted) 88%, transparent);
        background: color-mix(in srgb, var(--surface) 24%, transparent);
        transition: color 140ms ease, border-color 140ms ease, background 140ms ease, transform 140ms ease;
    }

    .social-links a::before,
    .social-links a::after {
        position: absolute;
        left: 50%;
        z-index: 10;
        pointer-events: none;
        opacity: 0;
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .social-links a::before {
        content: attr(data-tooltip);
        bottom: calc(100% + 9px);
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 10px;
        line-height: 1.2;
        white-space: nowrap;
        transform: translate(-50%, 3px);
    }

    .social-links a::after {
        content: '';
        bottom: calc(100% + 5px);
        width: 5px;
        height: 5px;
        border-right: 1px solid var(--border-strong);
        border-bottom: 1px solid var(--border-strong);
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        transform: translate(-50%, 3px) rotate(45deg);
    }

    .social-links a:hover,
    .social-links a:focus-visible {
        color: var(--text);
        border-color: var(--muted);
        background: color-mix(in srgb, var(--surface) 55%, transparent);
        transform: translateY(-1px);
        outline: none;
    }

    .social-links a:hover::before,
    .social-links a:hover::after,
    .social-links a:focus-visible::before,
    .social-links a:focus-visible::after {
        opacity: 1;
    }

    .social-links a:hover::before,
    .social-links a:focus-visible::before {
        transform: translate(-50%, 0);
    }

    .social-links a:hover::after,
    .social-links a:focus-visible::after {
        transform: translate(-50%, 0) rotate(45deg);
    }

    .waterfall-wrap {
        width: 100%;
        height: var(--waterfall-height);
        min-height: 0;
        flex: none;
        margin-top: 10px;
        overflow: hidden;
    }

    @media (min-width: 1100px) and (max-height: 859px) {
        .identity-profile {
            --profile-pad: 12px;
            --waterfall-height: clamp(138px, 19vh, 158px);
        }

        .avatar-stage {
            padding-bottom: 10px;
        }

        .avatar-wrap {
            width: 128px;
        }

        .identity-name-row {
            padding-top: 8px;
            padding-bottom: 7px;
        }

        .identity-name-row h1 {
            font-size: 18px;
        }

        .identity-subtitle {
            min-height: 32px;
            padding-top: 6px;
            padding-bottom: 7px;
        }

        :global(.identity-subtitle .role-flip) {
            font-size: 11px;
            line-height: 1.3;
        }

        .social-block {
            margin-top: 13px;
        }

        .social-links {
            gap: 6px;
        }

        .social-links a {
            width: 28px;
            height: 28px;
        }

        :global(.social-annotation-layer .social-note) {
            right: -4px;
            top: -20px;
            --note-font-size: 13px;
            --note-arrow-width: 31px;
            --note-arrow-height: 14px;
        }

        .waterfall-wrap {
            margin-top: 8px;
        }
    }

    @media (max-width: 720px) {
        .identity-profile {
            --profile-pad: 20px;
            --waterfall-height: 300px;
            grid-column: 1 / 3;
            grid-row: 1;
            min-height: 680px;
            border-right: 0;
            border-bottom: 1px solid var(--profile-line);
            overflow: hidden;
        }

        .avatar-wrap {
            width: 136px;
        }

        .social-annotation-layer {
            display: none;
        }
    }

    /* The contribution rail is capped by its real content height instead of
       scaling with the full board. The remaining vertical budget belongs to
       Experience / Education, so no dead strip grows below Fig. 02. */
    @media (min-width: 721px) {
        :global(.identity-board) {
            grid-template-rows:
                clamp(180px, 35%, 195px)
                minmax(0, 11.8034%)
                minmax(0, 1fr);
        }

        :global(.contribution-region .graph-caption) {
            font-size: 10.5px;
        }

        :global(.contribution-region .figure-number) {
            font-size: 9px;
        }

        :global(.home-redesign .location-region),
        :global(.home-redesign .streak-region) {
            padding-inline: clamp(12px, 0.95vw, 17px);
            padding-block: 0;
            align-items: center;
        }

        :global(.home-redesign .location-region) {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
            column-gap: clamp(12px, 1.1vw, 18px);
        }

        :global(.home-redesign .location-region .icon-label) {
            min-width: 0;
            justify-self: start;
            gap: 6px;
            color: var(--text);
            font-family: var(--font-sans);
            font-size: 11px;
            font-weight: 550;
            line-height: 1.2;
            letter-spacing: -0.015em;
            text-transform: none;
            white-space: nowrap;
        }

        :global(.home-redesign .location-region .region-primary) {
            min-width: 0;
            justify-self: center;
            margin: 0;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: var(--text);
            font-family: var(--font-mono);
            font-size: 10px;
            font-weight: 500;
            line-height: 1.2;
            letter-spacing: 0;
            white-space: nowrap;
        }

        :global(.home-redesign .status-clock-icon) {
            width: 13px;
            height: 13px;
            flex: none;
            display: grid;
            place-items: center;
            color: color-mix(in srgb, var(--text) 86%, var(--muted));
        }

        :global(.home-redesign .status-clock-icon svg) {
            width: 100%;
            height: 100%;
            display: block;
        }

        :global(.home-redesign .location-region .region-secondary) {
            min-width: 0;
            justify-self: end;
            margin: 0;
            overflow: hidden;
            color: var(--muted);
            font-family: var(--font-mono);
            font-size: 9px;
            line-height: 1.2;
            text-align: right;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        :global(.home-redesign .location-region .region-secondary::before) {
            content: none;
        }

        :global(.home-redesign .streak-region) {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            gap: clamp(12px, 1.1vw, 18px);
            cursor: default;
        }

        :global(.home-redesign .streak-region .icon-label) {
            min-width: 0;
            height: 20px;
            flex: 0 1 auto;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: color-mix(in srgb, var(--text) 82%, var(--muted));
            font-family: var(--font-mono);
            font-size: 9px;
            font-weight: 500;
            line-height: 1;
            letter-spacing: 0;
            text-transform: none;
            white-space: nowrap;
            transition: color 180ms ease, transform 180ms ease;
        }

        :global(.home-redesign .streak-region .icon-label span) {
            overflow: hidden;
            color: var(--muted);
            text-overflow: ellipsis;
        }

        :global(.home-redesign .streak-region .icon-label svg) {
            width: 20px;
            height: 20px;
            flex: none;
            display: block;
        }

        :global(.home-redesign .streak-region .streak-value) {
            min-width: 0;
            flex: none;
            margin: 0 0 0 auto;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--text);
            font-family: var(--font-sans);
            font-size: 13px;
            font-weight: 550;
            line-height: 1;
            letter-spacing: -0.02em;
            white-space: nowrap;
        }

        :global(.home-redesign .streak-region .streak-value strong) {
            color: inherit;
            font: inherit;
            font-weight: 600;
        }

        :global(.home-redesign .streak-region .streak-unit) {
            color: var(--muted);
            font-size: 9.5px;
            font-weight: 400;
            letter-spacing: 0;
        }

        :global(.home-redesign .streak-flame) {
            width: 17px;
            height: 17px;
            flex: none;
            display: grid;
            place-items: center;
            color: color-mix(in srgb, var(--text) 78%, var(--muted));
            transform-origin: 50% 90%;
            transition: color 180ms ease, filter 180ms ease, transform 180ms ease;
        }

        :global(.home-redesign .streak-flame svg) {
            width: 100%;
            height: 100%;
            display: block;
        }

        :global(.home-redesign .streak-region:hover .icon-label) {
            color: #58cc02;
