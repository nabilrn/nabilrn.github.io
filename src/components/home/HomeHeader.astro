---
import SiteSearch from '../SiteSearch.astro';
import ThemeToggle from '../ThemeToggle.astro';
import GitHubStars from './GitHubStars.astro';
import {
    getSiteContent,
    localeMeta,
    localizePath,
    normalizeLocale,
    supportedLocales,
    type SiteLocale,
} from '../../data/siteContent';

interface Props {
    locale?: SiteLocale;
}

const locale = normalizeLocale(Astro.props.locale);
const content = getSiteContent(locale);
const homePath = localizePath('/', locale);
const blogPath = localizePath('/blog/', locale);
---

<header class="home-header">
    <div class="home-header-inner">
        <div class="home-intro">
            <a href={homePath} class="home-greeting" aria-label={`${content.profile.name} — ${content.nav.home}`}>
                <span data-local-greeting data-ready="false">good day</span>
            </a>
        </div>

        <div class="home-spacer" aria-hidden="true"></div>

        <a
            class="design-reference"
            href="https://chanhdai.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Design reference: Chánh Đại. Open Chánh Đại's portfolio"
        >
            <span>design reference —</span>
            <strong>Chánh Đại</strong>
            <span aria-hidden="true">↗</span>
            <span class="design-reference-tooltip" role="tooltip">Visit Chánh Đại's portfolio ↗</span>
        </a>

        <nav class="home-nav" aria-label={content.nav.ariaPageNavigation}>
            <a href={homePath} class="home-nav-link is-active" aria-current="page">{content.nav.overview}</a>
            <a href={blogPath} class="home-nav-link">{content.nav.blog}</a>
        </nav>

        <div class="home-actions">
            <span class="header-separator desktop-separator" aria-hidden="true"></span>

            <div class="home-search">
                <SiteSearch locale={locale} />
            </div>

            <span class="header-separator desktop-separator" aria-hidden="true"></span>

            <GitHubStars repo="nabilrn/nabilrn.github.io" />

            <span class="header-separator" aria-hidden="true"></span>

            <ThemeToggle locale={locale} />

            <span class="header-separator" aria-hidden="true"></span>

            <details class="home-language">
                <summary aria-label={content.nav.ariaLanguageNavigation}>{locale.toUpperCase()}</summary>
                <div class="home-language-menu">
                    {supportedLocales.map((item) => (
                        <a
                            class:list={['home-language-option', { 'is-active': item === locale }]}
                            href={localizePath('/', item)}
                        >
                            <span>{item.toUpperCase()}</span>
                            <span>{localeMeta[item].label}</span>
                        </a>
                    ))}
                </div>
            </details>
        </div>
    </div>
</header>

<script is:inline>
    (() => {
        const target = document.querySelector('[data-local-greeting]');
        if (!(target instanceof HTMLElement)) return;

        const renderGreeting = () => {
            const hour = new Date().getHours();
            const greeting = hour >= 5 && hour < 12
                ? 'good morning'
                : hour >= 12 && hour < 17
                    ? 'good afternoon'
                    : 'good evening';

            target.textContent = greeting;
            target.dataset.ready = 'true';
        };

        renderGreeting();
        window.setInterval(renderGreeting, 60000);
    })();
</script>

<style>
    .home-header {
        position: relative;
        z-index: 30;
        width: 100%;
        height: 52px;
        background: var(--bg);
    }

    .home-header-inner {
        position: relative;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0 clamp(14px, 1.5vw, 24px);
        display: flex;
        align-items: center;
        gap: clamp(12px, 1.2vw, 20px);
        border-inline: 1px solid var(--sheet-line, var(--border));
    }

    .home-header-inner::before,
    .home-header-inner::after {
        content: '';
        position: absolute;
        left: 50%;
        width: 100vw;
        height: 1px;
        transform: translateX(-50%);
        background: var(--sheet-line, var(--border));
        pointer-events: none;
    }

    .home-header-inner::before {
        top: 0;
    }

    .home-header-inner::after {
        bottom: 0;
    }

    .home-intro {
        min-width: 0;
        display: flex;
        flex: none;
        align-items: center;
    }

    .home-greeting {
        display: inline-flex;
        align-items: center;
        flex: none;
        color: var(--muted);
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: 15px;
        font-weight: 400;
        line-height: 1;
        text-decoration: none;
        transform: rotate(-1.3deg);
        transform-origin: left center;
        transition: color 140ms ease, transform 140ms ease;
    }

    .home-greeting:hover,
    .home-greeting:focus-visible {
        color: var(--text);
        transform: rotate(-.6deg) translateY(-1px);
        outline: none;
    }

    .home-greeting [data-local-greeting] {
        opacity: 0;
        visibility: hidden;
        transition: opacity 120ms ease;
    }

    .home-greeting [data-local-greeting][data-ready='true'] {
        opacity: 1;
        visibility: visible;
    }

    .design-reference {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 6;
        min-width: 0;
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: .015em;
        white-space: nowrap;
        text-decoration: none;
        transform: translate(-50%, -50%);
        transition: color 140ms ease, transform 140ms ease;
    }

    .design-reference strong {
        color: color-mix(in srgb, var(--text) 86%, var(--muted));
        font: inherit;
        font-weight: 600;
        transition: color 140ms ease;
    }

    .design-reference:hover,
    .design-reference:focus-visible {
        color: var(--text);
        transform: translate(-50%, -50%) translateY(-1px);
        outline: none;
    }

    .design-reference:hover strong,
    .design-reference:focus-visible strong {
        color: var(--text);
    }

    .design-reference-tooltip {
        position: absolute;
        left: 50%;
        top: calc(100% + 7px);
        z-index: 40;
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 450;
        line-height: 1.2;
        letter-spacing: 0;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, -3px);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .design-reference:hover .design-reference-tooltip,
    .design-reference:focus-visible .design-reference-tooltip {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    .home-spacer {
        flex: 1 1 auto;
        min-width: 16px;
    }

    .home-nav {
        display: flex;
        align-items: center;
        gap: clamp(16px, 1.6vw, 26px);
        flex: none;
    }

    .home-nav-link {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.015em;
        transition: color 140ms ease;
    }

    .home-nav-link:hover,
    .home-nav-link.is-active {
        color: var(--text);
    }

    .home-actions {
        display: flex;
        flex: none;
        align-items: center;
        gap: 7px;
    }

    .header-separator {
        width: 1px;
        height: 20px;
        flex: none;
        background: var(--sheet-line, var(--border));
    }

    .home-search {
        display: flex;
        align-items: center;
    }

    .home-language {
        position: relative;
    }

    .home-language summary {
        min-width: 28px;
        height: 30px;
        padding: 0 4px;
        display: grid;
        place-items: center;
        list-style: none;
        border: 0;
        border-radius: 0;
        color: var(--muted);
        background: transparent;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 9px;
        line-height: 1;
        transition: color 140ms ease;
    }

    .home-language summary::-webkit-details-marker {
        display: none;
    }

    .home-language summary:hover,
    .home-language[open] summary {
        color: var(--text);
        background: transparent;
    }

    .home-language-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 170px;
        padding: 4px;
        display: grid;
        gap: 1px;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 0;
        box-shadow: var(--shadow);
    }

    .home-language-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 8px;
        border-radius: 0;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 10px;
    }

    .home-language-option:hover,
    .home-language-option.is-active {
        color: var(--text);
        background: var(--surface-2);
    }

    :global(.home-header .site-search-trigger) {
        width: auto;
        min-width: 0;
        height: 30px;
        min-height: 30px;
        padding: 0 4px;
        justify-content: center;
        gap: 6px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--muted);
        font-family: var(--font-sans);
        transition: color 140ms ease;
    }

    :global(.home-header .site-search-trigger:hover) {
        background: transparent;
        border-color: transparent;
        color: var(--text);
    }

    :global(.home-header .site-search-trigger > span) {
        display: none;
    }

    :global(.home-header .site-search-trigger > kbd) {
        display: inline-flex;
        align-items: center;
        min-height: 18px;
        padding: 1px 4px;
        border: 1px solid var(--border-strong);
        border-radius: 3px;
        background: var(--surface);
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        line-height: 1;
        box-shadow: none;
    }

    :global(.home-header .site-search-trigger svg) {
        width: 13px;
        height: 13px;
    }

    :global(.home-header .theme-toggle) {
        width: 30px;
        min-width: 30px;
        height: 30px;
        min-height: 30px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--muted);
    }

    :global(.home-header .theme-toggle:hover) {
        border-color: transparent;
        background: transparent;
        color: var(--text);
    }

    :global(.home-header .theme-toggle svg) {
        width: 14px;
        height: 14px;
        stroke-width: 1.6;
    }

    @media (max-width: 1020px) {
        .design-reference {
            display: none;
        }
    }

    @media (max-width: 760px) {
        .home-header {
            height: 48px;
        }

        .home-header-inner {
            padding: 0 12px;
            gap: 8px;
            border-inline: 0;
        }

        .home-greeting {
            font-size: 14px;
        }

        .home-nav,
        .home-search,
        .desktop-separator {
            display: none;
        }

        .home-spacer {
            min-width: 0;
        }

        .home-actions {
            gap: 5px;
        }
    }
</style>

<style is:global>
    /* Homepage drawing-sheet coordinate system.
       Content keeps its centered rails; selected horizontal structure escapes
       that content box and is clipped only by the viewport. */
    html,
    body,
    .full-shell {
        overflow-x: clip;
    }

    .full-shell .home-redesign[data-home-redesign] {
        overflow-x: visible;
    }

    .home-redesign[data-home-redesign] .portfolio-board {
        isolation: isolate;
        border-top: 0;
        border-bottom: 0;
    }

    .home-redesign[data-home-redesign] .portfolio-board::before,
    .home-redesign[data-home-redesign] .portfolio-board::after,
    .home-redesign[data-home-redesign] .top-layout::after {
        content: '';
        position: absolute;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        pointer-events: none;
    }

    .home-redesign[data-home-redesign] .portfolio-board::before,
    .home-redesign[data-home-redesign] .portfolio-board::after {
        z-index: 6;
        height: var(--minor-stroke);
        background: var(--sheet-line);
    }

    .home-redesign[data-home-redesign] .portfolio-board::before {
        top: 0;
    }

    .home-redesign[data-home-redesign] .portfolio-board::after {
        bottom: 0;
    }

    .home-redesign[data-home-redesign] .top-layout {
        position: relative;
        border-bottom: 0;
    }

    .home-redesign[data-home-redesign] .top-layout::after {
        right: auto;
        bottom: 0;
        z-index: 8;
        height: var(--major-stroke);
        background: var(--border);
    }

    /* Final interaction affordances shared by the locked profile + NR area. */
    .home-redesign[data-home-redesign] .nr-hud-title strong::before {
        content: '♪ ';
        color: color-mix(in srgb, var(--muted) 82%, transparent);
        font-weight: 400;
    }

    .home-redesign[data-home-redesign] .streak-region[data-profile-link='duolingo'] {
        position: relative;
        z-index: 9;
        overflow: visible !important;
    }

    .home-redesign[data-home-redesign] .streak-region[data-profile-link='duolingo']::before {
        content: 'View @bilcikiwir on Duolingo ↗';
        position: absolute;
        z-index: 30;
        left: 12px;
        bottom: calc(100% + 8px);
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 450;
        line-height: 1.2;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateY(3px);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .home-redesign[data-home-redesign] .streak-region[data-profile-link='duolingo']:hover::before,
    .home-redesign[data-home-redesign] .streak-region[data-profile-link='duolingo']:focus-within::before {
        opacity: 1;
        transform: translateY(0);
    }

    .home-redesign[data-home-redesign] .nr-song-credit::after {
        content: "Visit Sharou's YouTube channel ↗";
        position: absolute;
        z-index: 40;
        right: 0;
        bottom: calc(100% + 8px);
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 450;
        line-height: 1.2;
        letter-spacing: 0;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateY(3px);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .home-redesign[data-home-redesign] .nr-song-credit:hover::after,
    .home-redesign[data-home-redesign] .nr-song-credit:focus-visible::after {
        opacity: 1;
        transform: translateY(0);
    }
</style>