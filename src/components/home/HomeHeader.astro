---
import ThemeToggle from '../ThemeToggle.astro';
import GitHubStars from './GitHubStars.astro';
import VerifiedIcon from './VerifiedIcon.astro';
import { getSiteContent } from '../../data/siteContent';

type HeaderSection = 'overview' | 'blog' | 'components' | 'none';

interface Props {
    activeSection?: HeaderSection;
}

const activeSection = Astro.props.activeSection ?? 'overview';
const content = getSiteContent();
const homePath = '/';
const blogPath = '/blog/';
const componentsPath = '/components/';
---

<header class="home-header">
    <div class="home-header-inner">
        <div class="home-intro">
            <a href={homePath} class="home-greeting" aria-label={`${content.profile.name} — ${content.nav.home}`}>
                <span data-local-greeting data-ready="false">good day</span>
            </a>
        </div>

        <a
            class="design-reference"
            href="https://chanhdai.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Design reference: Chánh Đại. Visit chanhdai.com"
        >
            <span class="design-reference-copy">design reference —</span>
            <strong>Chánh Đại</strong>
            <span class="design-reference-verified" aria-hidden="true"><VerifiedIcon size={13} /></span>
            <span class="design-reference-tooltip" role="tooltip">visit chanhdai.com</span>
        </a>

        <nav class="home-nav" aria-label={content.nav.ariaPageNavigation}>
            <a
                href={homePath}
                class:list={['home-nav-link', { 'is-active': activeSection === 'overview' }]}
                aria-current={activeSection === 'overview' ? 'page' : undefined}
            >{content.nav.overview}</a>
            <a
                href={blogPath}
                class:list={['home-nav-link', { 'is-active': activeSection === 'blog' }]}
                aria-current={activeSection === 'blog' ? 'page' : undefined}
            >{content.nav.blog}</a>
            <a
                href={componentsPath}
                class:list={['home-nav-link', { 'is-active': activeSection === 'components' }]}
                aria-current={activeSection === 'components' ? 'page' : undefined}
            >{content.nav.components}</a>
        </nav>

        <div class="home-actions">
            <button
                type="button"
                class="header-search"
                aria-label="Search portfolio"
                title="Search portfolio"
                data-global-search-open
            >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="m16 16 4 4"></path>
                </svg>
                <kbd data-global-search-shortcut>Ctrl K</kbd>
            </button>

            <span class="header-separator" aria-hidden="true"></span>
            <GitHubStars repo="nabilrn/nabilrn.github.io" />
            <span class="header-separator" aria-hidden="true"></span>
            <ThemeToggle />
        </div>
    </div>
</header>

<script is:inline>
    (() => {
        const target = document.querySelector('[data-local-greeting]');
        if (!(target instanceof HTMLElement)) return;

        const renderGreeting = () => {
            const hour = new Date().getHours();
            const greeting = hour >= 5 && hour < 12
                ? 'good morning'
                : hour >= 12 && hour < 17
                    ? 'good afternoon'
                    : 'good evening';
            target.textContent = greeting;
            target.dataset.ready = 'true';
        };

        renderGreeting();
        window.setInterval(renderGreeting, 60000);
    })();
</script>

<style>
    .home-header {
        position: relative;
        z-index: 30;
        width: 100%;
        height: 52px;
        background: var(--bg);
    }

    .home-header-inner {
        position: relative;
        width: 100%;
        height: 100%;
        padding: 0 clamp(14px, 1.5vw, 24px);
        display: flex;
        align-items: center;
        gap: clamp(10px, 1.1vw, 18px);
        border-inline: 1px solid var(--sheet-line, var(--border));
    }

    .home-header-inner::before,
    .home-header-inner::after {
        content: '';
        position: absolute;
        left: 50%;
        width: 100vw;
        height: 1px;
        transform: translateX(-50%);
        background: var(--sheet-line, var(--border));
        pointer-events: none;
    }

    .home-header-inner::before { top: 0; }
    .home-header-inner::after { bottom: 0; }

    .home-intro {
        min-width: 0;
        display: flex;
        flex: 1 1 0;
        align-items: center;
    }

    .home-greeting {
        display: inline-flex;
        align-items: center;
        color: var(--muted);
        font-family: "Segoe Print", "Bradley Hand", "Comic Sans MS", cursive;
        font-size: 15px;
        line-height: 1;
        text-decoration: none;
        transform: rotate(-1.3deg);
        transform-origin: left center;
        transition: color 140ms ease, transform 140ms ease;
    }

    .home-greeting:hover,
    .home-greeting:focus-visible {
        color: var(--text);
        transform: rotate(-.6deg) translateY(-1px);
        outline: none;
    }

    .home-greeting [data-local-greeting] {
        opacity: 0;
        visibility: hidden;
        transition: opacity 120ms ease;
    }

    .home-greeting [data-local-greeting][data-ready='true'] {
        opacity: 1;
        visibility: visible;
    }

    .design-reference {
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 6;
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 11px;
        line-height: 1;
        white-space: nowrap;
        text-decoration: none;
        transform: translate(-50%, -50%);
    }

    .design-reference strong { color: var(--text); font: inherit; font-weight: 600; }
    .design-reference-copy { color: var(--muted); }
    .design-reference-verified {
        width: 13px;
        height: 13px;
        display: grid;
        place-items: center;
        color: #ffad1f;
    }

    .design-reference-tooltip {
        position: absolute;
        left: 50%;
        top: calc(100% + 7px);
        width: max-content;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: var(--surface);
        color: var(--text);
        font-size: 9px;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, -3px);
        transition: opacity 120ms ease, transform 120ms ease;
    }

    .design-reference:hover .design-reference-tooltip,
    .design-reference:focus-visible .design-reference-tooltip {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    .home-nav {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .home-nav-link {
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 520;
        line-height: 1;
        text-decoration: none;
        transition: color 120ms ease;
    }

    .home-nav-link:hover,
    .home-nav-link:focus-visible,
    .home-nav-link.is-active {
        color: var(--text);
        outline: none;
    }

    .home-nav-link.is-active { font-weight: 650; }

    .home-actions {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .header-search {
        min-height: 30px;
        padding: 0 2px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 0;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        transition: color 120ms ease;
    }

    .header-search:hover,
    .header-search:focus-visible {
        color: var(--text);
        outline: none;
    }

    .header-search svg {
        width: 14px;
        height: 14px;
    }

    .header-search kbd {
        padding: 2px 4px;
        border: 1px solid var(--border);
        border-bottom-color: var(--border-strong);
        border-radius: 3px;
        background: transparent;
        color: inherit;
        font-family: var(--font-mono);
        font-size: 8px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
    }

    .header-separator {
        width: 1px;
        height: 16px;
        background: var(--sheet-line, var(--border));
    }

    @media (max-width: 1080px) {
        .design-reference { display: none; }
        .home-intro { flex: 0 1 auto; }
    }

    @media (max-width: 760px) {
        .home-header { height: 48px; }
        .home-header-inner { padding-inline: 10px; gap: 7px; }
        .home-greeting { font-size: 13px; }
        .home-nav { gap: 10px; margin-left: auto; }
        .home-nav-link { min-height: 28px; font-size: 10px; }
        .header-search { width: 28px; padding: 0; justify-content: center; }
        .header-search kbd { display: none; }
        .home-actions { gap: 3px; }
    }

    @media (max-width: 560px) {
        .home-greeting { display: none; }
        .home-nav { gap: 8px; }
        .home-nav-link { font-size: 9.5px; }
        .header-separator { display: none; }
    }
</style>
