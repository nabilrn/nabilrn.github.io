---
import SiteSearch from '../SiteSearch.astro';
import ThemeToggle from '../ThemeToggle.astro';
import GitHubStars from './GitHubStars.astro';
import NRLogo from './NRLogo.astro';
import {
    getSiteContent,
    localeMeta,
    localizePath,
    normalizeLocale,
    supportedLocales,
    type SiteLocale,
} from '../../data/siteContent';

interface Props {
    locale?: SiteLocale;
}

const locale = normalizeLocale(Astro.props.locale);
const content = getSiteContent(locale);
const homePath = localizePath('/', locale);
const blogPath = localizePath('/blog/', locale);
---

<header class="home-header">
    <div class="home-header-inner">
        <a href={homePath} class="home-brand" aria-label={`${content.profile.name} — ${content.nav.home}`}>
            <NRLogo class="home-brand-logo" width={44} height={24} />
        </a>

        <div class="home-spacer" aria-hidden="true"></div>

        <nav class="home-nav" aria-label={content.nav.ariaPageNavigation}>
            <a href={homePath} class="home-nav-link is-active" aria-current="page">{content.nav.overview}</a>
            <a href={blogPath} class="home-nav-link">{content.nav.blog}</a>
        </nav>

        <div class="home-actions">
            <span class="header-separator desktop-separator" aria-hidden="true"></span>

            <div class="home-search">
                <SiteSearch locale={locale} />
            </div>

            <span class="header-separator desktop-separator" aria-hidden="true"></span>

            <GitHubStars repo="nabilrn/nabilrn.github.io" />

            <span class="header-separator" aria-hidden="true"></span>

            <ThemeToggle locale={locale} />

            <span class="header-separator" aria-hidden="true"></span>

            <details class="home-language">
                <summary aria-label={content.nav.ariaLanguageNavigation}>{locale.toUpperCase()}</summary>
                <div class="home-language-menu">
                    {supportedLocales.map((item) => (
                        <a
                            class:list={['home-language-option', { 'is-active': item === locale }]}
                            href={localizePath('/', item)}
                        >
                            <span>{item.toUpperCase()}</span>
                            <span>{localeMeta[item].label}</span>
                        </a>
                    ))}
                </div>
            </details>
        </div>
    </div>
</header>

<style>
    .home-header {
        position: relative;
        z-index: 30;
        width: 100%;
        height: 52px;
        background: var(--bg);
    }

    .home-header-inner {
        position: relative;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0 clamp(14px, 1.5vw, 24px);
        display: flex;
        align-items: center;
        gap: clamp(12px, 1.2vw, 20px);
        border-inline: 1px solid var(--sheet-line, var(--border));
    }

    .home-header-inner::before,
    .home-header-inner::after {
        content: '';
        position: absolute;
        left: 50%;
        width: 100vw;
        height: 1px;
        transform: translateX(-50%);
        background: var(--sheet-line, var(--border));
        pointer-events: none;
    }

    .home-header-inner::before {
        top: 0;
    }

    .home-header-inner::after {
        bottom: 0;
    }

    .home-brand {
        display: inline-flex;
        width: max-content;
        flex: none;
        align-items: center;
        color: var(--text);
        transition: color 140ms ease, opacity 140ms ease;
    }

    .home-brand:hover {
        opacity: 0.76;
    }

    .home-brand-logo {
        display: block;
        width: 44px;
        height: 24px;
    }

    .home-spacer {
        flex: 1 1 auto;
        min-width: 16px;
    }

    .home-nav {
        display: flex;
        align-items: center;
        gap: clamp(16px, 1.6vw, 26px);
        flex: none;
    }

    .home-nav-link {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.015em;
        transition: color 140ms ease;
    }

    .home-nav-link:hover,
    .home-nav-link.is-active {
        color: var(--text);
    }

    .home-actions {
        display: flex;
        flex: none;
        align-items: center;
        gap: 7px;
    }

    .header-separator {
        width: 1px;
        height: 20px;
        flex: none;
        background: var(--sheet-line, var(--border));
    }

    .home-search {
        display: flex;
        align-items: center;
    }

    .home-language {
        position: relative;
    }

    .home-language summary {
        min-width: 28px;
        height: 30px;
        padding: 0 4px;
        display: grid;
        place-items: center;
        list-style: none;
        border: 0;
        border-radius: 0;
        color: var(--muted);
        background: transparent;
        cursor: pointer;
        font-family: var(--font-mono);
        font-size: 9px;
        line-height: 1;
        transition: color 140ms ease;
    }

    .home-language summary::-webkit-details-marker {
        display: none;
    }

    .home-language summary:hover,
    .home-language[open] summary {
        color: var(--text);
        background: transparent;
    }

    .home-language-menu {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 170px;
        padding: 4px;
        display: grid;
        gap: 1px;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 0;
        box-shadow: var(--shadow);
    }

    .home-language-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 7px 8px;
        border-radius: 0;
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 10px;
    }

    .home-language-option:hover,
    .home-language-option.is-active {
        color: var(--text);
        background: var(--surface-2);
    }

    :global(.home-header .site-search-trigger) {
        width: auto;
        min-width: 0;
        height: 30px;
        min-height: 30px;
        padding: 0 4px;
        justify-content: center;
        gap: 6px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--muted);
        font-family: var(--font-sans);
        transition: color 140ms ease;
    }

    :global(.home-header .site-search-trigger:hover) {
        background: transparent;
        border-color: transparent;
        color: var(--text);
    }

    :global(.home-header .site-search-trigger > span) {
        display: none;
    }

    :global(.home-header .site-search-trigger > kbd) {
        display: inline-flex;
        align-items: center;
        min-height: 18px;
        padding: 1px 4px;
        border: 1px solid var(--border-strong);
        border-radius: 3px;
        background: var(--surface);
        color: var(--muted);
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        line-height: 1;
        box-shadow: none;
    }

    :global(.home-header .site-search-trigger svg) {
        width: 13px;
        height: 13px;
    }

    :global(.home-header .theme-toggle) {
        width: 30px;
        min-width: 30px;
        height: 30px;
        min-height: 30px;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: var(--muted);
    }

    :global(.home-header .theme-toggle:hover) {
        border-color: transparent;
        background: transparent;
        color: var(--text);
    }

    :global(.home-header .theme-toggle svg) {
        width: 14px;
        height: 14px;
        stroke-width: 1.6;
    }

    @media (max-width: 760px) {
        .home-header {
            height: 48px;
        }

        .home-header-inner {
            padding: 0 12px;
            gap: 8px;
            border-inline: 0;
        }

        .home-brand-logo {
            width: 40px;
            height: 22px;
        }

        .home-nav,
        .home-search,
        .desktop-separator {
            display: none;
        }

        .home-spacer {
            min-width: 0;
        }

        .home-actions {
            gap: 5px;
        }
    }
</style>

<style is:global>
    /* Homepage drawing-sheet coordinate system.
       Content keeps its centered rails; selected horizontal structure escapes
       that content box and is clipped only by the viewport. */
    html,
    body,
    .full-shell {
        overflow-x: clip;
    }

    .full-shell .home-redesign[data-home-redesign] {
        overflow-x: visible;
    }

    .home-redesign[data-home-redesign] .portfolio-board {
        isolation: isolate;
        border-top: 0;
        border-bottom: 0;
    }

    .home-redesign[data-home-redesign] .portfolio-board::before,
    .home-redesign[data-home-redesign] .portfolio-board::after,
    .home-redesign[data-home-redesign] .top-layout::after {
        content: '';
        position: absolute;
        left: 50%;
        width: 100vw;
        transform: translateX(-50%);
        pointer-events: none;
    }

    .home-redesign[data-home-redesign] .portfolio-board::before,
    .home-redesign[data-home-redesign] .portfolio-board::after {
        z-index: 6;
        height: var(--minor-stroke);
        background: var(--sheet-line);
    }

    .home-redesign[data-home-redesign] .portfolio-board::before {
        top: 0;
    }

    .home-redesign[data-home-redesign] .portfolio-board::after {
        bottom: 0;
    }

    .home-redesign[data-home-redesign] .top-layout {
        position: relative;
        border-bottom: 0;
    }

    .home-redesign[data-home-redesign] .top-layout::after {
        right: auto;
        bottom: 0;
        z-index: 8;
        height: var(--major-stroke);
        background: var(--border);
    }
</style>