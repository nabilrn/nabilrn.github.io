<script>
    type HourPoint = { hour?: string; views?: number; visitors?: number };
    type Summary = {
        generatedAt?: string;
        visitors?: number;
        pageviews?: number;
        topPage?: { path?: string; views?: number };
        last24Hours?: HourPoint[];
    };
    type ChartPoint = { label: string; views: number; visitors: number };
    type BeforeSwapEvent = Event & { newDocument?: Document };

    const PADANG_TIME_ZONE = 'Asia/Jakarta';
    const PADANG_MAPS_URL = 'https://www.google.com/maps/search/?api=1&query=Padang%2C%20Sumatera%20Barat%2C%20Indonesia';
    const DUOLINGO_PROFILE_URL = 'https://www.duolingo.com/profile/bilcikiwir?via=share_profile_link';

    let homeWasSeen = false;
    let blogWasSeen = false;
    let cleanupCurrentPage: (() => void) | null = null;

    const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
    const exact = new Intl.NumberFormat('en-US');
    const hourFormat = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
    const dayFormat = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short' });

    const normalizeApiBase = (value?: string) => value?.trim().replace(/\/+$/, '') ?? '';

    const getVisitorId = () => {
        const key = 'portfolio:visitor-id';
        const existing = localStorage.getItem(key);
        if (existing) return existing;
        const id = crypto.randomUUID();
        localStorage.setItem(key, id);
        return id;
    };

    const cleanupPageLifecycle = () => {
        cleanupCurrentPage?.();
        cleanupCurrentPage = null;
    };

    const renderHeaderGreeting = () => {
        const target = document.querySelector<HTMLElement>('[data-local-greeting]');
        if (!target) return;

        const hour = new Date().getHours();
        target.textContent = hour >= 5 && hour < 12
            ? 'good morning'
            : hour >= 12 && hour < 17
                ? 'good afternoon'
                : 'good evening';
        target.dataset.ready = 'true';
    };

    const ensureEducationOverlay = () => {
        const template = document.querySelector<HTMLTemplateElement>('[data-education-template]');
        const region = document.querySelector<HTMLElement>('.education-region');
        if (template && region && !region.querySelector('.education-panel')) {
            region.replaceChildren(template.content.cloneNode(true));
        }
    };

    const ensureProfileLinks = () => {
        const locationPlace = document.querySelector<HTMLElement>('.location-place');
        if (locationPlace && !locationPlace.querySelector('.profile-hit-link')) {
            locationPlace.dataset.profileLink = 'maps';

            const hitLink = document.createElement('a');
            hitLink.className = 'profile-hit-link';
            hitLink.href = PADANG_MAPS_URL;
            hitLink.target = '_blank';
            hitLink.rel = 'noopener';
            hitLink.setAttribute('aria-label', 'See Padang, Indonesia on Google Maps');
            locationPlace.append(hitLink);

            const svgNamespace = 'http://www.w3.org/2000/svg';
            const mapsIcon = document.createElementNS(svgNamespace, 'svg');
            mapsIcon.classList.add('location-map-brand');
            mapsIcon.setAttribute('viewBox', '0 0 24 24');
            mapsIcon.setAttribute('aria-hidden', 'true');
            mapsIcon.innerHTML = `
                <path fill="#34A853" d="M12 2a8 8 0 0 0-8 8c0 5 8 12 8 12s8-7 8-12a8 8 0 0 0-8-8Z"></path>
                <path fill="#FBBC04" d="M12 2a8 8 0 0 0-7.3 4.7L12 12l7.3-5.3A8 8 0 0 0 12 2Z"></path>
                <path fill="#EA4335" d="M4 10c0 2.2 1.5 5 3.4 7.3L12 12 4.7 6.7A8 8 0 0 0 4 10Z"></path>
                <circle cx="12" cy="10" r="2.8" fill="#4285F4"></circle>
            `;
            locationPlace.append(mapsIcon);

            const tooltip = document.createElement('span');
            tooltip.className = 'profile-link-tooltip';
            tooltip.textContent = 'See Padang on Google Maps';
            tooltip.setAttribute('role', 'tooltip');
            locationPlace.append(tooltip);
        }

        const streakRegion = document.querySelector<HTMLElement>('.streak-region');
        if (streakRegion && !streakRegion.querySelector('.profile-hit-link')) {
            streakRegion.dataset.profileLink = 'duolingo';

            const hitLink = document.createElement('a');
            hitLink.className = 'profile-hit-link';
            hitLink.href = DUOLINGO_PROFILE_URL;
            hitLink.target = '_blank';
            hitLink.rel = 'noopener';
            hitLink.setAttribute(
                'aria-label',
                `${streakRegion.getAttribute('aria-label') ?? 'Duolingo streak'}, open @bilcikiwir profile`,
            );
            streakRegion.append(hitLink);
        }
    };

    const initPadangClock = (controller: AbortController) => {
        const timeTarget = document.querySelector<HTMLElement>('[data-padang-time]');
        const dateTarget = document.querySelector<HTMLElement>('[data-padang-date]');
        const diffTarget = document.querySelector<HTMLElement>('[data-padang-diff]');
        const handsTarget = document.querySelector<SVGPathElement>('[data-padang-clock-hands]');
        if (!timeTarget || !dateTarget || !diffTarget) return;

        const timeFormatter = new Intl.DateTimeFormat('en-US', {
            timeZone: PADANG_TIME_ZONE,
            hour: '2-digit',
            minute: '2-digit',
            hour12: true,
        });
        const dateFormatter = new Intl.DateTimeFormat('en-GB', {
            timeZone: PADANG_TIME_ZONE,
            day: '2-digit',
            month: 'short',
            year: 'numeric',
        });
        const offsetFormatter = new Intl.DateTimeFormat('en-US', {
            timeZone: PADANG_TIME_ZONE,
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hourCycle: 'h23',
        });

        const getPadangOffset = (date: Date) => {
            const parts = offsetFormatter.formatToParts(date);
            const values = Object.fromEntries(
                parts.filter((part) => part.type !== 'literal').map((part) => [part.type, part.value]),
            );
            const representedUtc = Date.UTC(
                Number(values.year),
                Number(values.month) - 1,
                Number(values.day),
                Number(values.hour),
                Number(values.minute),
                Number(values.second),
            );
            return Math.round((representedUtc - date.getTime()) / 60000);
        };

        const clockHandsPath = (hour: number, minute: number) => {
            const h = hour % 12;
            const round = (value: number) => Math.round(value * 1000) / 1000;
            const minuteAngle = (minute / 60) * 2 * Math.PI;
            const hourAngle = ((h + minute / 60) / 12) * 2 * Math.PI;
            const hx = round(12 + 3.6 * Math.sin(hourAngle));
            const hy = round(12 - 3.6 * Math.cos(hourAngle));
            const mx = round(12 + 6 * Math.sin(minuteAngle));
            const my = round(12 - 6 * Math.cos(minuteAngle));
            return `M12 12 L${hx} ${hy} M12 12 L${mx} ${my}`;
        };

        const render = () => {
            const now = new Date();
            const timeParts = timeFormatter.formatToParts(now);
            const hourPart = timeParts.find((part) => part.type === 'hour')?.value ?? '12';
            const minutePart = timeParts.find((part) => part.type === 'minute')?.value ?? '00';
            const dayPeriod = timeParts.find((part) => part.type === 'dayPeriod')?.value ?? '';

            timeTarget.textContent = `${hourPart}:${minutePart}${dayPeriod ? ` ${dayPeriod}` : ''}`;
            dateTarget.textContent = dateFormatter.format(now).toUpperCase();

            const viewerOffset = -now.getTimezoneOffset();
            const padangOffset = getPadangOffset(now);
            const delta = padangOffset - viewerOffset;
            const absDelta = Math.abs(delta);

            let diffText = '// same time';
            if (absDelta >= 1) {
                const hours = Math.floor(absDelta / 60);
                const minutes = absDelta % 60;
                const pieces: string[] = [];
                if (hours) pieces.push(`${hours}h`);
                if (minutes) pieces.push(`${minutes}m`);
                diffText = `// ${pieces.join(' ')} ${delta > 0 ? 'ahead' : 'behind'}`;
            }
            diffTarget.textContent = diffText;

            if (handsTarget) {
                handsTarget.setAttribute('d', clockHandsPath(Number.parseInt(hourPart, 10), Number.parseInt(minutePart, 10)));
            }
        };

        render();
        const timer = window.setInterval(render, 30000);
        controller.signal.addEventListener('abort', () => window.clearInterval(timer), { once: true });
    };

    const initContributionTooltips = (controller: AbortController) => {
        const cells = Array.from(document.querySelectorAll<HTMLElement>('[data-contribution-tooltip]'));
        if (!cells.length || cells.every((cell) => cell.dataset.tooltipReady === 'true')) return;

        document.querySelector('.contribution-floating-tooltip')?.remove();
        const tooltip = document.createElement('div');
        tooltip.className = 'contribution-floating-tooltip';
        tooltip.setAttribute('role', 'tooltip');
        document.body.appendChild(tooltip);

        const hideTooltip = () => tooltip.classList.remove('is-visible');
        const showTooltip = (cell: HTMLElement) => {
            const label = cell.dataset.contributionTooltip;
            if (!label) return;

            tooltip.textContent = label;
            tooltip.style.left = '0px';
            tooltip.style.top = '0px';
            tooltip.classList.add('is-visible');

            const rect = cell.getBoundingClientRect();
            const tooltipRect = tooltip.getBoundingClientRect();
            const half = tooltipRect.width / 2;
            const left = Math.max(8 + half, Math.min(window.innerWidth - 8 - half, rect.left + rect.width / 2));
            const top = Math.max(tooltipRect.height + 12, rect.top);
            tooltip.style.left = `${left}px`;
            tooltip.style.top = `${top}px`;
        };

        cells.forEach((cell) => {
            if (cell.dataset.tooltipReady === 'true') return;
            cell.dataset.tooltipReady = 'true';
            cell.addEventListener('pointerenter', () => showTooltip(cell), { signal: controller.signal });
            cell.addEventListener('pointerleave', hideTooltip, { signal: controller.signal });
            cell.addEventListener('focus', () => showTooltip(cell), { signal: controller.signal });
            cell.addEventListener('blur', hideTooltip, { signal: controller.signal });
        });

        window.addEventListener('blur', hideTooltip, { signal: controller.signal });
    };

    const initExperienceOverflow = (controller: AbortController) => {
        const observers: ResizeObserver[] = [];

        document.querySelectorAll<HTMLElement>('.experience-panel').forEach((panel) => {
            const scroll = panel.querySelector<HTMLElement>('.experience-scroll');
            if (!scroll) return;

            const updateOverflowState = () => {
                const scrollable = scroll.scrollHeight - scroll.clientHeight > 2;
                const atBottom = !scrollable || scroll.scrollTop + scroll.clientHeight >= scroll.scrollHeight - 2;
                panel.dataset.scrollable = scrollable ? 'true' : 'false';
                panel.dataset.atBottom = atBottom ? 'true' : 'false';
            };

            updateOverflowState();
            scroll.addEventListener('scroll', updateOverflowState, { passive: true, signal: controller.signal });

            const observer = new ResizeObserver(updateOverflowState);
            observer.observe(scroll);
            const timeline = scroll.querySelector<HTMLElement>('.experience-timeline');
            if (timeline) observer.observe(timeline);
            observers.push(observer);
        });

        controller.signal.addEventListener('abort', () => {
            observers.forEach((observer) => observer.disconnect());
        }, { once: true });
    };

    const initLowerSections = (controller: AbortController) => {
        const template = document.querySelector<HTMLTemplateElement>('[data-lower-sections-template]');
        const bottomLayout = document.querySelector<HTMLElement>('.bottom-layout');
        const oldBlogRegion = bottomLayout?.querySelector<HTMLElement>('.blog-region');
        let inserted = false;

        if (template && bottomLayout && oldBlogRegion && !bottomLayout.querySelector('.analytics-region')) {
            oldBlogRegion.replaceWith(template.content.cloneNode(true));
            inserted = true;
        }

        if (!inserted) return;

        const analyticsRegion = document.querySelector<HTMLElement>('.analytics-region');
        const blogRegion = document.querySelector<HTMLElement>('.latest-blog-region');
        const apiBase = normalizeApiBase(analyticsRegion?.dataset.analyticsApi);
        const blogApiBase = normalizeApiBase(blogRegion?.dataset.blogMetricsApi) || apiBase;
        const visitorsEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-visitors]');
        const pageviewsEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-pageviews]');
        const topPageEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-top-page]');
        const sparkEl = analyticsRegion?.querySelector<HTMLElement>('[data-analytics-spark]');

        let tooltip = document.querySelector<HTMLElement>('.analytics-floating-tooltip');
        if (!tooltip) {
            tooltip = document.createElement('div');
            tooltip.className = 'analytics-floating-tooltip';
            tooltip.setAttribute('role', 'tooltip');
            document.body.appendChild(tooltip);
        }

        const activeTooltip = tooltip;
        const hideTooltip = () => activeTooltip?.classList.remove('is-visible');
        const showTooltip = (bar: HTMLElement) => {
            if (!activeTooltip) return;
            const label = bar.dataset.analyticsTooltip;
            if (!label) return;
            activeTooltip.textContent = label;
            activeTooltip.classList.add('is-visible');
            const rect = bar.getBoundingClientRect();
            const tip = activeTooltip.getBoundingClientRect();
            const half = tip.width / 2;
            activeTooltip.style.left = `${Math.max(8 + half, Math.min(innerWidth - 8 - half, rect.left + rect.width / 2))}px`;
            activeTooltip.style.top = `${Math.max(tip.height + 12, rect.top)}px`;
        };

        const hourlyPoints = (values?: HourPoint[]): ChartPoint[] => (values ?? []).map((item, index) => {
            const fallback = new Date(Date.now() - (23 - index) * 3_600_000);
            const parsed = item.hour ? new Date(item.hour) : fallback;
            const start = Number.isNaN(parsed.getTime()) ? fallback : parsed;
            const end = new Date(start.getTime() + 3_600_000);
            return {
                label: `${dayFormat.format(start)} · ${hourFormat.format(start)}–${hourFormat.format(end)}`,
                views: Math.max(0, Number(item.views ?? 0)),
                visitors: Math.max(0, Number(item.visitors ?? 0)),
            };
        });

        const renderSpark = (points: ChartPoint[]) => {
            if (!sparkEl) return;
            sparkEl.replaceChildren();
            const max = Math.max(0, ...points.map((point) => point.views));

            for (const point of points) {
                const empty = point.views === 0 || max === 0;
                const bar = document.createElement('span');
                bar.style.height = `${empty ? 0 : Math.max(12, (point.views / max) * 100)}%`;
                bar.dataset.empty = String(empty);
                bar.tabIndex = empty ? -1 : 0;
                bar.setAttribute('role', 'listitem');
                const label = `${point.label} · ${exact.format(point.views)} pageviews · ${exact.format(point.visitors)} visitors`;
                bar.setAttribute('aria-label', label);
                bar.dataset.analyticsTooltip = label;
                if (!empty) {
                    bar.addEventListener('pointerenter', () => showTooltip(bar), { signal: controller.signal });
                    bar.addEventListener('pointerleave', hideTooltip, { signal: controller.signal });
                    bar.addEventListener('focus', () => showTooltip(bar), { signal: controller.signal });
                    bar.addEventListener('blur', hideTooltip, { signal: controller.signal });
                }
                sparkEl.appendChild(bar);
            }
        };

        const renderUnavailable = () => {
            if (visitorsEl) visitorsEl.textContent = '—';
            if (pageviewsEl) pageviewsEl.textContent = '—';
            if (topPageEl) topPageEl.textContent = '—';
            renderSpark([]);
        };

        const renderSummary = (summary: Summary) => {
            const valid = typeof summary.generatedAt === 'string'
                && Array.isArray(summary.last24Hours)
                && summary.last24Hours.length === 24;
            if (!valid) {
                renderUnavailable();
                return;
            }
            if (visitorsEl) visitorsEl.textContent = compact.format(Number(summary.visitors ?? 0));
            if (pageviewsEl) pageviewsEl.textContent = compact.format(Number(summary.pageviews ?? 0));
            if (topPageEl) topPageEl.textContent = summary.topPage?.path || '/';
            renderSpark(hourlyPoints(summary.last24Hours));
        };

        renderUnavailable();
        window.addEventListener('blur', hideTooltip, { signal: controller.signal });

        void (async () => {
            if (!apiBase) return;
            const isLocalPreview = location.hostname === 'localhost'
                || location.hostname === '127.0.0.1'
                || location.hostname === '::1';

            if (!isLocalPreview) {
                try {
                    await fetch(`${apiBase}/analytics/view`, {
                        method: 'POST',
                        headers: { 'content-type': 'application/json' },
                        body: JSON.stringify({ path: location.pathname, visitorId: getVisitorId() }),
                        keepalive: true,
                        signal: controller.signal,
                    });
                } catch {
                    // Analytics must never block page rendering.
                }
            }

            try {
                const response = await fetch(`${apiBase}/analytics/summary`, {
                    headers: { Accept: 'application/json' },
                    cache: 'no-store',
                    signal: controller.signal,
                });
                if (!response.ok) throw new Error(`analytics summary ${response.status}`);
                const summary = await response.json() as Summary;
                renderSummary(summary);
            } catch {
                if (!controller.signal.aborted) renderUnavailable();
            }
        })();

        document.querySelectorAll<HTMLElement>('.tweet-post[data-blog-post-id]').forEach((post) => {
            const postId = post.dataset.blogPostId?.trim();
            const views = post.querySelector<HTMLElement>('[data-blog-views]');
            const likes = post.querySelector<HTMLElement>('[data-blog-likes]');
            if (!postId || !blogApiBase) return;

            void (async () => {
                try {
                    const response = await fetch(`${blogApiBase}/metrics/${encodeURIComponent(postId)}`, {
                        headers: { Accept: 'application/json' },
                        signal: controller.signal,
                    });
                    if (!response.ok) throw new Error(`blog metrics ${response.status}`);
                    const metrics = await response.json() as { views?: number; likes?: number };
                    if (views) views.textContent = compact.format(Number(metrics.views ?? 0));
                    if (likes) likes.textContent = compact.format(Number(metrics.likes ?? 0));
                } catch {
                    if (controller.signal.aborted) return;
                    if (views) views.textContent = '—';
                    if (likes) likes.textContent = '—';
                }
            })();
        });
    };

    const initBlogSearch = (controller: AbortController) => {
        const root = document.querySelector<HTMLElement>('[data-blog-feed-root]');
        if (!root) return;

        const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-post-search]'));
        const emptyState = root.querySelector<HTMLElement>('[data-empty-state]');
        const search = root.querySelector<HTMLInputElement>('[data-blog-search]');
        if (!search) return;

        const normalize = (value: string) => value
            .normalize('NFKD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase();

        const apply = () => {
            const query = normalize(search.value.trim());
            let visible = 0;
            cards.forEach((card) => {
                const haystack = card.dataset.postSearch ?? '';
                const matches = !query || haystack.includes(query);
                card.hidden = !matches;
                if (matches) visible += 1;
            });
            if (emptyState) emptyState.hidden = visible > 0;
        };

        search.addEventListener('input', apply, { signal: controller.signal });
        apply();
    };

    const initPageLifecycle = () => {
        cleanupPageLifecycle();
        renderHeaderGreeting();

        const controller = new AbortController();
        const home = document.querySelector('.home-redesign');
        const blog = document.querySelector('[data-blog-feed-root]');

        if (home) {
            ensureEducationOverlay();
            ensureProfileLinks();
            initContributionTooltips(controller);
            initLowerSections(controller);

            if (homeWasSeen) {
                initPadangClock(controller);
                initExperienceOverflow(controller);
            }
            homeWasSeen = true;
        }

        if (blog) {
            if (blogWasSeen) initBlogSearch(controller);
            blogWasSeen = true;
        }

        cleanupCurrentPage = () => {
            controller.abort();
            document.querySelector('.analytics-floating-tooltip')?.remove();
            document.querySelector('.contribution-floating-tooltip')?.remove();
        };
    };

    const prepareInlineEngagementScripts = (event: Event) => {
        const nextDocument = (event as BeforeSwapEvent).newDocument;
        nextDocument?.querySelectorAll<HTMLScriptElement>('script[data-root-id^="engage-"]').forEach((script) => {
            script.setAttribute('data-astro-rerun', '');
        });
    };

    document.addEventListener('astro:page-load', initPageLifecycle);
    document.addEventListener('astro:before-swap', (event) => {
        cleanupPageLifecycle();
        prepareInlineEngagementScripts(event);
    });
</script>
