---
type SkillItem = {
    label: string;
    source: 'simple' | 'lobe';
    slug: string;
    color?: string;
    colorAsset?: boolean;
    scale?: number;
};

type SkillTrack = {
    label: string;
    direction: 'up' | 'down';
    items: SkillItem[];
};

const SIMPLE_ICONS_COMMIT = '7f18aaa676087b8240b6f4ff58a6720be282da59';
const LOBE_ICONS_COMMIT = 'c450bacad7a78b13470ab78da2d4d034cbb0c880';
const TARGET_SPEED = 14;
const ICON_PITCH = 42;

const simpleIconUrl = (slug: string) =>
    `https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@${SIMPLE_ICONS_COMMIT}/icons/${slug}.svg`;
const lobeIconUrl = (slug: string, color = false) =>
    `https://cdn.jsdelivr.net/gh/lobehub/lobe-icons@${LOBE_ICONS_COMMIT}/packages/static-svg/icons/${slug}${color ? '-color' : ''}.svg`;

const tracks: SkillTrack[] = [
    {
        label: 'Backend',
        direction: 'down',
        items: [
            { label: 'Go', source: 'simple', slug: 'go', color: '#00ADD8' },
            { label: 'Node.js', source: 'simple', slug: 'nodedotjs', color: '#5FA04E' },
            { label: 'Express', source: 'simple', slug: 'express', color: 'var(--text)' },
            { label: 'Fastify', source: 'simple', slug: 'fastify', color: 'var(--text)' },
            { label: 'Hono', source: 'simple', slug: 'hono', color: '#E36002' },
            { label: 'PostgreSQL', source: 'simple', slug: 'postgresql', color: '#4169E1' },
            { label: 'Redis', source: 'simple', slug: 'redis', color: '#FF4438' },
            { label: 'Prisma', source: 'simple', slug: 'prisma', color: '#5A67D8', scale: 0.92 },
        ],
    },
    {
        label: 'Frontend and mobile',
        direction: 'up',
        items: [
            { label: 'TypeScript', source: 'simple', slug: 'typescript', color: '#3178C6' },
            { label: 'React', source: 'simple', slug: 'react', color: '#61DAFB' },
            { label: 'Next.js', source: 'simple', slug: 'nextdotjs', color: 'var(--text)' },
            { label: 'Svelte', source: 'simple', slug: 'svelte', color: '#FF3E00' },
            { label: 'Astro', source: 'simple', slug: 'astro', color: '#BC52EE' },
            { label: 'Flutter', source: 'simple', slug: 'flutter', color: '#02569B', scale: 0.92 },
            { label: 'Kotlin', source: 'simple', slug: 'kotlin', color: '#7F52FF' },
            { label: 'Android', source: 'simple', slug: 'android', color: '#3DDC84' },
        ],
    },
    {
        label: 'Infrastructure',
        direction: 'down',
        items: [
            { label: 'Docker', source: 'simple', slug: 'docker', color: '#2496ED' },
            { label: 'GitHub Actions', source: 'simple', slug: 'githubactions', color: '#2088FF' },
            { label: 'Caddy', source: 'simple', slug: 'caddy', color: '#1F88C0' },
            { label: 'Cloudflare', source: 'simple', slug: 'cloudflare', color: '#F38020' },
            { label: 'Proxmox', source: 'simple', slug: 'proxmox', color: '#E57000' },
            { label: 'Linux', source: 'simple', slug: 'linux', color: '#FCC624' },
            { label: 'Microsoft Azure', source: 'simple', slug: 'microsoftazure', color: '#0078D4' },
            { label: 'Google Cloud', source: 'simple', slug: 'googlecloud', color: '#4285F4' },
            { label: 'NGINX', source: 'simple', slug: 'nginx', color: '#009639' },
            { label: 'Debian', source: 'simple', slug: 'debian', color: '#A81D33' },
            { label: 'Ubuntu', source: 'simple', slug: 'ubuntu', color: '#E95420' },
        ],
    },
    {
        label: 'AI tools',
        direction: 'up',
        items: [
            { label: 'ChatGPT', source: 'lobe', slug: 'openai', color: 'var(--text)' },
            { label: 'Codex', source: 'lobe', slug: 'codex', colorAsset: true },
            { label: 'Claude', source: 'lobe', slug: 'claude', colorAsset: true },
            { label: 'Claude Code', source: 'lobe', slug: 'claudecode', colorAsset: true, scale: 0.96 },
            { label: 'Antigravity', source: 'lobe', slug: 'antigravity', colorAsset: true },
            { label: 'OpenCode', source: 'lobe', slug: 'opencode', color: 'var(--text)' },
            { label: 'Cursor', source: 'lobe', slug: 'cursor', color: 'var(--text)' },
            { label: 'GitHub Copilot', source: 'lobe', slug: 'githubcopilot', color: 'var(--text)', scale: 1.04 },
        ],
    },
];

const monoUrl = (item: SkillItem) => item.source === 'lobe' ? lobeIconUrl(item.slug) : simpleIconUrl(item.slug);
const colorUrl = (item: SkillItem) => item.source === 'lobe' && item.colorAsset ? lobeIconUrl(item.slug, true) : null;
const durationFor = (itemCount: number) => `${Math.round((itemCount * ICON_PITCH) / TARGET_SPEED)}s`;
---

<div class="skill-waterfall" aria-label="Technology stack">
    {tracks.map((track) => (
        <div
            class:list={['skill-column', `is-${track.direction}`]}
            style={`--track-duration:${durationFor(track.items.length)}`}
            aria-label={track.label}
        >
            <div class="skill-track">
                {[0, 1].map(() => (
                    <div class="skill-sequence" aria-hidden="true">
                        {track.items.map((item) => {
                            const coloredAsset = colorUrl(item);
                            return (
                                <span
                                    class:list={['skill-item', coloredAsset && 'has-color-asset']}
                                    data-skill-label={item.label}
                                    style={`--skill-icon:url('${monoUrl(item)}');--brand-color:${item.color ?? 'var(--text)'};--icon-scale:${item.scale ?? 1}`}
                                >
                                    <span class="skill-mono" aria-hidden="true" />
                                    {coloredAsset && (
                                        <img
                                            class="skill-color"
                                            src={coloredAsset}
                                            width="20"
                                            height="20"
                                            alt=""
                                            loading="lazy"
                                            decoding="async"
                                            aria-hidden="true"
                                        />
                                    )}
                                    <span class="sr-only">{item.label}</span>
                                </span>
                            );
                        })}
                    </div>
                ))}
            </div>
        </div>
    ))}
</div>

<style>
    .skill-waterfall {
        --skill-size: 30px;
        --skill-gap: 12px;
        width: 100%;
        height: 100%;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 8%, #000 92%, transparent 100%);
        mask-image: linear-gradient(to bottom, transparent 0, #000 8%, #000 92%, transparent 100%);
    }

    .skill-column {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .skill-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        will-change: transform;
        animation-duration: var(--track-duration);
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .is-up .skill-track {
        animation-name: waterfall-up;
    }

    .is-down .skill-track {
        animation-name: waterfall-down;
    }

    .skill-sequence {
        display: grid;
        justify-items: center;
        gap: var(--skill-gap);
        padding-bottom: var(--skill-gap);
    }

    .skill-item {
        position: relative;
        width: var(--skill-size);
        height: var(--skill-size);
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--muted) 80%, transparent);
        cursor: default;
    }

    .skill-mono,
    .skill-color {
        grid-area: 1 / 1;
        width: 19px;
        height: 19px;
        display: block;
        transform: scale(var(--icon-scale));
        transform-origin: center;
        transition: opacity 140ms ease, color 140ms ease, transform 140ms ease;
    }

    .skill-mono {
        color: currentColor;
        background: currentColor;
        -webkit-mask: var(--skill-icon) center / contain no-repeat;
        mask: var(--skill-icon) center / contain no-repeat;
    }

    .skill-color {
        object-fit: contain;
        opacity: 0;
    }

    .skill-item:hover {
        color: var(--brand-color);
    }

    .skill-item:hover .skill-mono {
        transform: scale(calc(var(--icon-scale) * 1.08));
    }

    .skill-item.has-color-asset:hover .skill-mono {
        opacity: 0;
    }

    .skill-item.has-color-asset:hover .skill-color {
        opacity: 1;
        transform: scale(calc(var(--icon-scale) * 1.08));
    }

    .skill-column:hover .skill-track {
        animation-play-state: paused;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @keyframes waterfall-up {
        from { transform: translateY(0); }
        to { transform: translateY(-50%); }
    }

    @keyframes waterfall-down {
        from { transform: translateY(-50%); }
        to { transform: translateY(0); }
    }

    :global(.skill-floating-tooltip) {
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        padding: 4px 7px;
        border: 1px solid var(--border-strong);
        border-radius: 5px;
        background: color-mix(in srgb, var(--surface) 96%, var(--bg));
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 10px;
        line-height: 1.2;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, calc(-100% - 7px));
        transition: opacity 120ms ease, transform 120ms ease;
    }

    :global(.skill-floating-tooltip.is-visible) {
        opacity: 1;
        transform: translate(-50%, calc(-100% - 10px));
    }

    @media (max-height: 859px) {
        .skill-waterfall {
            --skill-size: 26px;
            --skill-gap: 8px;
            gap: 8px;
        }

        .skill-mono,
        .skill-color {
            width: 17px;
            height: 17px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skill-track {
            animation: none;
            transform: none !important;
        }

        .skill-sequence:nth-child(2) {
            display: none;
        }
    }
</style>

<script>
    const tooltipClass = 'skill-floating-tooltip';
    let tooltip = document.querySelector<HTMLElement>(`.${tooltipClass}`);

    if (!tooltip) {
        tooltip = document.createElement('div');
        tooltip.className = tooltipClass;
        tooltip.setAttribute('role', 'tooltip');
        document.body.appendChild(tooltip);
    }

    const hideTooltip = () => tooltip?.classList.remove('is-visible');

    document.querySelectorAll<HTMLElement>('[data-skill-label]').forEach((item) => {
        if (item.dataset.tooltipReady === 'true') return;
        item.dataset.tooltipReady = 'true';

        item.addEventListener('pointerenter', () => {
            if (!tooltip) return;
            const label = item.dataset.skillLabel;
            if (!label) return;

            tooltip.textContent = label;
            tooltip.style.left = '0px';
            tooltip.style.top = '0px';
            tooltip.classList.add('is-visible');

            const rect = item.getBoundingClientRect();
            const tooltipRect = tooltip.getBoundingClientRect();
            const half = tooltipRect.width / 2;
            const left = Math.max(8 + half, Math.min(window.innerWidth - 8 - half, rect.left + rect.width / 2));
            const top = Math.max(tooltipRect.height + 12, rect.top);

            tooltip.style.left = `${left}px`;
            tooltip.style.top = `${top}px`;
        });

        item.addEventListener('pointerleave', hideTooltip);
    });

    window.addEventListener('blur', hideTooltip);
</script>
