const openAiPath = 'M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z';
---

<div class="skill-waterfall" aria-label="Technology stack">
    {tracks.map((track) => (
        <div
            class:list={['skill-column', `is-${track.direction}`]}
            style={`--track-duration:${track.duration}`}
            aria-label={track.label}
        >
            <div class="skill-track">
                {[0, 1].map(() => (
                    <div class="skill-sequence" aria-hidden="true">
                        {track.items.map((item) => (
                            <span class="skill-item" title={item.label}>
                                {item.inline === 'openai' ? (
                                    <svg class="skill-svg" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d={openAiPath} />
                                    </svg>
                                ) : (
                                    <span
                                        class="skill-mask"
                                        style={`--skill-icon:url('${iconUrl(item.slug!)}')`}
                                        aria-hidden="true"
                                    />
                                )}
                                <span class="sr-only">{item.label}</span>
                            </span>
                        ))}
                    </div>
                ))}
            </div>
        </div>
    ))}
</div>

<style>
    .skill-waterfall {
        --skill-size: 30px;
        --skill-gap: 12px;
        --seam-fix: 6px;
        width: 100%;
        height: 100%;
        min-height: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 8%, #000 92%, transparent 100%);
        mask-image: linear-gradient(to bottom, transparent 0, #000 8%, #000 92%, transparent 100%);
    }

    .skill-column {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .skill-track {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--skill-gap);
        will-change: transform;
        animation-duration: var(--track-duration);
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .is-up .skill-track {
        animation-name: waterfall-up;
    }

    .is-down .skill-track {
        animation-name: waterfall-down;
    }

    .skill-sequence {
        display: grid;
        justify-items: center;
        gap: var(--skill-gap);
    }

    .skill-item {
        width: var(--skill-size);
        height: var(--skill-size);
        display: grid;
        place-items: center;
        color: color-mix(in srgb, var(--muted) 82%, transparent);
        transition: color 140ms ease, transform 140ms ease;
    }

    .skill-item:hover {
        color: var(--text);
        transform: scale(1.08);
    }

    .skill-mask,
    .skill-svg {
        width: 18px;
        height: 18px;
        display: block;
    }

    .skill-mask {
        background: currentColor;
        -webkit-mask: var(--skill-icon) center / contain no-repeat;
        mask: var(--skill-icon) center / contain no-repeat;
    }

    .skill-svg {
        fill: currentColor;
    }

    .skill-waterfall:hover .skill-track {
        animation-play-state: paused;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @keyframes waterfall-up {
        from { transform: translateY(0); }
        to { transform: translateY(calc(-50% - var(--seam-fix))); }
    }

    @keyframes waterfall-down {
        from { transform: translateY(calc(-50% - var(--seam-fix))); }
        to { transform: translateY(0); }
    }

    @media (max-height: 859px) {
        .skill-waterfall {
            --skill-size: 26px;
            --skill-gap: 8px;
            --seam-fix: 4px;
            gap: 8px;
        }

        .skill-mask,
        .skill-svg {
            width: 16px;
            height: 16px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skill-track {
            animation: none;
            transform: none !important;
        }

        .skill-sequence:nth-child(2) {
            display: none;
        }
    }
</style>
