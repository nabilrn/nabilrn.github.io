const iconUrl = (slug: string) => `https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@${SIMPLE_ICONS_COMMIT}/icons/${slug}.svg`;

const tracks: SkillTrack[] = [
    {
        label: 'Backend',
        direction: 'down',
        duration: '26s',
        items: [
            { label: 'Go', slug: 'go' },
            { label: 'Node.js', slug: 'nodedotjs' },
            { label: 'Express', slug: 'express' },
            { label: 'Fastify', slug: 'fastify' },
            { label: 'Hono', slug: 'hono' },
            { label: 'PostgreSQL', slug: 'postgresql' },
            { label: 'Redis', slug: 'redis' },
            { label: 'Prisma', slug: 'prisma' },
        ],
    },
    {
        label: 'Frontend and mobile',
        direction: 'up',
        duration: '23s',
        items: [
            { label: 'TypeScript', slug: 'typescript' },
            { label: 'React', slug: 'react' },
            { label: 'Next.js', slug: 'nextdotjs' },
            { label: 'Svelte', slug: 'svelte' },
            { label: 'Astro', slug: 'astro' },
            { label: 'Flutter', slug: 'flutter' },
            { label: 'Kotlin', slug: 'kotlin' },
            { label: 'Android', slug: 'android' },
        ],
    },
    {
        label: 'Infrastructure',
        direction: 'down',
        duration: '28s',
        items: [
            { label: 'Docker', slug: 'docker' },
            { label: 'GitHub Actions', slug: 'githubactions' },
            { label: 'Caddy', slug: 'caddy' },
            { label: 'Cloudflare', slug: 'cloudflare' },
            { label: 'Proxmox', slug: 'proxmox' },
            { label: 'Linux', slug: 'linux' },
            { label: 'Microsoft Azure', slug: 'microsoftazure' },
            { label: 'Google Cloud', slug: 'googlecloud' },
        ],
    },
    {
        label: 'AI tools',
        direction: 'up',
        duration: '24s',
        items: [
            { label: 'ChatGPT', inline: 'openai' },
            { label: 'Codex', inline: 'openai' },
            { label: 'Claude', slug: 'anthropic' },
            { label: 'Claude Code', slug: 'anthropic' },
            { label: 'Google Antigravity', slug: 'google' },
            { label: 'OpenCode', slug: 'opencode' },
            { label: 'Cursor', slug: 'cursor' },
            { label: 'GitHub Copilot', slug: 'githubcopilot' },
        ],
    },
