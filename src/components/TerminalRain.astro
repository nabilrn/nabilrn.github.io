<canvas id="term-rain" aria-hidden="true"></canvas>

<style>
    #term-rain {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: 0.55;
    }
</style>

<script is:inline>
    (() => {
        const canvas = document.getElementById('term-rain');
        if (!canvas) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            canvas.remove();
            return;
        }
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const CHARS = 'ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉ0123456789<>/\\{}[]$#*+=~:;';
        const FONT = 15;
        const STEP = 75; /* ms between rain steps */

        let w = 0, h = 0, cols = 0;
        let drops = [], speeds = [];
        let fontFamily = 'monospace';

        let bg = '#0a0a0a';
        let head = 'rgba(255,255,255,0.95)';
        let isLight = false;

        const readTheme = () => {
            const cs = getComputedStyle(document.documentElement);
            bg = (cs.getPropertyValue('--bg') || '#0a0a0a').trim() || '#0a0a0a';
            const mono = cs.getPropertyValue('--font-mono').trim();
            if (mono) fontFamily = mono;
            isLight = document.documentElement.dataset.theme === 'light';
            head = isLight ? 'rgba(10,10,10,0.85)' : 'rgba(255,255,255,0.95)';
        };
        readTheme();
        new MutationObserver(readTheme).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['data-theme'],
        });

        const paintBase = () => {
            ctx.fillStyle = bg;
            ctx.globalAlpha = 1;
            ctx.fillRect(0, 0, w, h);
        };

        const resize = () => {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = window.innerWidth;
            h = window.innerHeight;
            canvas.width = Math.floor(w * dpr);
            canvas.height = Math.floor(h * dpr);
            canvas.style.width = w + 'px';
            canvas.style.height = h + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.font = FONT + 'px ' + fontFamily;
            ctx.textBaseline = 'top';
            cols = Math.ceil(w / FONT);
            drops = Array.from({ length: cols }, () => Math.floor((Math.random() * -h) / FONT));
            speeds = Array.from({ length: cols }, () => 0.45 + Math.random() * 0.75);
            paintBase();
        };
        resize();
        window.addEventListener('resize', resize);

        /* occasional subtle lightning flash */
        let flash = 0;
        const scheduleFlash = () => {
            window.setTimeout(() => {
                flash = 0.04 + Math.random() * 0.05;
                scheduleFlash();
            }, 9000 + Math.random() * 14000);
        };
        scheduleFlash();

        let last = 0;
        let acc = 0;
        const frame = (now) => {
            requestAnimationFrame(frame);
            if (!last) last = now;
            acc += now - last;
            last = now;
            if (acc < STEP) return;
            acc %= STEP;

            /* fade previous frame -> leaves the falling trail */
            ctx.globalAlpha = 0.085;
            ctx.fillStyle = bg;
            ctx.fillRect(0, 0, w, h);
            ctx.globalAlpha = 1;

            /* lightning decay */
            if (flash > 0.002) {
                ctx.fillStyle = isLight
                    ? 'rgba(10,10,10,' + flash.toFixed(3) + ')'
                    : 'rgba(255,255,255,' + flash.toFixed(3) + ')';
                ctx.fillRect(0, 0, w, h);
                flash *= 0.7;
            }

            ctx.fillStyle = head;
            for (let i = 0; i < cols; i++) {
                if (Math.random() < speeds[i]) drops[i]++;
                const y = drops[i] * FONT;
                if (y > 0 && y < h + FONT) {
                    ctx.fillText(CHARS[(Math.random() * CHARS.length) | 0], i * FONT, y);
                }
                if (y > h && Math.random() > 0.975) {
                    drops[i] = Math.floor(Math.random() * -20);
                }
            }
        };
        requestAnimationFrame(frame);
    })();
</script>
