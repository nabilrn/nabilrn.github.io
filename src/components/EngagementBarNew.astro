---
import Icon from './Icon.astro';
import { getSiteContent, normalizeLocale, type SiteLocale } from '../data/siteContent';

interface Props {
	postId: string;
	title: string;
	variant?: 'inline' | 'floating';
	locale?: SiteLocale;
}

const { postId, title, variant = 'inline', locale: rawLocale } = Astro.props;
const fallbackApiBase = import.meta.env.PROD
	? 'https://portfolio-metrics-api.nabilrizkinavisa.workers.dev'
	: '';
const apiBase = import.meta.env.PUBLIC_ENGAGEMENT_API_BASE?.trim() || fallbackApiBase;
const rootId = `engage-${postId}`;
const content = getSiteContent(normalizeLocale(rawLocale)).engagement;
---

<div id={rootId} class={`engage ${variant === 'floating' ? 'floating' : 'inline'}`} data-post-id={postId} data-api-base={apiBase} data-title={title} aria-live="polite">
	<div class="engage-stats">
		<span class="engage-stat" title="Views"><Icon name="views" /> <strong data-views>0</strong></span>
		<span class="engage-stat" title="Likes"><Icon name="heart" /> <strong data-likes>0</strong></span>
		<span class="engage-stat" title="Shares"><Icon name="share" /> <strong data-shares>0</strong></span>
	</div>
	<div class="engage-actions">
		<button class="engage-btn" aria-label={content.likePost} data-like-btn><Icon name="heart" /> <span class="label">{content.like}</span></button>
		<button class="engage-btn" data-share-btn="copy" aria-label={content.copyLink}><Icon name="copy" /> <span class="label">{content.copy}</span></button>
	</div>
</div>
<div id={`${rootId}-toast`} aria-hidden="true" class="toast"></div>

<style>
	.engage {
		display: flex;
		align-items: center;
		gap: 0;
		border: 1px solid var(--border);
		border-radius: 0;
		background: transparent;
	}

	.engage-stats,
	.engage-actions {
		display: flex;
		align-items: stretch;
	}

	.engage-stat,
	.engage-btn {
		min-height: 34px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 9px;
		color: var(--muted);
	}

	.engage-stat {
		padding: 0 9px;
		border-right: 1px solid var(--border);
	}

	.engage-stat strong {
		color: var(--text);
		font-weight: 500;
	}

	.engage-actions {
		margin-left: auto;
	}

	.engage-btn {
		padding: 0 10px;
		border: 0;
		border-left: 1px solid var(--border);
		border-radius: 0;
		background: transparent;
		cursor: pointer;
		transition: background 140ms ease, color 140ms ease;
	}

	.engage-btn:hover,
	.engage-btn:focus-visible {
		background: var(--surface);
		color: var(--text);
		outline: none;
	}

	.engage-btn:focus-visible {
		box-shadow: inset 0 0 0 1px var(--text);
	}

	.engage-btn.liked {
		color: var(--text);
		background: color-mix(in srgb, var(--surface) 78%, transparent);
	}

	.engage.floating {
		width: 100%;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		border: 0;
		background: transparent;
	}

	.engage.floating .engage-stats,
	.engage.floating .engage-actions {
		display: grid;
		grid-template-columns: 1fr;
		margin: 0;
	}

	.engage.floating .engage-stat,
	.engage.floating .engage-btn {
		min-height: 42px;
		padding: 7px 0;
		border: 0;
		border-bottom: 1px solid var(--border);
		flex-direction: column;
		gap: 4px;
	}

	.engage.floating .engage-stat:first-child {
		border-top: 1px solid var(--border);
	}

	.engage.floating .engage-btn {
		width: 100%;
	}

	.engage.floating .engage-btn .label {
		display: none;
	}

	@media (max-width: 820px) {
		.engage.floating {
			display: grid;
			grid-template-columns: 3fr 2fr;
			border: 1px solid var(--border);
		}

		.engage.floating .engage-stats {
			grid-template-columns: repeat(3, 1fr);
		}

		.engage.floating .engage-actions {
			grid-template-columns: repeat(2, 1fr);
			border-left: 1px solid var(--border);
		}

		.engage.floating .engage-stat,
		.engage.floating .engage-btn {
			min-height: 38px;
			padding: 0 6px;
			border: 0;
			border-right: 1px solid var(--border);
			flex-direction: row;
		}

		.engage.floating .engage-stat:first-child {
			border-top: 0;
		}

		.engage.floating .engage-stat:last-child,
		.engage.floating .engage-btn:last-child {
			border-right: 0;
		}
	}
</style>

<script
	is:inline
	data-root-id={rootId}
	data-link-copied-message={content.linkCopied}
	data-copied-message={content.copied}
>
	const script = document.currentScript;
	const rootId = script?.dataset.rootId || '';
	const linkCopiedMessage = script?.dataset.linkCopiedMessage || 'Link copied';
	const copiedMessage = script?.dataset.copiedMessage || 'Copied';
	const root = rootId ? document.getElementById(rootId) : null;
	(function () {
		const el = root;
		if (!el) return;
		const pid = el.dataset.postId;
		const api = el.dataset.apiBase || '';
		const viewsEl = el.querySelector('[data-views]');
		const likesEl = el.querySelector('[data-likes]');
		const sharesEl = el.querySelector('[data-shares]');
		const likeBtn = el.querySelector('[data-like-btn]');
		const shareBtns = el.querySelectorAll('[data-share-btn]');
		const toastId = `${rootId}-toast`;
		const visitorKey = 'portfolio:visitor-id';

		function getVisitor() {
			let visitor = localStorage.getItem(visitorKey);
			if (visitor) return visitor;
			visitor = crypto.randomUUID();
			localStorage.setItem(visitorKey, visitor);
			return visitor;
		}

		const visitor = getVisitor();

		async function fetchApi(body) {
			const endpoint = api.replace(/\/$/, '') + '/metrics/' + encodeURIComponent(pid);
			const res = body
				? await fetch(endpoint, {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify(body),
				  })
				: await fetch(endpoint);
			if (!res.ok) throw new Error('bad');
			return await res.json();
		}

		function setCounts(metrics) {
			if (viewsEl) viewsEl.textContent = metrics.views;
			if (likesEl) likesEl.textContent = metrics.likes;
			if (sharesEl) sharesEl.textContent = metrics.shares;
		}

		function showToast(msg) {
			let toast = document.getElementById(toastId);
			if (!toast) {
				toast = document.createElement('div');
				toast.id = toastId;
				document.body.appendChild(toast);
			}
			toast.textContent = msg;
			toast.style.position = 'fixed';
			toast.style.right = '1rem';
			toast.style.bottom = '1.25rem';
			toast.style.background = 'var(--bg)';
			toast.style.color = 'var(--text)';
			toast.style.padding = '7px 11px';
			toast.style.borderRadius = '0';
			toast.style.border = '1px solid var(--border-strong)';
			toast.style.fontFamily = 'var(--font-mono)';
			toast.style.fontSize = '9px';
			toast.style.textTransform = 'uppercase';
			toast.style.letterSpacing = '0.05em';
			toast.style.opacity = '1';
			toast.style.transition = 'opacity 0.15s ease';
			setTimeout(() => {
				try { toast.style.opacity = '0'; } catch {}
			}, 2000);
		}

		(async () => {
			try {
				if (api) {
					const metrics = await fetchApi();
					setCounts(metrics);
					if (metrics.liked) likeBtn?.classList.add('liked');
				}
			} catch {}

			try {
				if (api) {
					const metrics = await fetchApi({ action: 'view', visitorId: visitor });
					setCounts(metrics);
				}
			} catch {}

			if (!api) {
				const key = 'portfolio:views:' + pid;
				let views = Number(localStorage.getItem(key) || '0');
				const seenKey = 'portfolio:viewed-once:' + pid;
				if (!localStorage.getItem(seenKey)) {
					views++;
					localStorage.setItem(key, String(views));
					localStorage.setItem(seenKey, '1');
				}
				if (viewsEl) viewsEl.textContent = String(views);
			}
		})();

		likeBtn?.addEventListener('click', async () => {
			try {
				if (api) {
					const metrics = await fetchApi({ action: 'like', visitorId: visitor });
					setCounts(metrics);
					likeBtn.classList.toggle('liked', !!metrics.liked);
					return;
				}
			} catch {}

			const likesKey = 'portfolio:likes:' + pid;
			const likedKey = 'portfolio:liked:' + pid;
			let count = Number(localStorage.getItem(likesKey) || '0');
			let liked = localStorage.getItem(likedKey) === '1';
			liked = !liked;
			count = liked ? count + 1 : Math.max(0, count - 1);
			localStorage.setItem(likesKey, String(count));
			localStorage.setItem(likedKey, liked ? '1' : '0');
			if (likesEl) likesEl.textContent = String(count);
			likeBtn.classList.toggle('liked', liked);
		});

		shareBtns.forEach((button) =>
			button.addEventListener('click', async () => {
				const mode = button.dataset.shareBtn;
				const url = window.location.href;
				try {
					if (mode === 'copy') {
						await navigator.clipboard.writeText(url);
						showToast(linkCopiedMessage);
					}
					if (api) {
						await fetchApi({ action: 'share' });
						const metrics = await fetchApi();
						setCounts(metrics);
						return;
					}
				} catch {
					showToast(copiedMessage);
				}
				const sharesKey = 'portfolio:shares:' + pid;
				let count = Number(localStorage.getItem(sharesKey) || '0');
				count++;
				localStorage.setItem(sharesKey, String(count));
				if (sharesEl) sharesEl.textContent = String(count);
			})
		);
	})();
</script>
