---
import Icon from './Icon.astro';
import { getSiteContent, normalizeLocale, type SiteLocale } from '../data/siteContent';

interface Props {
	postId: string;
	title: string;
	variant?: 'inline' | 'floating' | 'feed';
	locale?: SiteLocale;
	trackView?: boolean;
}

const {
	postId,
	title,
	variant = 'inline',
	locale: rawLocale,
	trackView = true,
} = Astro.props;
const locale = normalizeLocale(rawLocale);
const fallbackApiBase = import.meta.env.PROD
	? 'https://portfolio-metrics-api.nabilrizkinavisa.workers.dev'
	: '';
const apiBase = import.meta.env.PUBLIC_ENGAGEMENT_API_BASE?.trim() || fallbackApiBase;
const rootId = `engage-${postId}`;
const dialogTitleId = `${rootId}-share-title`;
const content = getSiteContent(locale).engagement;
const shareCopy = locale === 'id'
	? {
		share: 'Bagikan',
		shareTitle: 'Bagikan tulisan',
		copy: 'Salin',
		copied: 'Tersalin',
		close: 'Tutup dialog bagikan',
		link: 'Tautan tulisan',
		platformPrefix: 'Bagikan ke',
		more: 'Lainnya',
		shared: 'Dibagikan',
	}
	: {
		share: 'Share',
		shareTitle: 'Share this post',
		copy: 'Copy',
		copied: 'Copied',
		close: 'Close share dialog',
		link: 'Post link',
		platformPrefix: 'Share on',
		more: 'More',
		shared: 'Shared',
	};
---

<div
	id={rootId}
	class={`engage ${variant}`}
	data-post-id={postId}
	data-api-base={apiBase}
	data-title={title}
	data-track-view={String(trackView)}
>
	<span class="engage-item view-item" title="Views" aria-label="Views">
		<Icon name="views" />
		<strong data-views>0</strong>
	</span>

	<button
		class="engage-item engage-action like-action"
		type="button"
		aria-label={content.likePost}
		aria-pressed="false"
		data-like-btn
	>
		<span class="heart-shell" aria-hidden="true"><Icon name="heart" /></span>
		<strong data-likes>0</strong>
	</button>

	<button
		class="engage-item engage-action share-action"
		type="button"
		aria-label={shareCopy.share}
		aria-haspopup="dialog"
		aria-expanded="false"
		data-share-trigger
	>
		<Icon name="share" />
		<strong data-shares>0</strong>
	</button>
</div>

<div class="share-backdrop" data-share-dialog hidden>
	<section
		class="share-dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby={dialogTitleId}
		tabindex="-1"
	>
		<header class="share-dialog-header">
			<h2 id={dialogTitleId}>{shareCopy.shareTitle}</h2>
			<button type="button" class="share-close" aria-label={shareCopy.close} data-share-close>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M6 6l12 12M18 6 6 18" />
				</svg>
			</button>
		</header>

		<div class="share-platforms" aria-label={shareCopy.share}>
			<a
				class="platform-action whatsapp"
				href="#"
				target="_blank"
				rel="noopener noreferrer"
				data-share-platform="whatsapp"
				data-tooltip={`${shareCopy.platformPrefix} WhatsApp`}
				aria-label={`${shareCopy.platformPrefix} WhatsApp`}
			>
				<span class="platform-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M12.04 2a9.75 9.75 0 0 0-8.31 14.85L2.4 21.7l4.96-1.3A9.78 9.78 0 1 0 12.04 2Zm0 17.78a8 8 0 0 1-4.08-1.12l-.29-.17-2.94.77.79-2.87-.19-.3a8.02 8.02 0 1 1 6.71 3.69Zm4.4-5.99c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19a7.23 7.23 0 0 1-1.33-1.65c-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.69 2.58 4.1 3.62.57.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.43-.58 1.63-1.15.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" /></svg>
				</span>
				<span>WhatsApp</span>
			</a>

			<a
				class="platform-action x-platform"
				href="#"
				target="_blank"
				rel="noopener noreferrer"
				data-share-platform="x"
				data-tooltip={`${shareCopy.platformPrefix} X`}
				aria-label={`${shareCopy.platformPrefix} X`}
			>
				<span class="platform-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.37l7.25-8.29L2.98 2h6.4l4.42 5.84L18.9 2Zm-1.09 17.84h1.72L8.44 4.05H6.6l11.21 15.79Z" /></svg>
				</span>
				<span>X</span>
			</a>

			<a
				class="platform-action linkedin"
				href="#"
				target="_blank"
				rel="noopener noreferrer"
				data-share-platform="linkedin"
				data-tooltip={`${shareCopy.platformPrefix} LinkedIn`}
				aria-label={`${shareCopy.platformPrefix} LinkedIn`}
			>
				<span class="platform-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M5.34 3.5A1.84 1.84 0 1 1 5.33 7.2a1.84 1.84 0 0 1 .01-3.69ZM3.75 8.65h3.18V20H3.75V8.65Zm5.16 0h3.05v1.55H12c.43-.81 1.49-1.88 3.55-1.88 3.8 0 4.5 2.5 4.5 5.76V20h-3.18v-5.25c0-1.25-.02-2.87-1.75-2.87-1.75 0-2.02 1.37-2.02 2.78V20H8.91V8.65Z" /></svg>
				</span>
				<span>LinkedIn</span>
			</a>

			<a
				class="platform-action facebook"
				href="#"
				target="_blank"
				rel="noopener noreferrer"
				data-share-platform="facebook"
				data-tooltip={`${shareCopy.platformPrefix} Facebook`}
				aria-label={`${shareCopy.platformPrefix} Facebook`}
			>
				<span class="platform-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M13.7 22v-8.7h2.92l.44-3.39H13.7V7.75c0-.98.27-1.65 1.68-1.65h1.8V3.07c-.31-.04-1.38-.13-2.62-.13-2.59 0-4.36 1.58-4.36 4.49v2.5H7.27v3.39h2.93V22h3.5Z" /></svg>
				</span>
				<span>Facebook</span>
			</a>

			<a
				class="platform-action telegram"
				href="#"
				target="_blank"
				rel="noopener noreferrer"
				data-share-platform="telegram"
				data-tooltip={`${shareCopy.platformPrefix} Telegram`}
				aria-label={`${shareCopy.platformPrefix} Telegram`}
			>
				<span class="platform-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="m21.56 3.27-3.07 14.46c-.23 1.02-.83 1.27-1.68.79l-4.67-3.44-2.25 2.17c-.25.25-.46.46-.94.46l.33-4.75 8.65-7.82c.38-.34-.08-.53-.58-.19L6.66 11.68 2.05 10.2c-1-.31-1.02-1 .21-1.48l18.01-6.94c.84-.3 1.57.2 1.29 1.49Z" /></svg>
				</span>
				<span>Telegram</span>
			</a>

			<button
				type="button"
				class="platform-action native-share"
				data-native-share
				data-tooltip={shareCopy.more}
				aria-label={shareCopy.more}
				hidden
			>
				<span class="platform-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" fill="none"><path d="M12 3v12M7.5 7.5 12 3l4.5 4.5M5 12.5V20h14v-7.5" /></svg>
				</span>
				<span>{shareCopy.more}</span>
			</button>
		</div>

		<div class="copy-link-row">
			<input type="text" readonly value="" aria-label={shareCopy.link} data-share-url />
			<button type="button" data-share-copy>{shareCopy.copy}</button>
		</div>
	</section>
</div>

<div id={`${rootId}-toast`} class="engage-toast" role="status" aria-live="polite"></div>

<style>
	.engage {
		display: flex;
		align-items: center;
		gap: 6px;
		width: max-content;
		max-width: 100%;
		color: var(--muted);
	}

	.engage-item {
		min-width: 42px;
		height: 34px;
		padding: 0 9px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1;
	}

	.engage-item strong {
		font: inherit;
		font-weight: 500;
		color: inherit;
	}

	.engage-action {
		cursor: pointer;
		transition: color 130ms ease, background 130ms ease, transform 130ms ease;
	}

	.engage-action:hover,
	.engage-action:focus-visible {
		color: var(--text);
		background: color-mix(in srgb, var(--surface-2) 72%, transparent);
		outline: none;
	}

	.engage-action:focus-visible {
		box-shadow: 0 0 0 1px var(--border-strong);
	}

	.heart-shell {
		position: relative;
		display: grid;
		place-items: center;
		width: 18px;
		height: 18px;
		isolation: isolate;
	}

	.like-action.liked {
		color: #f91880;
	}

	:global(.like-action.liked .heart-shell svg path) {
		fill: currentColor;
		stroke: currentColor;
	}

	.like-action.bursting .heart-shell {
		animation: heart-pop 430ms cubic-bezier(.2, .9, .25, 1.35);
	}

	.like-action.bursting .heart-shell::before,
	.like-action.bursting .heart-shell::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		pointer-events: none;
	}

	.like-action.bursting .heart-shell::before {
		width: 25px;
		height: 25px;
		border: 1.5px solid #f91880;
		border-radius: 50%;
		transform: translate(-50%, -50%) scale(.45);
		animation: heart-ring 430ms ease-out forwards;
		z-index: -1;
	}

	.like-action.bursting .heart-shell::after {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: #f91880;
		box-shadow:
			0 -12px #f91880,
			10px -7px #f91880,
			12px 4px #f91880,
			6px 11px #f91880,
			-6px 11px #f91880,
			-12px 4px #f91880,
			-10px -7px #f91880;
		transform: translate(-50%, -50%) scale(.35);
		animation: heart-particles 430ms ease-out forwards;
		z-index: -1;
	}

	.share-backdrop {
		position: fixed;
		inset: 0;
		z-index: 140;
		padding: 18px;
		display: grid;
		place-items: center;
		background: rgb(0 0 0 / 48%);
		backdrop-filter: blur(3px);
	}

	.share-backdrop[hidden] { display: none; }

	.share-dialog {
		width: min(520px, 100%);
		max-height: min(560px, calc(100vh - 36px));
		overflow: visible;
		border: 1px solid var(--border-strong);
		border-radius: 10px;
		background: var(--bg);
		box-shadow: 0 20px 70px rgb(0 0 0 / 24%);
		color: var(--text);
	}

	.share-dialog:focus { outline: none; }

	.share-dialog-header {
		height: 54px;
		padding: 0 14px 0 18px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}

	.share-dialog-header h2 {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 15px;
		font-weight: 650;
		letter-spacing: -0.015em;
	}

	.share-close {
		width: 32px;
		height: 32px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}

	.share-close:hover,
	.share-close:focus-visible {
		background: var(--surface-2);
		color: var(--text);
		outline: none;
	}

	.share-close svg {
		width: 17px;
		height: 17px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
	}

	.share-platforms {
		padding: 22px 18px 18px;
		display: grid;
		grid-template-columns: repeat(6, minmax(58px, 1fr));
		gap: 10px;
		border-bottom: 1px solid var(--border);
	}

	.platform-action {
		--brand: var(--text);
		position: relative;
		min-width: 0;
		padding: 0;
		display: grid;
		justify-items: center;
		gap: 7px;
		border: 0;
		background: transparent;
		color: var(--muted);
		font-family: var(--font-sans);
		font-size: 10px;
		line-height: 1.2;
		text-decoration: none;
		cursor: pointer;
	}

	.platform-action.whatsapp { --brand: #25d366; }
	.platform-action.linkedin { --brand: #0a66c2; }
	.platform-action.facebook { --brand: #1877f2; }
	.platform-action.telegram { --brand: #229ed9; }

	.platform-icon {
		width: 48px;
		height: 48px;
		display: grid;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		color: var(--muted);
		filter: grayscale(1);
		opacity: .72;
		transition:
			color 150ms ease,
			border-color 150ms ease,
			background 150ms ease,
			filter 150ms ease,
			opacity 150ms ease,
			transform 150ms ease;
	}

	.platform-icon svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
	}

	.native-share .platform-icon svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.platform-action:hover,
	.platform-action:focus-visible {
		color: var(--text);
		outline: none;
	}

	.platform-action:hover .platform-icon,
	.platform-action:focus-visible .platform-icon {
		color: var(--brand);
		border-color: color-mix(in srgb, var(--brand) 40%, var(--border));
		background: color-mix(in srgb, var(--brand) 8%, var(--surface));
		filter: none;
		opacity: 1;
		transform: translateY(-2px);
	}

	.platform-action::after {
		content: attr(data-tooltip);
		position: absolute;
		left: 50%;
		bottom: calc(100% + 8px);
		z-index: 3;
		max-width: 150px;
		padding: 5px 7px;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 10px;
		line-height: 1.2;
		white-space: nowrap;
		opacity: 0;
		transform: translate(-50%, 3px);
		pointer-events: none;
		transition: opacity 120ms ease, transform 120ms ease;
	}

	.platform-action:hover::after,
	.platform-action:focus-visible::after {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.copy-link-row {
		padding: 14px 18px 18px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 8px;
	}

	.copy-link-row input {
		min-width: 0;
		height: 38px;
		padding: 0 11px;
		border: 1px solid var(--border);
		border-radius: 7px;
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 10px;
		outline: none;
	}

	.copy-link-row input:focus {
		border-color: var(--border-strong);
	}

	.copy-link-row button {
		height: 38px;
		min-width: 64px;
		padding: 0 13px;
		border: 1px solid var(--border-strong);
		border-radius: 7px;
		background: transparent;
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 11px;
		font-weight: 600;
		cursor: pointer;
	}

	.copy-link-row button:hover,
	.copy-link-row button:focus-visible {
		background: var(--surface-2);
		outline: none;
	}

	.engage-toast {
		position: fixed;
		right: 16px;
		bottom: 20px;
		z-index: 160;
		padding: 7px 10px;
		border: 1px solid var(--border-strong);
		border-radius: 6px;
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 11px;
		opacity: 0;
		transform: translateY(4px);
		pointer-events: none;
		transition: opacity 140ms ease, transform 140ms ease;
	}

	.engage-toast.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.engage.feed {
		width: 100%;
		gap: clamp(18px, 7vw, 72px);
		justify-content: flex-start;
	}

	.engage.feed .engage-item {
		min-width: 0;
		padding-inline: 4px;
	}

	@keyframes heart-pop {
		0% { transform: scale(.78); }
		45% { transform: scale(1.34); }
		72% { transform: scale(.94); }
		100% { transform: scale(1); }
	}

	@keyframes heart-ring {
		0% { opacity: .85; transform: translate(-50%, -50%) scale(.4); }
		100% { opacity: 0; transform: translate(-50%, -50%) scale(1.45); }
	}

	@keyframes heart-particles {
		0% { opacity: 1; transform: translate(-50%, -50%) scale(.25); }
		100% { opacity: 0; transform: translate(-50%, -50%) scale(1.25); }
	}

	@media (max-width: 640px) {
		.share-dialog {
			align-self: end;
			border-radius: 12px 12px 0 0;
		}

		.share-backdrop {
			padding: 0;
			place-items: end center;
		}

		.share-platforms {
			grid-template-columns: repeat(3, 1fr);
			row-gap: 18px;
		}
	}

	@media (max-width: 520px) {
		.engage { gap: 3px; }

		.engage-item {
			height: 32px;
			padding-inline: 7px;
		}

		.copy-link-row {
			padding-inline: 14px;
		}

		.share-platforms {
			padding-inline: 14px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.engage-action,
		.engage-toast,
		.platform-icon,
		.platform-action::after,
		.like-action.bursting .heart-shell,
		.like-action.bursting .heart-shell::before,
		.like-action.bursting .heart-shell::after {
			animation: none;
			transition: none;
		}
	}
</style>

<script
	is:inline
	data-root-id={rootId}
	data-link-copied-message={content.linkCopied}
	data-shared-message={shareCopy.shared}
	data-copy-label={shareCopy.copy}
	data-copied-label={shareCopy.copied}
>
	const script = document.currentScript;
	const rootId = script?.dataset.rootId || '';
	const linkCopiedMessage = script?.dataset.linkCopiedMessage || 'Link copied';
	const sharedMessage = script?.dataset.sharedMessage || 'Shared';
	const copyLabel = script?.dataset.copyLabel || 'Copy';
	const copiedLabel = script?.dataset.copiedLabel || 'Copied';
	const root = rootId ? document.getElementById(rootId) : null;

	(function () {
		const el = root;
		if (!(el instanceof HTMLElement)) return;

		const pid = el.dataset.postId || '';
		const api = el.dataset.apiBase || '';
		const title = el.dataset.title || document.title;
		const trackView = el.dataset.trackView !== 'false';
		const viewsEl = el.querySelector('[data-views]');
		const likesEl = el.querySelector('[data-likes]');
		const sharesEl = el.querySelector('[data-shares]');
		const likeBtn = el.querySelector('[data-like-btn]');
		const shareTrigger = el.querySelector('[data-share-trigger]');
		const dialog = el.nextElementSibling instanceof HTMLElement && el.nextElementSibling.matches('[data-share-dialog]')
			? el.nextElementSibling
			: null;
		const dialogPanel = dialog?.querySelector('.share-dialog');
		const closeBtn = dialog?.querySelector('[data-share-close]');
		const copyBtn = dialog?.querySelector('[data-share-copy]');
		const urlInput = dialog?.querySelector('[data-share-url]');
		const nativeShareBtn = dialog?.querySelector('[data-native-share]');
		const platformLinks = Array.from(dialog?.querySelectorAll('[data-share-platform]') || []);
		const toast = dialog?.nextElementSibling instanceof HTMLElement && dialog.nextElementSibling.id === `${rootId}-toast`
			? dialog.nextElementSibling
			: document.getElementById(`${rootId}-toast`);
		const visitorKey = 'portfolio:visitor-id';
		const likedKey = `portfolio:liked:${pid}`;
		const pendingLikeKey = `portfolio:like-pending:${pid}`;
		const localLikesKey = `portfolio:likes:${pid}`;
		const localSharesKey = `portfolio:shares:${pid}`;
		let desiredLiked = localStorage.getItem(likedKey) === '1';
		let syncRunning = false;
		let retryTimer = 0;
		let toastTimer = 0;
		let copyResetTimer = 0;
		let previousOverflow = '';

		function getVisitor() {
			let visitor = localStorage.getItem(visitorKey);
			if (visitor) return visitor;
			visitor = crypto.randomUUID();
			localStorage.setItem(visitorKey, visitor);
			return visitor;
		}

		const visitor = getVisitor();

		function numberFrom(node) {
			return Number(node?.textContent || '0') || 0;
		}

		function setText(node, value) {
			if (node) node.textContent = String(Math.max(0, Number(value) || 0));
		}

		async function getState() {
			const endpoint = `${api.replace(/\/$/, '')}/metrics/${encodeURIComponent(pid)}?visitorId=${encodeURIComponent(visitor)}`;
			const res = await fetch(endpoint);
			if (!res.ok) throw new Error('metrics-get-failed');
			return await res.json();
		}

		async function postState(body) {
			const endpoint = `${api.replace(/\/$/, '')}/metrics/${encodeURIComponent(pid)}`;
			const res = await fetch(endpoint, {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify(body),
			});
			if (!res.ok) throw new Error('metrics-post-failed');
			return await res.json();
		}

		function applyCounts(metrics, includeLikes = true) {
			setText(viewsEl, metrics.views);
			if (includeLikes) setText(likesEl, metrics.likes);
			setText(sharesEl, metrics.shares);
		}

		function renderLiked(liked, animate = false) {
			if (!(likeBtn instanceof HTMLButtonElement)) return;
			likeBtn.classList.toggle('liked', liked);
			likeBtn.setAttribute('aria-pressed', String(liked));
			if (!animate || !liked || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			likeBtn.classList.remove('bursting');
			void likeBtn.offsetWidth;
			likeBtn.classList.add('bursting');
			window.setTimeout(() => likeBtn.classList.remove('bursting'), 480);
		}

		function storeLiked(liked) {
			desiredLiked = liked;
			localStorage.setItem(likedKey, liked ? '1' : '0');
		}

		function showToast(message) {
			if (!(toast instanceof HTMLElement)) return;
			window.clearTimeout(toastTimer);
			toast.textContent = message;
			toast.classList.add('visible');
			toastTimer = window.setTimeout(() => toast.classList.remove('visible'), 1800);
		}

		async function syncLike() {
			if (!api || syncRunning || localStorage.getItem(pendingLikeKey) !== '1') return;
			syncRunning = true;
			window.clearTimeout(retryTimer);

			try {
				while (localStorage.getItem(pendingLikeKey) === '1') {
					const target = desiredLiked;
					const state = await postState({ action: 'like', liked: target, visitorId: visitor });
					if (desiredLiked !== target) continue;

					localStorage.removeItem(pendingLikeKey);
					storeLiked(Boolean(state.liked));
					applyCounts(state, true);
					renderLiked(desiredLiked, false);
				}
			} catch {
				retryTimer = window.setTimeout(() => void syncLike(), 4000);
			} finally {
				syncRunning = false;
			}
		}

		function optimisticLikeToggle() {
			const nextLiked = !desiredLiked;
			storeLiked(nextLiked);
			localStorage.setItem(pendingLikeKey, '1');
			setText(likesEl, numberFrom(likesEl) + (nextLiked ? 1 : -1));
			renderLiked(nextLiked, nextLiked);

			if (api) {
				void syncLike();
				return;
			}

			localStorage.removeItem(pendingLikeKey);
			localStorage.setItem(localLikesKey, String(numberFrom(likesEl)));
		}

		async function copyUrl(url) {
			try {
				await navigator.clipboard.writeText(url);
				return true;
			} catch {
				const textarea = document.createElement('textarea');
				textarea.value = url;
				textarea.setAttribute('readonly', '');
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				const copied = document.execCommand('copy');
				textarea.remove();
				return copied;
			}
		}

		function recordShare() {
			setText(sharesEl, numberFrom(sharesEl) + 1);

			if (!api) {
				localStorage.setItem(localSharesKey, String(numberFrom(sharesEl)));
				return;
			}

			void postState({ action: 'share', visitorId: visitor })
				.then((state) => applyCounts(state, false))
				.catch(() => {});
		}

		function configureShareTargets() {
			const url = window.location.href;
			if (urlInput instanceof HTMLInputElement) urlInput.value = url;

			for (const option of platformLinks) {
				if (!(option instanceof HTMLAnchorElement)) continue;
				const platform = option.dataset.sharePlatform;
				if (platform === 'whatsapp') option.href = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
				if (platform === 'x') option.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
				if (platform === 'linkedin') option.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
				if (platform === 'facebook') option.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
				if (platform === 'telegram') option.href = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
			}

			if (nativeShareBtn instanceof HTMLButtonElement) {
				nativeShareBtn.hidden = typeof navigator.share !== 'function';
			}
		}

		function openShareDialog() {
			if (!(dialog instanceof HTMLElement) || !(shareTrigger instanceof HTMLButtonElement)) return;
			configureShareTargets();
			dialog.hidden = false;
			shareTrigger.setAttribute('aria-expanded', 'true');
			previousOverflow = document.body.style.overflow;
			document.body.style.overflow = 'hidden';
			window.requestAnimationFrame(() => {
				const firstAction = dialog.querySelector('.platform-action:not([hidden])');
				if (firstAction instanceof HTMLElement) firstAction.focus();
				else if (dialogPanel instanceof HTMLElement) dialogPanel.focus();
			});
		}

		function closeShareDialog({ restoreFocus = true } = {}) {
			if (!(dialog instanceof HTMLElement)) return;
			dialog.hidden = true;
			document.body.style.overflow = previousOverflow;
			if (shareTrigger instanceof HTMLButtonElement) {
				shareTrigger.setAttribute('aria-expanded', 'false');
				if (restoreFocus) shareTrigger.focus();
			}
		}

		likeBtn?.addEventListener('click', optimisticLikeToggle);
		shareTrigger?.addEventListener('click', openShareDialog);
		closeBtn?.addEventListener('click', () => closeShareDialog());

		copyBtn?.addEventListener('click', async () => {
			const url = window.location.href;
			const copied = await copyUrl(url);
			if (!copied) return;
			recordShare();
			showToast(linkCopiedMessage);

			if (copyBtn instanceof HTMLButtonElement) {
				window.clearTimeout(copyResetTimer);
				copyBtn.textContent = copiedLabel;
				copyResetTimer = window.setTimeout(() => {
					copyBtn.textContent = copyLabel;
				}, 1500);
			}
		});

		for (const option of platformLinks) {
			if (!(option instanceof HTMLAnchorElement)) continue;
			option.addEventListener('click', () => {
				recordShare();
				closeShareDialog({ restoreFocus: false });
			});
		}

		nativeShareBtn?.addEventListener('click', async () => {
			if (typeof navigator.share !== 'function') return;
			try {
				await navigator.share({ title, text: title, url: window.location.href });
				recordShare();
				showToast(sharedMessage);
				closeShareDialog({ restoreFocus: false });
			} catch (error) {
				if (error instanceof DOMException && error.name === 'AbortError') return;
			}
		});

		dialog?.addEventListener('click', (event) => {
			if (event.target === dialog) closeShareDialog();
		});

		document.addEventListener('keydown', (event) => {
			if (!(dialog instanceof HTMLElement) || dialog.hidden) return;
			if (event.key === 'Escape') {
				event.preventDefault();
				closeShareDialog();
				return;
			}

			if (event.key !== 'Tab') return;
			const focusable = Array.from(dialog.querySelectorAll('a[href], button:not([hidden]), input:not([disabled])'))
				.filter((node) => node instanceof HTMLElement && !node.hasAttribute('hidden'));
			if (!focusable.length) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;
			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		window.addEventListener('online', () => void syncLike());
		renderLiked(desiredLiked, false);

		(async () => {
			if (api) {
				try {
					const state = await getState();
					const hasPendingLike = localStorage.getItem(pendingLikeKey) === '1';
					applyCounts(state, !hasPendingLike);

					if (hasPendingLike) {
						const serverLiked = Boolean(state.liked);
						const optimisticLikes = Number(state.likes || 0) + (desiredLiked === serverLiked ? 0 : desiredLiked ? 1 : -1);
						setText(likesEl, optimisticLikes);
						void syncLike();
					} else {
						storeLiked(Boolean(state.liked));
						renderLiked(desiredLiked, false);
					}
				} catch {}

				if (trackView) {
					try {
						const state = await postState({ action: 'view', visitorId: visitor });
						const hasPendingLike = localStorage.getItem(pendingLikeKey) === '1';
						applyCounts(state, !hasPendingLike);
						if (!hasPendingLike && typeof state.liked === 'boolean') {
							storeLiked(state.liked);
							renderLiked(desiredLiked, false);
						}
					} catch {}
				}
				return;
			}

			setText(likesEl, Number(localStorage.getItem(localLikesKey) || '0'));
			setText(sharesEl, Number(localStorage.getItem(localSharesKey) || '0'));

			if (trackView) {
				const viewsKey = `portfolio:views:${pid}`;
				const seenKey = `portfolio:viewed-once:${pid}`;
				let views = Number(localStorage.getItem(viewsKey) || '0');
				if (!localStorage.getItem(seenKey)) {
					views += 1;
					localStorage.setItem(viewsKey, String(views));
					localStorage.setItem(seenKey, '1');
				}
				setText(viewsEl, views);
			}
		})();
	})();
</script>
