# Engagement bar API (Cloudflare Worker)
# Production builds default to the public worker URL when this is unset.
# Uncomment only when testing a different engagement API endpoint.
# PUBLIC_ENGAGEMENT_API_BASE=https://portfolio-metrics-api.nabilrizkinavisa.workers.dev

# Personal repos to display in Projects section (comma-separated, fetched from GitHub API)

# GitHub token for pinned repos (optional — only needed for GraphQL pinned items)
# GITHUB_TOKEN=github_pat_xxx
